{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "type": "stdio",
      "env": []
    },
    "langchain-docs": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "enabled": true
    },
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "type": "stdio",
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_SECRET": "xnch-agentmemory-secret"
      }
    }
  }
}
