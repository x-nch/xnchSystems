      )\n112: \n113:     # Step 4 — Context manifest (hard stop on failure)\n114:     try:\n115:         manifest = await load_context(_xnch, session, intent)\n116:     except Exception as exc:\n117:         logger.error(\"Context manifest load failed: %s\", exc)\n118:         raise HTTPException(status_code=503, detail=\"DEGRADED: context manifest unavailable\")\n119: \n120:     # Fetch weight config for this intent class (cached per session)\n121:     try:\n122:         weight_config = await _xnch.get_weight_config(intent.intent_class)\n123:     except Exception:\n124:         weight_config = None\n125: \n126:     evaluator = Evaluator(weight_config)\n127: \n128:     # Step 5 — Option generation\n129:     n = settings.options_count\n130:     raw_options, generation_path = await generate_options(\n131:         _model_adapter, session, intent, manifest, n\n132:     )\n133: \n134:     # Step 6 — Policy alignment filter\n135:     try:\n136:         surviving = await _policy_filter.filter(session, raw_options)\n137:     except AllOptionsBlocked:\n138:         hold_id = uuid4()\n139:         emit_event(str(session.trace_id), \"nexi\", \"ESCALATED_ALL_BLOCKED\",\n140:                    {\"hold_id\": str(hold_id)})\n141:         return SessionStartResponse(status=\"ESCALATED\", hold_id=hold_id)\n142: \n143:     # Step 7 — Scoring\n144:     evaluated = evaluator.score(surviving, intent, manifest, session)\n145: \n146:     # Step 8 — Outcome simulation (conditional)\n147:     evaluated = evaluator.simulate_and_rescore(evaluated, surviving, manifest, intent, session)\n148: \n149:     # Step 9 — Selection\n150:     n_blocked = len(raw_options) - len(surviving)\n151:     decision = select_decision(\n152:         session, intent, manifest,\n153:         [opt for opt, _ in surviving], evaluated,\n154:         n_generated=len(raw_options),\n155:         n_blocked=n_blocked,\n156:         generation_path=generation_path,\n157:     )\n158: \n159:     if decision.escalation_trigger