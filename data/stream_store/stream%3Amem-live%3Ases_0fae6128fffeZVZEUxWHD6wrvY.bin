= logging.getLogger(__name__)\n10: \n11: \n12: @dataclass\n13: class ProactivityEvent:\n14:     trigger: str\n15:     message: str\n16:     priority: int = 0\n17:     expires_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc) + timedelta(hours=2))\n18: \n19:     @property\n20:     def expired(self) -> bool:\n21:         return datetime.now(timezone.utc) > self.expires_at\n22: \n23:     def to_dict(self) -> dict:\n24:         return {\n25:             \"trigger\": self.trigger,\n26:             \"message\": self.message,\n27:             \"priority\": self.priority,\n28:             \"expires_at\": self.expires_at.isoformat(),\n29:         }\n30: \n31:     @classmethod\n32:     def from_dict(cls, d: dict) -> ProactivityEvent:\n33:         return cls(\n34:             trigger=d[\"trigger\"],\n35:             message=d[\"message\"],\n36:             priority=d.get(\"priority\", 0),\n37:             expires_at=datetime.fromisoformat(d[\"expires_at\"]),\n38:         )\n39: \n40: \n41: class ProactivityEngine:\n42:     def __init__(self, redis_client, http_client=None):\n43:         self._redis = redis_client\n44:         self._http = http_client\n45: \n46:     async def check_and_queue(\n47:         self,\n48:         pattern_store=None,\n49:         db_path=None,\n50:     ) -> list[ProactivityEvent]:\n51:         events: list[ProactivityEvent] = []\n52:         now = datetime.now(timezone.utc)\n53: \n54:         if pattern_store is not None:\n55:             try:\n56:                 patterns = await pattern_store.fetch_low_success(max_success_rate=0.4, min_confidence=0.5)\n57:                 for p in patterns:\n58:                     events.append(ProactivityEvent(\n59:                         trigger=\"stale_pattern\",\n60:                         message=(\n61:                             f\"ck-san, the {p.get('action_type', 'unknown')} pattern for \"\n62:                             f\"{p.get('intent_class', 'unknown')} is failing 60%+ of the time. \"\n63:                             f\"Want me to draft a policy candidate fix?\"\n64:                         ),\n65:                         priority=3,\n66:                         expires_at=now + timedelta(hours=2),\n67:                     ))\n68:             except Exception as e:\n69:                 logger.warning(\"Proactivity Rule 1 (stale pattern) failed: %s\", e)\n70: \n71:         if db_path is not None:\n72:             try:\n73:                 import aiosqlite\n74:                 async with aiosqlite.connect(db_path) as db:\n75:                     async with db.execute(\n76:                         \"SELECT value FROM system_state WHERE key = 'last_consolidation_run'\"\n77:                     ) as cursor:\n78:                         row = await cursor.fetchone()\n79:                 if row and row[0]:\n80:                     last_run = datetime.fromisoformat(row[0])\n81:                     if (now - last_run) > timedelta(hours=25):\n82:                         events.append(ProactivityEvent(\n83:                             trigger=\"consolidation_stale\",\n84:                             message=\"Consolidation has not run in 25h. Redis working memory may be stale.\",\n85:                             priority=2,\n86:                             expires_at=now + timedelta(hours=4),\n87:                         ))\n88:             except Exception as e:\n89:                 logger.warning(\"Proactivity Rule 2 (consolidation) failed: %s\", e)\n90: \n91:         if self._http is not None:\n92:             try:\n93:                 resp = await self._http.get(\"http://i9-node:8000/health\")\n94:                 if resp.status_code != 200:\n95:                     events.append(ProactivityEvent(\n96:                         trigger=\"inference_down\",\n97:                         message=\"Gemma 4 on i9 is not responding. Routing fallback to claude-judgment is active.\",\n98:                         priority=5,\n99:                         expires_at=now + timedelta(hours=1),\n100:                     ))\n101:             except Exception:\n102:                 events.append(ProactivityEvent(\n103:                     trigger=\"inference_down\",\n104:                     message=\"Gemma 4 on i9 is not responding. Routing fallback to claude-judgment is active.\",\n105:                     priority=5,\n106:                     expires_at=now + timedelta(hours=1),\n107:                 ))\n108: \n109:         if db_path is not None:\n110:             try:\n111:                 import aiosqlite\n112:                 async with aiosqlite.connect(db_path) as db:\n113:                     async with db.execute(\n114:                         \"SELECT value FROM system_state WHERE key = 'last_extraction_run'\"\n115:                     ) as cursor:\n116:                         row = await cursor.fetchone()\n117:                 if row and row[0]:\n118:                     last_extract = datetime.fromisoformat(row[0])\n119:                     if (now - last_extract) > timedelta(hours=7):\n120:                         events.append(ProactivityEvent(\n121:                             trigger=\"learning_loop_silence\",\n122:                             message=\"Pattern extractor has been silent for 7h. Check xnch-core logs.\",\n123:                             priority=4,\n124:                             expires_at=now + timedelta(hours=2),\n125:                         ))\n126:             except Exception as e:\n127:                 logger.warning(\"Proactivity Rule 4 (learning silence) failed: %s\", e)\n128: \n129:         for ev in events:\n130:             await self.queue_event(ev)\n131: \n132:         return events\n133: \n134:     async def queue_event(self, event: ProactivityEvent) -> None:\n135:         key = f\"proactivity:pending:{uuid4()}\"\n136:         ttl_seconds = max(60, int((event.expires_at - datetime.now(timezone.utc)).total_seconds()))\n137:         await self._redis.set(key, json.dumps(event.to_dict()), ex=ttl_seconds)\n138: \n139:     async def get_pending(self) -> list[ProactivityEvent]:\n140:         events: list[ProactivityEvent] = []\n141:         cursor = 0\n142:         while True:\n143:             cursor, keys = await self._redis.scan(cursor=cursor, match=\"proactivity:pending:*\")\n144:             for k in keys:\n145:                 raw = await self._redis.get(k)\n146:                 if raw is None:\n147:                     continue\n148:                 try:\n149:                     ev = ProactivityEvent.from_dict(json.loads(raw))\n150:                     if not ev.expired:\n151:                         events.append(ev)\n152:                 except Exception:\n153:                     pass\n154:             if cursor == 0:\n155:                 break\n156:         events.sort(key=lambda e: e.priority, reverse=True)\n157:         return events\n\n(End of file - total 157 lines)\n</content>"},"sessionId":"ses_0fae6128fffeZVZEUxWHD6wrvY","timestamp":"2026-06-26T18:03:37.067Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/nexi/nexi/proactivity/engine.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/nexi/nexi/proactivity/engine.py</path>\n<type>file</type>\n<content>\n1: from __future__ import annotations\n2: \n3: import json\n4: import logging\n5: from dataclasses import dataclass, field\n6: from datetime import datetime, timedelta, timezone\n7: from uuid import uuid4\n8: \n9: logger = logging.getLogger(__name__)\n10: \n11: \n12: @dataclass\n13: class ProactivityEvent:\n14:     trigger: str\n15:     message: str\n16:     priority: int = 0\n17:     expires_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc) + timedelta(hours=2))\n18: \n19:     @property\n20:     def expired(self) -> bool:\n21:         return datetime.now(timezone.utc) > self.expires_at\n22: \n23:     def to_dict(self) -> dict:\n24:         return {\n25:             \"trigger\": self.trigger,\n26:             \"message\": self.message,\n27:             \"priority\": self.priority,\n28:             \"expires_at\": self.expires_at.isoformat(),\n29:         }\n30: \n31:     @classmethod\n32:     def from_dict(cls, d: dict) -> ProactivityEvent:\n33:         return cls(\n34:             trigger=d[\"trigger\"],\n35:             message=d[\"message\"],\n36:             priority=d.get(\"priority\", 0),\n37:             expires_at=datetime.fromisoformat(d[\"expires_at\"]),\n38:         )\n39: \n40: \n41: class ProactivityEngine:\n42:     def __init__(self, redis_client, http_client=None):\n43:         self._redis = redis_client\n44:         self._http = http_client\n45: \n46:     async def check_and_queue(\n47:         self,\n48:         pattern_store=None,\n49:         db_path=None,\n50:     ) -> list[ProactivityEvent]:\n51:         events: list[ProactivityEvent] = []\n52:         now = datetime.now(timezone.utc)\n53: \n54:         if pattern_store is not None:\n55:             try:\n56:                 patterns = await pattern_store.fetch_low_success(max_success_rate=0.4, min_confidence=0.5)\n57:                 for p in patterns:\n58:                     events.append(ProactivityEvent(\n59:                         trigger=\"stale_pattern\",\n60:                         message=(\n61:                             f\"ck-san, the {p.get('action_type', 'unknown')} pattern for \"\n62:                             f\"{p.get('intent_class', 'unknown')} is failing 60%+ of the time. \"\n63:                             f\"Want me to draft a policy candidate fix?\"\n64:                         ),\n65:                         priority=3,\n66:                         expires_at=now + timedelta(hours=2),\n67:                     ))\n68:             except Exception as e:\n69:                 logger.warning(\"Proactivity Rule 1 (stale pattern) failed: %s\", e)\n70: \n71:         if db_path is not None:\n72:             try:\n73:                 import aiosqlite\n74:                 async with aiosqlite.connect(db_path) as db:\n75:                     async with db.execute(\n76:                         \"SELECT value FROM system_state WHERE key = 'last_consolidation_run'\"\n77:                     ) as cursor:\n78:                         row = await cursor.fetchone()\n79:                 if row and row[0]:\n80:                     last_run = datetime.fromisoformat(row[0])\n81:                     if (now - last_run) > timedelta(hours=25):\n82:                         events.append(ProactivityEvent(\n83:                             trigger=\"consolidation_stale\",\n84:                             message=\"Consolidation has not run in 25h. Redis working memory may be stale.\",\n85:                             priority=2,\n86:                             expires_at=now + timedelta(hours=4),\n87:                         ))\n88:             except Exception as e:\n89:                 logger.warning(\"Proactivity Rule 2 (consolidation) failed: %s\", e)\n90: \n91:         if self._http is not None:\n92:             try:\n93:                 resp = await self._http.get(\"http://i9-node:8000/health\")\n94:                 if resp.status_code != 200:\n95:                     events.append(ProactivityEvent(\n96:                         trigger=\"inference_down\",\n97:                         message=\"Gemma 4 on i9 is not responding. Routing fallback to claude-judgment is active.\",\n98:                         priority=5,\n99:                         expires_at=now + timedelta(hours=1),\n100:                     ))\n101:             except Exception:\n102:                 events.append(ProactivityEvent(\n103:                     trigger=\"inference_down\",\n104:                     message=\"Gemma 4 on i9 is not responding. Routing fallback to claude-judgment is active.\",\n105:                     priority=5,\n106:                     expires_at=now + timedelta(hours=1),\n107:                 ))\n108: \n109:         if db_path is not None:\n110:             try:\n111:                 import aiosqlite\n112:                 async with aiosqlite.connect(db_path) as db:\n113:                     async with db.execute(\n114:                         \"SELECT value FROM system_state WHERE key = 'last_extraction_run'\"\n115:                     ) as cursor:\n116:                         row = await cursor.fetchone()\n117:                 if row and row[0]:\n118:                     last_extract = datetime.fromisoformat(row[0])\n119:                     if (now - last_extract) > timedelta(hours=7):\n120:                         events.append(ProactivityEvent(\n121:                             trigger=\"learning_loop_silence\",\n122:                             message=\"Pattern extractor has been silent for 7h. Check xnch-core logs.\",\n123:                             priority=4,\n124:                             expires_at=now + timedelta(hours=2),\n125:                         ))\n126:             except Exception as e:\n127:                 logger.warning(\"Proactivity Rule 4 (learning silence) failed: %s\", e)\n128: \n129:         for ev in events:\n130:             await self.queue_event(ev)\n131: \n132:         return events\n133: \n134:     async def queue_event(self, event: ProactivityEvent) -> None:\n135:         key = f\"proactivity:pending:{uuid4()}\"\n136:         ttl_seconds = max(60, int((event.expires_at - datetime.now(timezone.utc)).total_seconds()))\n137:         await self._redis.set(key, json.dumps(event.to_dict()), ex=ttl_seconds)\n138: \n139:     async def get_pending(self) -> list[ProactivityEvent]:\n140:         events: list[ProactivityEvent] = []\n141:         cursor = 0\n142:         while True:\n143:             cursor, keys = await self._redis.scan(cursor=cursor, match=\"proactivity:pending:*\")\n144:             for k in keys:\n145:                 raw = await self._redis.get(k)\n146:                 if raw is None:\n147:                     continue\n148:                 try:\n149:                     ev = Proactivity