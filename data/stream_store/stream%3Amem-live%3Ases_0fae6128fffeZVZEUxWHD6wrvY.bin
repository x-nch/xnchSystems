ort SessionContext\n15: from .pipeline import (\n16:     IntentInterpreter, ClarificationRequired,\n17:     load_context,\n18:     generate_options,\n19:     PolicyFilter, AllOptionsBlocked,\n20:     Evaluator,\n21:     select_decision,\n22:     compile_action_spec, PlanCompilationError,\n23:     dispatch_execution,\n24: )\n25: from .pipeline.dispatch import TokenExpired\n26: from .utils.audit import emit_event\n27: \n28: logger = logging.getLogger(__name__)\n29: \n30: \n31: # ---------------------------------------------------------------------------\n32: # App lifecycle\n33: # ---------------------------------------------------------------------------\n34: \n35: _xnch: XnchClient | None = None\n36: _model_adapter: ModelAdapter | None = None\n37: _policy_filter: PolicyFilter | None = None\n38: _intent_interpreter: IntentInterpreter | None = None\n39: \n40: \n41: @asynccontextmanager\n42: async def lifespan(app: FastAPI):\n43:     global _xnch, _model_adapter, _policy_filter, _intent_interpreter\n44:     _xnch = XnchClient()\n45:     _model_adapter = ModelAdapter()\n46:     _policy_filter = PolicyFilter(_xnch)\n47:     _intent_interpreter = IntentInterpreter()\n48:     yield\n49:     await _xnch.aclose()\n50: \n51: \n52: app = FastAPI(title=\"Nexi\", version=\"0.1.0\", lifespan=lifespan)\n53: \n54: \n55: # ---------------------------------------------------------------------------\n56: # Request / response schemas\n57: # ---------------------------------------------------------------------------\n58: \n59: class SessionStartRequest(BaseModel):\n60:     session_id: UUID\n61:     trace_id: UUID\n62:     actor: dict[str, Any]\n63:     system_state_version: str\n64:     policy_version: str\n65:     raw_input: str\n66:     priority: str = \"NORMAL\"\n67:     idempotency_key: UUID\n68: \n69: \n70: class SessionStartResponse(BaseModel):\n71:     status: str\n72:     decision_id: UUID | None = None\n73:     execution_ref: UUID | None = None\n74:     estimated_completion_ms: int | None = None\n75:     audit_ref: UUID | None = None\n76:     clarification_required: bool = False\n77:     hold_id: UUID | None = None\n78:     error: str | None = None\n79: \n80: \n81: class ClarifyRequest(BaseModel):\n82:     amended_input: str\n83: \n84: \n85: # ---------------------------------------------------------------------------\n86: # Endpoints\n87: # ---------------------------------------------------------------------------\n88: \n89: @app.post(\"/session/start\", response_model=SessionStartResponse)\n90: async def session_start(\n91:     body: SessionStartRequest,\n92:     background_tasks: BackgroundTasks,\n93: ) -> SessionStartResponse:\n94:     \"\"\"Entry point called by xnch after actor resolution (Step 2 → Step 3).\"\"\"\n95:     session = SessionContext.model_validate(body.model_dump())\n96:     emit_event(session.trace_id, \"nexi\", \"SESSION_START_RECEIVED\",\n97:                {\"session_id\": str(session.session_id)})\n98: \n99:     if _intent_interpreter is None:\n100:         return SessionStartResponse(status=\"ERROR\", error=\"intent interpreter not available\")\n101: \n102:     # Step 3 — Intent interpretation\n103:     try:\n104:         intent = await _intent_interpreter.interpret(\n105:             body.raw_input, session.session_id, str(session.trace_id)\n106:         )\n107:     except ClarificationRequired as exc:\n108:         return SessionStartResponse(\n109:             status=\"CLARIFICATION_REQUIRED\",\n110:             clarification_required=True,\n111:         )\n112: \n113:     # Step 4 — Context manifest (hard stop on failure)\n114:     try:\n115:         manifest = await load_context(_xnch, session, intent)\n116:     except Exception as exc:\n117:         logger.error(\"Context manifest load failed: %s\", exc)\n118:         raise HTTPException(status_code=503, detail=\"DEGRADED: context manifest unavailable\")\n119: \n120:     # Fetch weight config for this intent class (cached per session)\n121:     try:\n122:         weight_config = await _xnch.get_weight_config(intent.intent_class)\n123:     except Exception:\n124:         weight_config = None\n125: \n126:     evaluator = Evaluator(weight_config)\n127: \n128:     # Step 5 — Option generation\n129:     n = settings.options_count\n130:     raw_options, generation_path = await generate_options(\n131:         _model_adapter, session, intent, manifest, n\n132:     )\n133: \n134:     # Step 6 — Policy alignment filter\n135:     try:\n136:         surviving = await _policy_filter.filter(session, raw_options)\n137:     except AllOptionsBlocked:\n138:         hold_id = uuid4()\n139:         emit_event(str(session.trace_id), \"nexi\", \"ESCALATED_ALL_BLOCKED\",\n140:                    {\"hold_id\": str(hold_id)})\n141:         return SessionStartResponse(status=\"ESCALATED\", hold_id=hold_id)\n142: \n143:     # Step 7 — Scoring\n144:     evaluated = evaluator.score(surviving, intent, manifest, session)\n145: \n146:     # Step 8 — Outcome simulation (conditional)\n147:     evaluated = evaluator.simulate_and_rescore(evaluated, surviving, manifest, intent, session)\n148: \n149:     # Step 9 — Selection\n150:     n_blocked = len(raw_options) - len(surviving)\n151:     decision = select_decision(\n152:         session, intent, manifest,\n153:         [opt for opt, _ in surviving], evaluated,\n154:         n_generated=len(raw_options),\n155:         n_blocked=n_blocked,\n156:         generation_path=generation_path,\n157:     )\n158: \n159:     if decision.escalation_triggered:\n160:         hold_id = uuid4()\n161:         return SessionStartResponse(status=\"ESCALATED\", hold_id=hold_id)\n162: \n163:     # Step 10a — Plan compilation\n164:     selected_opt = next(\n165:         (opt for opt, _ in surviving if opt.option_id == decision.selected_option_id),\n166:         None,\n167:     )\n168:     if selected_opt is None:\n169:         raise HTTPException(status_code=500, detail=\"Selected option not found\")\n170: \n171:     try:\n172:         compiled = compile_action_spec(selected_opt)\n173:     except PlanCompilationError as exc:\n174:         raise HTTPException(status_code=422, detail=str(exc))\n175: \n176:     if not compiled.nodes:\n177:         return JSONResponse({'error': 'compiled DAG has no nodes'}, status_code=422)\n178:     node = compiled.nodes[0]\n179:     validated_action_spec = {\n180:         \"type\": node.action_type,\n181:         \"target\": node.target,\n182:         \"params\": node.params,\n183:     }\n184: \n185:     # Step 10 — Final verdict\n186:     try:\n187:         verdict = await _xnch.submit_verdict(\n188:             session, decision, validated_action_spec, selected_opt.payload_hash\n189:         )\n190:     except Exception as exc:\n191:         error_body = str(exc)\n192:         if \"STALE_SESSION\" in error_body:\n193:             raise HTTPException(status_code=409, detail=\"STALE_SESSION: restart required\")\n194:         raise HTTPException(status_code=502, detail=f\"Verdict submission failed: {error_body}\")\n195: \n196:     if verdict.verdict == \"BLOCK\":\n197:         hold_id = uuid4()\n198:         return SessionStartResponse(status=\"ESCALATED\", hold_id=hold_id)\n199: \n200:     # Step 11 — Execution dispatch (async handoff)\n201:     execution_runner_url = settings.execution_runner_url\n202:     try:\n203:         dispatch_payload = await dispatch_execution(\n204:             session, decision, verdict, validated_action_spec, execution_runner_url\n205:         )\n206:     except TokenExpired:\n207:         # Resubmit to xnch for a new token, same decision_id\n208:         verdict = await _xnch.submit_verdict(\n209:             session, decision, vali"},"sessionId":"ses_0fae6128fffeZVZEUxWHD6wrvY","timestamp":"2026-06-26T18:03:37.295Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/nexi/nexi/main.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/nexi/nexi/main.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Nexi v0 — 