mport redis.asyncio as aioredis\n8: \n9: from ..config import settings\n10: \n11: \n12: class VoiceDaemon:\n13:     def __init__(self, redis_url: str | None = None) -> None:\n14:         self._redis = aioredis.from_url(\n15:             redis_url or settings.redis_url,\n16:             decode_responses=True,\n17:         )\n18:         self._vad_model = None\n19:         self._whisper_model = None\n20:         self._recording = False\n21:         self._audio_buffer: list[bytes] = []\n22: \n23:     async def aclose(self) -> None:\n24:         await self._redis.aclose()\n25: \n26:     async def load_models(self) -> None:\n27:         loop = asyncio.get_running_loop()\n28: \n29:         def _load_vad():\n30:             import silero_vad\n31:             return silero_vad.load_silero_vad()\n32: \n33:         def _load_whisper():\n34:             from faster_whisper import WhisperModel\n35:             return WhisperModel(\n36:                 \"base\",\n37:                 device=\"cuda\",\n38:                 compute_type=\"float16\",\n39:                 num_workers=1,\n40:             )\n41: \n42:         self._vad_model = await loop.run_in_executor(None, _load_vad)\n43:         self._whisper_model = await loop.run_in_executor(None, _load_whisper)\n44: \n45:     async def start_recording(self) -> dict[str, Any]:\n46:         if self._recording:\n47:             return {\"status\": \"already_recording\"}\n48:         self._recording = True\n49:         self._audio_buffer = []\n50:         return {\"status\": \"recording_started\", \"session_id\": str(uuid.uuid4())}\n51: \n52:     async def stop_recording(self) -> dict[str, Any]:\n53:         if not self._recording:\n54:             return {\"status\": \"not_recording\"}\n55:         self._recording = False\n56:         transcript = await self._transcribe()\n57:         perception_id = str(uuid.uuid4())\n58:         payload = {\n59:             \"id\": perception_id,\n60:             \"transcript\": transcript,\n61:             \"timestamp\": time.time(),\n62:             \"type\": \"voice\",\n63:         }\n64:         await self._redis.setex(\n65:             f\"perception:voice:{perception_id}\",\n66:             60,\n67:             json.dumps(payload),\n68:         )\n69:         self._audio_buffer = []\n70:         return {\n71:             \"status\": \"stopped\",\n72:             \"perception_id\": perception_id,\n73:             \"transcript\": transcript,\n74:         }\n75: \n76:     async def push_audio(self, chunk: bytes) -> None:\n77:         if not self._recording:\n78:             return\n79:         self._audio_buffer.append(chunk)\n80: \n81:     async def _transcribe(self) -> str:\n82:         if self._whisper_model is None or not self._audio_buffer:\n83:             return \"\"\n84:         import numpy as np\n85:         raw = b\"\".join(self._audio_buffer)\n86:         audio_np = np.frombuffer(raw, dtype=np.float32).astype(np.float32)\n87:         loop = asyncio.get_running_loop()\n88: \n89:         def _run():\n90:             segments, _ = self._whisper_model.transcribe(audio_np, beam_size=1)\n91:             return \" \".join(seg.text for seg in segments).strip()\n92: \n93:         return await loop.run_in_executor(None, _run)\n94: \n95:     async def detect_silence(self, chunk: bytes, sample_rate: int = 16000) -> bool:\n96:         if self._vad_model is None:\n97:             return True\n98:         import numpy as np\n99:         audio_int16 = np.frombuffer(chunk, dtype=np.int16).astype(np.float32) / 32768.0\n100:         loop = asyncio.get_running_loop()\n101: \n102:         def _check():\n103:             return self._vad_model.is_speech(audio_int16, sample_rate)\n104: \n105:         return not await loop.run_in_executor(None, _check)\n\n(End of file - total 105 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:20:50.864Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/perception/voice_daemon