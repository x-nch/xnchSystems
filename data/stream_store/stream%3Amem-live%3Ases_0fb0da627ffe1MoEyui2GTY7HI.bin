include modify_spec)\\n'\nLine 50: b'- DEFER: when action needs human approval (include requires_actor)\\n'\nLine 51: b'- Generate 1-3 candidate rules per batch\\n'\nLine 52: b'- Output raw YAML only, no markdown fences\\n'\nLine 53: b'\"\"\"\\n'\nLine 54: b'\\n'\nLine 55: b'\\n'\nLine 56: b'class PolicyCandidateGenerator:\\n'\nLine 57: b'    def __init__(self, patterns: PatternStore, db_path: Path) -> None:\\n'\nLine 58: b'        self._patterns = patterns\\n'\nLine 59: b'        self._db = db_path\\n'\nLine 60: b'\\n'\nLine 61: b'    async def run(self) -> int:\\n'\nLine 62: b'        low_success = await self._patterns.fetch_low_success(\\n'\nLine 63: b'            max_success_rate=0.4, min_confidence=0.6\\n'\nLine 64: b'        )\\n'\nLine 65: b'        if not low_success:\\n'\nLine 66: b'            logger.info(\"No low-success patterns found\")\\n'\nLine 67: b'            return 0\\n'\nLine 68: b'\\n'\nLine 69: b'        count = 0\\n'\nLine 70: b'        for i in range(0, len(low_success), 5):\\n'\nLine 71: b'            batch = low_success[i:i + 5]\\n'\nLine 72: b'            if all(await self._candidate_exists(p[\"pattern_id\"]) for p in batch):\\n'\nLine 73: b'                continue\\n'\nLine 74: b'\\n'\nLine 75: b'            yaml_output = await self._llm_generate(batch)\\n'\nLine 76: b'            if not yaml_output:\\n'\nLine 77: b'                continue\\n'\nLine 78: b'\\n'\nLine 79: b'            candidates = self._parse_candidates(yaml_output, batch)\\n'\nLine 80: b'            for cand in candidates:\\n'\nLine 81: b'                async with aiosqlite.connect(self._db) as db:\\n'\nLine 82: b'                    await db.execute(\\n'\nLine 83: b'                        \"\"\"INSERT INTO policy_candidates\\n'\nLine 84: b'                           (candidate_id, pattern_id, rule_yaml, triggering_pattern, status, created_at)\\n'\nLine 85: b'                           VALUES (?, ?, ?, ?, \\'PENDING\\', ?)\"\"\",\\n'\nLine 86: b'                        (cand[\"candidate_id\"], cand[\"pattern_id\"], cand[\"rule_yaml\"],\\n'\nLine 87: b'                         json.dumps(cand[\"triggering_pattern\"]), time.time()),\\n'\nLine 88: b'                    )\\n'\nLine 89: b'                    await db.commit()\\n'\nLine 90: b'                logger.info(\"Policy candidate %s written\", cand[\"candidate_id\"])\\n'\nLine 91: b'                count += 1\\n'\nLine 92: b'        return count\\n'\nLine 93: b'\\n'\nLine 94: b'    async def _llm_generate(self, patterns: list[dict]) -> str | None:\\n'\nLine 95: b'        pattern_summary = \"\\\\n\".join(\\n'\nLine 96: b'            f\"- {p[\\'intent_class\\']}|{p[\\'action_type\\']}|{p[\\'entity_class\\']}|{p[\\'actor_role\\']}  \"\\n'\nLine 97: b'            f\"success_rate={p[\\'success_rate\\']:.2f}  confidence={p[\\'confidence\\']:.2f}  \"\\n'\nLine 98: b'            f\"n={p[\\'observation_count\\']}\"\\n'\nLine 99: b'            for p in patterns\\n'\nLine 100: b'        )\\n'\nLine 101: b'        user_msg = f\"Generate policy rules for these failure patterns:\\\\n{pattern_summary}\"\\n'\nLine 102: b'\\n'\nLine 103: b'        try:\\n'\nLine 104: b'            async with httpx.AsyncClient(timeout=30.0) as client:\\n'\nLine 105: b'                resp = await client.post(_LLM_URL, json={\\n'\nLine 106: b'                    \"model\": _LLM_MODEL,\\n'\nLine 107: b'                    \"messages\": [\\n'\nLine 108: b'                        {\"role\": \"system\", \"content\": _CANDIDATE_SYSTEM_PROMPT},\\n'\nLine 109: b'                        {\"role\": \"user\", \"content\": user_msg},\\n'\nLine 110: b'                    ],\\n'\nLine 111: b'                    \"temperature\": 0.3,\\n'\nLine 112: b'                    \"max_tokens\": 1500,\\n'\nLine 113: b'                })\\n'\nLine 114: b'                resp.raise_for_status()\\n'\nLine 115: b'                body = resp.json()\\n'\nLine 116: b'                content = body[\"choices\"][0][\"message\"][\"content\"]\\n'\nLine 117: b'                return content.strip()\\n'\nLine 118: b'        except Exception as exc:\\n'\nLine 119: b'            logger.error(\"LLM call failed: %s\", exc)\\n'\nLine 120: b'            return None\\n'\nLine 121: b'\\n'\nLine 122: b'    def _parse_candidates(self, yaml_text: str, patterns: list[dict]) -> list[dict]:\\n'\nLine 123: b'        if yaml_text.startswith(\"```\"):\\n'\nLine 124: b'            yaml_text = yaml_text.strip().removeprefix(\"```yaml\").removeprefix(\"```\")\\n'\nLine 125: b'            if \"```\" in yaml_text:\\n'\nLine 126: b'                yaml_text = yaml_text[:yaml_text.index(\"```\")].strip()\\n'\nLine 127: b'\\n'\nLine 128: b'        try:\\n'\nLine 129: b'            raw = yaml.safe_load(yaml_text)\\n'\nLine 130: b'        except Exception as exc:\\n'\nLine 131: b'            logger.warning(\"Failed to parse LLM YAML output: %s\", exc)\\n'\nLine 132: b'            logger.debug(\"Raw output: %s\", yaml_text)\\n'\nLine 133: b'            return []\\n'\nLine 134: b'\\n'\nLine 135: b'        if not raw:\\n'\nLine 136: b'            return []\\n'\nLine 137: b'\\n'\nLine 138: b'        rules = raw if isinstance(raw, list) else raw.get(\"rules\", [])\\n'\nLine 139: b'        if not isinstance(rules, list):\\n'\nLine 140: b'            rules = [rules]\\n'\nLine 141: b'\\n'\nLine 142: b'        candidates = []\\n'\nLine 143: b'        for rule in rules:\\n'\nLine 144: b'            if not isinstance(rule, dict):\\n'\nLine 145: b'                continue\\n'\nLine 146: b'            verdict = rule.get(\"action\", {}).get(\"verdict\", \"\")\\n'\nLine 147: b'            if verdict == \"DENY\":\\n'\nLine 148: b'                continue\\n'\nLine 149: b'\\n'\nLine 150: b'            pattern_id = self._match_pattern_id(rule, patterns)\\n'\nLine 151: b'            cand_id = str(uuid4())\\n'\nLine 152: b'            rule_yaml = yaml.dump([rule], default_flow_style=False)\\n'\nLine 153: b'\\n'\nLine 154: b'            candidates.append({\\n'\nLine 155: b'                \"candidate_id\": cand_id,\\n'\nLine 156: b'                \"pattern_id\": pattern_id,\\n'\nLine 157: b'                \"rule_yaml\": rule_yaml,\\n'\nLine 158: b'                \"triggering_pattern\": next(\\n'\nLine 159: b'                    (p for p in patterns if p[\"pattern_id\"] == pattern_id), patterns[0]\\n'\nLine 160: b'                ),\\n'\nLine 161: b'            })\\n'\nLine 162: b'        return candidates\\n'\nLine 163: b'\\n'\nLine 164: b'    def _match_pattern_id(self, rule: dict, patterns: list[dict]) -> str:\\n'\nLine 165: b'        cond = rule.get(\"conditions\", {})\\n'\nLine 166: b'        ic = cond.get(\"intent_class\", \"\")\\n'\nLine 167: b'        at = cond.get(\"action_type\", \"\")\\n'\nLine 168: b'        ec = cond.get(\"entity_class\", \"\")\\n'\nLine 169: b'        ar = cond.get(\"actor_role\", \"\")\\n'\nLine 170: b'        for p in patterns:\\n'\nLine 171: b'            if (p[\"intent_class\"] == ic and p[\"action_type\"] == at\\n'\nLine 172: b'                    and p[\"entity_class\"] == ec and p[\"actor_role\"] == ar):\\n'\nLine 173: b'                return p[\"pattern_id\"]\\n'\nLine 174: b'        return patterns[0][\"pattern_id\"] if patterns else \"\"\\n'\nLine 175: b'\\n'\nLine 176: b'    async def _candidate_exists(self, pattern_id: str) -> bool:\\n'\nLine 177: b'        async with aiosqlite.connect(self._db) as db:\\n'\nLine 178: b'            async with db.execute(\\n'\nLine 179: b'                \"SELECT 1 FROM policy_candidates WHERE pattern_id = ? AND status = \\'PENDING\\'\",\\n'\nLine 180: b'                (pattern_id,),\\n'\nLine 181: b'            ) as cursor:\\n'\nLine 182: b'                return await cursor.fetchone() is not None'\n","truncated":false},"title":"Check lines 23+ for corruption","tool_input":"{\"command\":\"cd /Users/xnch/xnchSystems && python3 -c \\\"\\nwith open('xnch/xnch/learning/policy_candidates.py', 'rb') as f:\\n    lines = f.readlines()\\nfor i, 