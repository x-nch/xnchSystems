           for arg in args:\\n39:                 if hasattr(arg, 'headers'):\\n40:                     request = arg\\n41:                     break\\n42:             if request is None:\\n43:                 for _, v in kwargs.items():\\n44:                     if hasattr(v, 'headers'):\\n45:                         request = v\\n46:                         break\\n47:             if request is None:\\n48:                 raise HTTPException(status_code=500, detail=\\\"Request object not found\\\")\\n49: \\n50:             actor_role = request.headers.get(\\\"X-Actor-Role\\\", \\\"\\\")\\n51:             level = get_trust_level(actor_role)\\n52:             if level.value < minimum.value:\\n53:                 raise HTTPException(\\n54:                     status_code=403,\\n55:                     detail=f\\\"Actor '{actor_role}' (trust level {level.name}) \\\"\\n56:                            f\\\"does not meet minimum trust level {minimum.name}\\\",\\n57:                 )\\n58:             return await func(*args, **kwargs)\\n59:         return wrapper\\n60:     return decorator\\n\\n(End of file - total 60 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:20:49.649Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/security/trust_model.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/security/trust_model.py</path>\\n<type>file</type>\\n<content>\\n1: from __future__ import annotations\\n2: \\n3: import enum\\n4: from functools import wraps\\n5: from typing import Any\\n6: \\n7: from fastapi import HTTPException, Request\\n8: \\n9: \\n10: class TrustLevel(enum.IntEnum):\\n11:     UNTRUSTED = 1\\n12:     EXTERNAL_AGENT = 2\\n13:     TRUSTED_AGENT = 3\\n14:     OWNER = 4\\n15:     SYSTEM = 5\\n16: \\n17: \\n18: ACTOR_TRUST_MAP: dict[str, TrustLevel] = {\\n19:     \\\"nexi\\\": TrustLevel.SYSTEM,\\n20:     \\\"openclaw\\\": TrustLevel.OWNER,\\n21:  