      if file_saved:\\\\n54:             self.touch()\\\\n55:             actions.append({\\\\n56:                 \\\\\\\"rule\\\\\\\": \\\\\\\"vault_file_saved\\\\\\\",\\\\n57:                 \\\\\\\"action\\\\\\\": \\\\\\\"trigger_file_watcher\\\\\\\",\\\\n58:                 \\\\\\\"payload\\\\\\\": {},\\\\n59:             })\\\\n60: \\\\n61:         # Rule 4: User idle > timeout\\\\n62:         idle_duration = now - self._last_activity\\\\n63:         if idle_duration > self._idle_timeout:\\\\n64:             try:\\\\n65:                 asyncio.get_running_loop()\\\\n66:             except RuntimeError:\\\\n67:                 pass\\\\n68:             else:\\\\n69:                 from ..jobs.consolidation import run_consolidation\\\\n70:                 asyncio.create_task(run_consolidation())\\\\n71:             actions.append({\\\\n72:                 \\\\\\\"rule\\\\\\\": \\\\\\\"user_idle\\\\\\\",\\\\n73:                 \\\\\\\"action\\\\\\\": \\\\\\\"suppress_responses_and_consolidate\\\\\\\",\\\\n74:                 \\\\\\\"payload\\\\\\\": {\\\\\\\"idle_duration_s\\\\\\\": idle_duration},\\\\n75:             })\\\\n76: \\\\n77:         return actions\\\\n\\\\n(End of file - total 77 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv769op_ba7c69bab618\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv769op_ba7c69bab618\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_09_wchGI7OZ10DbCHRDwZL03045\\\",\\\"duration_ms\\\":5,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"import hashlib\\\\nimport json\\\\nimport time\\\\nfrom typing import Any\\\\n\\\\nimport httpx\\\\n\\\\nfrom ..config import settings\\\\n\\\\n\\\\nclass LangfuseClient:\\\\n    def __init__(\\\\n        self,\\\\n        public_key: str | None = None,\\\\n        secret_key: str | None = None,\\\\n        host: str | None = None,\\\\n    ) -> None:\\\\n        self._public_key = public_key or settings.langfuse_public_key\\\\n        self._secret_key = secret_key or settings.langfuse_secret_key\\\\n        self._host = (host or settings.langfuse_host).rstrip(\\\\\\\"/\\\\\\\")\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/observability/langfuse_client.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/observability/langfuse_client.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/observability/langfuse_client.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: import hashlib\\\\n2: import json\\\\n3: import time\\\\n4: from typing import Any\\\\n5: \\\\n6: import httpx\\\\n7: \\\\n8: from ..config import settings\\\\n9: \\\\n10: \\\\n11: class LangfuseClient:\\\\n12:     def __init__(\\\\n13:         self,\\\\n14:         public_key: str | None = None,\\\\n15:         secret_key: str | None = None,\\\\n16:         host: str | None = None,\\\\n17:     ) -> None:\\\\n18:         self._public_key = public_key or settings.langfuse_public_key\\\\n19:         self._secret_key = secret_key or settings.langfuse_secret_key\\\\n20:         self._host = (host or settings.langfuse_host).rstrip(\\\\\\\"/\\\\\\\")\\\\n21:         self._client = httpx.Client(base_url=self._host, timeout=5.0)\\\\n22: \\\\n23:     def close(self) -> None:\\\\n24:         self._client.close()\\\\n25: \\\\n26:     def _basic_auth(self) -> str:\\\\n27:         import base64\\\\n28:         raw = f\\\\\\\"{self._public_key}:{self._secret_key}\\\\\\\"\\\\n29:         return base64.b64encode(raw.encode()).decode()\\\\n30: \\\\n31:     def _headers(self) -> dict[str, str]:\\\\n32:         return {\\\\n33:             \\\\\\\"Authorization\\\\\\\": f\\\\\\\"Basic {self._basic_auth()}\\\\\\\",\\\\n34:             \\\\\\\"Content-Type\\\\\\\": \\\\\\\"application/json\\\\\\\",\\\\n35:         }\\\\n36: \\\\n37:     def trace_llm_call(\\\\n38:         self,\\\\n39:         prompt: str,\\\\n40:         response: str,\\\\n41:         model: str,\\\\n42:         latency_ms: int,\\\\n43:         tokens_used: int,\\\\n44:         trace_id: str = \\\\\\\"\\\\\\\",\\\\n45:     ) -> dict[str, Any] | None:\\\\n46:         if not self._public_key or not self._secret_key:\\\\n47:             return None\\\\n48:         generation_id = hashlib.sha256(f\\\\\\\"{trace_id}{time.time_ns()}\\\\\\\".encode()).hexdigest()[:16]\\\\n49:         body = {\\\\n50:             \\\\\\\"id\\\\\\\": generation_id,\\\\n51:             \\\\\\\"traceId\\\\\\\": trace_id or generation_id,\\\\n52:             \\\\\\\"name\\\\\\\": \\\\\\\"llm-call\\\\\\\",\\\\n53:             \\\\\\\"model\\\\\\\": model,\\\\n54:             \\\\\\\"modelParameters\\\\\\\": {\\\\n55:                 \\\\\\\"maxTokens\\\\\\\": tokens_used,\\\\n56:             },\\\\n57:             \\\\\\\"usage\\\\\\\": {\\\\n58:                 \\\\\\\"input\\\\\\\": len(prompt.split()),\\\\n59:                 \\\\\\\"output\\\\\\\": len(response.split()),\\\\n60:                 \\\\\\\"total\\\\\\\": len(prompt.split()) + len(response.split()),\\\\n61:             },\\\\n62:             \\\\\\\"prompt\\\\\\\": prompt,\\\\n63:             \\\\\\\"completion\\\\\\\": response,\\\\n64:             \\\\\\\"latency\\\\\\\": latency_ms,\\\\n65:         }\\\\n66:         try:\\\\n67:             resp = self._client.post(\\\\n68:                 \\\\\\\"/api/public/ingestion\\\\\\\",\\\\n69:                 headers=self._headers(),\\\\n70:                 json={\\\\\\\"batch\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"generation-create\\\\\\\", \\\\\\\"body\\\\\\\": body}]},\\\\n71:             )\\\\n72:             resp.raise_for_status()\\\\n73:             return body\\\\n74:         except Exception:\\\\n75:             return None\\\\n76: \\\\n77: \\\\n78: _client: LangfuseClient | None = None\\\\n79: \\\\n80: \\\\n81: def get_client() -> LangfuseClient:\\\\n82:     global _client\\\\n83:     if _client is None:\\\\n84:         _client = LangfuseClient()\\\\n85:     return _client\\\\n86: \\\\n87: \\\\n88: def trace_llm_call(\\\\n89:     prompt: str,\\\\n90:     response: str,\\\\n91:     model: str,\\\\n92:     latency_ms: int,\\\\n93:     tokens_used: int,\\\\n94:     trace_id: str = \\\\\\\"\\\\\\\",\\\\n95: ) -> dict[str, Any] | None:\\\\n96:     return get_client().trace_llm_call(\\\\n97:         prompt=prompt,\\\\n98:         response=response,\\\\n99:         model=model,\\\\n100:         latency_ms=latency_ms,\\\\n101:         tokens_used=tokens_used,\\\\n102:         trace_id=trace_id,\\\\n103:     )\\\\n\\\\n(End of file - total 103 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:52.103Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/observability/langfuse_client.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/observability/langfuse_client.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: import hashlib\\\\n2: import json\\\\n3: import time\\\\n4: from typing import Any\\\\n5: \\\\n6: import httpx\\\\n7: \\\\n8: from ..config import settings\\\\n9: \\\\n10: \\\\n11: class LangfuseClient:\\\\n12:     def __init__(\\\\n13:         self,\\\\n14:         public_key: str | None = None,\\\\n15:         secret_key: str | None = None,\\\\n16:         host: str | None = None,\\\\n17:     ) -> None:\\\\n18:         self._public_key = public_key or settings.langfuse_public_key\\\\n19:         self._secret_key = secret_key or settings.langfuse_secret_key\\\\n20:         self._host = (host or settings.langfuse_host).rstrip(\\\\\\\"/\\\\\\\")\\\\n21:         self._client = httpx.Client(base_url=self._host, timeout=5.0)\\\\n22: \\\\n23:     def close(self) -> None:\\\\n24:         self._client.close()\\\\n25: \\\\n26:     def _basic_auth(self) -> str:\\\\n27:         import base64\\\\n28:         raw = f\\\\\\\"{self._public_key}:{self._secret_key}\\\\\\\"\\\\n29:         return base64.b64encode(raw.encode()).decode()\\\\n30: \\\\n31:     def _headers(self) -> dict[str, str]:\\\\n32:         return {\\\\n33:             \\\\\\\"Authorization\\\\\\\": f\\\\\\\"Basic {self._basic_auth()}\\\\\\\",\\\\n34:             \\\\\\\"Content-Type\\\\\\\": \\\\\\\"application/json\\\\\\\",\\\\n35:         }\\\\n36: \\\\n37:     def trace_llm_call(\\\\n38:         self,\\\\n39:         prompt: str,\\\\n40:         response: str,\\\\n41:         model: str,\\\\n42:         latency_ms: int,\\\\n43:         tokens_used: int,\\\\n44:         trace_id: str = \\\\\\\"\\\\\\\",\\\\n45:     ) -> dict[str, Any] | None:\\\\n46:         if not self._public_key or not self._secret_key:\\\\n47:             return None\\\\n48:         generation_id = hashlib.sha256(f\\\\\\\"{trace_id}{time.time_ns()}\\\\\\\".encode()).hexdigest()[:16]\\\\n49:         body = {\\\\n50:             \\\\\\\"id\\\\\\\": generation_id,\\\\n51:             \\\\\\\"traceId\\\\\\\": trace_id or generation_id,\\\\n52:             \\\\\\\"name\\\\\\\": \\\\\\\"llm-call\\\\\\\",\\\\n53:             \\\\\\\"model\\\\\\\": model,\\\\n54:             \\\\\\\"modelParameters\\\\\\\": {\\\\n55:                 \\\\\\\"maxTokens\\\\\\\": tokens_used,\\\\n56:             },\\\\n57:             \\\\\\\"usage\\\\\\\": {\\\\n58:                 \\\\\\\"input\\\\\\\": len(prompt.split()),\\\\n59:                 \\\\\\\"output\\\\\\\": len(response.split()),\\\\n60:                 \\\\\\\"total\\\\\\\": len(prompt.split()) + len(response.split()),\\\\n61:             },\\\\n62:             \\\\\\\"prompt\\\\\\\": prompt,\\\\n63:             \\\\\\\"completion\\\\\\\": response,\\\\n64:             \\\\\\\"latency\\\\\\\": latency_ms,\\\\n65:         }\\\\n66:         try:\\\\n67:             resp = self._client.post(\\\\n68:                 \\\\\\\"/api/public/ingestion\\\\\\\",\\\\n69:                 headers=self._headers(),\\\\n70:                 json={\\\\\\\"batch\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"generation-create\\\\\\\", \\\\\\\"body\\\\\\\": body}]},\\\\n71:             )\\\\n72:             resp.raise_for_status()\\\\n73:             return body\\\\n74:         except Exception:\\\\n75:             return None\\\\n76: \\\\n77: \\\\n78: _client: LangfuseClient | None = None\\\\n79: \\\\n80: \\\\n81: def get_client() -> LangfuseClient:\\\\n82:     global _client\\\\n83:     if _client is None:\\\\n84:         _client = LangfuseClient()\\\\n85:     return _client\\\\n86: \\\\n87: \\\\n88: def trace_llm_call(\\\\n89:     prompt: str,\\\\n90:     response: str,\\\\n91:     model: str,\\\\n92:     latency_ms: int,\\\\n93:     tokens_used: int,\\\\n94:     trace_id: str = \\\\\\\"\\\\\\\",\\\\n95: ) -> dict[str, Any] | None:\\\\n96:     return get_client().trace_llm_call(\\\\n97:         prompt=prompt,\\\\n98:         response=response,\\\\n99:         model=model,\\\\n100:         latency_ms=latency_ms,\\\\n101:         tokens_used=tokens_used,\\\\n102:         trace_id=trace_id,\\\\n103:     )\\\\n\\\\n(End of file - total 103 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76d5v_85acfd06e42f\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76d5v_85acfd06e42f\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_00_Yo5DfztQMxxxmRYJ3YEl2237\\\",\\\"duration_ms\\\":5,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Pattern Extractor — 6h APScheduler job.\\\\n\\\\nQueries PgEpisodicStore decision_episodes since last_run.\\\\nFalls back to EpisodicStore (SQLite) when PgEpisodicStore not available.\\\\nGroups by (intent_class, action_type, entity_class, actor_role).\\\\nUpserts into PatternStore with Bayesian-smoothed confidence.\\\\nLast-run timestamp tracked in SQLite extraction_tracker table.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport hashlib\\\\nimport logging\\\\nimport time\\\\nfrom datetime import datetime, timezone\\\\nfrom pathlib import Path\\\\nfrom typing import TYPE_CHECKING\\\\nfrom uuid import uuid4\\\\n\\\\nimport aiosqlite\\\\n\\\\nfrom ..memory.pattern_store import PatternStore\\\\nfrom ..config import settings\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/learning/pattern_extractor.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/pattern_extractor.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/pattern_extractor.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Pattern Extractor — 6h APScheduler job.\\\\n2: \\\\n3: Queries PgEpisodicStore decision_episodes since last_run.\\\\n4: Falls back to EpisodicStore (SQLite) when PgEpisodicStore not available.\\\\n5: Groups by (intent_class, action_type, entity_class, actor_role).\\\\n6: Upserts into PatternStore with Bayesian-smoothed confidence.\\\\n7: Last-run timestamp tracked in SQLite extraction_tracker table.\\\\n8: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n9: import hashlib\\\\n10: import logging\\\\n11: import time\\\\n12: from datetime import datetime, timezone\\\\n13: from pathlib import Path\\\\n14: from typing import TYPE_CHECKING\\\\n15: from uuid import uuid4\\\\n16: \\\\n17: import aiosqlite\\\\n18: \\\\n19: from ..memory.pattern_store import PatternStore\\\\n20: from ..config import settings\\\\n21: \\\\n22: if TYPE_CHECKING:\\\\n23:     from ..memory.pg_episodic_store import PgEpisodicStore\\\\n24: \\\\n25: logger = logging.getLogger(__name__)\\\\n26: \\\\n27: \\\\n28: def _context_signature(intent_class: str, action_type: str, entity_class: str, actor_role: str) -> str:\\\\n29:     canonical = \\\\\\\"|\\\\\\\".join([\\\\n30:         intent_class.lower(), action_type.lower(), entity_class.lower(), actor_role.lower()\\\\n31:     ])\\\\n32:     return \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(canonical.encode()).hexdigest()\\\\n33: \\\\n34: \\\\n35: class PatternExtractor:\\\\n36:     def __init__(\\\\n37:         self,\\\\n38:         store,\\\\n39:         patterns: PatternStore,\\\\n40:         db_path: Path | None = None,\\\\n41:     ) -> None:\\\\n42:         self._store = store\\\\n43:         self._patterns = patterns\\\\n44:         self._db = db_path or settings.db_path\\\\n45:         self._is_pg = type(store).__name__ == \\\\\\\"PgEpisodicStore\\\\\\\"\\\\n46: \\\\n47:     async def run(self) -> int:\\\\n48:         last_run = await self._get_last_run()\\\\n49: \\\\n50:         if self._is_pg:\\\\n51:             return await self._run_pg(last_run)\\\\n52:         return await self._run_sqlite(last_run)\\\\n53: \\\\n54:     async def _run_pg(self, last_run: float | None) -> int:\\\\n55:         since = last_run if last_run else time.time() - 86400 * 30\\\\n56:         since_dt = datetime.fromtimestamp(since, tz=timezone.utc)\\\\n57:         episodes = await self._store.fetch_decision_episodes_since(since_dt)\\\\n58: \\\\n59:         if not episodes:\\\\n60:             await self._set_last_run(time.time())\\\\n61:             return 0\\\\n62: \\\\n63:         groups: dict[tuple[str, str, str, str], list[dict]] = {}\\\\n64:         for ep in episodes:\\\\n65:             key = (ep[\\\\\\\"intent_class\\\\\\\"], ep[\\\\\\\"action_type\\\\\\\"], ep[\\\\\\\"entity_class\\\\\\\"], ep[\\\\\\\"actor_role\\\\\\\"])\\\\n66:             groups.setdefault(key, []).append(ep)\\\\n67: \\\\n68:         written = 0\\\\n69:         run_id = str(uuid4())\\\\n70: \\\\n71:         for (intent_class, action_type, entity_class, actor_role), batch in groups.items():\\\\n72:             n, sr, conf, ad = self._compute_pattern(batch)\\\\n73:             if n < settings.pattern_min_observations:\\\\n74:                 continue\\\\n75:             await self._upsert(intent_class, action_type, entity_class, actor_role, sr, conf, n, ad, run_id)\\\\n76:             written += 1\\\\n77: \\\\n78:         await self._set_last_run(time.time())\\\\n79:         return written\\\\n80: \\\\n81:     async def _run_sqlite(self, last_run: float | None) -> int:\\\\n82:         from ..memory.episodic_store import EpisodicStore\\\\n83:         store: EpisodicStore = self._store\\\\n84:         tuples = await store.get_distinct_tuples()\\\\n85:         run_id = str(uuid4())\\\\n86:         written = 0\\\\n87: \\\\n88:         for intent_class, action_type, entity_class, actor_role in tuples:\\\\n89:             episodes = await store.fetch_for_extraction(\\\\n90:                 intent_class, action_type, entity_class, actor_role\\\\n91:             )\\\\n92:             n, sr, conf, ad = self._compute_pattern(episodes)\\\\n93:             if n < settings.pattern_min_observations:\\\\n94:                 continue\\\\n95:             await self._upsert(intent_class, action_type, entity_class, actor_role, sr, conf, n, ad, run_id)\\\\n96:             written += 1\\\\n97: \\\\n98:         await self._set_last_run(time.time())\\\\n99:         return written\\\\n100: \\\\n101:     def _compute_pattern(\\\\n102:         self,\\\\n103:         episodes: list[dict],\\\\n104:     ) -> tuple[int, float, float, float | None]:\\\\n105:         n = len(episodes)\\\\n106:         successes = sum(1 for ep in episodes if ep.get(\\\\\\\"outcome\\\\\\\") == \\\\\\\"SUCCESS\\\\\\\")\\\\n107:         success_rate = successes / n if n else 0.0\\\\n108:         confidence = (successes + 1) / (n + 2)\\\\n109:         deltas = [ep[\\\\\\\"prediction_delta\\\\\\\"] for ep in episodes if ep.get(\\\\\\\"prediction_delta\\\\\\\") is not None]\\\\n110:         avg_delta = sum(deltas) / len(deltas) if deltas else None\\\\n111:         return n, success_rate, confidence, avg_delta\\\\n112: \\\\n113:     async def _upsert(\\\\n114:         self,\\\\n115:         intent_class: str,\\\\n116:         action_type: str,\\\\n117:         entity_class: str,\\\\n118:         actor_role: str,\\\\n119:         success_rate: float,\\\\n120:         confidence: float,\\\\n121:         observation_count: int,\\\\n122:         avg_prediction_delta: float | None,\\\\n123:         run_id: str,\\\\n124:     ) -> None:\\\\n125:         sig = _context_signature(intent_class, action_type, entity_class, actor_role)\\\\n126:         await self._patterns.upsert_pattern(\\\\n127:             context_signature=sig,\\\\n128:             intent_class=intent_class,\\\\n129:             action_type=action_type,\\\\n130:             entity_class=entity_class,\\\\n131:             actor_role=actor_role,\\\\n132:             success_rate=round(success_rate, 4),\\\\n133:             confidence=round(confidence, 4),\\\\n134:             observation_count=observation_count,\\\\n135:             avg_prediction_delta=round(avg_prediction_delta, 4) if avg_prediction_delta is not None else None,\\\\n136:             extraction_run_id=run_id,\\\\n137:         )\\\\n138:         logger.info(\\\\n139:             \\\\\\\"Pattern written: %s|%s|%s|%s  success_rate=%.2f  confidence=%.2f  n=%d\\\\\\\",\\\\n140:             intent_class, action_type, entity_class, actor_role,\\\\n141:             success_rate, confidence, observation_count,\\\\n142:         )\\\\n143: \\\\n144:     async def _get_last_run(self) -> float | None:\\\\n145:         async with aiosqlite.connect(self._db) as db:\\\\n146:             await db.execute(\\\\n147:                 \\\\\\\"CREATE TABLE IF NOT EXISTS extraction_tracker (key TEXT PRIMARY KEY, value TEXT)\\\\\\\"\\\\n148:             )\\\\n149:             async with db.execute(\\\\n150:                 \\\\\\\"SELECT value FROM extraction_tracker WHERE key = 'last_run'\\\\\\\"\\\\n151:             ) as cursor:\\\\n152:                 row = await cursor.fetchone()\\\\n153:         return float(row[0]) if row else None\\\\n154: \\\\n155:     async def _set_last_run(self, ts: float) -> None:\\\\n156:         async with aiosqlite.connect(self._db) as db:\\\\n157:             await db.execute(\\\\n158:                 \\\\\\\"INSERT OR REPLACE INTO extraction_tracker (key, value) VALUES ('last_run', ?)\\\\\\\",\\\\n159:                 (str(ts),),\\\\n160:             )\\\\n161:             await db.commit()\\\\n\\\\n(End of file - total 161 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:56.610Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/pattern_extractor.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/pattern_extractor.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Pattern Extractor — 6h APScheduler job.\\\\n2: \\\\n3: Queries PgEpisodicStore decision_episodes since last_run.\\\\n4: Falls back to EpisodicStore (SQLite) when PgEpisodicStore not available.\\\\n5: Groups by (intent_class, action_type, entity_class, actor_role).\\\\n6: Upserts into PatternStore with Bayesian-smoothed confidence.\\\\n7: Last-run timestamp tracked in SQLite extraction_tracker table.\\\\n8: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n9: import hashlib\\\\n10: import logging\\\\n11: import time\\\\n12: from datetime import datetime, timezone\\\\n13: from pathlib import Path\\\\n14: from typing import TYPE_CHECKING\\\\n15: from uuid import uuid4\\\\n16: \\\\n17: import aiosqlite\\\\n18: \\\\n19: from ..memory.pattern_store import PatternStore\\\\n20: from ..config import settings\\\\n21: \\\\n22: if TYPE_CHECKING:\\\\n23:     from ..memory.pg_episodic_store import PgEpisodicStore\\\\n24: \\\\n25: logger = logging.getLogger(__name__)\\\\n26: \\\\n27: \\\\n28: def _context_signature(intent_class: str, action_type: str, entity_class: str, actor_role: str) -> str:\\\\n29:     canonical = \\\\\\\"|\\\\\\\".join([\\\\n30:         intent_class.lower(), action_type.lower(), entity_class.lower(), actor_role.lower()\\\\n31:     ])\\\\n32:     return \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(canonical.encode()).hexdigest()\\\\n33: \\\\n34: \\\\n35: class PatternExtractor:\\\\n36:     def __init__(\\\\n37:         self,\\\\n38:         store,\\\\n39:         patterns: PatternStore,\\\\n40:         db_path: Path | None = None,\\\\n41:     ) -> None:\\\\n42:         self._store = store\\\\n43:         self._patterns = patterns\\\\n44:         self._db = db_path or settings.db_path\\\\n45:         self._is_pg = type(store).__name__ == \\\\\\\"PgEpisodicStore\\\\\\\"\\\\n46: \\\\n47:     async def run(self) -> int:\\\\n48:         last_run = await self._get_last_run()\\\\n49: \\\\n50:         if self._is_pg:\\\\n51:             return await self._run_pg(last_run)\\\\n52:         return await self._run_sqlite(last_run)\\\\n53: \\\\n54:     async def _run_pg(self, last_run: float | None) -> int:\\\\n55:         since = last_run if last_run else time.time() - 86400 * 30\\\\n56:         since_dt = datetime.fromtimestamp(since, tz=timezone.utc)\\\\n57:         episodes = await self._store.fetch_decision_episodes_since(since_dt)\\\\n58: \\\\n59:         if not episodes:\\\\n60:             await self._set_last_run(time.time())\\\\n61:             return 0\\\\n62: \\\\n63:         groups: dict[tuple[str, str, str, str], list[dict]] = {}\\\\n64:         for ep in episodes:\\\\n65:             key = (ep[\\\\\\\"intent_class\\\\\\\"], ep[\\\\\\\"action_type\\\\\\\"], ep[\\\\\\\"entity_class\\\\\\\"], ep[\\\\\\\"actor_role\\\\\\\"])\\\\n66:             groups.setdefault(key, []).append(ep)\\\\n67: \\\\n68:         written = 0\\\\n69:         run_id = str(uuid4())\\\\n70: \\\\n71:         for (intent_class, action_type, entity_class, actor_role), batch in groups.items():\\\\n72:             n, sr, conf, ad = self._compute_pattern(batch)\\\\n73:             if n < settings.pattern_min_observations:\\\\n74:                 continue\\\\n75:             await self._upsert(intent_class, action_type, entity_class, actor_role, sr, conf, n, ad, run_id)\\\\n76:             written += 1\\\\n77: \\\\n78:         await self._set_last_run(time.time())\\\\n79:         return written\\\\n80: \\\\n81:     async def _run_sqlite(self, last_run: float | None) -> int:\\\\n82:         from ..memory.episodic_store import EpisodicStore\\\\n83:         store: EpisodicStore = self._store\\\\n84:         tuples = await store.get_distinct_tuples()\\\\n85:         run_id = str(uuid4())\\\\n86:         written = 0\\\\n87: \\\\n88:         for intent_class, action_type, entity_class, actor_role in tuples:\\\\n89:             episodes = await store.fetch_for_extraction(\\\\n90:                 intent_class, action_type, entity_class, actor_role\\\\n91:             )\\\\n92:             n, sr, conf, ad = self._compute_pattern(episodes)\\\\n93:             if n < settings.pattern_min_observations:\\\\n94:                 continue\\\\n95:             await self._upsert(intent_class, action_type, entity_class, actor_role, sr, conf, n, ad, run_id)\\\\n96:             written += 1\\\\n97: \\\\n98:         await self._set_last_run(time.time())\\\\n99:         return written\\\\n100: \\\\n101:     def _compute_pattern(\\\\n102:         self,\\\\n103:         episodes: list[dict],\\\\n104:     ) -> tuple[int, float, float, float | None]:\\\\n105:         n = len(episodes)\\\\n106:         successes = sum(1 for ep in episodes if ep.get(\\\\\\\"outcome\\\\\\\") == \\\\\\\"SUCCESS\\\\\\\")\\\\n107:         success_rate = successes / n if n else 0.0\\\\n108:         confidence = (successes + 1) / (n + 2)\\\\n109:         deltas = [ep[\\\\\\\"prediction_delta\\\\\\\"] for ep in episodes if ep.get(\\\\\\\"prediction_delta\\\\\\\") is not None]\\\\n110:         avg_delta = sum(deltas) / len(deltas) if deltas else None\\\\n111:         return n, success_rate, confidence, avg_delta\\\\n112: \\\\n113:     async def _upsert(\\\\n114:         self,\\\\n115:         intent_class: str,\\\\n116:         action_type: str,\\\\n117:         entity_class: str,\\\\n118:         actor_role: str,\\\\n119:         success_rate: float,\\\\n120:         confidence: float,\\\\n121:         observation_count: int,\\\\n122:         avg_prediction_delta: float | None,\\\\n123:         run_id: str,\\\\n124:     ) -> None:\\\\n125:         sig = _context_signature(intent_class, action_type, entity_class, actor_role)\\\\n126:         await self._patterns.upsert_pattern(\\\\n127:             context_signature=sig,\\\\n128:             intent_class=intent_class,\\\\n129:             action_type=action_type,\\\\n130:             entity_class=entity_class,\\\\n131:             actor_role=actor_role,\\\\n132:             success_rate=round(success_rate, 4),\\\\n133:             confidence=round(confidence, 4),\\\\n134:             observation_count=observation_count,\\\\n135:             avg_prediction_delta=round(avg_prediction_delta, 4) if avg_prediction_delta is not None else None,\\\\n136:             extraction_run_id=run_id,\\\\n137:         )\\\\n138:         logger.info(\\\\n139:             \\\\\\\"Pattern written: %s|%s|%s|%s  success_rate=%.2f  confidence=%.2f  n=%d\\\\\\\",\\\\n140:             intent_class, action_type, entity_class, actor_role,\\\\n141:             success_rate, confidence, observation_count,\\\\n142:         )\\\\n143: \\\\n144:     async def _get_last_run(self) -> float | None:\\\\n145:         async with aiosqlite.connect(self._db) as db:\\\\n146:             await db.execute(\\\\n147:                 \\\\\\\"CREATE TABLE IF NOT EXISTS extraction_tracker (key TEXT PRIMARY KEY, value TEXT)\\\\\\\"\\\\n148:             )\\\\n149:             async with db.execute(\\\\n150:                 \\\\\\\"SELECT value FROM extraction_tracker WHERE key = 'last_run'\\\\\\\"\\\\n151:             ) as cursor:\\\\n152:                 row = await cursor.fetchone()\\\\n153:         return float(row[0]) if row else None\\\\n154: \\\\n155:     async def _set_last_run(self, ts: float) -> None:\\\\n156:         async with aiosqlite.connect(self._db) as db:\\\\n157:             await db.execute(\\\\n158:                 \\\\\\\"INSERT OR REPLACE INTO extraction_tracker (key, value) VALUES ('last_run', ?)\\\\\\\",\\\\n159:                 (str(ts),),\\\\n160:             )\\\\n161:             await db.commit()\\\\n\\\\n(End of file - total 161 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76ddu_b55751000648\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76ddu_b55751000648\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_01_IpxmZ7lW4CNep9rHT9To0416\\\",\\\"duration_ms\\\":9,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Score Adapter — monitors per-dimension prediction accuracy; proposes weight adjustments.\\\\n\\\\nRolling 7-day accuracy vs 30-day baseline.\\\\nIf drift > 0.05: POST /governance/weights/propose.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport logging\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom uuid import uuid4\\\\n\\\\nimport httpx\\\\nimport aiosqlite\\\\n\\\\nfrom ..config import settings\\\\n\\\\nlogger = logging.getLogger(__name__)\\\\n\\\\n_DIMENSIONS = [\\\\\\\"policy_score\\\\\\\", \\\\\\\"outcome_score\\\\\\\", \\\\\\\"risk_score\\\\\\\", \\\\\\\"context_fit_score\\\\\\\"]\\\\n\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/learning/score_adapter.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Score Adapter — monitors per-dimension prediction accuracy; proposes weight adjustments.\\\\n2: \\\\n3: Rolling 7-day accuracy vs 30-day baseline.\\\\n4: If drift > 0.05: POST /governance/weights/propose.\\\\n5: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n6: import json\\\\n7: import logging\\\\n8: import time\\\\n9: from pathlib import Path\\\\n10: from uuid import uuid4\\\\n11: \\\\n12: import httpx\\\\n13: import aiosqlite\\\\n14: \\\\n15: from ..config import settings\\\\n16: \\\\n17: logger = logging.getLogger(__name__)\\\\n18: \\\\n19: _DIMENSIONS = [\\\\\\\"policy_score\\\\\\\", \\\\\\\"outcome_score\\\\\\\", \\\\\\\"risk_score\\\\\\\", \\\\\\\"context_fit_score\\\\\\\"]\\\\n20: \\\\n21: _DEFAULT_WEIGHTS = {\\\\n22:     'policy_score': 0.4,\\\\n23:     'outcome_score': 0.3,\\\\n24:     'risk_score': 0.2,\\\\n25:     'context_fit_score': 0.1,\\\\n26: }\\\\n27: \\\\n28: \\\\n29: class ScoreAdapter:\\\\n30:     def __init__(self, db_path: Path) -> None:\\\\n31:         self._db = db_path\\\\n32: \\\\n33:     async def evaluate(self) -> list[dict]:\\\\n34:         episodes = await self._fetch_episodes_with_scores()\\\\n35:         if not episodes:\\\\n36:             return []\\\\n37: \\\\n38:         now = time.time()\\\\n39:         seven_days = now - 86400 * 7\\\\n40:         thirty_days = now - 86400 * 30\\\\n41: \\\\n42:         short_win = [e for e in episodes if e[\\\\\\\"created_at\\\\\\\"] >= seven_days]\\\\n43:         long_win = [e for e in episodes if e[\\\\\\\"created_at\\\\\\\"] >= thirty_days]\\\\n44: \\\\n45:         proposals = []\\\\n46:         for dim in _DIMENSIONS:\\\\n47:             short_acc = self._dimension_accuracy(short_win, dim)\\\\n48:             long_acc = self._dimension_accuracy(long_win, dim)\\\\n49:             drift = abs(short_acc - long_acc)\\\\n50: \\\\n51:             logger.info(\\\\n52:                 \\\\\\\"Dimension %s: 7d=%.3f  30d=%.3f  drift=%.4f\\\\\\\",\\\\n53:                 dim, short_acc, long_acc, drift,\\\\n54:             )\\\\n55: \\\\n56:             if drift > 0.05 and len(short_win) >= 10:\\\\n57:                 logger.warning(\\\\n58:                     \\\\\\\"Drift %.4f > 0.05 for %s — proposing weight adjustment\\\\\\\",\\\\n59:                     drift, dim,\\\\n60:                 )\\\\n61:                 intent_classes = set(e[\\\\\\\"intent_class\\\\\\\"] for e in short_win)\\\\n62:                 for ic in intent_classes:\\\\n63:                     current = await self._fetch_current_weights(ic)\\\\n64:                     version = await self._propose_via_api(\\\\n65:                         intent_class=ic,\\\\n66:                         current_weights=current.get(\\\\\\\"weights\\\\\\\", current),\\\\n67:                         dimension=dim,\\\\n68:                         accuracy=short_acc,\\\\n69:                     )\\\\n70:                     if version:\\\\n71:                         proposals.append({\\\\n72:                             \\\\\\\"intent_class\\\\\\\": ic,\\\\n73:                             \\\\\\\"dimension\\\\\\\": dim,\\\\n74:                             \\\\\\\"drift\\\\\\\": round(drift, 4),\\\\n75:                             \\\\\\\"short_accuracy\\\\\\\": round(short_acc, 4),\\\\n76:                             \\\\\\\"long_accuracy\\\\\\\": round(long_acc, 4),\\\\n77:                             \\\\\\\"version\\\\\\\": version,\\\\n78:                         })\\\\n79:         return proposals\\\\n80: \\\\n81:     def _dimension_accuracy(self, episodes: list[dict], dimension: str) -> float:\\\\n82:         predicted = [ep[\\\\\\\"scores\\\\\\\"].get(dimension) for ep in episodes\\\\n83:                      if ep.get(\\\\\\\"scores\\\\\\\") and ep[\\\\\\\"scores\\\\\\\"].get(dimension) is not None]\\\\n84:         if len(predicted) < 5:\\\\n85:             return 1.0\\\\n86:         actuals = [1.0 if ep[\\\\\\\"outcome\\\\\\\"] == \\\\\\\"SUCCESS\\\\\\\" else 0.0 for ep in episodes\\\\n87:                    if ep.get(\\\\\\\"scores\\\\\\\") and ep[\\\\\\\"scores\\\\\\\"].get(dimension) is not None]\\\\n88:         return self._correlation(predicted, actuals)\\\\n89: \\\\n90:     def _correlation(self, predicted: list[float], actual: list[float]) -> float:\\\\n91:         n = len(predicted)\\\\n92:         if n < 2:\\\\n93:             return 1.0\\\\n94:         mean_p = sum(predicted) / n\\\\n95:         mean_a = sum(actual) / n\\\\n96:         num = sum((p - mean_p) * (a - mean_a) for p, a in zip(predicted, actual))\\\\n97:         den_p = (sum((p - mean_p) ** 2 for p in predicted)) ** 0.5\\\\n98:         den_a = (sum((a - mean_a) ** 2 for a in actual)) ** 0.5\\\\n99:         if den_p * den_a == 0:\\\\n100:             return 1.0\\\\n101:         return num / (den_p * den_a)\\\\n102: \\\\n103:     async def _fetch_episodes_with_scores(self) -> list[dict]:\\\\n104:         async with aiosqlite.connect(self._db) as db:\\\\n105:             db.row_factory = aiosqlite.Row\\\\n106:             async with db.execute(\\\\n107:                  \\\\\\\"\\\\\\\"\\\\\\\"SELECT episode_id, intent_class, outcome, context_json, created_at\\\\n108:                     FROM decision_episodes\\\\n109:                    WHERE outcome IS NOT NULL\\\\n110:                      AND json_extract(context_json, '$.scores') IS NOT NULL\\\\n111:                    ORDER BY created_at DESC\\\\n112:                    LIMIT 5000\\\\\\\"\\\\\\\"\\\\\\\"\\\\n113:             ) as cursor:\\\\n114:                 rows = await cursor.fetchall()\\\\n115: \\\\n116:         results = []\\\\n117:         for r in rows:\\\\n118:             try:\\\\n119:                 snapshot = json.loads(r[\\\\\\\"context_json\\\\\\\"])\\\\n120:             except (json.JSONDecodeError, TypeError):\\\\n121:                 continue\\\\n122:             scores = snapshot.get(\\\\\\\"scores\\\\\\\") if isinstance(snapshot, dict) else None\\\\n123:             if not scores:\\\\n124:                 continue\\\\n125:             results.append({\\\\n126:                 \\\\\\\"episode_id\\\\\\\": r[\\\\\\\"episode_id\\\\\\\"],\\\\n127:                 \\\\\\\"intent_class\\\\\\\": r[\\\\\\\"intent_class\\\\\\\"],\\\\n128:                 \\\\\\\"outcome\\\\\\\": r[\\\\\\\"outcome\\\\\\\"],\\\\n129:                 \\\\\\\"scores\\\\\\\": scores,\\\\n130:                 \\\\\\\"created_at\\\\\\\": r[\\\\\\\"created_at\\\\\\\"],\\\\n131:             })\\\\n132:         return results\\\\n133: \\\\n134:     async def _fetch_current_weights(self, intent_class: str) -> dict:\\\\n135:         async with aiosqlite.connect(self._db) as db:\\\\n136:             db.row_factory = aiosqlite.Row\\\\n137:             async with db.execute(\\\\n138:                 \\\\\\\"SELECT weights FROM weight_configs WHERE intent_class = ? AND is_active = 1\\\\\\\",\\\\n139:                 (intent_class,),\\\\n140:             ) as cursor:\\\\n141:                 row = await cursor.fetchone()\\\\n142:         if row:\\\\n143:             return json.loads(row[\\\\\\\"weights\\\\\\\"])\\\\n144:         return dict(_DEFAULT_WEIGHTS)\\\\n145: \\\\n146:     async def _propose_via_api(\\\\n147:         self,\\\\n148:         intent_class: str,\\\\n149:         current_weights: dict,\\\\n150:         dimension: str,\\\\n151:         accuracy: float,\\\\n152:     ) -> str:\\\\n153:         rate = 0.6 - accuracy\\\\n154:         adjustment = min(rate * 0.1, 0.05)\\\\n155: \\\\n156:         new_weights = dict(current_weights)\\\\n157:         new_weights[dimension] = round(new_weights.get(dimension, 0.25) - adjustment, 4)\\\\n158: \\\\n159:         total = sum(new_weights.values())\\\\n160:         if abs(total - 1.0) > 0.001:\\\\n161:             other_dims = [d for d in _DIMENSIONS if d != dimension]\\\\n162:             redistribute = (total - 1.0) / len(other_dims)\\\\n163:             for d in other_dims:\\\\n164:                 new_weights[d] = round(new_weights[d] - redistribute, 4)\\\\n165: \\\\n166:         if any(v < 0.05 for v in new_weights.values()):\\\\n167:             logger.warning(\\\\\\\"Weight adjustment would violate minimum 0.05 constraint — skipping\\\\\\\")\\\\n168:             return \\\\\\\"\\\\\\\"\\\\n169: \\\\n170:         payload = {\\\\n171:             \\\\\\\"intent_class\\\\\\\": intent_class,\\\\n172:             \\\\\\\"weights\\\\\\\": new_weights,\\\\n173:             \\\\\\\"episode_batch\\\\\\\": f\\\\\\\"batch-{int(time.time())}\\\\\\\",\\\\n174:             \\\\\\\"proposed_by\\\\\\\": \\\\\\\"score_adapter\\\\\\\",\\\\n175:         }\\\\n176:         try:\\\\n177:             async with httpx.AsyncClient(base_url=\\\\\\\"http://localhost:8001\\\\\\\", timeout=10.0) as client:\\\\n178:                 resp = await client.post(\\\\\\\"/governance/weights/propose\\\\\\\", json=payload)\\\\n179:                 resp.raise_for_status()\\\\n180:                 result = resp.json()\\\\n181:                 logger.info(\\\\\\\"Weight proposal submitted: %s\\\\\\\", result.get(\\\\\\\"version\\\\\\\"))\\\\n182:                 return result.get(\\\\\\\"version\\\\\\\", \\\\\\\"\\\\\\\")\\\\n183:         except Exception as exc:\\\\n184:             logger.error(\\\\\\\"Failed to propose weight adjustment: %s\\\\\\\", exc)\\\\n185:             return \\\\\\\"\\\\\\\"\\\\n\\\\n(End of file - total 185 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:56.896Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Score Adapter — monitors per-dimension prediction accuracy; proposes weight adjustments.\\\\n2: \\\\n3: Rolling 7-day accuracy vs 30-day baseline.\\\\n4: If drift > 0.05: POST /governance/weights/propose.\\\\n5: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n6: import json\\\\n7: import logging\\\\n8: import time\\\\n9: from pathlib import Path\\\\n10: from uuid import uuid4\\\\n11: \\\\n12: import httpx\\\\n13: import aiosqlite\\\\n14: \\\\n15: from ..config import settings\\\\n16: \\\\n17: logger = logging.getLogger(__name__)\\\\n18: \\\\n19: _DIMENSIONS = [\\\\\\\"policy_score\\\\\\\", \\\\\\\"outcome_score\\\\\\\", \\\\\\\"risk_score\\\\\\\", \\\\\\\"context_fit_score\\\\\\\"]\\\\n20: \\\\n21: _DEFAULT_WEIGHTS = {\\\\n22:     'policy_score': 0.4,\\\\n23:     'outcome_score': 0.3,\\\\n24:     'risk_score': 0.2,\\\\n25:     'context_fit_score': 0.1,\\\\n26: }\\\\n27: \\\\n28: \\\\n29: class ScoreAdapter:\\\\n30:     def __init__(self, db_path: Path) -> None:\\\\n31:         self._db = db_path\\\\n32: \\\\n33:     async def evaluate(self) -> list[dict]:\\\\n34:         episodes = await self._fetch_episodes_with_scores()\\\\n35:         if not episodes:\\\\n36:             return []\\\\n37: \\\\n38:         now = time.time()\\\\n39:         seven_days = now - 86400 * 7\\\\n40:         thirty_days = now - 86400 * 30\\\\n41: \\\\n42:         short_win = [e for e in episodes if e[\\\\\\\"created_at\\\\\\\"] >= seven_days]\\\\n43:         long_win = [e for e in episodes if e[\\\\\\\"created_at\\\\\\\"] >= thirty_days]\\\\n44: \\\\n45:         proposals = []\\\\n46:         for dim in _DIMENSIONS:\\\\n47:             short_acc = self._dimension_accuracy(short_win, dim)\\\\n48:             long_acc = self._dimension_accuracy(long_win, dim)\\\\n49:             drift = abs(short_acc - long_acc)\\\\n50: \\\\n51:             logger.info(\\\\n52:                 \\\\\\\"Dimension %s: 7d=%.3f  30d=%.3f  drift=%.4f\\\\\\\",\\\\n53:                 dim, short_acc, long_acc, drift,\\\\n54:             )\\\\n55: \\\\n56:             if drift > 0.05 and len(short_win) >= 10:\\\\n57:                 logger.warning(\\\\n58:                     \\\\\\\"Drift %.4f > 0.05 for %s — proposing weight adjustment\\\\\\\",\\\\n59:                     drift, dim,\\\\n60:                 )\\\\n61:                 intent_classes = set(e[\\\\\\\"intent_class\\\\\\\"] for e in short_win)\\\\n62:                 for ic in intent_classes:\\\\n63:                     current = await self._fetch_current_weights(ic)\\\\n64:                     version = await self._propose_via_api(\\\\n65:                         intent_class=ic,\\\\n66:                         current_weights=current.get(\\\\\\\"weights\\\\\\\", current),\\\\n67:                         dimension=dim,\\\\n68:                         accuracy=short_acc,\\\\n69:                     )\\\\n70:                     if version:\\\\n71:                         proposals.append({\\\\n72:                             \\\\\\\"intent_class\\\\\\\": ic,\\\\n73:                             \\\\\\\"dimension\\\\\\\": dim,\\\\n74:                             \\\\\\\"drift\\\\\\\": round(drift, 4),\\\\n75:                             \\\\\\\"short_accuracy\\\\\\\": round(short_acc, 4),\\\\n76:                             \\\\\\\"long_accuracy\\\\\\\": round(long_acc, 4),\\\\n77:                             \\\\\\\"version\\\\\\\": version,\\\\n78:                         })\\\\n79:         return proposals\\\\n80: \\\\n81:     def _dimension_accuracy(self, episodes: list[dict], dimension: str) -> float:\\\\n82:         predicted = [ep[\\\\\\\"scores\\\\\\\"].get(dimension) for ep in episodes\\\\n83:                      if ep.get(\\\\\\\"scores\\\\\\\") and ep[\\\\\\\"scores\\\\\\\"].get(dimension) is not None]\\\\n84:         if len(predicted) < 5:\\\\n85:             return 1.0\\\\n86:         actuals = [1.0 if ep[\\\\\\\"outcome\\\\\\\"] == \\\\\\\"SUCCESS\\\\\\\" else 0.0 for ep in episodes\\\\n87:                    if ep.get(\\\\\\\"scores\\\\\\\") and ep[\\\\\\\"scores\\\\\\\"].get(dimension) is not None]\\\\n88:         return self._correlation(predicted, actuals)\\\\n89: \\\\n90:     def _correlation(self, predicted: list[float], actual: list[float]) -> float:\\\\n91:         n = len(predicted)\\\\n92:         if n < 2:\\\\n93:             return 1.0\\\\n94:         mean_p = sum(predicted) / n\\\\n95:         mean_a = sum(actual) / n\\\\n96:         num = sum((p - mean_p) * (a - mean_a) for p, a in zip(predicted, actual))\\\\n97:         den_p = (sum((p - mean_p) ** 2 for p in predicted)) ** 0.5\\\\n98:         den_a = (sum((a - mean_a) ** 2 for a in actual)) ** 0.5\\\\n99:         if den_p * den_a == 0:\\\\n100:             return 1.0\\\\n101:         return num / (den_p * den_a)\\\\n102: \\\\n103:     async def _fetch_episodes_with_scores(self) -> list[dict]:\\\\n104:         async with aiosqlite.connect(self._db) as db:\\\\n105:             db.row_factory = aiosqlite.Row\\\\n106:             async with db.execute(\\\\n107:                  \\\\\\\"\\\\\\\"\\\\\\\"SELECT episode_id, intent_class, outcome, context_json, created_at\\\\n108:                     FROM decision_episodes\\\\n109:                    WHERE outcome IS NOT NULL\\\\n110:                      AND json_extract(context_json, '$.scores') IS NOT NULL\\\\n111:                    ORDER BY created_at DESC\\\\n112:                    LIMIT 5000\\\\\\\"\\\\\\\"\\\\\\\"\\\\n113:             ) as cursor:\\\\n114:                 rows = await cursor.fetchall()\\\\n115: \\\\n116:         results = []\\\\n117:         for r in rows:\\\\n118:             try:\\\\n119:                 snapshot = json.loads(r[\\\\\\\"context_json\\\\\\\"])\\\\n120:             except (json.JSONDecodeError, TypeError):\\\\n121:                 continue\\\\n122:             scores = snapshot.get(\\\\\\\"scores\\\\\\\") if isinstance(snapshot, dict) else None\\\\n123:             if not scores:\\\\n124:                 continue\\\\n125:             results.append({\\\\n126:                 \\\\\\\"episode_id\\\\\\\": r[\\\\\\\"episode_id\\\\\\\"],\\\\n127:                 \\\\\\\"intent_class\\\\\\\": r[\\\\\\\"intent_class\\\\\\\"],\\\\n128:                 \\\\\\\"outcome\\\\\\\": r[\\\\\\\"outcome\\\\\\\"],\\\\n129:                 \\\\\\\"scores\\\\\\\": scores,\\\\n130:                 \\\\\\\"created_at\\\\\\\": r[\\\\\\\"created_at\\\\\\\"],\\\\n131:             })\\\\n132:         return results\\\\n133: \\\\n134:     async def _fetch_current_weights(self, intent_class: str) -> dict:\\\\n135:         async with aiosqlite.connect(self._db) as db:\\\\n136:             db.row_factory = aiosqlite.Row\\\\n137:             async with db.execute(\\\\n138:                 \\\\\\\"SELECT weights FROM weight_configs WHERE intent_class = ? AND is_active = 1\\\\\\\",\\\\n139:                 (intent_class,),\\\\n140:             ) as cursor:\\\\n141:                 row = await cursor.fetchone()\\\\n142:         if row:\\\\n143:             return json.loads(row[\\\\\\\"weights\\\\\\\"])\\\\n144:         return dict(_DEFAULT_WEIGHTS)\\\\n145: \\\\n146:     async def _propose_via_api(\\\\n147:         self,\\\\n148:         intent_class: str,\\\\n149:         current_weights: dict,\\\\n150:         dimension: str,\\\\n151:         accuracy: float,\\\\n152:     ) -> str:\\\\n153:         rate = 0.6 - accuracy\\\\n154:         adjustment = min(rate * 0.1, 0.05)\\\\n155: \\\\n156:         new_weights = dict(current_weights)\\\\n157:         new_weights[dimension] = round(new_weights.get(dimension, 0.25) - adjustment, 4)\\\\n158: \\\\n159:         total = sum(new_weights.values())\\\\n160:         if abs(total - 1.0) > 0.001:\\\\n161:             other_dims = [d for d in _DIMENSIONS if d != dimension]\\\\n162:             redistribute = (total - 1.0) / len(other_dims)\\\\n163:             for d in other_dims:\\\\n164:                 new_weights[d] = round(new_weights[d] - redistribute, 4)\\\\n165: \\\\n166:         if any(v < 0.05 for v in new_weights.values()):\\\\n167:             logger.warning(\\\\\\\"Weight adjustment would violate minimum 0.05 constraint — skipping\\\\\\\")\\\\n168:             return \\\\\\\"\\\\\\\"\\\\n169: \\\\n170:         payload = {\\\\n171:             \\\\\\\"intent_class\\\\\\\": intent_class,\\\\n172:             \\\\\\\"weights\\\\\\\": new_weights,\\\\n173:             \\\\\\\"episode_batch\\\\\\\": f\\\\\\\"batch-{int(time.time())}\\\\\\\",\\\\n174:             \\\\\\\"proposed_by\\\\\\\": \\\\\\\"score_adapter\\\\\\\",\\\\n175:         }\\\\n176:         try:\\\\n177:             async with httpx.AsyncClient(base_url=\\\\\\\"http://localhost:8001\\\\\\\", timeout=10.0) as client:\\\\n178:                 resp = await client.post(\\\\\\\"/governance/weights/propose\\\\\\\", json=payload)\\\\n179:                 resp.raise_for_status()\\\\n180:                 result = resp.json()\\\\n181:                 logger.info(\\\\\\\"Weight proposal submitted: %s\\\\\\\", result.get(\\\\\\\"version\\\\\\\"))\\\\n182:                 return result.get(\\\\\\\"version\\\\\\\", \\\\\\\"\\\\\\\")\\\\n183:         except Exception as exc:\\\\n184:             logger.error(\\\\\\\"Failed to propose weight adjustment: %s\\\\\\\", exc)\\\\n185:             return \\\\\\\"\\\\\\\"\\\\n\\\\n(End of file - total 185 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76dm4_5e28b628a0a4\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76dm4_5e28b628a0a4\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_02_UrTlHNacLrvEhS3FyVtx3361\\\",\\\"duration_ms\\\":9,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Policy Candidate Generator — LLM-driven policy rule proposals.\\\\n\\\\nReads low-success, high-confidence patterns from PatternStore.\\\\nCalls LLM (via litellm proxy) to generate policy DSL candidate rules.\\\\nOutputs candidates with ALLOW/BLOCK/MODIFY/DEFER verdicts (never DENY).\\\\nWrites to policy_candidates SQLite table.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport logging\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom uuid import uuid4\\\\n\\\\nimport httpx\\\\nimport aiosqlite\\\\nimport yaml\\\\n\\\\nfrom ..memory.pattern_store import PatternStore\\\\n\\\\nlogger = logging.getLogger(__name__)\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/learning/policy_candidates.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/policy_candidates.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/policy_candidates.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Policy Candidate Generator — LLM-driven policy rule proposals.\\\\n2: \\\\n3: Reads low-success, high-confidence patterns from PatternStore.\\\\n4: Calls LLM (via litellm proxy) to generate policy DSL candidate rules.\\\\n5: Outputs candidates with ALLOW/BLOCK/MODIFY/DEFER verdicts (never DENY).\\\\n6: Writes to policy_candidates SQLite table.\\\\n7: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n8: import json\\\\n9: import logging\\\\n10: import time\\\\n11: from pathlib import Path\\\\n12: from uuid import uuid4\\\\n13: \\\\n14: import httpx\\\\n15: import aiosqlite\\\\n16: import yaml\\\\n17: \\\\n18: from ..memory.pattern_store import PatternStore\\\\n19: \\\\n20: logger = logging.getLogger(__name__)\\\\n21: \\\\n22: _LLM_URL = \\\\\\\"http://localhost:4000/v1/chat/completions\\\\\\\"\\\\n23: _LLM_MODEL = \\\\\\\"claude-judgment\\\\\\\"\\\\n24: _CANDIDATE_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are a policy engineer for the XNCH autonomous governance system.\\\\n25: Given failure patterns, suggest policy rule candidates in XNCH policy DSL.\\\\n26: \\\\n27: Rules have this YAML structure:\\\\n28: ```yaml\\\\n29: - rule_id: <unique-id>\\\\n30:   priority: <integer — 100-500, lower = higher priority>\\\\n31:   conditions:\\\\n32:     intent_class: <EXECUTION | QUERY | DECISION | ESCALATION>\\\\n33:     action_type: <string or omit>\\\\n34:     entity_class: <string or omit>\\\\n35:     actor_role: <string or omit>\\\\n36:   action:\\\\n37:     verdict: <ALLOW | ALLOW_WITH_WARNINGS | BLOCK | MODIFY | DEFER>\\\\n38:     reason: <string>\\\\n39: ```\\\\n40: \\\\n41: Constraints:\\\\n42: - Use ONLY these verdicts: ALLOW, ALLOW_WITH_WARNINGS, BLOCK, MODIFY, DEFER (never DENY)\\\\n43: - ALLOW_WITH_WARNINGS: when action is ok but caution needed\\\\n44: - BLOCK: when pattern suggests action should be prevented\\\\n45: - MODIFY: when action spec needs field changes (include modify_spec)\\\\n46: - DEFER: when action needs human approval (include requires_actor)\\\\n47: - Generate 1-3 candidate rules per batch\\\\n48: - Output raw YAML only, no markdown fences\\\\n49: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n50: \\\\n51: \\\\n52: class PolicyCandidateGenerator:\\\\n53:     def __init__(self, patterns: PatternStore, db_path: Path) -> None:\\\\n54:         self._patterns = patterns\\\\n55:         self._db = db_path\\\\n56: \\\\n57:     async def run(self) -> int:\\\\n58:         low_success = await self._patterns.fetch_low_success(\\\\n59:             max_success_rate=0.4, min_confidence=0.6\\\\n60:         )\\\\n61:         if not low_success:\\\\n62:             logger.info(\\\\\\\"No low-success patterns found\\\\\\\")\\\\n63:             return 0\\\\n64: \\\\n65:         count = 0\\\\n66:         for i in range(0, len(low_success), 5):\\\\n67:             batch = low_success[i:i + 5]\\\\n68:             if all(await self._candidate_exists(p[\\\\\\\"pattern_id\\\\\\\"]) for p in batch):\\\\n69:                 continue\\\\n70: \\\\n71:             yaml_output = await self._llm_generate(batch)\\\\n72:             if not yaml_output:\\\\n73:                 continue\\\\n74: \\\\n75:             candidates = self._parse_candidates(yaml_output, batch)\\\\n76:             for cand in candidates:\\\\n77:                 async with aiosqlite.connect(self._db) as db:\\\\n78:                     await db.execute(\\\\n79:                         \\\\\\\"\\\\\\\"\\\\\\\"INSERT INTO policy_candidates\\\\n80:                            (candidate_id, pattern_id, rule_yaml, triggering_pattern, status, created_at)\\\\n81:                            VALUES (?, ?, ?, ?, 'PENDING', ?)\\\\\\\"\\\\\\\"\\\\\\\",\\\\n82:                         (cand[\\\\\\\"candidate_id\\\\\\\"], cand[\\\\\\\"pattern_id\\\\\\\"], cand[\\\\\\\"rule_yaml\\\\\\\"],\\\\n83:                          json.dumps(cand[\\\\\\\"triggering_pattern\\\\\\\"]), time.time()),\\\\n84:                     )\\\\n85:                     await db.commit()\\\\n86:                 logger.info(\\\\\\\"Policy candidate %s written\\\\\\\", cand[\\\\\\\"candidate_id\\\\\\\"])\\\\n87:                 count += 1\\\\n88:         return count\\\\n89: \\\\n90:     async def _llm_generate(self, patterns: list[dict]) -> str | None:\\\\n91:         pattern_summary = \\\\\\\"\\\\\\\\n\\\\\\\".join(\\\\n92:             f\\\\\\\"- {p['intent_class']}|{p['action_type']}|{p['entity_class']}|{p['actor_role']}  \\\\\\\"\\\\n93:             f\\\\\\\"success_rate={p['success_rate']:.2f}  confidence={p['confidence']:.2f}  \\\\\\\"\\\\n94:             f\\\\\\\"n={p['observation_count']}\\\\\\\"\\\\n95:             for p in patterns\\\\n96:         )\\\\n97:         user_msg = f\\\\\\\"Generate policy rules for these failure patterns:\\\\\\\\n{pattern_summary}\\\\\\\"\\\\n98: \\\\n99:         try:\\\\n100:             async with httpx.AsyncClient(timeout=30.0) as client:\\\\n101:                 resp = await client.post(_LLM_URL, json={\\\\n102:                     \\\\\\\"model\\\\\\\": _LLM_MODEL,\\\\n103:                     \\\\\\\"messages\\\\\\\": [\\\\n104:                         {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": _CANDIDATE_SYSTEM_PROMPT},\\\\n105:                         {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": user_msg},\\\\n106:                     ],\\\\n107:                     \\\\\\\"temperature\\\\\\\": 0.3,\\\\n108:                     \\\\\\\"max_tokens\\\\\\\": 1500,\\\\n109:                 })\\\\n110:                 resp.raise_for_status()\\\\n111:                 body = resp.json()\\\\n112:                 content = body[\\\\\\\"choices\\\\\\\"][0][\\\\\\\"message\\\\\\\"][\\\\\\\"content\\\\\\\"]\\\\n113:                 return content.strip()\\\\n114:         except Exception as exc:\\\\n115:             logger.error(\\\\\\\"LLM call failed: %s\\\\\\\", exc)\\\\n116:             return None\\\\n117: \\\\n118:     def _parse_candidates(self, yaml_text: str, patterns: list[dict]) -> list[dict]:\\\\n119:         if yaml_text.startswith(\\\\\\\"```\\\\\\\"):\\\\n120:             yaml_text = yaml_text.strip().removeprefix(\\\\\\\"```yaml\\\\\\\").removeprefix(\\\\\\\"```\\\\\\\")\\\\n121:             if \\\\\\\"```\\\\\\\" in yaml_text:\\\\n122:                 yaml_text = yaml_text[:yaml_text.index(\\\\\\\"```\\\\\\\")].strip()\\\\n123: \\\\n124:         try:\\\\n125:             raw = yaml.safe_load(yaml_text)\\\\n126:         except Exception as exc:\\\\n127:             logger.warning(\\\\\\\"Failed to parse LLM YAML output: %s\\\\\\\", exc)\\\\n128:             logger.debug(\\\\\\\"Raw output: %s\\\\\\\", yaml_text)\\\\n129:             return []\\\\n130: \\\\n131:         if not raw:\\\\n132:             return []\\\\n133: \\\\n134:         rules = raw if isinstance(raw, list) else raw.get(\\\\\\\"rules\\\\\\\", [])\\\\n135:         if not isinstance(rules, list):\\\\n136:             rules = [rules]\\\\n137: \\\\n138:         candidates = []\\\\n139:         for rule in rules:\\\\n140:             if not isinstance(rule, dict):\\\\n141:                 continue\\\\n142:             verdict = rule.get(\\\\\\\"action\\\\\\\", {}).get(\\\\\\\"verdict\\\\\\\", \\\\\\\"\\\\\\\")\\\\n143:             if verdict == \\\\\\\"DENY\\\\\\\":\\\\n144:                 continue\\\\n145: \\\\n146:             pattern_id = self._match_pattern_id(rule, patterns)\\\\n147:             cand_id = str(uuid4())\\\\n148:             rule_yaml = yaml.dump([rule], default_flow_style=False)\\\\n149: \\\\n150:             candidates.append({\\\\n151:                 \\\\\\\"candidate_id\\\\\\\": cand_id,\\\\n152:                 \\\\\\\"pattern_id\\\\\\\": pattern_id,\\\\n153:                 \\\\\\\"rule_yaml\\\\\\\": rule_yaml,\\\\n154:                 \\\\\\\"triggering_pattern\\\\\\\": next(\\\\n155:                     (p for p in patterns if p[\\\\\\\"pattern_id\\\\\\\"] == pattern_id), patterns[0]\\\\n156:                 ),\\\\n157:             })\\\\n158:         return candidates\\\\n159: \\\\n160:     def _match_pattern_id(self, rule: dict, patterns: list[dict]) -> str:\\\\n161:         cond = rule.get(\\\\\\\"conditions\\\\\\\", {})\\\\n162:         ic = cond.get(\\\\\\\"intent_class\\\\\\\", \\\\\\\"\\\\\\\")\\\\n163:         at = cond.get(\\\\\\\"action_type\\\\\\\", \\\\\\\"\\\\\\\")\\\\n164:         ec = cond.get(\\\\\\\"entity_class\\\\\\\", \\\\\\\"\\\\\\\")\\\\n165:         ar = cond.get(\\\\\\\"actor_role\\\\\\\", \\\\\\\"\\\\\\\")\\\\n166:         for p in patterns:\\\\n167:             if (p[\\\\\\\"intent_class\\\\\\\"] == ic and p[\\\\\\\"action_type\\\\\\\"] == at\\\\n168:                     and p[\\\\\\\"entity_class\\\\\\\"] == ec and p[\\\\\\\"actor_role\\\\\\\"] == ar):\\\\n169:                 return p[\\\\\\\"pattern_id\\\\\\\"]\\\\n170:         return patterns[0][\\\\\\\"pattern_id\\\\\\\"] if patterns else \\\\\\\"\\\\\\\"\\\\n171: \\\\n172:     async def _candidate_exists(self, pattern_id: str) -> bool:\\\\n173:         async with aiosqlite.connect(self._db) as db:\\\\n174:             async with db.execute(\\\\n175:                 \\\\\\\"SELECT 1 FROM policy_candidates WHERE pattern_id = ? AND status = 'PENDING'\\\\\\\",\\\\n176:                 (pattern_id,),\\\\n177:             ) as cursor:\\\\n178:                 return await cursor.fetchone() is not None\\\\n\\\\n(End of file - total 178 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:57.194Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/learning/policy_candidates.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/learning/policy_candidates.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Policy Candidate Generator — LLM-driven policy rule proposals.\\\\n2: \\\\n3: Reads low-success, high-confidence patterns from PatternStore.\\\\n4: Calls LLM (via litellm proxy) to generate policy DSL candidate rules.\\\\n5: Outputs candidates with ALLOW/BLOCK/MODIFY/DEFER verdicts (never DENY).\\\\n6: Writes to policy_candidates SQLite table.\\\\n7: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n8: import json\\\\n9: import logging\\\\n10: import time\\\\n11: from pathlib import Path\\\\n12: from uuid import uuid4\\\\n13: \\\\n14: import httpx\\\\n15: import aiosqlite\\\\n16: import yaml\\\\n17: \\\\n18: from ..memory.pattern_store import PatternStore\\\\n19: \\\\n20: logger = logging.getLogger(__name__)\\\\n21: \\\\n22: _LLM_URL = \\\\\\\"http://localhost:4000/v1/chat/completions\\\\\\\"\\\\n23: _LLM_MODEL = \\\\\\\"claude-judgment\\\\\\\"\\\\n24: _CANDIDATE_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are a policy engineer for the XNCH autonomous governance system.\\\\n25: Given failure patterns, suggest policy rule candidates in XNCH policy DSL.\\\\n26: \\\\n27: Rules have this YAML structure:\\\\n28: ```yaml\\\\n29: - rule_id: <unique-id>\\\\n30:   priority: <integer — 100-500, lower = higher priority>\\\\n31:   conditions:\\\\n32:     intent_class: <EXECUTION | QUERY | DECISION | ESCALATION>\\\\n33:     action_type: <string or omit>\\\\n34:     entity_class: <string or omit>\\\\n35:     actor_role: <string or omit>\\\\n36:   action:\\\\n37:     verdict: <ALLOW | ALLOW_WITH_WARNINGS | BLOCK | MODIFY | DEFER>\\\\n38:     reason: <string>\\\\n39: ```\\\\n40: \\\\n41: Constraints:\\\\n42: - Use ONLY these verdicts: ALLOW, ALLOW_WITH_WARNINGS, BLOCK, MODIFY, DEFER (never DENY)\\\\n43: - ALLOW_WITH_WARNINGS: when action is ok but caution needed\\\\n44: - BLOCK: when pattern suggests action should be prevented\\\\n45: - MODIFY: when action spec needs field changes (include modify_spec)\\\\n46: - DEFER: when action needs human approval (include requires_actor)\\\\n47: - Generate 1-3 candidate rules per batch\\\\n48: - Output raw YAML only, no markdown fences\\\\n49: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n50: \\\\n51: \\\\n52: class PolicyCandidateGenerator:\\\\n53:     def __init__(self, patterns: PatternStore, db_path: Path) -> None:\\\\n54:         self._patterns = patterns\\\\n55:         self._db = db_path\\\\n56: \\\\n57:     async def run(self) -> int:\\\\n58:         low_success = await self._patterns.fetch_low_success(\\\\n59:             max_success_rate=0.4, min_confidence=0.6\\\\n60:         )\\\\n61:         if not low_success:\\\\n62:             logger.info(\\\\\\\"No low-success patterns found\\\\\\\")\\\\n63:             return 0\\\\n64: \\\\n65:         count = 0\\\\n66:         for i in range(0, len(low_success), 5):\\\\n67:             batch = low_success[i:i + 5]\\\\n68:             if all(await self._candidate_exists(p[\\\\\\\"pattern_id\\\\\\\"]) for p in batch):\\\\n69:                 continue\\\\n70: \\\\n71:             yaml_output = await self._llm_generate(batch)\\\\n72:             if not yaml_output:\\\\n73:                 continue\\\\n74: \\\\n75:             candidates = self._parse_candidates(yaml_output, batch)\\\\n76:             for cand in candidates:\\\\n77:                 async with aiosqlite.connect(self._db) as db:\\\\n78:                     await db.execute(\\\\n79:                         \\\\\\\"\\\\\\\"\\\\\\\"INSERT INTO policy_candidates\\\\n80:                            (candidate_id, pattern_id, rule_yaml, triggering_pattern, status, created_at)\\\\n81:                            VALUES (?, ?, ?, ?, 'PENDING', ?)\\\\\\\"\\\\\\\"\\\\\\\",\\\\n82:                         (cand[\\\\\\\"candidate_id\\\\\\\"], cand[\\\\\\\"pattern_id\\\\\\\"], cand[\\\\\\\"rule_yaml\\\\\\\"],\\\\n83:                          json.dumps(cand[\\\\\\\"triggering_pattern\\\\\\\"]), time.time()),\\\\n84:                     )\\\\n85:                     await db.commit()\\\\n86:                 logger.info(\\\\\\\"Policy candidate %s written\\\\\\\", cand[\\\\\\\"candidate_id\\\\\\\"])\\\\n87:                 count += 1\\\\n88:         return count\\\\n89: \\\\n90:     async def _llm_generate(self, patterns: list[dict]) -> str | None:\\\\n91:         pattern_summary = \\\\\\\"\\\\\\\\n\\\\\\\".join(\\\\n92:             f\\\\\\\"- {p['intent_class']}|{p['action_type']}|{p['entity_class']}|{p['actor_role']}  \\\\\\\"\\\\n93:             f\\\\\\\"success_rate={p['success_rate']:.2f}  confidence={p['confidence']:.2f}  \\\\\\\"\\\\n94:             f\\\\\\\"n={p['observation_count']}\\\\\\\"\\\\n95:             for p in patterns\\\\n96:         )\\\\n97:         user_msg = f\\\\\\\"Generate policy rules for these failure patterns:\\\\\\\\n{pattern_summary}\\\\\\\"\\\\n98: \\\\n99:         try:\\\\n100:             async with httpx.AsyncClient(timeout=30.0) as client:\\\\n101:                 resp = await client.post(_LLM_URL, json={\\\\n102:                     \\\\\\\"model\\\\\\\": _LLM_MODEL,\\\\n103:                     \\\\\\\"messages\\\\\\\": [\\\\n104:                         {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": _CANDIDATE_SYSTEM_PROMPT},\\\\n105:                         {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": user_msg},\\\\n106:                     ],\\\\n107:                     \\\\\\\"temperature\\\\\\\": 0.3,\\\\n108:                     \\\\\\\"max_tokens\\\\\\\": 1500,\\\\n109:                 })\\\\n110:                 resp.raise_for_status()\\\\n111:                 body = resp.json()\\\\n112:                 content = body[\\\\\\\"choices\\\\\\\"][0][\\\\\\\"message\\\\\\\"][\\\\\\\"content\\\\\\\"]\\\\n113:                 return content.strip()\\\\n114:         except Exception as exc:\\\\n115:             logger.error(\\\\\\\"LLM call failed: %s\\\\\\\", exc)\\\\n116:             return None\\\\n117: \\\\n118:     def _parse_candidates(self, yaml_text: str, patterns: list[dict]) -> list[dict]:\\\\n119:         if yaml_text.startswith(\\\\\\\"```\\\\\\\"):\\\\n120:             yaml_text = yaml_text.strip().removeprefix(\\\\\\\"```yaml\\\\\\\").removeprefix(\\\\\\\"```\\\\\\\")\\\\n121:             if \\\\\\\"```\\\\\\\" in yaml_text:\\\\n122:                 yaml_text = yaml_text[:yaml_text.index(\\\\\\\"```\\\\\\\")].strip()\\\\n123: \\\\n124:         try:\\\\n125:             raw = yaml.safe_load(yaml_text)\\\\n126:         except Exception as exc:\\\\n127:             logger.warning(\\\\\\\"Failed to parse LLM YAML output: %s\\\\\\\", exc)\\\\n128:             logger.debug(\\\\\\\"Raw output: %s\\\\\\\", yaml_text)\\\\n129:             return []\\\\n130: \\\\n131:         if not raw:\\\\n132:             return []\\\\n133: \\\\n134:         rules = raw if isinstance(raw, list) else raw.get(\\\\\\\"rules\\\\\\\", [])\\\\n135:         if not isinstance(rules, list):\\\\n136:             rules = [rules]\\\\n137: \\\\n138:         candidates = []\\\\n139:         for rule in rules:\\\\n140:             if not isinstance(rule, dict):\\\\n141:                 continue\\\\n142:             verdict = rule.get(\\\\\\\"action\\\\\\\", {}).get(\\\\\\\"verdict\\\\\\\", \\\\\\\"\\\\\\\")\\\\n143:             if verdict == \\\\\\\"DENY\\\\\\\":\\\\n144:                 continue\\\\n145: \\\\n146:             pattern_id = self._match_pattern_id(rule, patterns)\\\\n147:             cand_id = str(uuid4())\\\\n148:             rule_yaml = yaml.dump([rule], default_flow_style=False)\\\\n149: \\\\n150:             candidates.append({\\\\n151:                 \\\\\\\"candidate_id\\\\\\\": cand_id,\\\\n152:                 \\\\\\\"pattern_id\\\\\\\": pattern_id,\\\\n153:                 \\\\\\\"rule_yaml\\\\\\\": rule_yaml,\\\\n154:                 \\\\\\\"triggering_pattern\\\\\\\": next(\\\\n155:                     (p for p in patterns if p[\\\\\\\"pattern_id\\\\\\\"] == pattern_id), patterns[0]\\\\n156:                 ),\\\\n157:             })\\\\n158:         return candidates\\\\n159: \\\\n160:     def _match_pattern_id(self, rule: dict, patterns: list[dict]) -> str:\\\\n161:         cond = rule.get(\\\\\\\"conditions\\\\\\\", {})\\\\n162:         ic = cond.get(\\\\\\\"intent_class\\\\\\\", \\\\\\\"\\\\\\\")\\\\n163:         at = cond.get(\\\\\\\"action_type\\\\\\\", \\\\\\\"\\\\\\\")\\\\n164:         ec = cond.get(\\\\\\\"entity_class\\\\\\\", \\\\\\\"\\\\\\\")\\\\n165:         ar = cond.get(\\\\\\\"actor_role\\\\\\\", \\\\\\\"\\\\\\\")\\\\n166:         for p in patterns:\\\\n167:             if (p[\\\\\\\"intent_class\\\\\\\"] == ic and p[\\\\\\\"action_type\\\\\\\"] == at\\\\n168:                     and p[\\\\\\\"entity_class\\\\\\\"] == ec and p[\\\\\\\"actor_role\\\\\\\"] == ar):\\\\n169:                 return p[\\\\\\\"pattern_id\\\\\\\"]\\\\n170:         return patterns[0][\\\\\\\"pattern_id\\\\\\\"] if patterns else \\\\\\\"\\\\\\\"\\\\n171: \\\\n172:     async def _candidate_exists(self, pattern_id: str) -> bool:\\\\n173:         async with aiosqlite.connect(self._db) as db:\\\\n174:             async with db.execute(\\\\n175:                 \\\\\\\"SELECT 1 FROM policy_candidates WHERE pattern_id = ? AND status = 'PENDING'\\\\\\\",\\\\n176:                 (pattern_id,),\\\\n177:             ) as cursor:\\\\n178:                 return await cursor.fetchone() is not None\\\\n\\\\n(End of file - total 178 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76dtp_d17e079a2813\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76dtp_d17e079a2813\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_03_ERPieD3LzxnQvc25gNqB6864\\\",\\\"duration_ms\\\":5,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Consolidation job — summarization, graph extraction, decay, archival.\\\\nUses agentmemory for all storage operations.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nfrom __future__ import annotations\\\\n\\\\nimport logging\\\\nfrom datetime import datetime, timezone, timedelta\\\\n\\\\nfrom agentmemory import get_memories, update_memory\\\\n\\\\nfrom xnch.memory.graph_extractor import extract_and_store\\\\nfrom xnch.memory.pg_episodic_store import CATEGORY as EPISODE_CATEGORY\\\\n\\\\nlogger = logging.getLogger(__name__)\\\\n\\\\n\\\\nasync def run_consolidation() -> None:\\\\n    try:\\\\n        await _zep_summarize()\\\\n\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/jobs/consolidation.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/jobs/consolidation.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/jobs/consolidation.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Consolidation job — summarization, graph extraction, decay, archival.\\\\n2: Uses agentmemory for all storage operations.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n3: \\\\n4: from __future__ import annotations\\\\n5: \\\\n6: import logging\\\\n7: from datetime import datetime, timezone, timedelta\\\\n8: \\\\n9: from agentmemory import get_memories, update_memory\\\\n10: \\\\n11: from xnch.memory.graph_extractor import extract_and_store\\\\n12: from xnch.memory.pg_episodic_store import CATEGORY as EPISODE_CATEGORY\\\\n13: \\\\n14: logger = logging.getLogger(__name__)\\\\n15: \\\\n16: \\\\n17: async def run_consolidation() -> None:\\\\n18:     try:\\\\n19:         await _zep_summarize()\\\\n20: \\\\n21:         triples = await extract_and_store()\\\\n22:         logger.info(\\\\\\\"Graph extraction: %d triples written\\\\\\\", triples)\\\\n23: \\\\n24:         _recompute_decay()\\\\n25: \\\\n26:         archived = _archive_low_decay()\\\\n27:         logger.info(\\\\\\\"Consolidation complete — %d episodes archived\\\\\\\", archived)\\\\n28:     except Exception:\\\\n29:         logger.exception(\\\\\\\"Consolidation failed\\\\\\\")\\\\n30: \\\\n31: \\\\n32: async def _zep_summarize() -> None:\\\\n33:     episodes = get_memories(EPISODE_CATEGORY, n_results=100)\\\\n34:     logger.info(\\\\\\\"Zep summarization: %d episodes in window\\\\\\\", len(episodes))\\\\n35: \\\\n36: \\\\n37: def _recompute_decay() -> None:\\\\n38:     now = datetime.now(timezone.utc)\\\\n39:     all_mem = get_memories(EPISODE_CATEGORY, n_results=5000)\\\\n40:     for m in all_mem:\\\\n41:         meta = dict(m[\\\\\\\"metadata\\\\\\\"])\\\\n42:         try:\\\\n43:             ts = datetime.fromisoformat(meta.get(\\\\\\\"timestamp\\\\\\\", now.isoformat()))\\\\n44:         except Exception:\\\\n45:             ts = now\\\\n46:         days = (now - ts).total_seconds() / 86400\\\\n47:         importance = float(meta.get(\\\\\\\"importance\\\\\\\", 1.0))\\\\n48:         recall_count = int(meta.get(\\\\\\\"recall_count\\\\\\\", 0))\\\\n49:         decay = importance * (2.718 ** (-0.1 * days)) * (1 + 0.1 * recall_count)\\\\n50:         meta[\\\\\\\"decay_score\\\\\\\"] = str(round(decay, 4))\\\\n51:         update_memory(EPISODE_CATEGORY, m[\\\\\\\"id\\\\\\\"], metadata=meta)\\\\n52: \\\\n53: \\\\n54: def _archive_low_decay() -> int:\\\\n55:     all_mem = get_memories(EPISODE_CATEGORY, n_results=5000)\\\\n56:     archived = 0\\\\n57:     for m in all_mem:\\\\n58:         meta = dict(m[\\\\\\\"metadata\\\\\\\"])\\\\n59:         if meta.get(\\\\\\\"archived\\\\\\\", \\\\\\\"False\\\\\\\") == \\\\\\\"True\\\\\\\":\\\\n60:             continue\\\\n61:         decay = float(meta.get(\\\\\\\"decay_score\\\\\\\", 1.0))\\\\n62:         if decay < 0.1:\\\\n63:             meta[\\\\\\\"archived\\\\\\\"] = \\\\\\\"True\\\\\\\"\\\\n64:             update_memory(EPISODE_CATEGORY, m[\\\\\\\"id\\\\\\\"], metadata=meta)\\\\n65:             archived += 1\\\\n66:     return archived\\\\n\\\\n(End of file - total 66 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:57.466Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/jobs/consolidation.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/jobs/consolidation.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Consolidation job — summarization, graph extraction, decay, archival.\\\\n2: Uses agentmemory for all storage operations.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n3: \\\\n4: from __future__ import annotations\\\\n5: \\\\n6: import logging\\\\n7: from datetime import datetime, timezone, timedelta\\\\n8: \\\\n9: from agentmemory import get_memories, update_memory\\\\n10: \\\\n11: from xnch.memory.graph_extractor import extract_and_store\\\\n12: from xnch.memory.pg_episodic_store import CATEGORY as EPISODE_CATEGORY\\\\n13: \\\\n14: logger = logging.getLogger(__name__)\\\\n15: \\\\n16: \\\\n17: async def run_consolidation() -> None:\\\\n18:     try:\\\\n19:         await _zep_summarize()\\\\n20: \\\\n21:         triples = await extract_and_store()\\\\n22:         logger.info(\\\\\\\"Graph extraction: %d triples written\\\\\\\", triples)\\\\n23: \\\\n24:         _recompute_decay()\\\\n25: \\\\n26:         archived = _archive_low_decay()\\\\n27:         logger.info(\\\\\\\"Consolidation complete — %d episodes archived\\\\\\\", archived)\\\\n28:     except Exception:\\\\n29:         logger.exception(\\\\\\\"Consolidation failed\\\\\\\")\\\\n30: \\\\n31: \\\\n32: async def _zep_summarize() -> None:\\\\n33:     episodes = get_memories(EPISODE_CATEGORY, n_results=100)\\\\n34:     logger.info(\\\\\\\"Zep summarization: %d episodes in window\\\\\\\", len(episodes))\\\\n35: \\\\n36: \\\\n37: def _recompute_decay() -> None:\\\\n38:     now = datetime.now(timezone.utc)\\\\n39:     all_mem = get_memories(EPISODE_CATEGORY, n_results=5000)\\\\n40:     for m in all_mem:\\\\n41:         meta = dict(m[\\\\\\\"metadata\\\\\\\"])\\\\n42:         try:\\\\n43:             ts = datetime.fromisoformat(meta.get(\\\\\\\"timestamp\\\\\\\", now.isoformat()))\\\\n44:         except Exception:\\\\n45:             ts = now\\\\n46:         days = (now - ts).total_seconds() / 86400\\\\n47:         importance = float(meta.get(\\\\\\\"importance\\\\\\\", 1.0))\\\\n48:         recall_count = int(meta.get(\\\\\\\"recall_count\\\\\\\", 0))\\\\n49:         decay = importance * (2.718 ** (-0.1 * days)) * (1 + 0.1 * recall_count)\\\\n50:         meta[\\\\\\\"decay_score\\\\\\\"] = str(round(decay, 4))\\\\n51:         update_memory(EPISODE_CATEGORY, m[\\\\\\\"id\\\\\\\"], metadata=meta)\\\\n52: \\\\n53: \\\\n54: def _archive_low_decay() -> int:\\\\n55:     all_mem = get_memories(EPISODE_CATEGORY, n_results=5000)\\\\n56:     archived = 0\\\\n57:     for m in all_mem:\\\\n58:         meta = dict(m[\\\\\\\"metadata\\\\\\\"])\\\\n59:         if meta.get(\\\\\\\"archived\\\\\\\", \\\\\\\"False\\\\\\\") == \\\\\\\"True\\\\\\\":\\\\n60:             continue\\\\n61:         decay = float(meta.get(\\\\\\\"decay_score\\\\\\\", 1.0))\\\\n62:         if decay < 0.1:\\\\n63:             meta[\\\\\\\"archived\\\\\\\"] = \\\\\\\"True\\\\\\\"\\\\n64:             update_memory(EPISODE_CATEGORY, m[\\\\\\\"id\\\\\\\"], metadata=meta)\\\\n65:             archived += 1\\\\n66:     return archived\\\\n\\\\n(End of file - total 66 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76e2a_7927e436983e\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76e2a_7927e436983e\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_04_XIv6gl8AFNJcTBMpYlYN4448\\\",\\\"duration_ms\\\":4,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Step 3 — Intent Normalization (Contract 4). LiteLLM-backed classifier.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport hashlib\\\\nimport json\\\\nimport re\\\\nfrom typing import Any\\\\nfrom uuid import UUID\\\\n\\\\nimport httpx\\\\nfrom agentmemory import create_memory, search_memory\\\\n\\\\nfrom ..config import settings\\\\nfrom ..models.intent import Intent, IntentClass, ActionType, Urgency\\\\nfrom ..utils.audit import emit_event\\\\nfrom xnch.security.injection_guard import scan_input, InjectionResult\\\\n\\\\n\\\\nclass PolicyViolation(Exception):\\\\n    pass\\\\n\\\\n\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"nexi/nexi/pipeline/intent_interpreter.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/intent_interpreter.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/intent_interpreter.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 3 — Intent Normalization (Contract 4). LiteLLM-backed classifier.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import hashlib\\\\n3: import json\\\\n4: import re\\\\n5: from typing import Any\\\\n6: from uuid import UUID\\\\n7: \\\\n8: import httpx\\\\n9: from agentmemory import create_memory, search_memory\\\\n10: \\\\n11: from ..config import settings\\\\n12: from ..models.intent import Intent, IntentClass, ActionType, Urgency\\\\n13: from ..utils.audit import emit_event\\\\n14: from xnch.security.injection_guard import scan_input, InjectionResult\\\\n15: \\\\n16: \\\\n17: class PolicyViolation(Exception):\\\\n18:     pass\\\\n19: \\\\n20: \\\\n21: _CLASSIFICATION_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are an intent classifier for a systems-management agent.\\\\n22: Classify the user's raw input into one of these intent classes:\\\\n23: \\\\n24: - QUERY: Read-only information retrieval (list, show, get, fetch, display)\\\\n25: - DECISION: Planning, design, recommendation, analysis for decision support\\\\n26: - EXECUTION: Mutating actions (deploy, rollback, write, delete, backup, run)\\\\n27: - ESCALATION: Escalate to human operator\\\\n28: \\\\n29: Respond with a JSON object using this schema:\\\\n30: {\\\\n31:   \\\\\\\"intent_class\\\\\\\": \\\\\\\"QUERY|DECISION|EXECUTION|ESCALATION\\\\\\\",\\\\n32:   \\\\\\\"action_type\\\\\\\": \\\\\\\"<appropriate action from the list below>\\\\\\\",\\\\n33:   \\\\\\\"entity_class\\\\\\\": \\\\\\\"<guessed entity type: ML_MODEL|SERVICE|DATABASE|CLUSTER|FILE|SCRIPT|SCHEMA|RESOURCE>\\\\\\\",\\\\n34:   \\\\\\\"urgency\\\\\\\": \\\\\\\"LOW|NORMAL|HIGH|CRITICAL\\\\\\\",\\\\n35:   \\\\\\\"entity_id\\\\\\\": \\\\\\\"<the noun phrase identifying the target>\\\\\\\",\\\\n36:   \\\\\\\"clarifications_needed\\\\\\\": [\\\\\\\"<question if ambiguous>\\\\\\\"]\\\\n37: }\\\\n38: \\\\n39: Action types by class:\\\\n40: QUERY → READ_FILE, LIST, ANALYZE, QUERY\\\\n41: DECISION → PLAN, ANALYZE\\\\n42: EXECUTION → DEPLOY, ROLLBACK, BACKUP, RESTORE, WRITE_FILE, DELETE_FILE, RUN_COMMAND, RUN_SCRIPT, STAGE, MUTATE\\\\n43: ESCALATION → ESCALATE\\\\n44: \\\\n45: If the input is ambiguous (multiple interpretations possible), populates clarifications_needed\\\\n46: with specific questions to disambiguate. Otherwise leave it empty.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n47: \\\\n48: \\\\n49: class ClarificationRequired(Exception):\\\\n50:     def __init__(self, session_id: UUID, ambiguity_score: float, questions: list[str] | None = None) -> None:\\\\n51:         self.session_id = session_id\\\\n52:         self.ambiguity_score = ambiguity_score\\\\n53:         self.questions = questions or []\\\\n54:         msg = f\\\\\\\"Ambiguity score {ambiguity_score:.2f} exceeds threshold\\\\\\\"\\\\n55:         if self.questions:\\\\n56:             msg += f\\\\\\\"; questions: {'; '.join(self.questions)}\\\\\\\"\\\\n57:         super().__init__(msg)\\\\n58: \\\\n59: \\\\n60: # Stage 1: rule-based pre-filter (confidence=1.0, ambiguity=0.0)\\\\n61: _RULES: list[tuple[re.Pattern, IntentClass, str]] = [\\\\n62:     (re.compile(r\\\\\\\"^(list|show all|enumerate)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"LIST\\\\\\\"),\\\\n63:     (re.compile(r\\\\\\\"^(show|read|get|fetch|display)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"READ_FILE\\\\\\\"),\\\\n64:     (re.compile(r\\\\\\\"^(analyze|inspect|check|scan)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"ANALYZE\\\\\\\"),\\\\n65:     (re.compile(r\\\\\\\"^(deploy|launch|start|spin up)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"DEPLOY\\\\\\\"),\\\\n66:     (re.compile(r\\\\\\\"^(rollback|revert)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"ROLLBACK\\\\\\\"),\\\\n67:     (re.compile(r\\\\\\\"^back(up|fill)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"BACKUP\\\\\\\"),\\\\n68:     (re.compile(r\\\\\\\"^(delete|remove|drop)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"DELETE_FILE\\\\\\\"),\\\\n69:     (re.compile(r\\\\\\\"^(write|create|add)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"WRITE_FILE\\\\\\\"),\\\\n70:     (re.compile(r\\\\\\\"^(plan|design|propose)\\\\\\\\b\\\\\\\", re.I), IntentClass.DECISION, \\\\\\\"PLAN\\\\\\\"),\\\\n71:     (re.compile(r\\\\\\\"^(recommend|suggest|advise)\\\\\\\\b\\\\\\\", re.I), IntentClass.DECISION, \\\\\\\"ANALYZE\\\\\\\"),\\\\n72:     (re.compile(r\\\\\\\"^escalate\\\\\\\\b\\\\\\\", re.I), IntentClass.ESCALATION, \\\\\\\"ESCALATE\\\\\\\"),\\\\n73: ]\\\\n74: \\\\n75: \\\\n76: def _rule_classify(raw_input: str) -> tuple[IntentClass, str, float, float] | None:\\\\n77:     for pattern, intent_class, action_type in _RULES:\\\\n78:         if pattern.search(raw_input.strip()):\\\\n79:             return intent_class, action_type, 1.0, 0.0\\\\n80:     return None\\\\n81: \\\\n82: \\\\n83: def _extract_entity(raw_input: str) -> tuple[str, str]:\\\\n84:     tokens = raw_input.strip().split()\\\\n85:     entity_id = tokens[1] if len(tokens) > 1 else \\\\\\\"unknown\\\\\\\"\\\\n86:     entity_class_hints = {\\\\n87:         \\\\\\\"model\\\\\\\": \\\\\\\"ML_MODEL\\\\\\\", \\\\\\\"service\\\\\\\": \\\\\\\"SERVICE\\\\\\\", \\\\\\\"db\\\\\\\": \\\\\\\"DATABASE\\\\\\\",\\\\n88:         \\\\\\\"database\\\\\\\": \\\\\\\"DATABASE\\\\\\\", \\\\\\\"cluster\\\\\\\": \\\\\\\"CLUSTER\\\\\\\", \\\\\\\"file\\\\\\\": \\\\\\\"FILE\\\\\\\",\\\\n89:         \\\\\\\"script\\\\\\\": \\\\\\\"SCRIPT\\\\\\\", \\\\\\\"schema\\\\\\\": \\\\\\\"SCHEMA\\\\\\\",\\\\n90:     }\\\\n91:     for token in tokens:\\\\n92:         for hint, cls in entity_class_hints.items():\\\\n93:             if hint in token.lower():\\\\n94:                 return entity_id, cls\\\\n95:     return entity_id, \\\\\\\"RESOURCE\\\\\\\"\\\\n96: \\\\n97: \\\\n98: def _recall_intent(raw_input: str) -> Intent | None:\\\\n99:     try:\\\\n100:         results = search_memory(\\\\\\\"intent-classifications\\\\\\\", raw_input, n_results=3, include_embeddings=False)\\\\n101:         for item in results:\\\\n102:             mem = item.get(\\\\\\\"document\\\\\\\", \\\\\\\"\\\\\\\") if isinstance(item, dict) else str(item)\\\\n103:             if isinstance(mem, str):\\\\n104:                 try:\\\\n105:                     data = json.loads(mem)\\\\n106:                     if data.get(\\\\\\\"raw_input\\\\\\\", \\\\\\\"\\\\\\\").lower().strip() == raw_input.lower().strip():\\\\n107:                         return Intent(\\\\n108:                             session_id=UUID(int=0),\\\\n109:                             intent_class=IntentClass(data[\\\\\\\"intent_class\\\\\\\"]),\\\\n110:                             action_type=ActionType(data[\\\\\\\"action_type\\\\\\\"]),\\\\n111:                             target_entity_id=data.get(\\\\\\\"entity_id\\\\\\\", \\\\\\\"unknown\\\\\\\"),\\\\n112:                             target_entity_class=data.get(\\\\\\\"entity_class\\\\\\\", \\\\\\\"RESOURCE\\\\\\\"),\\\\n113:                             urgency=Urgency(data.get(\\\\\\\"urgency\\\\\\\", \\\\\\\"NORMAL\\\\\\\")),\\\\n114:                             ambiguity_score=0.0,\\\\n115:                             raw_input_hash=\\\\\\\"\\\\\\\",\\\\n116:                             raw_input=raw_input,\\\\n117:                         )\\\\n118:                 except Exception:\\\\n119:                     pass\\\\n120:     except Exception:\\\\n121:         pass\\\\n122:     return None\\\\n123: \\\\n124: \\\\n125: def _persist_intent(raw_input: str, intent: Intent) -> None:\\\\n126:     try:\\\\n127:         create_memory(\\\\n128:             \\\\\\\"intent-classifications\\\\\\\",\\\\n129:             json.dumps({\\\\n130:                 \\\\\\\"raw_input\\\\\\\": raw_input,\\\\n131:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n132:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n133:                 \\\\\\\"entity_id\\\\\\\": intent.target_entity_id,\\\\n134:                 \\\\\\\"entity_class\\\\\\\": intent.target_entity_class,\\\\n135:                 \\\\\\\"urgency\\\\\\\": intent.urgency,\\\\n136:             }),\\\\n137:             metadata={\\\\n138:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n139:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n140:             },\\\\n141:         )\\\\n142:     except Exception:\\\\n143:         pass\\\\n144: \\\\n145: \\\\n146: class IntentInterpreter:\\\\n147:     \\\\\\\"\\\\\\\"\\\\\\\"Contract 4 two-stage classifier: rule-based pre-filter + LiteLLM fallback.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n148: \\\\n149:     async def interpret(self, raw_input: str, session_id: UUID, trace_id: str) -> Intent:\\\\n150:         raw_input_hash = \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(raw_input.encode()).hexdigest()\\\\n151: \\\\n152:         injection_result = scan_input(raw_input)\\\\n153:         if not injection_result.is_clean:\\\\n154:             emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"INJECTION_BLOCKED\\\\\\\",\\\\n155:                        {\\\\\\\"risk_score\\\\\\\": injection_result.risk_score,\\\\n156:                         \\\\\\\"matched_patterns\\\\\\\": injection_result.matched_patterns})\\\\n157:             raise PolicyViolation(f\\\\\\\"Input failed injection scan (risk={injection_result.risk_score:.2f})\\\\\\\")\\\\n158: \\\\n159:         emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"CLASSIFY_START\\\\\\\")\\\\n160: \\\\n161:         rule_result = _rule_classify(raw_input)\\\\n162:         if rule_result:\\\\n163:             intent_class, action_type, confidence, ambiguity_score = rule_result\\\\n164:             classification_method = \\\\\\\"rule\\\\\\\"\\\\n165: \\\\n166:             if ambiguity_score > 0.7:\\\\n167:                 emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"CLARIFICATION_REQUIRED\\\\\\\",\\\\n168:                            {\\\\\\\"ambiguity_score\\\\\\\": ambiguity_score})\\\\n\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:57.775Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/intent_interpreter.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/intent_interpreter.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 3 — Intent Normalization (Contract 4). LiteLLM-backed classifier.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import hashlib\\\\n3: import json\\\\n4: import re\\\\n5: from typing import Any\\\\n6: from uuid import UUID\\\\n7: \\\\n8: import httpx\\\\n9: from agentmemory import create_memory, search_memory\\\\n10: \\\\n11: from ..config import settings\\\\n12: from ..models.intent import Intent, IntentClass, ActionType, Urgency\\\\n13: from ..utils.audit import emit_event\\\\n14: from xnch.security.injection_guard import scan_input, InjectionResult\\\\n15: \\\\n16: \\\\n17: class PolicyViolation(Exception):\\\\n18:     pass\\\\n19: \\\\n20: \\\\n21: _CLASSIFICATION_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are an intent classifier for a systems-management agent.\\\\n22: Classify the user's raw input into one of these intent classes:\\\\n23: \\\\n24: - QUERY: Read-only information retrieval (list, show, get, fetch, display)\\\\n25: - DECISION: Planning, design, recommendation, analysis for decision support\\\\n26: - EXECUTION: Mutating actions (deploy, rollback, write, delete, backup, run)\\\\n27: - ESCALATION: Escalate to human operator\\\\n28: \\\\n29: Respond with a JSON object using this schema:\\\\n30: {\\\\n31:   \\\\\\\"intent_class\\\\\\\": \\\\\\\"QUERY|DECISION|EXECUTION|ESCALATION\\\\\\\",\\\\n32:   \\\\\\\"action_type\\\\\\\": \\\\\\\"<appropriate action from the list below>\\\\\\\",\\\\n33:   \\\\\\\"entity_class\\\\\\\": \\\\\\\"<guessed entity type: ML_MODEL|SERVICE|DATABASE|CLUSTER|FILE|SCRIPT|SCHEMA|RESOURCE>\\\\\\\",\\\\n34:   \\\\\\\"urgency\\\\\\\": \\\\\\\"LOW|NORMAL|HIGH|CRITICAL\\\\\\\",\\\\n35:   \\\\\\\"entity_id\\\\\\\": \\\\\\\"<the noun phrase identifying the target>\\\\\\\",\\\\n36:   \\\\\\\"clarifications_needed\\\\\\\": [\\\\\\\"<question if ambiguous>\\\\\\\"]\\\\n37: }\\\\n38: \\\\n39: Action types by class:\\\\n40: QUERY → READ_FILE, LIST, ANALYZE, QUERY\\\\n41: DECISION → PLAN, ANALYZE\\\\n42: EXECUTION → DEPLOY, ROLLBACK, BACKUP, RESTORE, WRITE_FILE, DELETE_FILE, RUN_COMMAND, RUN_SCRIPT, STAGE, MUTATE\\\\n43: ESCALATION → ESCALATE\\\\n44: \\\\n45: If the input is ambiguous (multiple interpretations possible), populates clarifications_needed\\\\n46: with specific questions to disambiguate. Otherwise leave it empty.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n47: \\\\n48: \\\\n49: class ClarificationRequired(Exception):\\\\n50:     def __init__(self, session_id: UUID, ambiguity_score: float, questions: list[str] | None = None) -> None:\\\\n51:         self.session_id = session_id\\\\n52:         self.ambiguity_score = ambiguity_score\\\\n53:         self.questions = questions or []\\\\n54:         msg = f\\\\\\\"Ambiguity score {ambiguity_score:.2f} exceeds threshold\\\\\\\"\\\\n55:         if self.questions:\\\\n56:             msg += f\\\\\\\"; questions: {'; '.join(self.questions)}\\\\\\\"\\\\n57:         super().__init__(msg)\\\\n58: \\\\n59: \\\\n60: # Stage 1: rule-based pre-filter (confidence=1.0, ambiguity=0.0)\\\\n61: _RULES: list[tuple[re.Pattern, IntentClass, str]] = [\\\\n62:     (re.compile(r\\\\\\\"^(list|show all|enumerate)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"LIST\\\\\\\"),\\\\n63:     (re.compile(r\\\\\\\"^(show|read|get|fetch|display)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"READ_FILE\\\\\\\"),\\\\n64:     (re.compile(r\\\\\\\"^(analyze|inspect|check|scan)\\\\\\\\b\\\\\\\", re.I), IntentClass.QUERY, \\\\\\\"ANALYZE\\\\\\\"),\\\\n65:     (re.compile(r\\\\\\\"^(deploy|launch|start|spin up)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"DEPLOY\\\\\\\"),\\\\n66:     (re.compile(r\\\\\\\"^(rollback|revert)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"ROLLBACK\\\\\\\"),\\\\n67:     (re.compile(r\\\\\\\"^back(up|fill)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"BACKUP\\\\\\\"),\\\\n68:     (re.compile(r\\\\\\\"^(delete|remove|drop)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"DELETE_FILE\\\\\\\"),\\\\n69:     (re.compile(r\\\\\\\"^(write|create|add)\\\\\\\\b\\\\\\\", re.I), IntentClass.EXECUTION, \\\\\\\"WRITE_FILE\\\\\\\"),\\\\n70:     (re.compile(r\\\\\\\"^(plan|design|propose)\\\\\\\\b\\\\\\\", re.I), IntentClass.DECISION, \\\\\\\"PLAN\\\\\\\"),\\\\n71:     (re.compile(r\\\\\\\"^(recommend|suggest|advise)\\\\\\\\b\\\\\\\", re.I), IntentClass.DECISION, \\\\\\\"ANALYZE\\\\\\\"),\\\\n72:     (re.compile(r\\\\\\\"^escalate\\\\\\\\b\\\\\\\", re.I), IntentClass.ESCALATION, \\\\\\\"ESCALATE\\\\\\\"),\\\\n73: ]\\\\n74: \\\\n75: \\\\n76: def _rule_classify(raw_input: str) -> tuple[IntentClass, str, float, float] | None:\\\\n77:     for pattern, intent_class, action_type in _RULES:\\\\n78:         if pattern.search(raw_input.strip()):\\\\n79:             return intent_class, action_type, 1.0, 0.0\\\\n80:     return None\\\\n81: \\\\n82: \\\\n83: def _extract_entity(raw_input: str) -> tuple[str, str]:\\\\n84:     tokens = raw_input.strip().split()\\\\n85:     entity_id = tokens[1] if len(tokens) > 1 else \\\\\\\"unknown\\\\\\\"\\\\n86:     entity_class_hints = {\\\\n87:         \\\\\\\"model\\\\\\\": \\\\\\\"ML_MODEL\\\\\\\", \\\\\\\"service\\\\\\\": \\\\\\\"SERVICE\\\\\\\", \\\\\\\"db\\\\\\\": \\\\\\\"DATABASE\\\\\\\",\\\\n88:         \\\\\\\"database\\\\\\\": \\\\\\\"DATABASE\\\\\\\", \\\\\\\"cluster\\\\\\\": \\\\\\\"CLUSTER\\\\\\\", \\\\\\\"file\\\\\\\": \\\\\\\"FILE\\\\\\\",\\\\n89:         \\\\\\\"script\\\\\\\": \\\\\\\"SCRIPT\\\\\\\", \\\\\\\"schema\\\\\\\": \\\\\\\"SCHEMA\\\\\\\",\\\\n90:     }\\\\n91:     for token in tokens:\\\\n92:         for hint, cls in entity_class_hints.items():\\\\n93:             if hint in token.lower():\\\\n94:                 return entity_id, cls\\\\n95:     return entity_id, \\\\\\\"RESOURCE\\\\\\\"\\\\n96: \\\\n97: \\\\n98: def _recall_intent(raw_input: str) -> Intent | None:\\\\n99:     try:\\\\n100:         results = search_memory(\\\\\\\"intent-classifications\\\\\\\", raw_input, n_results=3, include_embeddings=False)\\\\n101:         for item in results:\\\\n102:             mem = item.get(\\\\\\\"document\\\\\\\", \\\\\\\"\\\\\\\") if isinstance(item, dict) else str(item)\\\\n103:             if isinstance(mem, str):\\\\n104:                 try:\\\\n105:                     data = json.loads(mem)\\\\n106:                     if data.get(\\\\\\\"raw_input\\\\\\\", \\\\\\\"\\\\\\\").lower().strip() == raw_input.lower().strip():\\\\n107:                         return Intent(\\\\n108:                             session_id=UUID(int=0),\\\\n109:                             intent_class=IntentClass(data[\\\\\\\"intent_class\\\\\\\"]),\\\\n110:                             action_type=ActionType(data[\\\\\\\"action_type\\\\\\\"]),\\\\n111:                             target_entity_id=data.get(\\\\\\\"entity_id\\\\\\\", \\\\\\\"unknown\\\\\\\"),\\\\n112:                             target_entity_class=data.get(\\\\\\\"entity_class\\\\\\\", \\\\\\\"RESOURCE\\\\\\\"),\\\\n113:                             urgency=Urgency(data.get(\\\\\\\"urgency\\\\\\\", \\\\\\\"NORMAL\\\\\\\")),\\\\n114:                             ambiguity_score=0.0,\\\\n115:                             raw_input_hash=\\\\\\\"\\\\\\\",\\\\n116:                             raw_input=raw_input,\\\\n117:                         )\\\\n118:                 except Exception:\\\\n119:                     pass\\\\n120:     except Exception:\\\\n121:         pass\\\\n122:     return None\\\\n123: \\\\n124: \\\\n125: def _persist_intent(raw_input: str, intent: Intent) -> None:\\\\n126:     try:\\\\n127:         create_memory(\\\\n128:             \\\\\\\"intent-classifications\\\\\\\",\\\\n129:             json.dumps({\\\\n130:                 \\\\\\\"raw_input\\\\\\\": raw_input,\\\\n131:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n132:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n133:                 \\\\\\\"entity_id\\\\\\\": intent.target_entity_id,\\\\n134:                 \\\\\\\"entity_class\\\\\\\": intent.target_entity_class,\\\\n135:                 \\\\\\\"urgency\\\\\\\": intent.urgency,\\\\n136:             }),\\\\n137:             metadata={\\\\n138:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n139:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n140:             },\\\\n141:         )\\\\n142:     except Exception:\\\\n143:         pass\\\\n144: \\\\n145: \\\\n146: class IntentInterpreter:\\\\n147:     \\\\\\\"\\\\\\\"\\\\\\\"Contract 4 two-stage classifier: rule-based pre-filter + LiteLLM fallback.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n148: \\\\n149:     async def interpret(self, raw_input: str, session_id: UUID, trace_id: str) -> Intent:\\\\n150:         raw_input_hash = \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(raw_input.encode()).hexdigest()\\\\n151: \\\\n152:         injection_result = scan_input(raw_input)\\\\n153:         if not injection_result.is_clean:\\\\n154:             emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"INJECTION_BLOCKED\\\\\\\",\\\\n155:                        {\\\\\\\"risk_score\\\\\\\": injection_result.risk_score,\\\\n156:                         \\\\\\\"matched_patterns\\\\\\\": injection_result.matched_patterns})\\\\n157:             raise PolicyViolation(f\\\\\\\"Input failed injection scan (risk={injection_result.risk_score:.2f})\\\\\\\")\\\\n158: \\\\n159:         emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"CLASSIFY_START\\\\\\\")\\\\n160: \\\\n161:         rule_result = _rule_classify(raw_input)\\\\n162:         if rule_result:\\\\n163:             intent_class, action_type, confidence, ambiguity_score = rule_result\\\\n164:             classification_method = \\\\\\\"rule\\\\\\\"\\\\n165: \\\\n166:             if ambiguity_score > 0.7:\\\\n167:                 emit_event(trace_id, \\\\\\\"intent_interpreter\\\\\\\", \\\\\\\"CLARIFICATION_REQUIRED\\\\\\\",\\\\n168:                            {\\\\\\\"ambiguity_score\\\\\\\": ambiguity_score})\\\\n\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76e9v_3e50a2431901\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76e9v_3e50a2431901\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_05_tPNAuf0yQhAqMDqYmDrh0318\\\",\\\"duration_ms\\\":5,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Step 5 — Constrained option generation via LiteLLM structured output.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport uuid\\\\nfrom typing import Any\\\\n\\\\nimport httpx\\\\nfrom agentmemory import create_memory\\\\n\\\\nfrom ..adapters.model_adapter import ModelAdapter\\\\nfrom ..config import settings\\\\nfrom ..models import SessionContext, Intent, ContextManifest, PlanOption\\\\nfrom ..models.options import GenerationPath, ActionSpec\\\\nfrom ..utils.audit import emit_event\\\\nfrom xnch.routing.classifier import classify_request\\\\n\\\\n\\\\n_OPTION_GENERATION_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are an option generator for a systems-management agent.\\\\nGiven an intent summary and context, generate exactly N distinct PlanOption objects.\\\\n\\\\nEach option must include:\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"nexi/nexi/pipeline/option_generator.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/option_generator.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/option_generator.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 5 — Constrained option generation via LiteLLM structured output.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import json\\\\n3: import uuid\\\\n4: from typing import Any\\\\n5: \\\\n6: import httpx\\\\n7: from agentmemory import create_memory\\\\n8: \\\\n9: from ..adapters.model_adapter import ModelAdapter\\\\n10: from ..config import settings\\\\n11: from ..models import SessionContext, Intent, ContextManifest, PlanOption\\\\n12: from ..models.options import GenerationPath, ActionSpec\\\\n13: from ..utils.audit import emit_event\\\\n14: from xnch.routing.classifier import classify_request\\\\n15: \\\\n16: \\\\n17: _OPTION_GENERATION_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are an option generator for a systems-management agent.\\\\n18: Given an intent summary and context, generate exactly N distinct PlanOption objects.\\\\n19: \\\\n20: Each option must include:\\\\n21: - action_type: one of READ_FILE, WRITE_FILE, DELETE_FILE, LIST, RUN_COMMAND, RUN_SCRIPT,\\\\n22:   DEPLOY, ROLLBACK, STAGE, MUTATE, BACKUP, RESTORE, PLAN, ANALYZE, ESCALATE, QUERY\\\\n23: - action_spec: {\\\\\\\"target\\\\\\\": \\\\\\\"<entity target>\\\\\\\", \\\\\\\"params\\\\\\\": {<key-value params>}}\\\\n24: - stated_rationale: why this option is viable\\\\n25: - estimated_side_effects: list of strings describing potential state changes\\\\n26: - reversible: whether the action can be undone\\\\n27: \\\\n28: Respond with a JSON object:\\\\n29: {\\\\\\\"options\\\\\\\": [list of PlanOption objects]}\\\\n30: \\\\n31: Available actions: {available_actions}\\\\n32: \\\\n33: Generate exactly N={options_count} options. Return valid JSON only.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n34: \\\\n35: \\\\n36: def _persist_options(session: SessionContext, intent: Intent, options: list[PlanOption]) -> None:\\\\n37:     try:\\\\n38:         create_memory(\\\\n39:             \\\\\\\"generated-options\\\\\\\",\\\\n40:             json.dumps({\\\\n41:                 \\\\\\\"raw_input\\\\\\\": intent.raw_input,\\\\n42:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n43:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n44:                 \\\\\\\"options_count\\\\\\\": len(options),\\\\n45:                 \\\\\\\"option_types\\\\\\\": [o.action_type for o in options],\\\\n46:             }),\\\\n47:             metadata={\\\\n48:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n49:                 \\\\\\\"trace_id\\\\\\\": str(session.trace_id),\\\\n50:             },\\\\n51:         )\\\\n52:     except Exception:\\\\n53:         pass\\\\n54: \\\\n55: \\\\n56: def _build_context_summary(manifest: ContextManifest) -> dict:\\\\n57:     outcomes = {\\\\\\\"S\\\\\\\": 0, \\\\\\\"P\\\\\\\": 0, \\\\\\\"F\\\\\\\": 0}\\\\n58:     for ep in manifest.episodes:\\\\n59:         if ep.outcome == \\\\\\\"SUCCESS\\\\\\\":\\\\n60:             outcomes[\\\\\\\"S\\\\\\\"] += 1\\\\n61:         elif ep.outcome == \\\\\\\"PARTIAL\\\\\\\":\\\\n62:             outcomes[\\\\\\\"P\\\\\\\"] += 1\\\\n63:         elif ep.outcome == \\\\\\\"FAILURE\\\\\\\":\\\\n64:             outcomes[\\\\\\\"F\\\\\\\"] += 1\\\\n65: \\\\n66:     dominant = None\\\\n67:     if manifest.patterns:\\\\n68:         dominant = max(manifest.patterns, key=lambda p: p.confidence)\\\\n69: \\\\n70:     return {\\\\n71:         \\\\\\\"recent_outcomes\\\\\\\": f\\\\\\\"{outcomes['S']}S/{outcomes['P']}P/{outcomes['F']}F\\\\\\\",\\\\n72:         \\\\\\\"dominant_pattern\\\\\\\": (\\\\n73:             f\\\\\\\"{dominant.success_rate:.2f} success (conf={dominant.confidence:.2f})\\\\\\\"\\\\n74:             if dominant else \\\\\\\"no pattern\\\\\\\"\\\\n75:         ),\\\\n76:     }\\\\n77: \\\\n78: \\\\n79: def _build_option_prompt(intent: Intent, context_summary: dict, n: int) -> str:\\\\n80:     available_actions = [\\\\n81:         \\\\\\\"READ_FILE\\\\\\\", \\\\\\\"WRITE_FILE\\\\\\\", \\\\\\\"DELETE_FILE\\\\\\\", \\\\\\\"LIST\\\\\\\",\\\\n82:         \\\\\\\"RUN_COMMAND\\\\\\\", \\\\\\\"RUN_SCRIPT\\\\\\\", \\\\\\\"DEPLOY\\\\\\\", \\\\\\\"ROLLBACK\\\\\\\",\\\\n83:         \\\\\\\"STAGE\\\\\\\", \\\\\\\"MUTATE\\\\\\\", \\\\\\\"BACKUP\\\\\\\", \\\\\\\"RESTORE\\\\\\\",\\\\n84:         \\\\\\\"PLAN\\\\\\\", \\\\\\\"ANALYZE\\\\\\\", \\\\\\\"ESCALATE\\\\\\\", \\\\\\\"QUERY\\\\\\\",\\\\n85:     ]\\\\n86:     intent_summary = {\\\\n87:         \\\\\\\"class\\\\\\\": intent.intent_class,\\\\n88:         \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n89:         \\\\\\\"target_entity_id\\\\\\\": intent.target_entity_id,\\\\n90:         \\\\\\\"target_entity_class\\\\\\\": intent.target_entity_class,\\\\n91:         \\\\\\\"urgency\\\\\\\": intent.urgency,\\\\n92:     }\\\\n93:     prompt_data = {\\\\n94:         \\\\\\\"intent\\\\\\\": intent_summary,\\\\n95:         \\\\\\\"context\\\\\\\": context_summary,\\\\n96:     }\\\\n97:     system_prompt = _OPTION_GENERATION_SYSTEM_PROMPT.format(\\\\n98:         available_actions=json.dumps(available_actions),\\\\n99:         options_count=n,\\\\n100:     )\\\\n101:     return system_prompt, json.dumps(prompt_data)\\\\n102: \\\\n103: \\\\n104: async def generate_options(\\\\n105:     adapter: ModelAdapter,\\\\n106:     session: SessionContext,\\\\n107:     intent: Intent,\\\\n108:     manifest: ContextManifest,\\\\n109:     n: int = 5,\\\\n110: ) -> tuple[list[PlanOption], GenerationPath]:\\\\n111:     emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_START\\\\\\\",\\\\n112:                {\\\\\\\"n\\\\\\\": n, \\\\\\\"intent_class\\\\\\\": intent.intent_class})\\\\n113: \\\\n114:     context_summary = _build_context_summary(manifest)\\\\n115: \\\\n116:     model_route = classify_request(\\\\n117:         raw_input=intent.raw_input,\\\\n118:         actor_role=session.actor.role,\\\\n119:         metadata={\\\\n120:             \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n121:             \\\\\\\"complexity_score\\\\\\\": 0.5,\\\\n122:             \\\\\\\"privacy_sensitive\\\\\\\": False,\\\\n123:         },\\\\n124:     )\\\\n125: \\\\n126:     try:\\\\n127:         system_msg, user_msg = _build_option_prompt(intent, context_summary, n)\\\\n128:         async with httpx.AsyncClient(\\\\n129:             base_url=settings.litellm_proxy_url, timeout=settings.litellm_proxy_timeout_s\\\\n130:         ) as client:\\\\n131:             resp = await client.post(\\\\n132:                 \\\\\\\"/chat/completions\\\\\\\",\\\\n133:                 json={\\\\n134:                     \\\\\\\"model\\\\\\\": model_route.model_name,\\\\n135:                     \\\\\\\"messages\\\\\\\": [\\\\n136:                         {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": system_msg},\\\\n137:                         {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": user_msg},\\\\n138:                     ],\\\\n139:                     \\\\\\\"response_format\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"json_object\\\\\\\"},\\\\n140:                 },\\\\n141:             )\\\\n142:             resp.raise_for_status()\\\\n143:             content = resp.json()[\\\\\\\"choices\\\\\\\"][0][\\\\\\\"message\\\\\\\"][\\\\\\\"content\\\\\\\"]\\\\n144:             parsed = json.loads(content)\\\\n145:             items = parsed.get(\\\\\\\"options\\\\\\\", [])\\\\n146:             options = []\\\\n147:             for item in items:\\\\n148:                 spec = ActionSpec(\\\\n149:                     type=item.get(\\\\\\\"action_type\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n150:                     target=item.get(\\\\\\\"action_spec\\\\\\\", {}).get(\\\\\\\"target\\\\\\\", intent.target_entity_id),\\\\n151:                     params=item.get(\\\\\\\"action_spec\\\\\\\", {}).get(\\\\\\\"params\\\\\\\", {}),\\\\n152:                 )\\\\n153:                 options.append(PlanOption(\\\\n154:                     option_id=uuid.uuid4(),\\\\n155:                     action_type=item[\\\\\\\"action_type\\\\\\\"].upper(),\\\\n156:                     action_spec=spec,\\\\n157:                     stated_rationale=item.get(\\\\\\\"stated_rationale\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n158:                     estimated_side_effects=item.get(\\\\\\\"estimated_side_effects\\\\\\\", []),\\\\n159:                     reversible=item.get(\\\\\\\"reversible\\\\\\\", True),\\\\n160:                     payload_hash=\\\\\\\"sha256:\\\\\\\" + __import__(\\\\\\\"hashlib\\\\\\\").sha256(json.dumps(spec.model_dump(), sort_keys=True).encode()).hexdigest(),\\\\n161:                 ))\\\\n162: \\\\n163:         if options:\\\\n164:             emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_COMPLETE\\\\\\\",\\\\n165:                        {\\\\\\\"options_count\\\\\\\": len(options), \\\\\\\"path\\\\\\\": \\\\\\\"MODEL\\\\\\\"})\\\\n166:             _persist_options(session, intent, options)\\\\n167:             return options, GenerationPath.MODEL\\\\n168:     except Exception:\\\\n169:         pass\\\\n170: \\\\n171:     options, path = await adapter.generate_options(\\\\n172:         intent_class=intent.intent_class,\\\\n173:         target_entity_id=intent.target_entity_id,\\\\n174:         target_entity_class=intent.target_entity_class,\\\\n175:         context_summary=context_summary,\\\\n176:         n=n,\\\\n177:     )\\\\n178: \\\\n179:     if path == GenerationPath.MODEL:\\\\n180:         _persist_options(session, intent, options)\\\\n181: \\\\n182:     emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_COMPLETE\\\\\\\",\\\\n183:                {\\\\\\\"options_count\\\\\\\": len(options), \\\\\\\"path\\\\\\\": path})\\\\n184:     return options, path\\\\n\\\\n(End of file - total 184 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:58.050Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/option_generator.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/option_generator.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 5 — Constrained option generation via LiteLLM structured output.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import json\\\\n3: import uuid\\\\n4: from typing import Any\\\\n5: \\\\n6: import httpx\\\\n7: from agentmemory import create_memory\\\\n8: \\\\n9: from ..adapters.model_adapter import ModelAdapter\\\\n10: from ..config import settings\\\\n11: from ..models import SessionContext, Intent, ContextManifest, PlanOption\\\\n12: from ..models.options import GenerationPath, ActionSpec\\\\n13: from ..utils.audit import emit_event\\\\n14: from xnch.routing.classifier import classify_request\\\\n15: \\\\n16: \\\\n17: _OPTION_GENERATION_SYSTEM_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"You are an option generator for a systems-management agent.\\\\n18: Given an intent summary and context, generate exactly N distinct PlanOption objects.\\\\n19: \\\\n20: Each option must include:\\\\n21: - action_type: one of READ_FILE, WRITE_FILE, DELETE_FILE, LIST, RUN_COMMAND, RUN_SCRIPT,\\\\n22:   DEPLOY, ROLLBACK, STAGE, MUTATE, BACKUP, RESTORE, PLAN, ANALYZE, ESCALATE, QUERY\\\\n23: - action_spec: {\\\\\\\"target\\\\\\\": \\\\\\\"<entity target>\\\\\\\", \\\\\\\"params\\\\\\\": {<key-value params>}}\\\\n24: - stated_rationale: why this option is viable\\\\n25: - estimated_side_effects: list of strings describing potential state changes\\\\n26: - reversible: whether the action can be undone\\\\n27: \\\\n28: Respond with a JSON object:\\\\n29: {\\\\\\\"options\\\\\\\": [list of PlanOption objects]}\\\\n30: \\\\n31: Available actions: {available_actions}\\\\n32: \\\\n33: Generate exactly N={options_count} options. Return valid JSON only.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n34: \\\\n35: \\\\n36: def _persist_options(session: SessionContext, intent: Intent, options: list[PlanOption]) -> None:\\\\n37:     try:\\\\n38:         create_memory(\\\\n39:             \\\\\\\"generated-options\\\\\\\",\\\\n40:             json.dumps({\\\\n41:                 \\\\\\\"raw_input\\\\\\\": intent.raw_input,\\\\n42:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n43:                 \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n44:                 \\\\\\\"options_count\\\\\\\": len(options),\\\\n45:                 \\\\\\\"option_types\\\\\\\": [o.action_type for o in options],\\\\n46:             }),\\\\n47:             metadata={\\\\n48:                 \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n49:                 \\\\\\\"trace_id\\\\\\\": str(session.trace_id),\\\\n50:             },\\\\n51:         )\\\\n52:     except Exception:\\\\n53:         pass\\\\n54: \\\\n55: \\\\n56: def _build_context_summary(manifest: ContextManifest) -> dict:\\\\n57:     outcomes = {\\\\\\\"S\\\\\\\": 0, \\\\\\\"P\\\\\\\": 0, \\\\\\\"F\\\\\\\": 0}\\\\n58:     for ep in manifest.episodes:\\\\n59:         if ep.outcome == \\\\\\\"SUCCESS\\\\\\\":\\\\n60:             outcomes[\\\\\\\"S\\\\\\\"] += 1\\\\n61:         elif ep.outcome == \\\\\\\"PARTIAL\\\\\\\":\\\\n62:             outcomes[\\\\\\\"P\\\\\\\"] += 1\\\\n63:         elif ep.outcome == \\\\\\\"FAILURE\\\\\\\":\\\\n64:             outcomes[\\\\\\\"F\\\\\\\"] += 1\\\\n65: \\\\n66:     dominant = None\\\\n67:     if manifest.patterns:\\\\n68:         dominant = max(manifest.patterns, key=lambda p: p.confidence)\\\\n69: \\\\n70:     return {\\\\n71:         \\\\\\\"recent_outcomes\\\\\\\": f\\\\\\\"{outcomes['S']}S/{outcomes['P']}P/{outcomes['F']}F\\\\\\\",\\\\n72:         \\\\\\\"dominant_pattern\\\\\\\": (\\\\n73:             f\\\\\\\"{dominant.success_rate:.2f} success (conf={dominant.confidence:.2f})\\\\\\\"\\\\n74:             if dominant else \\\\\\\"no pattern\\\\\\\"\\\\n75:         ),\\\\n76:     }\\\\n77: \\\\n78: \\\\n79: def _build_option_prompt(intent: Intent, context_summary: dict, n: int) -> str:\\\\n80:     available_actions = [\\\\n81:         \\\\\\\"READ_FILE\\\\\\\", \\\\\\\"WRITE_FILE\\\\\\\", \\\\\\\"DELETE_FILE\\\\\\\", \\\\\\\"LIST\\\\\\\",\\\\n82:         \\\\\\\"RUN_COMMAND\\\\\\\", \\\\\\\"RUN_SCRIPT\\\\\\\", \\\\\\\"DEPLOY\\\\\\\", \\\\\\\"ROLLBACK\\\\\\\",\\\\n83:         \\\\\\\"STAGE\\\\\\\", \\\\\\\"MUTATE\\\\\\\", \\\\\\\"BACKUP\\\\\\\", \\\\\\\"RESTORE\\\\\\\",\\\\n84:         \\\\\\\"PLAN\\\\\\\", \\\\\\\"ANALYZE\\\\\\\", \\\\\\\"ESCALATE\\\\\\\", \\\\\\\"QUERY\\\\\\\",\\\\n85:     ]\\\\n86:     intent_summary = {\\\\n87:         \\\\\\\"class\\\\\\\": intent.intent_class,\\\\n88:         \\\\\\\"action_type\\\\\\\": intent.action_type,\\\\n89:         \\\\\\\"target_entity_id\\\\\\\": intent.target_entity_id,\\\\n90:         \\\\\\\"target_entity_class\\\\\\\": intent.target_entity_class,\\\\n91:         \\\\\\\"urgency\\\\\\\": intent.urgency,\\\\n92:     }\\\\n93:     prompt_data = {\\\\n94:         \\\\\\\"intent\\\\\\\": intent_summary,\\\\n95:         \\\\\\\"context\\\\\\\": context_summary,\\\\n96:     }\\\\n97:     system_prompt = _OPTION_GENERATION_SYSTEM_PROMPT.format(\\\\n98:         available_actions=json.dumps(available_actions),\\\\n99:         options_count=n,\\\\n100:     )\\\\n101:     return system_prompt, json.dumps(prompt_data)\\\\n102: \\\\n103: \\\\n104: async def generate_options(\\\\n105:     adapter: ModelAdapter,\\\\n106:     session: SessionContext,\\\\n107:     intent: Intent,\\\\n108:     manifest: ContextManifest,\\\\n109:     n: int = 5,\\\\n110: ) -> tuple[list[PlanOption], GenerationPath]:\\\\n111:     emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_START\\\\\\\",\\\\n112:                {\\\\\\\"n\\\\\\\": n, \\\\\\\"intent_class\\\\\\\": intent.intent_class})\\\\n113: \\\\n114:     context_summary = _build_context_summary(manifest)\\\\n115: \\\\n116:     model_route = classify_request(\\\\n117:         raw_input=intent.raw_input,\\\\n118:         actor_role=session.actor.role,\\\\n119:         metadata={\\\\n120:             \\\\\\\"intent_class\\\\\\\": intent.intent_class,\\\\n121:             \\\\\\\"complexity_score\\\\\\\": 0.5,\\\\n122:             \\\\\\\"privacy_sensitive\\\\\\\": False,\\\\n123:         },\\\\n124:     )\\\\n125: \\\\n126:     try:\\\\n127:         system_msg, user_msg = _build_option_prompt(intent, context_summary, n)\\\\n128:         async with httpx.AsyncClient(\\\\n129:             base_url=settings.litellm_proxy_url, timeout=settings.litellm_proxy_timeout_s\\\\n130:         ) as client:\\\\n131:             resp = await client.post(\\\\n132:                 \\\\\\\"/chat/completions\\\\\\\",\\\\n133:                 json={\\\\n134:                     \\\\\\\"model\\\\\\\": model_route.model_name,\\\\n135:                     \\\\\\\"messages\\\\\\\": [\\\\n136:                         {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": system_msg},\\\\n137:                         {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": user_msg},\\\\n138:                     ],\\\\n139:                     \\\\\\\"response_format\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"json_object\\\\\\\"},\\\\n140:                 },\\\\n141:             )\\\\n142:             resp.raise_for_status()\\\\n143:             content = resp.json()[\\\\\\\"choices\\\\\\\"][0][\\\\\\\"message\\\\\\\"][\\\\\\\"content\\\\\\\"]\\\\n144:             parsed = json.loads(content)\\\\n145:             items = parsed.get(\\\\\\\"options\\\\\\\", [])\\\\n146:             options = []\\\\n147:             for item in items:\\\\n148:                 spec = ActionSpec(\\\\n149:                     type=item.get(\\\\\\\"action_type\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n150:                     target=item.get(\\\\\\\"action_spec\\\\\\\", {}).get(\\\\\\\"target\\\\\\\", intent.target_entity_id),\\\\n151:                     params=item.get(\\\\\\\"action_spec\\\\\\\", {}).get(\\\\\\\"params\\\\\\\", {}),\\\\n152:                 )\\\\n153:                 options.append(PlanOption(\\\\n154:                     option_id=uuid.uuid4(),\\\\n155:                     action_type=item[\\\\\\\"action_type\\\\\\\"].upper(),\\\\n156:                     action_spec=spec,\\\\n157:                     stated_rationale=item.get(\\\\\\\"stated_rationale\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n158:                     estimated_side_effects=item.get(\\\\\\\"estimated_side_effects\\\\\\\", []),\\\\n159:                     reversible=item.get(\\\\\\\"reversible\\\\\\\", True),\\\\n160:                     payload_hash=\\\\\\\"sha256:\\\\\\\" + __import__(\\\\\\\"hashlib\\\\\\\").sha256(json.dumps(spec.model_dump(), sort_keys=True).encode()).hexdigest(),\\\\n161:                 ))\\\\n162: \\\\n163:         if options:\\\\n164:             emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_COMPLETE\\\\\\\",\\\\n165:                        {\\\\\\\"options_count\\\\\\\": len(options), \\\\\\\"path\\\\\\\": \\\\\\\"MODEL\\\\\\\"})\\\\n166:             _persist_options(session, intent, options)\\\\n167:             return options, GenerationPath.MODEL\\\\n168:     except Exception:\\\\n169:         pass\\\\n170: \\\\n171:     options, path = await adapter.generate_options(\\\\n172:         intent_class=intent.intent_class,\\\\n173:         target_entity_id=intent.target_entity_id,\\\\n174:         target_entity_class=intent.target_entity_class,\\\\n175:         context_summary=context_summary,\\\\n176:         n=n,\\\\n177:     )\\\\n178: \\\\n179:     if path == GenerationPath.MODEL:\\\\n180:         _persist_options(session, intent, options)\\\\n181: \\\\n182:     emit_event(session.trace_id, \\\\\\\"option_generator\\\\\\\", \\\\\\\"GENERATION_COMPLETE\\\\\\\",\\\\n183:                {\\\\\\\"options_count\\\\\\\": len(options), \\\\\\\"path\\\\\\\": path})\\\\n184:     return options, path\\\\n\\\\n(End of file - total 184 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76ejh_c9a8c7ebdbbe\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76ejh_c9a8c7ebdbbe\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_06_oCK92zf0I5AKRsjQlTgV2282\\\",\\\"duration_ms\\\":5,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Step 10a — Action spec validation before verdict submission.\\\\n\\\\nConverts a PlanOption into a single-node CompiledDAG for execution dispatch.\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom ..models.dag import DAGNode, CompiledDAG\\\\nfrom ..models.options import ActionSpec, PlanOption\\\\n\\\\n\\\\n_KNOWN_ACTION_TYPES = {\\\\n    \\\\\\\"READ_FILE\\\\\\\", \\\\\\\"WRITE_FILE\\\\\\\", \\\\\\\"DELETE_FILE\\\\\\\", \\\\\\\"LIST\\\\\\\",\\\\n    \\\\\\\"RUN_COMMAND\\\\\\\", \\\\\\\"RUN_SCRIPT\\\\\\\", \\\\\\\"DEPLOY\\\\\\\", \\\\\\\"ROLLBACK\\\\\\\",\\\\n    \\\\\\\"STAGE\\\\\\\", \\\\\\\"MUTATE\\\\\\\", \\\\\\\"BACKUP\\\\\\\", \\\\\\\"RESTORE\\\\\\\", \\\\\\\"PLAN\\\\\\\",\\\\n    \\\\\\\"ANALYZE\\\\\\\", \\\\\\\"ESCALATE\\\\\\\", \\\\\\\"QUERY\\\\\\\",\\\\n}\\\\n\\\\n\\\\nclass PlanCompilationError(Exception):\\\\n    pass\\\\n\\\\n\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"nexi/nexi/pipeline/plan_compiler.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/plan_compiler.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/plan_compiler.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 10a — Action spec validation before verdict submission.\\\\n2: \\\\n3: Converts a PlanOption into a single-node CompiledDAG for execution dispatch.\\\\n4: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n5: from ..models.dag import DAGNode, CompiledDAG\\\\n6: from ..models.options import ActionSpec, PlanOption\\\\n7: \\\\n8: \\\\n9: _KNOWN_ACTION_TYPES = {\\\\n10:     \\\\\\\"READ_FILE\\\\\\\", \\\\\\\"WRITE_FILE\\\\\\\", \\\\\\\"DELETE_FILE\\\\\\\", \\\\\\\"LIST\\\\\\\",\\\\n11:     \\\\\\\"RUN_COMMAND\\\\\\\", \\\\\\\"RUN_SCRIPT\\\\\\\", \\\\\\\"DEPLOY\\\\\\\", \\\\\\\"ROLLBACK\\\\\\\",\\\\n12:     \\\\\\\"STAGE\\\\\\\", \\\\\\\"MUTATE\\\\\\\", \\\\\\\"BACKUP\\\\\\\", \\\\\\\"RESTORE\\\\\\\", \\\\\\\"PLAN\\\\\\\",\\\\n13:     \\\\\\\"ANALYZE\\\\\\\", \\\\\\\"ESCALATE\\\\\\\", \\\\\\\"QUERY\\\\\\\",\\\\n14: }\\\\n15: \\\\n16: \\\\n17: class PlanCompilationError(Exception):\\\\n18:     pass\\\\n19: \\\\n20: \\\\n21: def compile_action_spec(opt: PlanOption) -> CompiledDAG:\\\\n22:     \\\\\\\"\\\\\\\"\\\\\\\"Validates the selected option and returns a single-node CompiledDAG.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n23:     spec = opt.action_spec\\\\n24: \\\\n25:     if not spec.type:\\\\n26:         raise PlanCompilationError(\\\\\\\"action_spec.type is required\\\\\\\")\\\\n27:     if not spec.target:\\\\n28:         raise PlanCompilationError(\\\\\\\"action_spec.target is required\\\\\\\")\\\\n29:     if spec.params is None:\\\\n30:         raise PlanCompilationError(\\\\\\\"action_spec.params must not be null\\\\\\\")\\\\n31: \\\\n32:     if spec.type.upper() not in _KNOWN_ACTION_TYPES:\\\\n33:         pass\\\\n34: \\\\n35:     node = DAGNode(\\\\n36:         node_id=str(opt.option_id),\\\\n37:         action_type=spec.type.upper(),\\\\n38:         target=spec.target,\\\\n39:         params=spec.params,\\\\n40:         depends_on=[],\\\\n41:     )\\\\n42:     return CompiledDAG(\\\\n43:         nodes=[node],\\\\n44:         edges=[],\\\\n45:         entry_node=node.node_id,\\\\n46:     )\\\\n\\\\n(End of file - total 46 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:58.395Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/plan_compiler.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/plan_compiler.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Step 10a — Action spec validation before verdict submission.\\\\n2: \\\\n3: Converts a PlanOption into a single-node CompiledDAG for execution dispatch.\\\\n4: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n5: from ..models.dag import DAGNode, CompiledDAG\\\\n6: from ..models.options import ActionSpec, PlanOption\\\\n7: \\\\n8: \\\\n9: _KNOWN_ACTION_TYPES = {\\\\n10:     \\\\\\\"READ_FILE\\\\\\\", \\\\\\\"WRITE_FILE\\\\\\\", \\\\\\\"DELETE_FILE\\\\\\\", \\\\\\\"LIST\\\\\\\",\\\\n11:     \\\\\\\"RUN_COMMAND\\\\\\\", \\\\\\\"RUN_SCRIPT\\\\\\\", \\\\\\\"DEPLOY\\\\\\\", \\\\\\\"ROLLBACK\\\\\\\",\\\\n12:     \\\\\\\"STAGE\\\\\\\", \\\\\\\"MUTATE\\\\\\\", \\\\\\\"BACKUP\\\\\\\", \\\\\\\"RESTORE\\\\\\\", \\\\\\\"PLAN\\\\\\\",\\\\n13:     \\\\\\\"ANALYZE\\\\\\\", \\\\\\\"ESCALATE\\\\\\\", \\\\\\\"QUERY\\\\\\\",\\\\n14: }\\\\n15: \\\\n16: \\\\n17: class PlanCompilationError(Exception):\\\\n18:     pass\\\\n19: \\\\n20: \\\\n21: def compile_action_spec(opt: PlanOption) -> CompiledDAG:\\\\n22:     \\\\\\\"\\\\\\\"\\\\\\\"Validates the selected option and returns a single-node CompiledDAG.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n23:     spec = opt.action_spec\\\\n24: \\\\n25:     if not spec.type:\\\\n26:         raise PlanCompilationError(\\\\\\\"action_spec.type is required\\\\\\\")\\\\n27:     if not spec.target:\\\\n28:         raise PlanCompilationError(\\\\\\\"action_spec.target is required\\\\\\\")\\\\n29:     if spec.params is None:\\\\n30:         raise PlanCompilationError(\\\\\\\"action_spec.params must not be null\\\\\\\")\\\\n31: \\\\n32:     if spec.type.upper() not in _KNOWN_ACTION_TYPES:\\\\n33:         pass\\\\n34: \\\\n35:     node = DAGNode(\\\\n36:         node_id=str(opt.option_id),\\\\n37:         action_type=spec.type.upper(),\\\\n38:         target=spec.target,\\\\n39:         params=spec.params,\\\\n40:         depends_on=[],\\\\n41:     )\\\\n42:     return CompiledDAG(\\\\n43:         nodes=[node],\\\\n44:         edges=[],\\\\n45:         entry_node=node.node_id,\\\\n46:     )\\\\n\\\\n(End of file - total 46 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76er1_6e162dfb4a84\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76er1_6e162dfb4a84\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_07_588i62ketWB1aBrxY42v7737\\\",\\\"duration_ms\\\":3,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"from __future__ import annotations\\\\n\\\\nfrom dataclasses import dataclass, field\\\\nfrom datetime import datetime, timezone\\\\nfrom typing import Any\\\\n\\\\nfrom nexi.character.prompt_loader import build_system_prompt\\\\n\\\\n\\\\n@dataclass\\\\nclass AssembledContext:\\\\n    system_prompt: str = \\\\\\\"\\\\\\\"\\\\n    recent_turns: list[dict] = field(default_factory=list)\\\\n    relevant_episodes: list[str] = field(default_factory=list)\\\\n    entity_context: list[dict] = field(default_factory=list)\\\\n    relationship_context: list[dict] = field(default_factory=list)\\\\n    perception_snippets: list[str] = field(default_factory=list)\\\\n\\\\n    def to_messages(self, raw_input: str) -> list[dict]:\\\\n        msgs = [{\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": self.system_prompt}]\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"nexi/nexi/pipeline/context_assembler.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/context_assembler.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/context_assembler.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: from __future__ import annotations\\\\n2: \\\\n3: from dataclasses import dataclass, field\\\\n4: from datetime import datetime, timezone\\\\n5: from typing import Any\\\\n6: \\\\n7: from nexi.character.prompt_loader import build_system_prompt\\\\n8: \\\\n9: \\\\n10: @dataclass\\\\n11: class AssembledContext:\\\\n12:     system_prompt: str = \\\\\\\"\\\\\\\"\\\\n13:     recent_turns: list[dict] = field(default_factory=list)\\\\n14:     relevant_episodes: list[str] = field(default_factory=list)\\\\n15:     entity_context: list[dict] = field(default_factory=list)\\\\n16:     relationship_context: list[dict] = field(default_factory=list)\\\\n17:     perception_snippets: list[str] = field(default_factory=list)\\\\n18: \\\\n19:     def to_messages(self, raw_input: str) -> list[dict]:\\\\n20:         msgs = [{\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": self.system_prompt}]\\\\n21:         for t in self.recent_turns:\\\\n22:             msgs.append({\\\\\\\"role\\\\\\\": t.get(\\\\\\\"role\\\\\\\", \\\\\\\"user\\\\\\\"), \\\\\\\"content\\\\\\\": t.get(\\\\\\\"content\\\\\\\", \\\\\\\"\\\\\\\")})\\\\n23:         msgs.append({\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": raw_input})\\\\n24:         return msgs\\\\n25: \\\\n26: \\\\n27: def _extract_entity_mentions(text: str) -> list[str]:\\\\n28:     import re\\\\n29:     matches = re.findall(r'\\\\\\\\b([A-Z][a-z]+(?: [A-Z][a-z]+)*)\\\\\\\\b', text)\\\\n30:     seen = set()\\\\n31:     entities = []\\\\n32:     for m in matches:\\\\n33:         if m.lower() not in seen and len(m) > 2:\\\\n34:             seen.add(m.lower())\\\\n35:             entities.append(m)\\\\n36:     return entities\\\\n37: \\\\n38: \\\\n39: async def assemble_context(\\\\n40:     session_id: str,\\\\n41:     raw_input: str,\\\\n42:     working_memory,\\\\n43:     pg_episodic,\\\\n44:     graph_store,\\\\n45:     relationship_store,\\\\n46:     sensory_buffer,\\\\n47:     proactivity_engine=None,\\\\n48: ) -> AssembledContext:\\\\n49:     ctx = AssembledContext()\\\\n50: \\\\n51:     recent_turns = await working_memory.get_turns(session_id, last_n=20)\\\\n52:     ctx.recent_turns = recent_turns\\\\n53: \\\\n54:     relevant = await pg_episodic.retrieve_similar(\\\\n55:         query_text=raw_input, top_k=5\\\\n56:     )\\\\n57:     ctx.relevant_episodes = [\\\\n58:         r.get(\\\\\\\"summary\\\\\\\") or r.get(\\\\\\\"raw_text\\\\\\\", \\\\\\\"\\\\\\\") for r in relevant\\\\n59:     ]\\\\n60: \\\\n61:     entities = _extract_entity_mentions(raw_input)\\\\n62:     if entities:\\\\n63:         for ent in entities:\\\\n64:             entity_node = graph_store.get_entity_by_name(ent)\\\\n65:             if entity_node:\\\\n66:                 eid = entity_node[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"entity_id\\\\\\\", ent)\\\\n67:                 connections = graph_store.query_entity_connections(eid)\\\\n68:                 ctx.entity_context.extend(connections)\\\\n69:                 rels = await relationship_store.get_relationships(eid)\\\\n70:                 ctx.relationship_context.extend(\\\\n71:                     {\\\\\\\"entity_a\\\\\\\": r.entity_a_id, \\\\\\\"entity_b\\\\\\\": r.entity_b_id,\\\\n72:                      \\\\\\\"type\\\\\\\": r.relationship_type, \\\\\\\"strength\\\\\\\": r.strength}\\\\n73:                     for r in rels\\\\n74:                 )\\\\n75: \\\\n76:     recent_perceptions = await sensory_buffer.read_recent(\\\\\\\"voice\\\\\\\", limit=3)\\\\n77:     ctx.perception_snippets = [p.get(\\\\\\\"data\\\\\\\", \\\\\\\"\\\\\\\") for p in recent_perceptions]\\\\n78: \\\\n79:     session_memories = ctx.relevant_episodes[:5]\\\\n80:     session_entities = [f\\\\\\\"{c.get('connected_name', '')} ({c.get('rel_type', '')})\\\\\\\" for c in ctx.entity_context[:5]]\\\\n81:     ctx.system_prompt = build_system_prompt(\\\\n82:         session_memory=[{\\\\\\\"summary\\\\\\\": s} for s in session_memories],\\\\n83:         recent_entities=session_entities,\\\\n84:     )\\\\n85: \\\\n86:     if proactivity_engine is not None:\\\\n87:         pending = await proactivity_engine.get_pending()\\\\n88:         if pending:\\\\n89:             obs_lines = \\\\\\\"\\\\\\\\n\\\\\\\".join(e.message for e in pending)\\\\n90:             ctx.system_prompt += f\\\\\\\"\\\\\\\\n\\\\\\\\n## Pending Observations\\\\\\\\n{obs_lines}\\\\\\\"\\\\n91: \\\\n92:     ts = datetime.now(timezone.utc).isoformat()\\\\n93:     ctx.system_prompt += f\\\\\\\"\\\\\\\\n\\\\\\\\nContext assembled at {ts}\\\\\\\"\\\\n94: \\\\n95:     return ctx\\\\n\\\\n(End of file - total 95 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:58.667Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/pipeline/context_assembler.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/pipeline/context_assembler.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: from __future__ import annotations\\\\n2: \\\\n3: from dataclasses import dataclass, field\\\\n4: from datetime import datetime, timezone\\\\n5: from typing import Any\\\\n6: \\\\n7: from nexi.character.prompt_loader import build_system_prompt\\\\n8: \\\\n9: \\\\n10: @dataclass\\\\n11: class AssembledContext:\\\\n12:     system_prompt: str = \\\\\\\"\\\\\\\"\\\\n13:     recent_turns: list[dict] = field(default_factory=list)\\\\n14:     relevant_episodes: list[str] = field(default_factory=list)\\\\n15:     entity_context: list[dict] = field(default_factory=list)\\\\n16:     relationship_context: list[dict] = field(default_factory=list)\\\\n17:     perception_snippets: list[str] = field(default_factory=list)\\\\n18: \\\\n19:     def to_messages(self, raw_input: str) -> list[dict]:\\\\n20:         msgs = [{\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": self.system_prompt}]\\\\n21:         for t in self.recent_turns:\\\\n22:             msgs.append({\\\\\\\"role\\\\\\\": t.get(\\\\\\\"role\\\\\\\", \\\\\\\"user\\\\\\\"), \\\\\\\"content\\\\\\\": t.get(\\\\\\\"content\\\\\\\", \\\\\\\"\\\\\\\")})\\\\n23:         msgs.append({\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": raw_input})\\\\n24:         return msgs\\\\n25: \\\\n26: \\\\n27: def _extract_entity_mentions(text: str) -> list[str]:\\\\n28:     import re\\\\n29:     matches = re.findall(r'\\\\\\\\b([A-Z][a-z]+(?: [A-Z][a-z]+)*)\\\\\\\\b', text)\\\\n30:     seen = set()\\\\n31:     entities = []\\\\n32:     for m in matches:\\\\n33:         if m.lower() not in seen and len(m) > 2:\\\\n34:             seen.add(m.lower())\\\\n35:             entities.append(m)\\\\n36:     return entities\\\\n37: \\\\n38: \\\\n39: async def assemble_context(\\\\n40:     session_id: str,\\\\n41:     raw_input: str,\\\\n42:     working_memory,\\\\n43:     pg_episodic,\\\\n44:     graph_store,\\\\n45:     relationship_store,\\\\n46:     sensory_buffer,\\\\n47:     proactivity_engine=None,\\\\n48: ) -> AssembledContext:\\\\n49:     ctx = AssembledContext()\\\\n50: \\\\n51:     recent_turns = await working_memory.get_turns(session_id, last_n=20)\\\\n52:     ctx.recent_turns = recent_turns\\\\n53: \\\\n54:     relevant = await pg_episodic.retrieve_similar(\\\\n55:         query_text=raw_input, top_k=5\\\\n56:     )\\\\n57:     ctx.relevant_episodes = [\\\\n58:         r.get(\\\\\\\"summary\\\\\\\") or r.get(\\\\\\\"raw_text\\\\\\\", \\\\\\\"\\\\\\\") for r in relevant\\\\n59:     ]\\\\n60: \\\\n61:     entities = _extract_entity_mentions(raw_input)\\\\n62:     if entities:\\\\n63:         for ent in entities:\\\\n64:             entity_node = graph_store.get_entity_by_name(ent)\\\\n65:             if entity_node:\\\\n66:                 eid = entity_node[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"entity_id\\\\\\\", ent)\\\\n67:                 connections = graph_store.query_entity_connections(eid)\\\\n68:                 ctx.entity_context.extend(connections)\\\\n69:                 rels = await relationship_store.get_relationships(eid)\\\\n70:                 ctx.relationship_context.extend(\\\\n71:                     {\\\\\\\"entity_a\\\\\\\": r.entity_a_id, \\\\\\\"entity_b\\\\\\\": r.entity_b_id,\\\\n72:                      \\\\\\\"type\\\\\\\": r.relationship_type, \\\\\\\"strength\\\\\\\": r.strength}\\\\n73:                     for r in rels\\\\n74:                 )\\\\n75: \\\\n76:     recent_perceptions = await sensory_buffer.read_recent(\\\\\\\"voice\\\\\\\", limit=3)\\\\n77:     ctx.perception_snippets = [p.get(\\\\\\\"data\\\\\\\", \\\\\\\"\\\\\\\") for p in recent_perceptions]\\\\n78: \\\\n79:     session_memories = ctx.relevant_episodes[:5]\\\\n80:     session_entities = [f\\\\\\\"{c.get('connected_name', '')} ({c.get('rel_type', '')})\\\\\\\" for c in ctx.entity_context[:5]]\\\\n81:     ctx.system_prompt = build_system_prompt(\\\\n82:         session_memory=[{\\\\\\\"summary\\\\\\\": s} for s in session_memories],\\\\n83:         recent_entities=session_entities,\\\\n84:     )\\\\n85: \\\\n86:     if proactivity_engine is not None:\\\\n87:         pending = await proactivity_engine.get_pending()\\\\n88:         if pending:\\\\n89:             obs_lines = \\\\\\\"\\\\\\\\n\\\\\\\".join(e.message for e in pending)\\\\n90:             ctx.system_prompt += f\\\\\\\"\\\\\\\\n\\\\\\\\n## Pending Observations\\\\\\\\n{obs_lines}\\\\\\\"\\\\n91: \\\\n92:     ts = datetime.now(timezone.utc).isoformat()\\\\n93:     ctx.system_prompt += f\\\\\\\"\\\\\\\\n\\\\\\\\nContext assembled at {ts}\\\\\\\"\\\\n94: \\\\n95:     return ctx\\\\n\\\\n(End of file - total 95 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76eyl_8b235e4c77b8\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76eyl_8b235e4c77b8\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_08_0ZDQX1m7ouTVgi0hpr7H6212\\\",\\\"duration_ms\\\":9,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"from __future__ import annotations\\\\n\\\\nfrom datetime import datetime, timezone\\\\nfrom pathlib import Path\\\\n\\\\nimport yaml\\\\n\\\\n\\\\n_CHARACTER_PATH = Path(__file__).parent / \\\\\\\"nexi_character.yaml\\\\\\\"\\\\n\\\\n\\\\ndef load_character() -> dict:\\\\n    with open(_CHARACTER_PATH) as f:\\\\n        return yaml.safe_load(f)\\\\n\\\\n\\\\ndef build_system_prompt(\\\\n    session_memory: list[dict] | None = None,\\\\n    recent_entities: list[str] | None = None,\\\\n) -> str:\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"nexi/nexi/character/prompt_loader.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/character/prompt_loader.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/character/prompt_loader.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: from __future__ import annotations\\\\n2: \\\\n3: from datetime import datetime, timezone\\\\n4: from pathlib import Path\\\\n5: \\\\n6: import yaml\\\\n7: \\\\n8: \\\\n9: _CHARACTER_PATH = Path(__file__).parent / \\\\\\\"nexi_character.yaml\\\\\\\"\\\\n10: \\\\n11: \\\\n12: def load_character() -> dict:\\\\n13:     with open(_CHARACTER_PATH) as f:\\\\n14:         return yaml.safe_load(f)\\\\n15: \\\\n16: \\\\n17: def build_system_prompt(\\\\n18:     session_memory: list[dict] | None = None,\\\\n19:     recent_entities: list[str] | None = None,\\\\n20: ) -> str:\\\\n21:     char = load_character()\\\\n22:     identity = char[\\\\\\\"identity\\\\\\\"]\\\\n23:     style = char[\\\\\\\"communication_style\\\\\\\"]\\\\n24:     now = datetime.now(timezone.utc).strftime(\\\\\\\"%Y-%m-%d %H:%M UTC\\\\\\\")\\\\n25: \\\\n26:     parts = [f\\\\\\\"You are {identity['name']}.\\\\\\\", identity[\\\\\\\"persona\\\\\\\"]]\\\\n27:     parts.append(\\\\\\\"\\\\\\\")\\\\n28:     parts.append(f\\\\\\\"You address the user as {identity['address_user_as']}.\\\\\\\")\\\\n29:     parts.append(f\\\\\\\"Communication: {style['verbosity']}, {style['tone']}.\\\\\\\")\\\\n30:     parts.append(f\\\\\\\"Current time: {now}\\\\\\\")\\\\n31:     parts.append(\\\\\\\"\\\\\\\")\\\\n32: \\\\n33:     if session_memory:\\\\n34:         parts.append(\\\\\\\"## Session Context\\\\\\\")\\\\n35:         for mem in session_memory[-5:]:\\\\n36:             summary = mem.get(\\\\\\\"summary\\\\\\\", mem.get(\\\\\\\"raw_text\\\\\\\", \\\\\\\"\\\\\\\"))\\\\n37:             parts.append(f\\\\\\\"- {summary}\\\\\\\")\\\\n38:         parts.append(\\\\\\\"\\\\\\\")\\\\n39: \\\\n40:     if recent_entities:\\\\n41:         parts.append(\\\\\\\"## Known Entities\\\\\\\")\\\\n42:         for ent in recent_entities:\\\\n43:             parts.append(f\\\\\\\"- {ent}\\\\\\\")\\\\n44:         parts.append(\\\\\\\"\\\\\\\")\\\\n45: \\\\n46:     return \\\\\\\"\\\\\\\\n\\\\\\\".join(parts)\\\\n47: \\\\n48: \\\\n49: def get_nexi_system_prompt() -> str:\\\\n50:     return build_system_prompt()\\\\n\\\\n(End of file - total 50 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:58.940Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/nexi/nexi/character/prompt_loader.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/nexi/nexi/character/prompt_loader.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: from __future_