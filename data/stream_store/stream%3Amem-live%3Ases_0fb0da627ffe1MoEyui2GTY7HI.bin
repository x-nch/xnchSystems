ttings.attention_screen_diff_threshold\\n21:         self._idle_timeout = idle_timeout_s or settings.attention_idle_timeout_s\\n22:         self._last_activity: float = time.time()\\n23: \\n24:     def touch(self) -> None:\\n25:         self._last_activity = time.time()\\n26: \\n27:     def evaluate(\\n28:         self,\\n29:         voice_transcript: str | None,\\n30:         silence_duration_s: float,\\n31:         screen_pixel_diff: float,\\n32:         file_saved: bool,\\n33:         **kwargs: Any,\\n34:     ) -> list[dict[str, Any]]:\\n35:         actions: list[dict[str, Any]] = []\\n36:         now = time.time()\\n37: \\n38:         # Rule 1: Voice transcript present + silence > threshold\\n39:         if voice_transcript and silence_duration_s > self._silence_threshold:\\n40:             self.touch()\\n41:             actions.append({\\n42:                 \\\"rule\\\": \\\"voice_transcript\\\",\\n43:                 \\\"action\\\": \\\"forward_to_gateway\\\",\\n44:                 \\\"payload\\\": {\\\"transcript\\\": voice_transcript},\\n45:             })\\n46: \\n47:         # Rule 2: Screen pixel diff > threshold\\n48:         if screen_pixel_diff > self._screen_diff_threshold:\\n49:             self.touch()\\n50:             actions.append({\\n51:                 \\\"rule\\\": \\\"screen_change\\\",\\n52:                 \\\"action\\\": \\\"encode_and_store_episode\\\",\\n53:                 \\\"payload\\\": {\\\"pixel_diff\\\": screen_pixel_diff, \\\"layer\\\": 2},\\n54:             })\\n55: \\n56:         # Rule 3: File saved in vault\\n57:         if file_saved:\\n58:             self.touch()\\n59:             actions.append({\\n60:                 \\\"rule\\\": \\\"vault_file_saved\\\",\\n61:                 \\\"action\\\": \\\"trigger_file_watcher\\\",\\n62:                 \\\"payload\\\": {},\\n63:             })\\n64: \\n65:         # Rule 4: User idle > timeout\\n66:         idle_duration = now - self._last_activity\\n67:         if idle_duration > self._idle_timeout:\\n68:             try:\\n69:                 loop = asyncio.get_running_loop()\\n70:             except RuntimeError:\\n71:                 pass\\n72:             else:\\n73:                 from ..jobs.consolidation import run_consolidation\\n74:                 task = asyncio.create_task(run_consolidation())\\n75:                 task.add_done_callback(lambda t: t.exception() and logger.error(\\\"consolidation failed: %s\\\", t.exception()))\\n76:             actions.append({\\n77:                 \\\"rule\\\": \\\"user_idle\\\",\\n78:                 \\\"action\\\": \\\"suppress_responses_and_consolidate\\\",\\n79:                 \\\"payload\\\": {\\\"idle_duration_s\\\": idle_duration},\\n80:             })\\n81: \\n82:         return actions\\n\\n(End of file - total 82 lines)\\n</content>\"},\"sessionId\":\"ses_0fae25260fferIk2T6UHXhI3mF\",\"timestamp\":\"2026-06-26T18:07:42.326Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/perception/attention_filter.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/perception/attention_filter.py</path>\\n<type>file</type>\\n<content>\\n1: import asyncio\\n2: import logging\\n3: import time\\n4: from typing import Any\\n5: \\n6: from ..config import settings\\n7: \\n8: \\n9: logger = logging.getLogger(__name__)\\n10: \\n11: \\n12: class AttentionFilter:\\n13:     def __init__(\\n14:         self,\\n15:         silence_threshold_s: float | None = None,\\n16:         screen_diff_threshold: float | None = None,\\n17:         idle_timeout_s: int | None = None,\\n18:     ) -> None:\\n19:         self._silence_threshold = silence_threshold_s or settings.attention_silence_threshold_s\\n20:         self._screen_diff_threshold = screen_diff_threshold or settings.attention_screen_diff_threshold\\n21:         self._idle_timeout = idle_timeout_s or settings.attention_idle_timeout_s\\n22:         self._last_activity: float = time.time()\\n23: \\n