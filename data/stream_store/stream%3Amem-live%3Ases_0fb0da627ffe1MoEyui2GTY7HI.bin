    return result\\\\n91: \\\\n92: \\\\n93: class PolicyEngine:\\\\n94:     def __init__(self, policy_set: PolicySet) -> None:\\\\n95:         self._rules = policy_set.rules\\\\n96: \\\\n97:     def evaluate(\\\\n98:         self,\\\\n99:         intent_class: str,\\\\n100:         action_type: str,\\\\n101:         entity_class: str,\\\\n102:         actor_role: str,\\\\n103:         actor_capabilities: list[str],\\\\n104:         action_spec: dict[str, Any],\\\\n105:         urgency: str = \\\\\\\"NORMAL\\\\\\\",\\\\n106:         reversible: bool = True,\\\\n107:     ) -> DryRunResult:\\\\n108:         ctx = {\\\\n109:             \\\\\\\"intent_class\\\\\\\": intent_class,\\\\n110:             \\\\\\\"action_type\\\\\\\": action_type,\\\\n111:             \\\\\\\"entity_class\\\\\\\": entity_class,\\\\n112:             \\\\\\\"actor_role\\\\\\\": actor_role,\\\\n113:             \\\\\\\"actor_capabilities\\\\\\\": actor_capabilities,\\\\n114:             \\\\\\\"urgency\\\\\\\": urgency,\\\\n115:             \\\\\\\"reversible\\\\\\\": reversible,\\\\n116:         }\\\\n117: \\\\n118:         for rule in self._rules:\\\\n119:             if not _matches(rule, ctx):\\\\n120:                 continue\\\\n121: \\\\n122:             verdict = rule.action.verdict\\\\n123: \\\\n124:             if verdict == PolicyVerdict.BLOCK:\\\\n125:                 return DryRunResult(verdict=verdict, policy_refs=[rule.rule_id])\\\\n126: \\\\n127:             if verdict == PolicyVerdict.MODIFY:\\\\n128:                 modified = _apply_modify(action_spec, rule.action.modify_spec or {})\\\\n129:                 return DryRunResult(\\\\n130:                     verdict=verdict,\\\\n131:                     policy_refs=[rule.rule_id],\\\\n132:                     modified_action_spec=modified,\\\\n133:                 )\\\\n134: \\\\n135:             if verdict == PolicyVerdict.DEFER:\\\\n136:                 return DryRunResult(\\\\n137:                     verdict=verdict,\\\\n138:                     policy_refs=[rule.rule_id],\\\\n139:                     requires_actor=rule.action.requires_actor,\\\\n140:                 )\\\\n141: \\\\n142:             if verdict == PolicyVerdict.ALLOW_WITH_WARNINGS:\\\\n143:                 return DryRunResult(\\\\n144:                     verdict=verdict,\\\\n145:                     policy_refs=[rule.rule_id],\\\\n146:                     warnings=rule.action.warnings,\\\\n147:                 )\\\\n148: \\\\n149:             # ALLOW\\\\n150:             return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[rule.rule_id])\\\\n151: \\\\n152:         # Default: no rule matched\\\\n153:         return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[\\\\\\\"default.allow\\\\\\\"])\\\\n154: \\\\n155:     def reload(self, policy_set: PolicySet) -> None:\\\\n156:         self._rules = policy_set.rules\\\\n\\\\n(End of file - total 156 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76zzk_7227531afccd\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76zzk_7227531afccd\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_03_JoOb0Hj06ktYXaMlgD6D4629\\\",\\\"duration_ms\\\":13,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Contract 1: YAML policy loader. Merges default + custom rule sets.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport logging\\\\nfrom dataclasses import dataclass, field\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\n\\\\nimport yaml\\\\n\\\\nlogger = logging.getLogger(__name__)\\\\n\\\\n\\\\n@dataclass\\\\nclass TimeWindow:\\\\n    days: list[str] = field(default_factory=list)\\\\n    hours_utc: str = \\\\\\\"\\\\\\\"\\\\n\\\\n\\\\n@dataclass\\\\nclass RuleConditions:\\\\n    intent_class: str | None = None\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/policy/loader.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Contract 1: YAML policy loader. Merges default + custom rule sets.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import logging\\\\n3: from dataclasses import dataclass, field\\\\n4: from pathlib import Path\\\\n5: from typing import Any\\\\n6: \\\\n7: import yaml\\\\n8: \\\\n9: logger = logging.getLogger(__name__)\\\\n10: \\\\n11: \\\\n12: @dataclass\\\\n13: class TimeWindow:\\\\n14:     days: list[str] = field(default_factory=list)\\\\n15:     hours_utc: str = \\\\\\\"\\\\\\\"\\\\n16: \\\\n17: \\\\n18: @dataclass\\\\n19: class RuleConditions:\\\\n20:     intent_class: str | None = None\\\\n21:     action_type: str | None = None\\\\n22:     entity_class: str | None = None\\\\n23:     actor_role: str | None = None\\\\n24:     actor_capabilities: list[str] = field(default_factory=list)\\\\n25:     urgency: str | None = None\\\\n26:     reversible: bool | None = None\\\\n27:     time_window: TimeWindow | None = None\\\\n28: \\\\n29: \\\\n30: @dataclass\\\\n31: class RuleAction:\\\\n32:     verdict: str\\\\n33:     reason: str\\\\n34:     warnings: list[str] = field(default_factory=list)\\\\n35:     modify_spec: dict[str, Any] | None = None\\\\n36:     requires_actor: str | None = None\\\\n37: \\\\n38: \\\\n39: @dataclass\\\\n40: class Rule:\\\\n41:     rule_id: str\\\\n42:     priority: int\\\\n43:     conditions: RuleConditions\\\\n44:     action: RuleAction\\\\n45:     source_file: str = \\\\\\\"\\\\\\\"\\\\n46: \\\\n47: \\\\n48: @dataclass\\\\n49: class PolicySet:\\\\n50:     rules: list[Rule] = field(default_factory=list)\\\\n51: \\\\n52: \\\\n53: def _parse_rule(raw: dict, source: str) -> Rule:\\\\n54:     cond_raw = raw.get(\\\\\\\"conditions\\\\\\\") or {}\\\\n55:     tw_raw = cond_raw.get(\\\\\\\"time_window\\\\\\\")\\\\n56:     conditions = RuleConditions(\\\\n57:         intent_class=cond_raw.get(\\\\\\\"intent_class\\\\\\\"),\\\\n58:         action_type=cond_raw.get(\\\\\\\"action_type\\\\\\\"),\\\\n59:         entity_class=cond_raw.get(\\\\\\\"entity_class\\\\\\\"),\\\\n60:         actor_role=cond_raw.get(\\\\\\\"actor_role\\\\\\\"),\\\\n61:         actor_capabilities=cond_raw.get(\\\\\\\"actor_capabilities\\\\\\\") or [],\\\\n62:         urgency=cond_raw.get(\\\\\\\"urgency\\\\\\\"),\\\\n63:         reversible=cond_raw.get(\\\\\\\"reversible\\\\\\\"),\\\\n64:         time_window=TimeWindow(\\\\n65:             days=tw_raw.get(\\\\\\\"days\\\\\\\", []),\\\\n66:             hours_utc=tw_raw.get(\\\\\\\"hours_utc\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n67:         ) if tw_raw else None,\\\\n68:     )\\\\n69:     act_raw = raw.get(\\\\\\\"action\\\\\\\", {})\\\\n70:     action = RuleAction(\\\\n71:         verdict=act_raw[\\\\\\\"verdict\\\\\\\"],\\\\n72:         reason=act_raw.get(\\\\\\\"reason\\\\\\\", \\\\\\\"\\\\\\\"),\\\\n73:         warnings=act_raw.get(\\\\\\\"warnings\\\\\\\") or [],\\\\n74:         modify_spec=act_raw.get(\\\\\\\"modify_spec\\\\\\\"),\\\\n75:         requires_actor=act_raw.get(\\\\\\\"requires_actor\\\\\\\"),\\\\n76:     )\\\\n77:     return Rule(\\\\n78:         rule_id=raw[\\\\\\\"rule_id\\\\\\\"],\\\\n79:         priority=raw[\\\\\\\"priority\\\\\\\"],\\\\n80:         conditions=conditions,\\\\n81:         action=action,\\\\n82:         source_file=source,\\\\n83:     )\\\\n84: \\\\n85: \\\\n86: def _load_file(path: Path) -> list[Rule]:\\\\n87:     if not path.exists():\\\\n88:         return []\\\\n89:     data = yaml.safe_load(path.read_text())\\\\n90:     rules = []\\\\n91:     for raw in (data or {}).get(\\\\\\\"rules\\\\\\\", []):\\\\n92:         try:\\\\n93:             rules.append(_parse_rule(raw, path.name))\\\\n94:         except Exception as exc:\\\\n95:             logger.warning(\\\\\\\"Skipping malformed rule in %s: %s\\\\\\\", path.name, exc)\\\\n96:     return rules\\\\n97: \\\\n98: \\\\n99: class PolicyLoader:\\\\n100:     def __init__(self, policies_dir: Path) -> None:\\\\n101:         self._dir = policies_dir\\\\n102: \\\\n103:     def load(self) -> PolicySet:\\\\n104:         default_rules = _load_file(self._dir / \\\\\\\"default.yaml\\\\\\\")\\\\n105:         custom_rules = _load_file(self._dir / \\\\\\\"custom.yaml\\\\\\\")\\\\n106:         all_rules = default_rules + custom_rules\\\\n107: \\\\n108:         # Warn on duplicate priorities (per Contract 1)\\\\n109:         seen: dict[int, str] = {}\\\\n110:         for r in all_rules:\\\\n111:             if r.priority in seen:\\\\n112:                 logger.warning(\\\\n113:                     \\\\\\\"Duplicate priority %d: rule '%s' and '%s'\\\\\\\",\\\\n114:                     r.priority, seen[r.priority], r.rule_id,\\\\n115:                 )\\\\n116:             else:\\\\n117:                 seen[r.priority] = r.rule_id\\\\n118: \\\\n119:         return PolicySet(rules=sorted(all_rules, key=lambda r: r.priority))\\\\n\\\\n(End of file - total 119 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:21:26.190Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Contract 1: YAML policy loader. Merges default + custom rule sets.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import logging\\\\n3: from dataclasses import dataclass, field\\\\n4: from pathlib import Path\\\\n5: from typing import Any\\\\n6: \\\\n7: import yaml\\\\n8: \\\\n9: logger = logging.getLogger(__name__)\\\\n10: \\\\n11: \\\\n12: @dataclass\\\\n13: class TimeWindow:\\\\n14:     days: list[str] = field(default_factory=list)\\\\n15:     hours_utc: str = \\\\\\\"\\\\\\\"\\\\n16: \\\\n17: \\\\n18: @dataclass\\\\n19: class RuleC