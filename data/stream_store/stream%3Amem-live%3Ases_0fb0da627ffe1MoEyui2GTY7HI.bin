et(\"entity_class\"),\n60:         actor_role=cond_raw.get(\"actor_role\"),\n61:         actor_capabilities=cond_raw.get(\"actor_capabilities\") or [],\n62:         urgency=cond_raw.get(\"urgency\"),\n63:         reversible=cond_raw.get(\"reversible\"),\n64:         time_window=TimeWindow(\n65:             days=tw_raw.get(\"days\", []),\n66:             hours_utc=tw_raw.get(\"hours_utc\", \"\"),\n67:         ) if tw_raw else None,\n68:     )\n69:     act_raw = raw.get(\"action\", {})\n70:     action = RuleAction(\n71:         verdict=act_raw[\"verdict\"],\n72:         reason=act_raw.get(\"reason\", \"\"),\n73:         warnings=act_raw.get(\"warnings\") or [],\n74:         modify_spec=act_raw.get(\"modify_spec\"),\n75:         requires_actor=act_raw.get(\"requires_actor\"),\n76:     )\n77:     return Rule(\n78:         rule_id=raw[\"rule_id\"],\n79:         priority=raw[\"priority\"],\n80:         conditions=conditions,\n81:         action=action,\n82:         source_file=source,\n83:     )\n84: \n85: \n86: def _load_file(path: Path) -> list[Rule]:\n87:     if not path.exists():\n88:         return []\n89:     data = yaml.safe_load(path.read_text())\n90:     rules = []\n91:     for raw in (data or {}).get(\"rules\", []):\n92:         try:\n93:             rules.append(_parse_rule(raw, path.name))\n94:         except Exception as exc:\n95:             logger.warning(\"Skipping malformed rule in %s: %s\", path.name, exc)\n96:     return rules\n97: \n98: \n99: class PolicyLoader:\n100:     def __init__(self, policies_dir: Path) -> None:\n101:         self._dir = policies_dir\n102: \n103:     def load(self) -> PolicySet:\n104:         default_rules = _load_file(self._dir / \"default.yaml\")\n105:         custom_rules = _load_file(self._dir / \"custom.yaml\")\n106:         all_rules = default_rules + custom_rules\n107: \n108:         # Warn on duplicate priorities (per Contract 1)\n109:         seen: dict[int, str] = {}\n110:         for r in all_rules:\n111:             if r.priority in seen:\n112:                 logger.warning(\n113:                     \"Duplicate priority %d: rule '%s' and '%s'\",\n114:                     r.priority, seen[r.priority], r.rule_id,\n115:                 )\n116:             else:\n117:                 seen[r.priority] = r.rule_id\n118: \n119:         return PolicySet(rules=sorted(all_rules, key=lambda r: r.priority))\n\n(End of file - total 119 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:26.190Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/policy/loader.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Contract 1: YAML policy loader. Merges default + custom rule sets.\"\"\"\n2: import logging\n3: from dataclasses import dataclass, field\n4: from pathlib import Path\n5: from typing import Any\n6: \n7: import yaml\n8: \n9: logger = logging.getLogger(__name__)\n10: \n11: \n12: @dataclass\n13: class TimeWindow:\n14:     days: list[str] = field(default_factory=list)\n15:     hours_utc: str = \"\"\n16: \n17: \n18: @dataclass\n19: class RuleConditions:\n20:     intent_class: str | None = None\n21:     action_type: str | None = None\n22:     entity_class: str | None = None\n23:     actor_role: str | None = None\n24:     actor_capabilities: list[str] = field(default_factory=list)\n25:     urgency: str | None = None\n26:     reversible: bool | None = None\n27:     time_window: TimeWindow | None = None\n28: \n29: \n30: @dataclass\n31: class RuleAction:\n32:     verdict: str\n33:     reason: str\n34:     warnings: list[str] = field(default_factory=list)\n35:     modify_spec: dict[str, Any] | None = None\n36:     requires_actor: str | None = None\n37: \n38: \n39: @dataclass\n40: class Rule:\n41:     rule_id: str\n42:     priority: int\n43:     conditions: RuleConditions\n44:     action: RuleAction\n45:     source_file: str = \"\"\n46: \n47: \n48: @d