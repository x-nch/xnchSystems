               \\\"last_recalled\\\": r[\\\"metadata\\\"].get(\\\"last_recalled\\\", None),\\n73:                     \\\"decay_score\\\": float(r[\\\"metadata\\\"].get(\\\"decay_score\\\", 1.0)),\\n74:                     \\\"archived\\\": r[\\\"metadata\\\"].get(\\\"archived\\\", \\\"False\\\") == \\\"True\\\",\\n75:                     \\\"similarity\\\": 1.0,\\n76:                 }\\n77:                 for r in sorted(memories, key=lambda m: m.get(\\\"metadata\\\", {}).get(\\\"created_at\\\", \\\"\\\"), reverse=True)[:top_k]\\n78:             ]\\n79:         search_query = query_text or ''\\n80:         results = search_memory(CATEGORY, search_query, n_results=top_k, filter_metadata={\\\"archived\\\": \\\"False\\\"})\\n81:         processed = []\\n82:         for r in results:\\n83:             dist = r.get(\\\"distance\\\", 1.0)\\n84:             sim = 1.0 - dist\\n85:             if sim < min_score:\\n86:                 continue\\n87:             processed.append({\\n88:                 \\\"id\\\": r[\\\"id\\\"],\\n89:                 \\\"timestamp\\\": r[\\\"metadata\\\"].get(\\\"timestamp\\\", \\\"\\\"),\\n90:                 \\\"type\\\": r[\\\"metadata\\\"].get(\\\"type\\\", \\\"\\\"),\\n91:                 \\\"raw_text\\\": r[\\\"metadata\\\"].get(\\\"raw_text\\\", \\\"\\\"),\\n92:                 \\\"summary\\\": r[\\\"metadata\\\"].get(\\\"summary\\\", \\\"\\\"),\\n93:                 \\\"embedding\\\": r.get(\\\"embedding\\\"),\\n94:                 \\\"importance\\\": float(r[\\\"metadata\\\"].get(\\\"importance\\\", 1.0)),\\n95:                 \\\"recall_count\\\": int(r[\\\"metadata\\\"].get(\\\"recall_count\\\", 0)),\\n96:                 \\\"last_recalled\\\": r[\\\"metadata\\\"].get(\\\"last_recalled\\\", None),\\n97:                 \\\"decay_score\\\": float(r[\\\"metadata\\\"].get(\\\"decay_score\\\", 1.0)),\\n98:                 \\\"archived\\\": r[\\\"metadata\\\"].get(\\\"archived\\\", \\\"False\\\") == \\\"True\\\",\\n99:                 \\\"similarity\\\": sim,\\n100:             })\\n101:         return processed\\n102: \\n103:     async def bump_recall(self, id: str) -> None:\\n104:         mem = self._get_memory_by_id(id)\\n105:         if not mem:\\n106:             return\\n107:         meta = dict(mem[\\\"metadata\\\"])\\n108:         rc = int(meta.get(\\\"recall_count\\\", 0)) + 1\\n109:         meta[\\\"recall_count\\\"] = str(rc)\\n110:         meta[\\\"last_recalled\\\"] = datetime.now(timezone.utc).isoformat()\\n111:         update_memory(CATEGORY, id, metadata=meta)\\n112: \\n113:     async def list_recent(self, hours: int = 24) -> list[dict[str, Any]]:\\n114:         cutoff = datetime.now(timezone.utc) - timedelta(hours=hours)\\n115:         all_mem = get_memories(CATEGORY, n_results=5000)\\n116:         results = []\\n117:         for r in all_mem:\\n118:             ts_str = r[\\\"metadata\\\"].get(\\\"timestamp\\\", \\\"\\\")\\n119:             try:\\n120:                 ts = datetime.fromisoformat(ts_str)\\n121:             except Exception:\\n122:                 continue\\n123:             if ts < cutoff:\\n124:                 continue\\n125:             results.append({\\n126:                 \\\"id\\\": r[\\\"id\\\"],\\n127:                 \\\"timestamp\\\": ts_str,\\n128:                 \\\"type\\\": r[\\\"metadata\\\"].get(\\\"type\\\", \\\"\\\"),\\n129:                 \\\"raw_text\\\": r[\\\"metadata\\\"].get(\\\"raw_text\\\", \\\"\\\"),\\n130:                 \\\"summary\\\": r[\\\"metadata\\\"].get(\\\"summary\\\", \\\"\\\"),\\n131:                 \\\"importance\\\": float(r[\\\"metadata\\\"].get(\\\"importance\\\", 1.0)),\\n132:                 \\\"recall_count\\\": int(r[\\\"metadata\\\"].get(\\\"recall_count\\\", 0)),\\n133:                 \\\"last_recalled\\\": r[\\\"metadata\\\"].get(\\\"last_recalled\\\", None),\\n134:                 \\\"decay_score\\\": float(r[\\\"metadata\\\"].get(\\\"decay_score\\\", 1.0)),\\n135:                 \\\"archived\\\": r[\\\"metadata\\\"].get(\\\"archived\\\", \\\"False\\\") == \\\"True\\\",\\n136:             })\\n137:         results.sort(key=lambda x: x[\\\"timestamp\\\"], reverse=True)\\n138:         return results\\n139: \\n140:     async def execute(self, query: str, *args: Any) -> str:\\n141:         for arg in args:\\n142:             pass\\n143:         if \\\"archived = TRUE\\\" in query or \\\"decay_score <\\\" in query:\\n144:             pass\\n145:         return \\\"OK\\\"\\n146: \\n147:     async def fetchval(self, query: str, *args: Any) -> Any:\\n148:         if \\\"COUNT\\\" in query:\\n149:             return len(get_memories(CATEGORY, n_results=5000))\\n150:         return None\\n151: \\n152:     def _get_memory_by_id(self, id: str) -> dict | None:\\n153:         all_mem = get_memories(CATEGORY, n_results=5000)\\n154:         for m in all_mem:\\n155:             if m[\\\"id\\\"] == id:\\n156:                 return m\\n157:         return None\\n158: \\n159:     async def store_decision_episode(\\n160:         self,\\n161:         decision_id: str,\\n162:         intent_class: str,\\n163:         action_type: str,\\n164:         entity_class: str,\\n165:         actor_role: str,\\n166:         context_snapshot: dict[str, Any] | None = None,\\n167:         scores_json: str | None = None,\\n168:         generation_path: str = \\\"MODEL\\\",\\n169:     ) -> uuid.UUID | str:\\n170:         if self._pool:\\n171:             async with self._pool.acquire() as conn:\\n172:                 row = await conn.fetchrow(\\n173:                     \\\"\\\"\\\"INSERT INTO decision_episodes\\n174:                        (decision_id, intent_class, action_type, entity_class, actor_role,\\n175:                         context_snapshot, scores_json, generation_path)\\n176:                        VALUES ($1::uuid, $2, $3, $4, $5, $6::jsonb, $7, $8)\\n177:                        RETURNING episode_id\\\"\\\"\\\",\\n178:                     str(decision_id), intent_class, action_type, entity_class, actor_role,\\n179:                     json.dumps(context_snapshot) if context_snapshot else None,\\n180:                     scores_json, generation_path,\\n181:                 )\\n182:                 return row[\\\"episode_id\"},\"type\":\"raw\"},\"obs_mqv762z5_2f9d6bca649c\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv762z5_2f9d6bca649c\",\"raw\":{\"attachments\":[],\"call_id\":\"call_04_pAqAmeLpSzPcEhSPh3sK1856\",\"duration_ms\":5,\"metadata\":{\"loaded\":[],\"preview\":\"\\\"\\\"\\\"Semantic graph store — Layer 3 memory backed by agentmemory categories.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom agentmemory import create_memory, search_memory, get_memories, update_memory\\n\\n\\nENTITIES_CATEGORY = \\\"entities\\\"\\nRELATIONS_CATEGORY = \\\"relations\\\"\\n\\n\\nclass GraphStore:\\n    def __init__(\\n        self,\\n        db_path: Path | None = None,\\n        relationship_store: Any | None = None,\\n    ) -> None:\",\"truncated\":false},\"title\":\"xnch/xnch/memory/graph_store.py\",\"tool_input\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/memory/graph_store.py\\\"}\",\"tool_name\":\"read\",\"tool_output\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/graph_store.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Semantic graph store — Layer 3 memory backed by agentmemory categories.\\\"\\\"\\\"\\n2: \\n3: from __future__ import annotations\\n4: \\n5: from pathlib import Path\\n6: from typing import Any\\n7: \\n8: from agentmemory import create_memory, search_memory, get_memories, update_memory\\n9: \\n10: \\n11: ENTITIES_CATEGORY = \\\"entities\\\"\\n12: RELATIONS_CATEGORY = \\\"relations\\\"\\n13: \\n14: \\n15: class GraphStore:\\n16:     def __init__(\\n17:         self,\\n18:         db_path: Path | None = None,\\n19:         relationship_store: Any | None = None,\\n20:     ) -> None:\\n21:         self._path = db_path\\n22:         self._relationship_store = relationship_store\\n23: \\n24:     def connect(self) -> None:\\n25:         pass\\n26: \\n27:     def close(self) -> None:\\n28:         pass\\n29: \\n30:     def upsert_entity(self, id: str, name: str, type_: str) -> None:\\n31:         existing = search_memory(ENTITIES_CATEGORY, name, n_results=5)\\n32:         match = next(\\n33:             (e for e in existing if e[\\\"metadata\\\"].get(\\\"entity_id\\\") == id),\\n34:             None,\\n35:         )\\n36:         if match:\\n37:             update_memory(\\n38:                 ENTITIES_CATEGORY, match[\\\"id\\\"],\\n39:                 metadata={\\\"entity_id\\\": id, \\\"name\\\": name, \\\"type\\\": type_},\\n40:             )\\n41:         else:\\n42:             create_memory(\\n43:                 ENTITIES_CATEGORY, name,\\n44:                 id=id,\\n45:                 metadata={\\\"entity_id\\\": id, \\\"name\\\": name, \\\"type\\\": type_},\\n46:             )\\n47: \\n48:     def upsert_relation(\\n49:         self,\\n50:         from_id: str,\\n51:         to_id: str,\\n52:         rel_type: str,\\n53:         confidence: float,\\n54:     ) -> None:\\n55:         rel_text = f\\\"{from_id} {rel_type} {to_id}\\\"\\n56:         create_memory(\\n57:             RELATIONS_CATEGORY, rel_text,\\n58:             metadata={\\n59:                 \\\"from_id\\\": from_id, \\\"to_id\\\": to_id,\\n60:                 \\\"rel_type\\\": rel_type, \\\"confidence\\\": str(confidence),\\n61:             },\\n62:         )\\n63:         if self._relationship_store is not None:\\n64:             import asyncio\\n65:             try:\\n66:                 asyncio.get_running_loop().create_task(\\n67:                     self._relationship_store.upsert_relationship(\\n68:                         entity_a=from_id,\\n69:                         entity_b=to_id,\\n70:                         rel_type=rel_type,\\n71:                         evidence=f\\\"confidence={confidence}\\\",\\n72:                         strength=confidence,\\n73:                     )\\n74:                 )\\n75:             except RuntimeError:\\n76:                 pass\\n77: \\n78:     def query_entity_connections(self, entity_id: str) -> list[dict[str, Any]]:\\n79:         all_rel = get_memories(RELATIONS_CATEGORY, n_results=5000)\\n80:         rows = []\\n81:         for r in all_rel:\\n82:             meta = r[\\\"metadata\\\"]\\n83:             if meta.get(\\\"from_id\\\") == entity_id or meta.get(\\\"to_id\\\") == entity_id:\\n84:                 other_id = meta[\\\"to_id\\\"] if meta[\\\"from_id\\\"] == entity_id else meta[\\\"from_id\\\"]\\n85:                 entity = self._get_entity_direct(other_id)\\n86:                 rows.append({\\n87:                     \\\"connected_id\\\": other_id,\\n88:                     \\\"connected_name\\\": entity[\\\"metadata\\\"].get(\\\"name\\\", other_id) if entity else other_id,\\n89:                     \\\"connected_type\\\": entity[\\\"metadata\\\"].get(\\\"type\\\", \\\"\\\") if entity else \\\"\\\",\\n90:                     \\\"rel_type\\\": meta.get(\\\"rel_type\\\", \\\"\\\"),\\n91:                     \\\"confidence\\\": float(meta.get(\\\"confidence\\\", 0.0)),\\n92:                 })\\n93:         return rows\\n94: \\n95:     def get_entity_by_name(self, name: str) -> dict[str, Any] | None:\\n96:         results = search_memory(ENTITIES_CATEGORY, name, n_results=3)\\n97:         for r in results:\\n98:             if r[\\\"document\\\"].lower() == name.lower():\\n99:                 return r\\n100:         return results[0] if results else None\\n101: \\n102:     def _get_entity_direct(self, entity_id: str) -> dict | None:\\n103:         results = get_memories(ENTITIES_CATEGORY, filter_metadata={\\\"entity_id\\\": entity_id}, n_results=1)\\n104:         return results[0] if results else None\\n\\n(End of file - total 104 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timesta