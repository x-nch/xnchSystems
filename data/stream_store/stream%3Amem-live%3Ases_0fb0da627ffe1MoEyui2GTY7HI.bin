(redis.delete(SYSTEM_PROMPT_CACHE_KEY))\\\\n    except Exception:\\\\n        logger.warning(\\\\\\\"Failed to invalidate system prompt cache\\\\\\\", exc_info=True)\\\",\\\"newString\\\":\\\"    return app._nexi_proactivity\\\\n\\\\n\\\\nasync def _safe_redis_delete(redis, key: str) -> None:\\\\n    try:\\\\n        await redis.delete(key)\\\\n    except Exception as exc:\\\\n        logger.warning(\\\\\\\"Redis delete failed for key %s: %s\\\\\\\", key, exc)\\\\n\\\\n\\\\ndef _invalidate_system_prompt_cache(app) -> None:\\\\n    redis = app.kv_cache.redis_client\\\\n    import asyncio\\\\n    asyncio.ensure_future(_safe_redis_delete(redis, SYSTEM_PROMPT_CACHE_KEY))\\\"}\",\"toolName\":\"edit\",\"toolOutput\":\"Edit applied successfully.\"},\"type\":\"raw\"},\"obs_mqv8vb3k_4d84f0b4871d\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv8vb3k_4d84f0b4871d\",\"raw\":{\"attachments\":[],\"call_id\":\"call_00_bKet6w2NalXyshTEt7ib7075\",\"duration_ms\":1,\"metadata\":{\"diagnostics\":{},\"diff\":\"Index: /Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\n===================================================================\\n--- /Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\n+++ /Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\n@@ -60,9 +60,9 @@\\n \\n @router.get(\\\"/system-prompt\\\", response_class=PlainTextResponse)\\n async def get_system_prompt(request: Request) -> str:\\n     app = request.app.state\\n-    redis = app.kv_cache._redis\\n+    redis = app.kv_cache.redis_client\\n \\n     cached = await redis.get(SYSTEM_PROMPT_CACHE_KEY)\\n     if cached:\\n         return cached\\n\",\"filediff\":{\"additions\":1,\"deletions\":1,\"file\":\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\",\"patch\":\"Index: /Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\n===================================================================\\n--- /Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\n+++ /Users/xnch/xn