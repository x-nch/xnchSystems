hments":[],"call_id":"call_00_tMouIuwSQOtYRcGSB9tE8041","duration_ms":11,"metadata":{"loaded":[],"preview":"\"\"\"Contract 2: RS256 execution token issuance and jti replay protection.\"\"\"\nimport time\nfrom dataclasses import dataclass, field\nfrom uuid import UUID, uuid4\n\nimport jwt\n\nfrom ..config import settings\nfrom xnch.security.trust_model import TrustLevel, get_trust_level\n\n\n_TOKEN_TTL_BY_TRUST: dict[TrustLevel, int] = {\n    TrustLevel.SYSTEM: 7 * 86400,\n    TrustLevel.OWNER: 86400,\n    TrustLevel.TRUSTED_AGENT: 3600,\n    TrustLevel.EXTERNAL_AGENT: 1800,\n    TrustLevel.UNTRUSTED: 0,\n}\n\n","truncated":false},"title":"xnch/xnch/auth/token.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/auth/token.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/token.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Contract 2: RS256 execution token issuance and jti replay protection.\"\"\"\n2: import time\n3: from dataclasses import dataclass, field\n4: from uuid import UUID, uuid4\n5: \n6: import jwt\n7: \n8: from ..config import settings\n9: from xnch.security.trust_model import TrustLevel, get_trust_level\n10: \n11: \n12: _TOKEN_TTL_BY_TRUST: dict[TrustLevel, int] = {\n13:     TrustLevel.SYSTEM: 7 * 86400,\n14:     TrustLevel.OWNER: 86400,\n15:     TrustLevel.TRUSTED_AGENT: 3600,\n16:     TrustLevel.EXTERNAL_AGENT: 1800,\n17:     TrustLevel.UNTRUSTED: 0,\n18: }\n19: \n20: \n21: @dataclass\n22: class ExecutionTokenClaims:\n23:     session_id: UUID\n24:     decision_id: UUID\n25:     trace_id: UUID\n26:     actor_id: str\n27:     actor_role: str\n28:     action_type: str\n29:     entity_class: str\n30:     policy_version: str\n31:     system_state_version: str\n32: \n33: \n34: class _JtiSeenSet:\n35:     \"\"\"In-process replay protection. TTL-evicts entries after their exp passes.\"\"\"\n36: \n37:     def __init__(self) -> None:\n38:         self._seen: dict[str, float] = {}  # jti → exp unix-seconds\n39: \n40:     def consume(self, jti: str, exp: float) -> bool:\n41:         \"\"\"Return True if jti is new (not replayed). Always adds to seen-set on first call.\"\"\"\n42:         self._evict()\n43:         if jti in self._seen:\n44:             return False\n45:         self._seen[jti] = exp\n46:         return True\n47: \n48:     def _evict(self) -> None:\n49:         now = time.time()\n50:         stale = [k for k, exp in self._seen.items() if exp < now]\n51:         for k in stale:\n52:             del self._seen[k]\n53: \n54: \n55: class TokenSigner:\n56:     def __init__(self, private_pem: bytes) -> None:\n57:         self._private_pem = private_pem\n58: \n59:     def issue(self, claims: ExecutionTokenClaims) -> tuple[str, int]:\n60:         \"\"\"Issue a signed RS256 execution token. Returns (token, ttl_ms).\"\"\"\n61:         now = int(time.time())\n62:         trust_level = get_trust_level(claims.actor_role)\n63:         ttl_s = _TOKEN_TTL_BY_TRUST.get(trust_level, 3600)\n64:         ttl_ms = ttl_s * 1000\n65:         payload = {\n66:             \"iss\": \"xnch\",\n67:             \"sub\": \"execution_token\",\n68:             \"jti\": str(uuid4()),\n69:             \"iat\": now,\n70:             \"exp\": now + ttl_s,\n71:             \"role\": claims.actor_role,\n72:             \"session_id\": str(claims.session_id),\n73:             \"decision_id\": str(claims.decision_id),\n74:             \"trace_id\": str(claims.trace_id),\n75:             \"actor_id\": claims.actor_id,\n76:             \"actor_role\": claims.actor_role,\n77:             \"action_type\": claims.action_type,\n78:             \"entity_class\": claims.entity_class,\n79:             \"policy_version\": claims.policy_version,\n80:             \"system_state_version\": claims.system_state_version,\n81:             \"token_ttl_ms\": ttl_ms,\n82:             \"trust_level\": trust_level.name,\n83:         }\n84:         token = jwt.encode(payload, self._private_pem, algorithm=\"RS256\")\n85:         return token, ttl_ms\n86: \n87: \n88: class TokenVerifier:\n89:     \"\"\"Verifies incoming auth tokens (HS256, shared secret) for xnch API callers.\"\"\"\n90: \n91:     def __init__(self, secret: str) -> None:\n92:         self._secret = secret\n93:         self._jti_seen = _JtiSeenSet()\n94: \n95:     def verify_bearer(self, authorization: str) -> str | None:\n96:         \"\"\"Extract and verify actor_id from Authorization header.\n97: \n98:         v0 accepts two formats:\n99:           - 'actor:<actor_id>'  — plain actor reference (dev only)\n100:           - 'Bearer <hs256-jwt>' — HS256 token with 'sub' = actor_id\n101:         \"\"\"\n102:         if not authorization:\n103:             return None\n104: \n105:         if authorization.startswith(\"actor:\"):\n106:             return authorization[len(\"actor:\"):]\n107: \n108:         [REDACTED_SECRET](\"Bearer \").strip()\n109:         try:\n110:             payload = jwt.decode(token, self._secret, algorithms=[\"HS256\"])\n111:             return payload.get(\"sub\")\n112:         except jwt.PyJWTError:\n113:             return None\n\n(End of file - total 113 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:25.335Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/auth/token.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/token.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Contract 2: RS256 execution token issuance and jti replay protection.\"\"\"\n2: import time\n3: from dataclasses import dataclass, field\n4: from uuid import UUID, uuid4\n5: \n6: import jwt\n7: \n8: from ..config import settings\n9: from xnch.security.trust_model import TrustLevel, get_trust_level\n10: \n11: \n12: _TOKEN_TTL_BY_TRUST: dict[TrustLevel, int] = {\n13:     TrustLevel.SYSTEM: 7 * 86400,\n14:     TrustLevel.OWNER: 86400,\n15:     TrustLevel.TRUSTED_AGENT: 3600,\n16:     TrustLevel.EXTERNAL_AGENT: 1800,\n17:     TrustLevel.UNTRUSTED: 0,\n18: }\n19: \n20: \n21: @dataclass\n22: class ExecutionTokenClaims:\n23:     session_id: UUID\n24:     decision_id: UUID\n25:     trace_id: UUID\n26:     actor_id: str\n27:     actor_role: str\n28:     action_type: str\n29:     entity_class: str\n30:     policy_version: str\n31:     system_state_version: str\n32: \n33: \n34: class _JtiSeenSet:\n35:     \"\"\"In-process replay protection. TTL-evicts entries after their exp passes.\"\"\"\n36: \n37:     def __init__(self) -> None:\n38:         self._seen: dict[str, float] = {}  # jti → exp unix-seconds\n39: \n40:     def consume(self, jti: str, exp: float) -> bool:\n41:         \"\"\"Return True if jti is new (not replayed). Always adds to seen-set on first call.\"\"\"\n42:         self._evict()\n43:         if jti in self._seen:\n44:             return False\n45:         self._seen[jti] = exp\n46:         return True\n47: \n48:     def _evict(self) -> None:\n49:         now = time.time()\n50:         stale = [k for k, exp in self._seen.items() if exp < now]\n51:         for k in stale:\n52:             del self._seen[k]\n53: \n54: \n55: class TokenSigner:\n56:     def __init__(self, private_pem: bytes) -> None:\n57:         self._private_pem = private_pem\n58: \n59:     def issue(self, claims: ExecutionTokenClaims) -> tuple[str, int]:\n60:         \"\"\"Issue a signed RS256 execution token. Returns (token, ttl_ms).\"\"\"\n61:         now = int(time.time())\n62:         trust_level = get_trust_level(claims.actor_role)\n63:         ttl_s = _TOKEN_TTL_BY_TRUST.get(trust_level, 3600)\n64:         ttl_ms = ttl_s * 1000\n65:         payload = {\n66:             \"iss\": \"xnch\",\n67:             \"sub\": \"execution_token\",\n68:             \"jti\": str(uuid4()),\n69:             \"iat\": now,\n70:             \"exp\": now + ttl_s,\n71:             \"role\": claims.actor_role,\n72:             \"session_id\": str(claims.session_id),\n73:             \"decision_id\": str(claims.decision_id),\n74:             \"trace_id\": str(claims.trace_id),\n75:             \"actor_id\": claims.actor_id,\n76:             \"actor_role\": claims.actor_role,\n77:             \"action_type\": claims.action_type,\n78:             \"entity_class\": claims.entity_class,\n79:             \"policy_version\": claims.policy_version,\n80:             \"system_state_version\": claims.system_state_version,\n81:             \"token_ttl_ms\": ttl_ms,\n82:             \"trust_level\": trust_level.name,\n83:         }\n84:         token = jwt.encode(payload, self._private_pem, algorithm=\"RS256\")\n85:         return token, ttl_ms\n86: \n87: \n88: class TokenVerifier:\n89:     \"\"\"Verifies incoming auth tokens (HS256, shared secret) for xnch API callers.\"\"\"\n90: \n91:     def __init__(self, secret: str) -> None:\n92:         self._secret = secret\n93:         self._jti_seen = _JtiSeenSet()\n94: \n95:     def verify_bearer(self, authorization: str) -> str | None:\n96:         \"\"\"Extract and verify actor_id from Authorization header.\n97: \n98:         v0 accepts two formats:\n99:           - 'actor:<actor_id>'  — plain actor reference (dev only)\n100:           - 'Bearer <hs256-jwt>' — HS256 token with 'sub' = actor_id\n101:         \"\"\"\n102:         if not authorization:\n103:             return None\n104: \n105:         if authorization.startswith(\"actor:\"):\n106:             return authorization[len(\"actor:\"):]\n107: \n108:         [REDACTED_SECRET](\"Bearer \").strip()\n109:         try:\n110:             payload = jwt.decode(token, self._secret, algorithms=[\"HS256\"])\n111:             return payload.get(\"sub\")\n112:         except jwt.PyJWTError:\n113:             return None\n\n(End of file - total 113 lines)\n</content>"},"type":"raw"},"obs_mqv76zl2_f6a42ed941eb":{"observation":{"hookType":"post_tool_use","id":"obs_mqv76zl2_f6a42ed941eb","raw":{"attachments":[],"call_id":"call_01_9QTV3WkSld6u9Zd3PF7c9819","duration_ms":14,"metadata":{"loaded":[],"preview":"\"\"\"RS256 key pair management. Generates and persists a 2048-bit RSA key pair.\"\"\"\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\nfrom cryptography.hazmat.primitives import serialization\nfrom cryptography.hazmat.primitives.asymmetric import rsa\n\n\n@dataclass(frozen=True)\nclass KeyPair:\n    private_pem: bytes\n    public_pem: bytes\n\n\ndef load_or_generate_keypair(keys_dir: Path) -> KeyPair:\n    keys_dir.mkdir(parents=True, exist_ok=True)\n    private_path = keys_dir / \"private.pem\"\n    public_path = keys_dir / \"public.pem\"\n\n    if private_path.exists() and public_path.exists():","truncated":false},"title":"xnch/xnch/auth/keys.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/auth/keys.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/keys.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RS256 key pair management. Generates and persists a 2048-bit RSA key pair.\"\"\"\n2: from dataclasses import dataclass\n3: from pathlib import Path\n4: \n5: from cryptography.hazmat.primitives import serialization\n6: from cryptography.hazmat.primitives.asymmetric import rsa\n7: \n8: \n9: @dataclass(frozen=True)\n10: class KeyPair:\n11:     private_pem: bytes\n12:     public_pem: bytes\n13: \n14: \n15: def load_or_generate_keypair(keys_dir: Path) -> KeyPair:\n16:     keys_dir.mkdir(parents=True, exist_ok=True)\n17:     private_path = keys_dir / \"private.pem\"\n18:     public_path = keys_dir / \"public.pem\"\n19: \n20:     if private_path.exists() and public_path.exists():\n21:         return KeyPair(\n22:             private_pem=private_path.read_bytes(),\n23:             public_pem=public_path.read_bytes(),\n24:         )\n25: \n26:     private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)\n27:     private_pem = private_key.private_bytes(\n28:         encoding=serialization.Encoding.PEM,\n29:         format=serialization.PrivateFormat.PKCS8,\n30:         encryption_algorithm=serialization.NoEncryption(),\n31:     )\n32:     public_pem = private_key.public_key().public_bytes(\n33:         encoding=serialization.Encoding.PEM,\n34:         format=serialization.PublicFormat.SubjectPublicKeyInfo,\n35:     )\n36:     private_path.write_bytes(private_pem)\n37:     private_path.chmod(0o600)\n38:     public_path.write_bytes(public_pem)\n39:     return KeyPair(private_pem=private_pem, public_pem=public_pem)\n\n(End of file - total 39 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:25.668Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/auth/keys.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/keys.py</path>\n<type>file</type>\n<content>\n1: \"\"\"RS256 key pair management. Generates and persists a 2048-bit RSA key pair.\"\"\"\n2: from dataclasses import dataclass\n3: from pathlib import Path\n4: \n5: from cryptography.hazmat.primitives import serialization\n6: from cryptography.hazmat.primitives.asymmetric import rsa\n7: \n8: \n9: @dataclass(frozen=True)\n10: class KeyPair:\n11:     private_pem: bytes\n12:     public_pem: bytes\n13: \n14: \n15: def load_or_generate_keypair(keys_dir: Path) -> KeyPair:\n16:     keys_dir.mkdir(parents=True, exist_ok=True)\n17:     private_path = keys_dir / \"private.pem\"\n18:     public_path = keys_dir / \"public.pem\"\n19: \n20:     if private_path.exists() and public_path.exists():\n21:         return KeyPair(\n22:             private_pem=private_path.read_bytes(),\n23:             public_pem=public_path.read_bytes(),\n24:         )\n25: \n26:     private_key = rsa.generate_private_key(public_exponent=65537, key_size=2048)\n27:     private_pem = private_key.private_bytes(\n28:         encoding=serialization.Encoding.PEM,\n29:         format=serialization.PrivateFormat.PKCS8,\n30:         encryption_algorithm=serialization.NoEncryption(),\n31:     )\n32:     public_pem = private_key.public_key().public_bytes(\n33:         encoding=serialization.Encoding.PEM,\n34:         format=serialization.PublicFormat.SubjectPublicKeyInfo,\n35:     )\n36:     private_path.write_bytes(private_pem)\n37:     private_path.chmod(0o600)\n38:     public_path.write_bytes(public_pem)\n39:     return KeyPair(private_pem=private_pem, public_pem=public_pem)\n\n(End of file - total 39 lines)\n</content>"},"type":"raw"},"obs_mqv76zqw_bd64e954d1ef":{"observation":{"hookType":"post_tool_use","id":"obs_mqv76zqw_bd64e954d1ef","raw":{"attachments":[],"call_id":"call_02_2O0Q8EQg4yWQfLl5Bs9q3529","duration_ms":12,"metadata":{"loaded":[],"preview":"\"\"\"Contract 1: policy evaluation engine.\n\nRules evaluated in ascending priority order. First match wins.\nDefault ALLOW when no rule matches.\n\"\"\"\nimport re\nimport time\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nfrom .loader import PolicySet, Rule, RuleConditions\n\n\n_DAY_MAP = {\n    \"MON\": 0, \"TUE\": 1, \"WED\": 2, \"THU\": 3, \"FRI\": 4, \"SAT\": 5, \"SUN\": 6,\n}\n\n\nclass PolicyVerdict:\n    ALLOW = \"ALLOW\"","truncated":false},"title":"xnch/xnch/policy/engine.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/policy/engine.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/policy/engine.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Contract 1: policy evaluation engine.\n2: \n3: Rules evaluated in ascending priority order. First match wins.\n4: Default ALLOW when no rule matches.\n5: \"\"\"\n6: import re\n7: import time\n8: from dataclasses import dataclass, field\n9: from typing import Any\n10: \n11: from .loader import PolicySet, Rule, RuleConditions\n12: \n13: \n14: _DAY_MAP = {\n15:     \"MON\": 0, \"TUE\": 1, \"WED\": 2, \"THU\": 3, \"FRI\": 4, \"SAT\": 5, \"SUN\": 6,\n16: }\n17: \n18: \n19: class PolicyVerdict:\n20:     ALLOW = \"ALLOW\"\n21:     ALLOW_WITH_WARNINGS = \"ALLOW_WITH_WARNINGS\"\n22:     MODIFY = \"MODIFY\"\n23:     DEFER = \"DEFER\"\n24:     BLOCK = \"BLOCK\"\n25: \n26: \n27: @dataclass\n28: class DryRunResult:\n29:     verdict: str\n30:     policy_refs: list[str]\n31:     warnings: list[str] = field(default_factory=list)\n32:     modified_action_spec: dict[str, Any] | None = None\n33:     requires_actor: str | None = None\n34: \n35: \n36: def _matches_time_window(tw) -> bool:\n37:     if not tw:\n38:         return True\n39:     now = time.gmtime()\n40:     if tw.days:\n41:         if time.strftime(\"%a\", now).upper()[:3] not in tw.days:\n42:             return False\n43:     if tw.hours_utc:\n44:         m = re.match(r\"(\\d{2}):(\\d{2})-(\\d{2}):(\\d{2})\", tw.hours_utc)\n45:         if m:\n46:             start_min = int(m.group(1)) * 60 + int(m.group(2))\n47:             end_min = int(m.group(3)) * 60 + int(m.group(4))\n48:             now_min = now.tm_hour * 60 + now.tm_min\n49:             if not (start_min <= now_min < end_min):\n50:                 return False\n51:     return True\n52: \n53: \n54: def _matches(rule: Rule, ctx: dict[str, Any]) -> bool:\n55:     c = rule.conditions\n56:     if c.intent_class and c.intent_class != ctx.get(\"intent_class\"):\n57:         return False\n58:     if c.action_type and c.action_type.lower() != (ctx.get(\"action_type\") or \"\").lower():\n59:         return False\n60:     if c.entity_class and c.entity_class != ctx.get(\"entity_class\"):\n61:         return False\n62:     if c.actor_role and c.actor_role != ctx.get(\"actor_role\"):\n63:         return False\n64:     if c.actor_capabilities:\n65:         caps = set(ctx.get(\"actor_capabilities\") or [])\n66:         if not all(cap in caps for cap in c.actor_capabilities):\n67:             return False\n68:     if c.urgency and c.urgency != ctx.get(\"urgency\"):\n69:         return False\n70:     if c.reversible is not None and c.reversible != ctx.get(\"reversible\"):\n71:         return False\n72:     if not _matches_time_window(c.time_window):\n73:         return False\n74:     return True\n75: \n76: \n77: def _apply_modify(action_spec: dict[str, Any], modify_spec: dict[str, Any]) -> dict[str, Any]:\n78:     \"\"\"Apply dot-path field replacement to a copy of action_spec.\"\"\"\n79:     result = dict(action_spec)\n80:     dot_path: str = modify_spec.get(\"field\", \"\")\n81:     value = modify_spec.get(\"value\")\n82:     parts = dot_path.split(\".\")\n83:     target = result\n84:     for part in parts[:-1]:\n85:         if part not in target:\n86:             target[part] = {}\n87:         target = target[part]\n88:     if parts:\n89:         target[parts[-1]] = value\n90:     return result\n91: \n92: \n93: class PolicyEngine:\n94:     def __init__(self, policy_set: PolicySet) -> None:\n95:         self._rules = policy_set.rules\n96: \n97:     def evaluate(\n98:         self,\n99:         intent_class: str,\n100:         action_type: str,\n101:         entity_class: str,\n102:         actor_role: str,\n103:         actor_capabilities: list[str],\n104:         action_spec: dict[str, Any],\n105:         urgency: str = \"NORMAL\",\n106:         reversible: bool = True,\n107:     ) -> DryRunResult:\n108:         ctx = {\n109:             \"intent_class\": intent_class,\n110:             \"action_type\": action_type,\n111:             \"entity_class\": entity_class,\n112:             \"actor_role\": actor_role,\n113:             \"actor_capabilities\": actor_capabilities,\n114:             \"urgency\": urgency,\n115:             \"reversible\": reversible,\n116:         }\n117: \n118:         for rule in self._rules:\n119:             if not _matches(rule, ctx):\n120:                 continue\n121: \n122:             verdict = rule.action.verdict\n123: \n124:             if verdict == PolicyVerdict.BLOCK:\n125:                 return DryRunResult(verdict=verdict, policy_refs=[rule.rule_id])\n126: \n127:             if verdict == PolicyVerdict.MODIFY:\n128:                 modified = _apply_modify(action_spec, rule.action.modify_spec or {})\n129:                 return DryRunResult(\n130:                     verdict=verdict,\n131:                     policy_refs=[rule.rule_id],\n132:                     modified_action_spec=modified,\n133:                 )\n134: \n135:             if verdict == PolicyVerdict.DEFER:\n136:                 return DryRunResult(\n137:                     verdict=verdict,\n138:                     policy_refs=[rule.rule_id],\n139:                     requires_actor=rule.action.requires_actor,\n140:                 )\n141: \n142:             if verdict == PolicyVerdict.ALLOW_WITH_WARNINGS:\n143:                 return DryRunResult(\n144:                     verdict=verdict,\n145:                     policy_refs=[rule.rule_id],\n146:                     warnings=rule.action.warnings,\n147:                 )\n148: \n149:             # ALLOW\n150:             return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[rule.rule_id])\n151: \n152:         # Default: no rule matched\n153:         return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[\"default.allow\"])\n154: \n155:     def reload(self, policy_set: PolicySet) -> None:\n156:         self._rules = policy_set.rules\n\n(End of file - total 156 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:25.878Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/policy/engine.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/policy/engine.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Contract 1: policy evaluation engine.\n2: \n3: Rules evaluated in ascending priority order. First match wins.\n4: Default ALLOW when no rule matches.\n5: \"\"\"\n6: import re\n7: import time\n8: from dataclasses import dataclass, field\n9: from typing import Any\n10: \n11: from .loader import PolicySet, Rule, RuleConditions\n12: \n13: \n14: _DAY_MAP = {\n15:     \"MON\": 0, \"TUE\": 1, \"WED\": 2, \"THU\": 3, \"FRI\": 4, \"SAT\": 5, \"SUN\": 6,\n16: }\n17: \n18: \n19: class PolicyVerdict:\n20:     ALLOW = \"ALLOW\"\n21:     ALLOW_WITH_WARNINGS = \"ALLOW_WITH_WARNINGS\"\n22:     MODIFY = \"MODIFY\"\n23:     DEFER = \"DEFER\"\n24:     BLOCK = \"BLOCK\"\n25: \n26: \n27: @dataclass\n28: class DryRunResult:\n29:     verdict: str\n30:     policy_refs: list[str]\n31:     warnings: list[str] = field(default_factory=list)\n32:     modified_action_spec: dict[str, Any] | None = None\n33:     requires_actor: str | None = None\n34: \n35: \n36: def _matches_time_window(tw) -> bool:\n37:     if not tw:\n38:         return True\n39:     now = time.gmtime()\n40:     if tw.days:\n41:         if time.strftime(\"%a\", now).upper()[:3] not in tw.days:\n42:             return False\n43:     if tw.hours_utc:\n44:         m = re.match(r\"(\\d{2}):(\\d{2})-(\\d{2}):(\\d{2})\", tw.hours_utc)\n45:         if m:\n46:             start_min = int(m.group(1)) * 60 + int(m.group(2))\n47:             end_min = int(m.group(3)) * 60 + int(m.group(4))\n48:             now_min = now.tm_hour * 60 + now.tm_min\n49:             if not (start_min <= now_min < end_min):\n50:                 return False\n51:     return True\n52: \n53: \n54: def _matches(rule: Rule, ctx: dict[str, Any]) -> bool:\n55:     c = rule.conditions\n56:     if c.intent_class and c.intent_class != ctx.get(\"intent_class\"):\n57:         return False\n58:     if c.action_type and c.action_type.lower() != (ctx.get(\"action_type\") or \"\").lower():\n59:         return False\n60:     if c.entity_class and c.entity_class != ctx.get(\"entity_class\"):\n61:         return False\n62:     if c.actor_role and c.actor_role != ctx.get(\"actor_role\"):\n63:         return False\n64:     if c.actor_capabilities:\n65:         caps = set(ctx.get(\"actor_capabilities\") or [])\n66:         if not all(cap in caps for cap in c.actor_capabilities):\n67:             return False\n68:     if c.urgency and c.urgency != ctx.get(\"urgency\"):\n69:         return False\n70:     if c.reversible is not None and c.reversible != ctx.get(\"reversible\"):\n71:         return False\n72:     if not _matches_time_window(c.time_window):\n73:         return False\n74:     return True\n75: \n76: \n77: def _apply_modify(action_spec: dict[str, Any], modify_spec: dict[str, Any]) -> dict[str, Any]:\n78:     \"\"\"Apply dot-path field replacement to a copy of action_spec.\"\"\"\n79:     result = dict(action_spec)\n80:     dot_path: str = modify_spec.get(\"field\", \"\")\n81:     value = modify_spec.get(\"value\")\n82:     parts = dot_path.split(\".\")\n83:     target = result\n84:     for part in parts[:-1]:\n85:         if part not in target:\n86:             target[part] = {}\n87:         target = target[part]\n88:     if parts:\n89:         target[parts[-1]] = value\n90:     return result\n91: \n92: \n93: class PolicyEngine:\n94:     def __init__(self, policy_set: PolicySet) -> None:\n95:         self._rules = policy_set.rules\n96: \n97:     def evaluate(\n98:         self,\n99:         intent_class: str,\n100:         action_type: str,\n101:         entity_class: str,\n102:         actor_role: str,\n103:         actor_capabilities: list[str],\n104:         action_spec: dict[str, Any],\n105:         urgency: str = \"NORMAL\",\n106:         reversible: bool = True,\n107:     ) -> DryRunResult:\n108:         ctx = {\n109:             \"intent_class\": intent_class,\n110:             \"action_type\": action_type,\n111:             \"entity_class\": entity_class,\n112:             \"actor_role\": actor_role,\n113:             \"actor_capabilities\": actor_capabilities,\n114:             \"urgency\": urgency,\n115:             \"reversible\": reversible,\n116:         }\n117: \n118:         for rule in self._rules:\n119:             if not _matches(rule, ctx):\n120:                 continue\n121: \n122:             verdict = rule.action.verdict\n123: \n124:             if verdict == PolicyVerdict.BLOCK:\n125:                 return DryRunResult(verdict=verdict, policy_refs=[rule.rule_id])\n126: \n127:             if verdict == PolicyVerdict.MODIFY:\n128:                 modified = _apply_modify(action_spec, rule.action.modify_spec or {})\n129:                 return DryRunResult(\n130:                     verdict=verdict,\n131:                     policy_refs=[rule.rule_id],\n132:                     modified_action_spec=modified,\n133:                 )\n134: \n135:             if verdict == PolicyVerdict.DEFER:\n136:                 return DryRunResult(\n137:                     verdict=verdict,\n138:                     policy_refs=[rule.rule_id],\n139:                     requires_actor=rule.action.requires_actor,\n140:                 )\n141: \n142:             if verdict == PolicyVerdict.ALLOW_WITH_WARNINGS:\n143:                 return DryRunResult(\n144:                     verdict=verdict,\n145:                     policy_refs=[rule.rule_id],\n146:                     warnings=rule.action.warnings,\n147:                 )\n148: \n149:             # ALLOW\n150:             return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[rule.rule_id])\n151: \n152:         # Default: no rule matched\n153:         return DryRunResult(verdict=PolicyVerdict.ALLOW, policy_refs=[\"default.allow\"])\n154: \n155:     def reload(self, policy_set: PolicySet) -> None:\n156:         self._rules = policy_set.rules\n\n(End of file - total 156 lines)\n</content>"},"type":"raw"},"obs_mqv76zzk_7227531afccd":{"observation":{"hookType":"post_tool_use","id":"obs_mqv76zzk_7227531afccd","raw":{"attachments":[],"call_id":"call_03_JoOb0Hj06ktYXaMlgD6D4629","duration_ms":13,"metadata":{"loaded":[],"preview":"\"\"\"Contract 1: YAML policy loader. Merges default + custom rule sets.\"\"\"\nimport logging\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass TimeWindow:\n    days: list[str] = field(default_factory=list)\n    hours_utc: str = \"\"\n\n\n@dataclass\nclass RuleConditions:\n    intent_cla