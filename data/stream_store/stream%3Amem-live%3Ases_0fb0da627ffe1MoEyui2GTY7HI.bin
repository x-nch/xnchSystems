UST_MAP: dict[str, TrustLevel] = {\\n19:     \\\"nexi\\\": TrustLevel.SYSTEM,\\n20:     \\\"openclaw\\\": TrustLevel.OWNER,\\n21:     \\\"claude_code\\\": TrustLevel.TRUSTED_AGENT,\\n22:     \\\"opencode\\\": TrustLevel.TRUSTED_AGENT,\\n23:     \\\"perception_daemon\\\": TrustLevel.TRUSTED_AGENT,\\n24:     \\\"consolidation_job\\\": TrustLevel.TRUSTED_AGENT,\\n25:     \\\"external\\\": TrustLevel.UNTRUSTED,\\n26: }\\n27: \\n28: \\n29: def get_trust_level(actor_role: str) -> TrustLevel:\\n30:     return ACTOR_TRUST_MAP.get(actor_role, TrustLevel.UNTRUSTED)\\n31: \\n32: \\n33: def requires_trust(minimum: TrustLevel):\\n34:     def decorator(func: Any) -> Any:\\n35:         @wraps(func)\\n36:         async def wrapper(*args: Any, **kwargs: Any) -> Any:\\n37:             request: Request | None = None\\n38:             for arg in args:\\n39:                 if hasattr(arg, 'headers'):\\n40:                     request = arg\\n41:                     break\\n42:             if request is None:\\n43:                 for _, v in kwargs.items():\\n44:                     if hasattr(v, 'headers'):\\n45:                         request = v\\n46:                         break\\n47:             if request is None:\\n48:                 raise HTTPException(status_code=500, detail=\\\"Request object not found\\\")\\n49: \\n50:             actor_role = request.headers.get(\\\"X-Actor-Role\\\", \\\"\\\")\\n51:             level = get_trust_level(actor_role)\\n52:             if level.value < minimum.value:\\n53:                 raise HTTPException(\\n54:                     status_code=403,\\n55:                     detail=f\\\"Actor '{actor_role}' (trust level {level.name}) \\\"\\n56:                            f\\\"does not meet minimum trust level {minimum.name}\\\",\\n57:                 )\\n58:             return await func(*args, **kwargs)\\n59:         return wrapper\\n60:     return decorator\\n\\n(End of file - total 60 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627f