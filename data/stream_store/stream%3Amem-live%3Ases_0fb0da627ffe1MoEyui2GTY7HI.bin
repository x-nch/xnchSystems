el\\n\\nfrom nexi.character.prompt_loader import build_system_prompt\\nfrom nexi.pipeline.context_assembler import assemble_context\\nfrom nexi.proactivity.engine import ProactivityEngine\\nfrom xnch.routing.classifier import classify_request\\nfrom xnch.security.injection_guard import scan_input\\n\\nlogger = logging.getLogger(__name__)\\nrouter = APIRouter(prefix=\\\"/nexi\\\", tags=[\\\"nexi\\\"])\\n\",\"truncated\":false},\"title\":\"xnch/xnch/routes/nexi_gateway.py\",\"tool_input\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\\"}\",\"tool_name\":\"read\",\"tool_output\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py</path>\\n<type>file</type>\\n<content>\\n1: import json\\n2: import logging\\n3: import os\\n4: from typing import Any\\n5: from uuid import uuid4\\n6: \\n7: import httpx\\n8: from fastapi import APIRouter, HTTPException, Request\\n9: from fastapi.responses import PlainTextResponse, StreamingResponse\\n10: from pydantic import BaseModel\\n11: \\n12: from nexi.character.prompt_loader import build_system_prompt\\n13: from nexi.pipeline.context_assembler import assemble_context\\n14: from nexi.proactivity.engine import ProactivityEngine\\n15: from xnch.routing.classifier import classify_request\\n16: from xnch.security.injection_guard import scan_input\\n17: \\n18: logger = logging.getLogger(__name__)\\n19: router = APIRouter(prefix=\\\"/nexi\\\", tags=[\\\"nexi\\\"])\\n20: \\n21: SYSTEM_PROMPT_CACHE_KEY = \\\"nexi:system-prompt\\\"\\n22: SYSTEM_PROMPT_CACHE_TTL = 60\\n23: \\n24: LITELLM_BASE = os.environ.get(\\\"LITELLM_BASE_URL\\\", \\\"http://i7-node:4000\\\")\\n25: LITELLM_API_KEY = os.environ.get(\\\"LITELLM_API_KEY\\\", \\\"\\\")\\n26: \\n27: \\n28: class ChatRequest(BaseModel):\\n29:     session_id: str\\n30:     message: str\\n31:     actor_role: str = \\\"openclaw\\\"\\n32: \\n33: \\n34: class MemoryRecallRequest(BaseModel):\\n35:     query: str\\n36:     top_k: int = 5\\n37: \\n38: \\n39: def _get_proactivity(app) -> ProactivityEngine:\\n40:     if not hasattr(app, \\\"_nexi_proactivity\\\"):\\n41:         redis = app.kv_cache.redis_client\\n42:         app._nexi_proactivity = ProactivityEngine(redis)\\n43:     return app._nexi_proactivity\\n44: \\n45: \\n46: def _invalidate_system_prompt_cache(app) -> None:\\n47:     redis = app.kv_cache._redis\\n48:     import asyncio\\n49:     try:\\n50:         asyncio.ensure_future(redis.delete(SYSTEM_PROMPT_CACHE_KEY))\\n51:     except Exception:\\n52:         logger.warning(\\\"Failed to invalidate system prompt cache\\\", exc_info=True)\\n53: \\n54: \\n55: @router.get(\\\"/system-prompt\\\", response_class=PlainTextResponse)\\n56: async def get_system_prompt(request: Request) -> str:\\n57:     app = request.app.state\\n58:     redis = app.kv_cache._redis\\n59: \\n60:     cached = await redis.get(SYSTEM_PROMPT_CACHE_KEY)\\n61:     if cached:\\n62:         return cached\\n63: \\n64:     from agentmemory import get_memories\\n65:     entities = get_memories(\\\"entities\\\", n_results=20)\\n66:     recent_entities = [e.get(\\\"document\\\", \\\"\\\") for e in entities if e.get(\\\"document\\\")]\\n67: \\n68:     prompt = build_system_prompt(session_memory=[], recent_entities=recent_entities)\\n69:     await redis.set(SYSTEM_PROMPT_CACHE_KEY, prompt, ex=SYSTEM_PROMPT_CACHE_TTL)\\n70:     return prompt\\n71: \\n72: \\n73: @router.post(\\\"/chat\\\")\\n74: async def chat(body: ChatRequest, request: Request) -> dict[str, Any]:\\n75:     app = request.app.state\\n76: \\n77:     result = scan_input(body.message, app.event_log)\\n78:     if not result.is_clean:\\n79:         raise HTTPException(status_code=400, detail=\\\"Input rejected by injection guard\\\")\\n80: \\n81:     ctx = await assemble_context(\\n82:         session_id=body.session_id,\\n83:         raw_input=body.message,\\n84:         working_memory=app.working_memory,\\n85:         pg_episodic=app.pg_episodic,\\n86:         graph_store=app.graph_store,\\n87:         relationship_store=app.relationship_store,\\n88:         sensory_buffer=app.sensory_buffer,\\n89:         proactivity_engine=_get_proactivity(app),\\n90:     )\\n91: \\n92:     route = classify_request(body.message, body.actor_role, {})\\n93:     messages = ctx.to_messages(body.message)\\n94:     model_name = route.model_name\\n95: \\n96:     await app.working_memory.append_turn(body.session_id, \\\"user\\\", body.message)\\n97: \\n98:     try:\\n99:         async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\\n100:             resp = await client.post(\\n101:                 \\\"/chat/completions\\\",\\n102:                 json={\\n103:                     \\\"model\\\": model_name,\\n104:                     \\\"messages\\\": messages,\\n105:                     \\\"max_tokens\\\": 2048,\\n106:                     \\\"temperature\\\": 0.7,\\n107:                 },\\n108:                 headers={\\\"Authorization\\\": f\\\"Bearer {LITELLM_API_KEY}\\\"} if LITELLM_API_KEY else {},\\n109:             )\\n110:             resp.raise_for_status()\\n111:             response_text = resp.json()[\\\"choices\\\"][0][\\\"message\\\"][\\\"content\\\"]\\n112:     except Exception as exc:\\n113:         logger.error(\\\"LiteLLM call failed: %s\\\", exc)\\n114:         raise HTTPException(status_code=502, detail=\\\"LiteLLM unavailable\\\")\\n115: \\n116:     await app.working_memory.append_turn(body.session_id, \\\"assistant\\\", response_text)\\n117: \\n118:     await app.pg_episodic.store_episode(\\n119:         type_=\\\"conversation\\\",\\n120:         raw_text=f\\\"{body.message}\\\\n{response_text}\\\",\\n121:         summary=f\\\"OpenClaw chat: {body.message[:100]}\\\",\\n122:     )\\n123: \\n124:     _invalidate_system_prompt_cache(app)\\n125: \\n126:     return {\\n127:         \\\"response\\\": response_text,\\n128:         \\\"model_used\\\": model_name,\\n129:         \\\"session_id\\\": body.session_id,\\n130:     }\\n131: \\n132: \\n133: @router.post(\\\"/chat/stream\\\")\\n134: async def chat_stream(body: ChatRequest, request: Request) -> StreamingResponse:\\n135:     app = request.app.state\\n136: \\n137:     result = scan_input(body.message, app.event_log)\\n138:     if not result.is_clean:\\n139:         raise HTTPException(status_code=400, detail=\\\"Input rejected by injection guard\\\")\\n140: \\n141:     ctx = await assemble_context(\\n142:         session_id=body.session_id,\\n143:         raw_input=body.message,\\n144:         working_memory=app.working_memory,\\n145:         pg_episodic=app.pg_episodic,\\n146:         graph_store=app.graph_store,\\n147:         relationship_store=app.relationship_store,\\n148:         sensory_buffer=app.sensory_buffer,\\n149:         proactivity_engine=_get_proactivity(app),\\n150:     )\\n151: \\n152:     route = classify_request(body.message, body.actor_role, {})\\n153:     messages = ctx.to_messages(body.message)\\n154:     model_name = route.model_name\\n155: \\n156:     await app.working_memory.append_turn(body.session_id, \\\"user\\\", body.message)\\n157: \\n158:     async def event_stream():\\n159:         full_text = \\\"\\\"\\n160:         try:\\n161:             async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\\n162:                 async with client.stream(\\n163:                     \\\"POST\\\",\\n164:                     \\\"/chat/completions\\\",\\n165:                     json={\\n166:                         \\\"model\\\": model_name,\\n167:                         \\\"messages\\\": messages,\\n168:                         \\\"max_tokens\\\": 2048,\\n169:                         \\\"temperature\\\": 0.7,\\n170:                         \\\"stream\\\": True,\\n171:                     },\\n172:                     headers={\\\"Authorization\\\": f\\\"Bearer {LITELLM_API_KEY}\\\"} if LITELLM_API_KEY else {},\\n173:                 ) as resp:\\n174:                     if resp.status_code != 200:\\n175:                         yield f\\\"data: {json.dumps({'error': f'LiteLLM error {resp.status_code}'})}\\\\n\\\\n\\\"\\n176:                         yield \\\"data: [DONE]\\\\n\\\\n\\\"\\n177:                         return\\n178:                     async for line in resp.aiter_lines():\\n179:                         if not line.startswith(\\\"data: \\\"):\\n180:                             continue\\n181:                         payload = line.removeprefix(\\\"data: \\\")\\n182:                         if payload == \\\"[DONE]\\\":\\n183:                             break\\n184:                         try:\\n185:                             chunk = json.loads(payload)\\n186:                             delta = chunk.get(\\\"choices\\\", [{}])[0].get(\\\"delta\\\", {}).get(\\\"content\\\", \\\"\\\")\\n187:                             if delta:\\n188:                                 full_text += delta\\n189:                                 yield f\\\"data: {json.dumps({'content': delta})}\\\\n\\\\n\\\"\\n190:                         except json.JSONDecodeError:\\n191:                             continue\\n192:         except Exception as exc:\\n193:             logger.error(\\\"LiteLLM stream failed: %s\\\", exc)\\n194:             yield f\\\"data: {json.dumps({'error': 'LiteLLM unavailable'})}\\\\n\\\\n\\\"\\n195:             yield \\\"data: [DONE]\\\\n\\\\n\\\"\\n196:             return\\n197: \\n1\"},\"sessionId\":\"ses_0fae25260fferIk2T6UHXhI3mF\",\"timestamp\":\"2026-06-26T18:07:52.006Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py</path>\\n<type>file</type>\\n<content>\\n1: import json\\n2: import logging\\n3: import os\\n4: from typing import Any\\n5: from uuid import uuid4\\n6: \\n7: import httpx\\n8: from fastapi import APIRouter, HTTPException, Request\\n9: from fastapi.responses import Pla