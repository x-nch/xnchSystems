            )\\\\n40:                 except Exception:\\\\n41:                     pass\\\\n42:     except Exception:\\\\n43:         pass\\\\n44: \\\\n45:     if metadata.get(\\\\\\\"privacy_sensitive\\\\\\\"):\\\\n46:         route = ModelRoute(\\\\n47:             model_name=\\\\\\\"gemma4-local\\\\\\\",\\\\n48:             reason=\\\\\\\"privacy_sensitive: routed to local model\\\\\\\",\\\\n49:         )\\\\n50:         _persist_route(raw_input, actor_role, metadata, route)\\\\n51:         return route\\\\n52: \\\\n53:     intent_class = metadata.get(\\\\\\\"intent_class\\\\\\\", \\\\\\\"\\\\\\\")\\\\n54:     complexity_score = metadata.get(\\\\\\\"complexity_score\\\\\\\", 0.0)\\\\n55: \\\\n56:     if intent_class == \\\\\\\"EXECUTION\\\\\\\":\\\\n57:         route = ModelRoute(\\\\n58:             model_name=\\\\\\\"gemma4-local\\\\\\\",\\\\n59:             reason=\\\\\\\"intent_class=EXECUTION: routed to local model for low-latency execution\\\\\\\",\\\\n60:         )\\\\n61:         _persist_route(raw_input, actor_role, metadata, route)\\\\n62:         return route\\\\n63: \\\\n64:     if intent_class == \\\\\\\"DECISION\\\\\\\":\\\\n65:         complexity_score = _compute_complexity(raw_input, metadata)\\\\n66:         if complexity_score > 0.7:\\\\n67:             route = ModelRoute(\\\\n68:                 model_name=\\\\\\\"claude-judgment\\\\\\\",\\\\n69:                 reason=f\\\\\\\"intent_class=DECISION complexity={complexity_score:.2f}: routed to cloud judgment model\\\\\\\",\\\\n70:             )\\\\n71:             _persist_route(raw_input, actor_role, metadata, route)\\\\n72:             return route\\\\n73: \\\\n74:     route = ModelRoute(\\\\n75:         model_name=\\\\\\\"gemma4-local\\\\\\\",\\\\n76:         reason=\\\\\\\"default route: local model\\\\\\\",\\\\n77:     )\\\\n78:     _persist_route(raw_input, actor_role, metadata, route)\\\\n79:     return route\\\\n80: \\\\n81: \\\\n82: def _persist_route(raw_input: str, actor_role: str, 