L auto-expiry.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import json\n6: import time\n7: from uuid import uuid4\n8: \n9: import redis.asyncio as aioredis\n10: \n11: \n12: class SensoryBuffer:\n13:     def __init__(\n14:         self,\n15:         redis_url: str = \"redis://localhost:6379/0\",\n16:         redis_client: aioredis.Redis | None = None,\n17:     ) -> None:\n18:         if redis_client is not None:\n19:             self._redis = redis_client\n20:         else:\n21:             self._redis = aioredis.from_url(redis_url, decode_responses=True)\n22: \n23:     async def aclose(self) -> None:\n24:         await self._redis.aclose()\n25: \n26:     async def write_perception(\n27:         self, source: str, data: bytes | str, ttl: int = 60\n28:     ) -> str:\n29:         key = f\"perception:{source}:{uuid4()}\"\n30:         if isinstance(data, bytes):\n31:             data = data.decode(\"utf-8\", errors=\"replace\")\n32:         payload = json.dumps({\n33:             \"source\": source,\n34:             \"data\": data,\n35:             \"timestamp\": time.time(),\n36:         })\n37:         await self._redis.set(key, payload, ex=ttl)\n38:         return key\n39: \n40:     async def read_recent(self, source: str, limit: int = 10) -> list[dict]:\n41:         pattern = f\"perception:{source}:*\"\n42:         cursor = 0\n43:         keys: list[str] = []\n44:         while True:\n45:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n46:             keys.extend(batch)\n47:             if cursor == 0:\n48:                 break\n49:         if not keys:\n50:             return []\n51:         pipe = self._redis.pipeline()\n52:         for k in keys:\n53:             pipe.get(k)\n54:         values = await pipe.execute()\n55:         perceptions = [\n56:             (k, json.loads(v))\n57:             for k, v in zip(keys, values)\n58:             if v is not None\n59:         ]\n60:         perceptions.sort(key=lambda x: x[1].get(\"timestamp\", 0), reverse=True)\n61:         return [p[1] for p in perceptions[:limit]]\n62: \n63:     async def flush_to_working_memory(\n64:         self,\n65:         key: str,\n66:         summary: str,\n67:         working_memory: object | None = None,\n68:         session_id: str = \"default\",\n69:     ) -> None:\n70:         raw = await self._redis.get(key)\n71:         if raw is None:\n72:             return\n73:         payload = json.loads(raw)\n74:         await self._redis.delete(key)\n75:         if working_memory is not None:\n76:             from xnch.memory.working_memory import WorkingMemory\n77: \n78:             if isinstance(working_memory, WorkingMemory):\n79:                 src = payload.get(\"source\", \"unknown\")\n80:                 await working_memory.append_turn(\n81:                     session_id, \"perception\", f\"[{src}] {summary}\"\n82:                 )\n\n(End of file - total 82 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:20:42.250Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/sensory_buffer.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/sensory_buffer.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Layer 0 — Sensory Buffer (Redis). Raw perception signals with TTL auto-expiry.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import json\n6: import time\n7: from uuid import uuid4\n8: \n9: import redis.asyncio as aioredis\n10: \n11: \n12: class SensoryBuffer:\n13:     def __init__(\n14:         self,\n15:         redis_url: str = \"redis://localhost:6379/0\",\n16:         redis_client: aioredis.Redis | None = None,\n17:     ) -> None:\n18:         if redis_client is not None:\n19:             self._redis = redis_client\n20:         else:\n21:             self._redis = aioredis.from_url(redis_url, decode_responses=True)\n22: \n23:     async def aclose(self) -> None:\n24:         await self._redis.aclose()\n25: \n26:     async def write_perception(\n27:         self, source: str, data: bytes | str, ttl: int = 60\n28:     ) -> str:\n29:         key = f\"perception:{source}:{uuid4()}\"\n30:         if isinstance(data, bytes):\n31:             data = data.decode(\"utf-8\", errors=\"replace\")\n32:         payload = json.dumps({\n33:             \"source\": source,\n34:             \"data\": data,\n35:             \"timestamp\": time.time(),\n36:         })\n37:         await self._redis.set(key, payload, ex=ttl)\n38:         return key\n39: \n40:     async def read_recent(self, source: str, limit: int = 10) -> list[dict]:\n41:         pattern = f\"perception:{source}:*\"\n42:         cursor = 0\n43:         keys: list[str] = []\n44:         while True:\n45:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n46:             keys.extend(batch)\n47:             if cursor == 0:\n48:                 break\n49:         if not keys:\n50:             return []\n51:         pipe = self._redis.pipeline()\n52:         for k in keys:\n53:             pipe.get(k)\n54:         values = await pipe.execute()\n55:         perceptions = [\n56:             (k, json.loads(v))\n57:             for k, v in zip(keys, values)\n58:             if v is not None\n59:         ]\n60:         perceptions.sort(key=lambda x: x[1].get(\"timestamp\", 0), reverse=True)\n61:         return [p[1] for p in perceptions[:limit]]\n62: \n63:     async def flush_to_working_memory(\n64:         self,\n65:         key: str,\n66:         summary: str,\n67:         working_memory: object | None = None,\n68:         session_id: str = \"default\",\n69:     ) -> None:\n70:         raw = await self._redis.get(key)\n71:         if raw is None:\n72:             return\n73:         payload = json.loads(raw)\n74:         await self._redis.delete(key)\n75:         if working_memory is not None:\n76:             from xnch.memory.working_memory import WorkingMemory\n77: \n78:             if isinstance(working_memory, WorkingMemory):\n79:                 src = payload.get(\"source\", \"unknown\")\n80:                 await working_memory.append_turn(\n81:                     session_id, \"perception\", f\"[{src}] {summary}\"\n82:                 )\n\n(End of file - total 82 lines)\n</content>"},"type":"raw"},"obs_mqv762an_ecbd7adaa374":{"observation":{"hookType":"post_tool_use","id":"obs_mqv762an_ecbd7adaa374","raw":{"attachments":[],"call_id":"call_01_crLetg92zfX2P1ApL7nE4506","duration_ms":4,"metadata":{"loaded":[],"preview":"\"\"\"Layer 1 — Working Memory (Redis). Active session context with TTL.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport time\nfrom typing import Any\n\nimport redis.asyncio as aioredis\n\n\nclass WorkingMemory:\n    def __init__(\n        self,\n        redis_url: str = \"redis://localhost:6379/0\",\n        redis_client: aioredis.Redis | None = None,\n    ) -> None:\n        if redis_client is not None:\n            self._redis = redis_client\n        else:","truncated":false},"title":"xnch/xnch/memory/working_memory.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/working_memory.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/working_memory.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Layer 1 — Working Memory (Redis). Active session context with TTL.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import json\n6: import time\n7: from typing import Any\n8: \n9: import redis.asyncio as aioredis\n10: \n11: \n12: class WorkingMemory:\n13:     def __init__(\n14:         self,\n15:         redis_url: str = \"redis://localhost:6379/0\",\n16:         redis_client: aioredis.Redis | None = None,\n17:     ) -> None:\n18:         if redis_client is not None:\n19:             self._redis = redis_client\n20:         else:\n21:             self._redis = aioredis.from_url(redis_url, decode_responses=True)\n22: \n23:     async def aclose(self) -> None:\n24:         await self._redis.aclose()\n25: \n26:     async def set_context(\n27:         self, session_id: str, key: str, value: Any, ttl: int = 3600\n28:     ) -> None:\n29:         hkey = f\"session:{session_id}:{key}\"\n30:         await self._redis.hset(hkey, mapping={\"value\": json.dumps(value)})\n31:         await self._redis.expire(hkey, ttl)\n32: \n33:     async def get_context(self, session_id: str, key: str) -> Any | None:\n34:         hkey = f\"session:{session_id}:{key}\"\n35:         raw = await self._redis.hget(hkey, \"value\")\n36:         if raw is None:\n37:             return None\n38:         return json.loads(raw)\n39: \n40:     async def get_full_session(self, session_id: str) -> dict[str, Any]:\n41:         pattern = f\"session:{session_id}:*\"\n42:         cursor = 0\n43:         keys: list[str] = []\n44:         while True:\n45:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n46:             keys.extend(batch)\n47:             if cursor == 0:\n48:                 break\n49:         result: dict[str, Any] = {}\n50:         hash_keys = [k for k in keys if k.split(\":\", 2)[2] != \"turns\"]\n51:         if not hash_keys:\n52:             return result\n53:         pipe = self._redis.pipeline()\n54:         for k in hash_keys:\n55:             pipe.hgetall(k)\n56:         values = await pipe.execute()\n57:         for k, v in zip(hash_keys, values):\n58:             if not v:\n59:                 continue\n60:             key_name = k.split(\":\", 2)[2]\n61:             result[key_name] = json.loads(v.get(\"value\", \"null\"))\n62:         return result\n63: \n64:     async def clear_session(self, session_id: str) -> None:\n65:         pattern = f\"session:{session_id}:*\"\n66:         cursor = 0\n67:         keys: list[str] = []\n68:         while True:\n69:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n70:             keys.extend(batch)\n71:             if cursor == 0:\n72:                 break\n73:         if keys:\n74:             await self._redis.delete(*keys)\n75: \n76:     async def append_turn(self, session_id: str, role: str, content: str) -> None:\n77:         turn_key = f\"session:{session_id}:turns\"\n78:         turn = json.dumps({\n79:             \"role\": role,\n80:             \"content\": content,\n81:             \"timestamp\": time.time(),\n82:         })\n83:         await self._redis.rpush(turn_key, turn)\n84: \n85:     async def get_turns(\n86:         self, session_id: str, last_n: int = 20\n87:     ) -> list[dict[str, Any]]:\n88:         turn_key = f\"session:{session_id}:turns\"\n89:         length = await self._redis.llen(turn_key)\n90:         start = max(0, length - last_n)\n91:         raw = await self._redis.lrange(turn_key, start, -1)\n92:         return [json.loads(t) for t in raw]\n\n(End of file - total 92 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:20:42.526Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/working_memory.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/working_memory.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Layer 1 — Working Memory (Redis). Active session context with TTL.\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import json\n6: import time\n7: from typing import Any\n8: \n9: import redis.asyncio as aioredis\n10: \n11: \n12: class WorkingMemory:\n13:     def __init__(\n14:         self,\n15:         redis_url: str = \"redis://localhost:6379/0\",\n16:         redis_client: aioredis.Redis | None = None,\n17:     ) -> None:\n18:         if redis_client is not None:\n19:             self._redis = redis_client\n20:         else:\n21:             self._redis = aioredis.from_url(redis_url, decode_responses=True)\n22: \n23:     async def aclose(self) -> None:\n24:         await self._redis.aclose()\n25: \n26:     async def set_context(\n27:         self, session_id: str, key: str, value: Any, ttl: int = 3600\n28:     ) -> None:\n29:         hkey = f\"session:{session_id}:{key}\"\n30:         await self._redis.hset(hkey, mapping={\"value\": json.dumps(value)})\n31:         await self._redis.expire(hkey, ttl)\n32: \n33:     async def get_context(self, session_id: str, key: str) -> Any | None:\n34:         hkey = f\"session:{session_id}:{key}\"\n35:         raw = await self._redis.hget(hkey, \"value\")\n36:         if raw is None:\n37:             return None\n38:         return json.loads(raw)\n39: \n40:     async def get_full_session(self, session_id: str) -> dict[str, Any]:\n41:         pattern = f\"session:{session_id}:*\"\n42:         cursor = 0\n43:         keys: list[str] = []\n44:         while True:\n45:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n46:             keys.extend(batch)\n47:             if cursor == 0:\n48:                 break\n49:         result: dict[str, Any] = {}\n50:         hash_keys = [k for k in keys if k.split(\":\", 2)[2] != \"turns\"]\n51:         if not hash_keys:\n52:             return result\n53:         pipe = self._redis.pipeline()\n54:         for k in hash_keys:\n55:             pipe.hgetall(k)\n56:         values = await pipe.execute()\n57:         for k, v in zip(hash_keys, values):\n58:             if not v:\n59:                 continue\n60:             key_name = k.split(\":\", 2)[2]\n61:             result[key_name] = json.loads(v.get(\"value\", \"null\"))\n62:         return result\n63: \n64:     async def clear_session(self, session_id: str) -> None:\n65:         pattern = f\"session:{session_id}:*\"\n66:         cursor = 0\n67:         keys: list[str] = []\n68:         while True:\n69:             cursor, batch = await self._redis.scan(cursor=cursor, match=pattern)\n70:             keys.extend(batch)\n71:             if cursor == 0:\n72:                 break\n73:         if keys:\n74:             await self._redis.delete(*keys)\n75: \n76:     async def append_turn(self, session_id: str, role: str, content: str) -> None:\n77:         turn_key = f\"session:{session_id}:turns\"\n78:         turn = json.dumps({\n79:             \"role\": role,\n80:             \"content\": content,\n81:             \"timestamp\": time.time(),\n82:         })\n83:         await self._redis.rpush(turn_key, turn)\n84: \n85:     async def get_turns(\n86:         self, session_id: str, last_n: int = 20\n87:     ) -> list[dict[str, Any]]:\n88:         turn_key = f\"session:{session_id}:turns\"\n89:         length = await self._redis.llen(turn_key)\n90:         start = max(0, length - last_n)\n91:         raw = await self._redis.lrange(turn_key, start, -1)\n92:         return [json.loads(t) for t in raw]\n\n(End of file - total 92 lines)\n</content>"},"type":"raw"},"obs_mqv762iv_bf7e14d42c4f":{"observation":{"hookType":"post_tool_use","id":"obs_mqv762iv_bf7e14d42c4f","raw":{"attachments":[],"call_id":"call_02_j7uEfq5D85dfDJEuWjQk1283","duration_ms":5,"metadata":{"loaded":[],"preview":"\"\"\"Episodic Store — records every decision outcome for the learning loop.\"\"\"\nimport json\nimport time\nfrom pathlib import Path\nfrom typing import Any\nfrom uuid import uuid4\n\nimport aiosqlite\n\n\nclass EpisodicStore:\n    def __init__(self, db_path: Path) -> None:\n        self._db = db_path\n\n    async def create_episode(\n        self,\n        decision_id: str,\n        intent_class: str,\n        action_type: str,\n        entity_class: str,","truncated":false},"title":"xnch/xnch/memory/episodic_store.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/episodic_store.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/episodic_store.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Episodic Store — records every decision outcome for the learning loop.\"\"\"\n2: import json\n3: import time\n4: from pathlib import Path\n5: from typing import Any\n6: from uuid import uuid4\n7: \n8: import aiosqlite\n9: \n10: \n11: class EpisodicStore:\n12:     def __init__(self, db_path: Path) -> None:\n13:         self._db = db_path\n14: \n15:     async def create_episode(\n16:         self,\n17:         decision_id: str,\n18:         intent_class: str,\n19:         action_type: str,\n20:         entity_class: str,\n21:         actor_role: str,\n22:         context_snapshot: dict[str, Any],\n23:         generation_path: str = \"MODEL\",\n24:     ) -> str:\n25:         episode_id = str(uuid4())\n26:         async with aiosqlite.connect(self._db) as db:\n27:             await db.execute(\n28:                 \"\"\"INSERT INTO episodes\n29:                    (episode_id, decision_id, intent_class, action_type, entity_class,\n30:                     actor_role, context_snapshot, generation_path, created_at)\n31:                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n32:                 (episode_id, decision_id, intent_class, action_type, entity_class,\n33:                  actor_role, json.dumps(context_snapshot), generation_path, time.time()),\n34:             )\n35:             await db.commit()\n36:         return episode_id\n37: \n38:     async def complete_episode(\n39:         self,\n40:         decision_id: str,\n41:         outcome: str,\n42:         observed_state_delta: dict[str, Any],\n43:         side_effects: list[str],\n44:         duration_ms: int,\n45:         anomalies: list[str],\n46:     ) -> str | None:\n47:         snapshot = {\n48:             \"observed_state_delta\": observed_state_delta,\n49:             \"side_effects_observed\": side_effects,\n50:             \"duration_ms\": duration_ms,\n51:             \"anomalies\": anomalies,\n52:         }\n53:         async with aiosqlite.connect(self._db) as db:\n54:             async with db.execute(\n55:                 \"SELECT episode_id FROM episodes WHERE decision_id = ?\", (decision_id,)\n56:             ) as cursor:\n57:                 row = await cursor.fetchone()\n58:             if not row:\n59:                 return None\n60:             episode_id = row[0]\n61:             await db.execute(\n62:                 \"\"\"UPDATE episodes SET outcome = ?, context_snapshot = json_patch(context_snapshot, ?),\n63:                    completed_at = ? WHERE episode_id = ?\"\"\",\n64:                 (outcome, json.dumps(snapshot), time.time(), episode_id),\n65:             )\n66:             await db.commit()\n67:         return episode_id\n68: \n69:     async def write_prediction_update(\n70:         self,\n71:         episode_id: str,\n72:         prediction_delta: float,\n73:         early_reextraction_flag: bool,\n74:     ) -> None:\n75:         async with aiosqlite.connect(self._db) as db:\n76:             await db.execute(\n77:                 \"\"\"UPDATE episodes SET prediction_delta = ?, early_reextraction_flag = ?\n78:                    WHERE episode_id = ?\"\"\",\n79:                 (prediction_delta, int(early_reextraction_flag), episode_id),\n80:             )\n81:             await db.commit()\n82: \n83:     async def fetch_for_extraction(\n84:         self,\n85:         intent_class: str,\n86:         action_type: str,\n87:         entity_class: str,\n88:         actor_role: str,\n89:         limit: int = 500,\n90:     ) -> list[dict[str, Any]]:\n91:         \"\"\"Fetch completed, non-rule-based episodes for a given context tuple.\"\"\"\n92:         async with aiosqlite.connect(self._db) as db:\n93:             db.row_factory = aiosqlite.Row\n94:             async with db.execute(\n95:                 \"\"\"SELECT episode_id, outcome, prediction_delta\n96:                    FROM episodes\n97:                    WHERE intent_class = ? AND action_type = ? AND entity_class = ?\n98:                      AND actor_role = ? AND outcome IS NOT NULL\n99:                      AND generation_path = 'MODEL'\n100:                    ORDER BY created_at DESC LIMIT ?\"\"\",\n101:                 (intent_class, action_type, entity_class, actor_role, limit),\n102:             ) as cursor:\n103:                 rows = await cursor.fetchall()\n104:         return [dict(r) for r in rows]\n105: \n106:     async def fetch_for_manifest(\n107:         self,\n108:         intent_class: str,\n109:         entity_class: str,\n110:         actor_role: str,\n111:         lookback_days: int = 30,\n112:         max_episodes: int = 20,\n113:     ) -> list[dict[str, Any]]:\n114:         cutoff = time.time() - lookback_days * 86400\n115:         async with aiosqlite.connect(self._db) as db:\n116:             db.row_factory = aiosqlite.Row\n117:             async with db.execute(\n118:                 \"\"\"SELECT episode_id, action_type, entity_class, outcome, created_at\n119:                    FROM episodes\n120:                    WHERE intent_class = ? AND entity_class = ? AND actor_role = ?\n121:                      AND created_at >= ? AND outcome IS NOT NULL\n122:                    ORDER BY created_at DESC LIMIT ?\"\"\",\n123:                 (intent_class, entity_class, actor_role, cutoff, max_episodes),\n124:             ) as cursor:\n125:                 rows = await cursor.fetchall()\n126:         return [dict(r) for r in rows]\n127: \n128:     async def get_distinct_tuples(self) -> list[tuple[str, str, str, str]]:\n129:         \"\"\"All (intent_class, action_type, entity_class, actor_role) tuples with completed episodes.\"\"\"\n130:         async with aiosqlite.connect(self._db) as db:\n131:             async with db.execute(\n132:                 \"\"\"SELECT DISTINCT intent_class, action_type, entity_class, actor_role\n133:                    FROM episodes WHERE outcome IS NOT NULL\"\"\"\n134:             ) as cursor:\n135:                 rows = await cursor.fetchall()\n136:         return [tuple(r) for r in rows]\n137: \n138:     async def get_flagged_for_early_extraction(self) -> list[tuple[str, str, str, str]]:\n139:         async with aiosqlite.connect(self._db) as db:\n140:             async with db.execute(\n141:                 \"\"\"SELECT DISTINCT intent_class, action_type, entity_class, actor_role\n142:                    FROM episodes WHERE early_reextraction_flag = 1 AND outcome IS NOT NULL\"\"\"\n143:             ) as cursor:\n144:                 rows = await cursor.fetchall()\n145:         return [tuple(r) for r in rows]\n146: \n147:     async def clear_early_extraction_flags(self) -> None:\n148:         async with aiosqlite.connect(self._db) as db:\n149:             await db.execute(\"UPDATE episodes SET early_reextraction_flag = 0\")\n150:             await db.commit()\n\n(End of file - total 150 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:20:42.821Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/episodic_store.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/episodic_store.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Episodic Store — records every decision outcome for the learning loop.\"\"\"\n2: import json\n3: import time\n4: from pathlib import Path\n5: from typing import Any\n6: from uuid import uuid4\n7: \n8: import aiosqlite\n9: \n10: \n11: class EpisodicStore:\n12:     def __init__(self, db_path: Path) -> None:\n13:         self._db = db_path\n14: \n15:     async def create_episode(\n16:         self,\n17:         decision_id: str,\n18:         intent_class: str,\n19:         action_type: str,\n20:         entity_class: str,\n21:         actor_role: str,\n22:         context_snapshot: dict[str, Any],\n23:         generation_path: str = \"MODEL\",\n24:     ) -> str:\n25:         episode_id = str(uuid4())\n26:         async with aiosqlite.connect(self._db) as db:\n27:             await db.execute(\n28:                 \"\"\"INSERT INTO episodes\n29:                    (episode_id, decision_id, intent_class, action_type, entity_class,\n30:                     actor_role, context_snapshot, generation_path, created_at)\n31:                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\"\"\",\n32:                 (episode_id, decision_id, intent_class, action_type, entity_class,\n33:                  actor_role, json.dumps(context_snapshot), generation_path, time.time()),\n34:             )\n35:             await db.commit()\n36:         return episode_id\n37: \n38:     async def complete_episode(\n39:         self,\n40:         decision_id: str,\n41:         outcome: str,\n42:         observed_state_delta: dict[str, Any],\n43:         side_effects: list[str],\n44:         duration_ms: int,\n45:         anomalies: list[str],\n46:     ) -> str | None:\n47:         snapshot = {\n48:             \"observed_state_delta\": observed_state_delta,\n49:             \"side_effects_observed\": side_effects,\n50:             \"duration_ms\": duration_ms,\n51:             \"anomalies\": anomalies,\n52:         }\n53:         async with aiosqlite.connect(self._db) as db:\n54:             async with db.execute(\n55:                 \"SELECT episode_id FROM episodes WHERE decision_id = ?\", (decision_id,)\n56:             ) as cursor:\n57:                 row = await cursor.fetchone()\n58:             if not row:\n59:                 return None\n60:             episode_id = row[0]\n61:             await db.execute(\n62:                 \"\"\"UPDATE episodes SET outcome = ?, context_snapshot = json_patch(context_snapshot, ?),\n63:                    completed_at = ? WHERE episode_id = ?\"\"\",\n64:                 (outcome, json.dumps(snapshot), time.time(), episode_id),\n65:             )\n66:             await db.commit()\n67:         return episode_id\n68: \n69:     async def write_prediction_update(\n70:         self,\n71:         episode_id: str,\n72:         prediction_delta: float,\n73:         early_reextraction_flag: bool,\n74:     ) -> None:\n75:         async with aiosqlite.connect(self._db) as db:\n76:             await db.execute(\n77:                 \"\"\"UPDATE episodes SET prediction_delta = ?, early_reextraction_flag = ?\n78:                    WHERE episode_id = ?\"\"\",\n79:                 (prediction_delta, int(early_reextraction_flag), episode_id),\n80:             )\n81:             await db.commit()\n82: \n83:     async def fetch_for_extraction(\n84:         self,\n85:         intent_class: str,\n86:         action_type: str,\n87:         entity_class: str,\n88:         actor_role: str,\n89:         limit: int = 500,\n90:     ) -> list[dict[str, Any]]:\n91:         \"\"\"Fetch completed, non-rule-based episodes for a given context tuple.\"\"\"\n92:         async with aiosqlite.connect(self._db) as db:\n93:             db.row_factory = aiosqlite.Row\n94:             async with db.execute(\n95:                 \"\"\"SELECT episode_id, outcome, prediction_delta\n96:                    FROM episodes\n97:                    WHERE intent_class = ? AND action_type = ? AND entity_class = ?\n98:                      AND actor_role = ? AND outcome IS NOT NULL\n99:                      AND generation_path = 'MODEL'\n100:                    ORDER BY created_at DESC LIMIT ?\"\"\",\n101:                 (intent_class, action_type, entity_class, actor_role, limit),\n102:             ) as cursor:\n103:                 rows = await cursor.fetchall()\n104:         return [dict(r) for r in rows]\n105: \n106:     async def fetch_for_manifest(\n107:         self,\n108:         intent_class: str,\n109:         entity_class: str,\n110:         actor_role: str,\n111:         lookback_days: int = 30,\n112:         max_episodes: int = 20,\n113:     ) -> list[dict[str, Any]]:\n114:         cutoff = time.time() - lookback_days * 86400\n115:         async with aiosqlite.connect(self._db) as db:\n116:             db.row_factory = aiosqlite.Row\n117:             async with db.execute(\n118:                 \"\"\"SELECT episode_id, action_type, entity_class, outcome, created_at\n119:                    FROM episodes\n120:                    WHERE intent_class = ? AND entity_class = ? AND actor_role = ?\n121:                      AND created_at >= ? AND outcome IS NOT NULL\n122:                    ORDER BY created_at DESC LIMIT ?\"\"\",\n123:                 (intent_class, entity_class, actor_role, cutoff, max_episodes),\n124:             ) as cursor:\n125:                 rows = await cursor.fetchall()\n126:         return [dict(r) for r in rows]\n127: \n128:     async def get_distinct_tuples(self) -> list[tuple[str, str, str, str]]:\n129:         \"\"\"All (intent_class, action_type, entity_class, actor_role) tuples with completed episodes.\"\"\"\n130:         async with aiosqlite.connect(self._db) as db:\n131:             async with db.execute(\n132:                 \"\"\"SELECT DISTINCT intent_class, action_type, entity_class, actor_role\n133:                    FROM episodes WHERE outcome IS NOT NULL\"\"\"\n134:             ) as cursor:\n135:                 rows = await cursor.fetchall()\n136:         return [tuple(r) for r in rows]\n137: \n138:     async def get_flagged_for_early_extraction(self) -> list[tuple[str, str, str, str]]:\n139:         async with aiosqlite.connect(self._db) as db:\n140:             async with db.execute(\n141:                 \"\"\"SELECT DISTINCT intent_class, action_type, entity_class, actor_role\n142:                    FROM episodes WHERE early_reextraction_flag = 1 AND outcome IS NOT NULL\"\"\"\n143:             ) as cursor:\n144:                 rows = await cursor.fetchall()\n145:         return [tuple(r) for r in rows]\n146: \n147:     async def clear_early_extraction_flags(self) -> None:\n148:         async with aiosqlite.connect(self._db) as db:\n149:             await db.execute(\"UPDATE episodes SET early_reextraction_flag = 0\")\n150:             await db.commit()\n\n(End of file - total 150 lines)\n</content>"},"type":"raw"},"obs_mqv762t4_659a952d7b59":{"observation":{"hookType":"post_tool_use","id":"obs_mqv762t4_659a952d7b59","raw":{"attachments":[],"call_id":"call_03_zRRszkD3xgV55aKQwCoo2113","duration_ms":5,"metadata":{"loaded":[],"preview":"\"\"\"PostgreSQL + pgvector episodic store — Layer 2 memory.\nBacked by agentmemory (ChromaDB) with pgvector-compatible schema semantics.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom datetime import datetime, timezone, timedelta\nfrom typing import Any\n\nfrom agentmemory import create_memory, search_memory, get_memories, update_memory\n\n\nCATEGORY = \"episodes\"\n\n\nclass PgEpisodicStore:\n    def __init__(self, dsn: str | None = None) -> None:\n        self._dsn = dsn\n        self._pool = None","truncated":false},"title":"xnch/xnch/memory/pg_episodic_store.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/pg_episodic_store.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/pg_episodic_store.py</path>\n<type>file</type>\n<content>\n1: \"\"\"PostgreSQL + pgvector episodic store — Layer 2 memory.\n2: Backed by agentmemory (ChromaDB) with pgvector-compatible schema semantics.\"\"\"\n3: \n4: from __future__ import annotations\n5: \n6: import json\n7: import uuid\n8: from datetime import datetime, timezone, timedelta\n9: from typing import Any\n10: \n11: from agentmemory import create_memory, search_memory, get_memories, update_memory\n12: \n13: \n14: CATEGORY = \"episodes\"\n15: \n16: \n17: class PgEpisodicStore:\n18:     def __init__(self, dsn: str | None = None) -> None:\n19:         self._dsn = dsn\n20:         self._pool = None\n21: \n22:     async def connect(self) -> None:\n23:         pass\n24: \n25:     async def store_episode(\n26:         self,\n27:         type_: str,\n28:         raw_text: str | None = None,\n29:         summary: str | None = None,\n30:         embedding: list[float] | None = None,\n31:         importance: float = 1.0,\n32:     ) -> str:\n33:         now = datetime.now(timezone.utc)\n34:         memory_id = str(uuid.uuid4())\n35:         m = {\n36:             \"type\": type_,\n37:             \"raw_text\": raw_text or \"\",\n38:             \"summary\": summary or \"\",\n39:             \"importance\": str(importance),\n40:             \"recall_count\": \"0\",\n41:             \"last_recalled\": \"\",\n42:             \"archived\": \"False\",\n43:             \"timestamp\": now.isoformat(),\n44:         }\n45:         create_memory(\n46:             CATEGORY,\n47:             raw_text or summary or \"\",\n48:             id=memory_id,\n49:             metadata=m,\n50:         )\n51:         return memory_id\n52: \n53:     async def retrieve_similar(\n54:         self,\n55:         embedding: list[float] | None = None,\n56:         query_text: str | None = None,\n57:         top_k: int = 5,\n58:         min_score: float = 0.0,\n59:     ) -> list[dict[str, Any]]:\n60:         if embedding is None:\n61:             memories = get_memories(CATEGORY, n_results=max(50, top_k * 10))\n62:             return [\n63:                 {\n64:                     \"id\": r[\"id\"],\n65:                     \"timestamp\": r[\"metadata\"].get(\"timestamp\", \"\"),\n66:                     \"type\": r[\"metadata\"].get(\"type\", \"\"),\n67:                     \"raw_text\": r[\"metadata\"].get(\"raw_text\", \"\"),\n68:                     \"summary\": r[\"metadata\"].get(\"summary\", \"\"),\n69:                     \"embedding\": r.get(\"embedding\"),\n70:                     \"importance\": float(r[\"metadata\"].get(\"importance\", 1.0)),\n71:                     \"recall_count\": int(r[\"metadata\"].get(\"recall_count\", 0)),\n72:                     \"last_recalled\": r[\"metadata\"].get(\"last_recalled\", None),\n73:                     \"decay_score\": float(r[\"metadata\"].get(\"decay_score\", 1.0)),\n74:                     \"archived\": r[\"metadata\"].get(\"archived\", \"False\") == \"True\",\n75:                     \"similarity\": 1.0,\n76:                 }\n77:                 for r in sorted(memories, key=lambda m: m.get(\"metadata\", {}).get(\"created_at\", \"\"), reverse=True)[:top_k]\n78:             ]\n79:         search_query = query_text or ''\n80:         results = search_memory(CATEGORY, search_query, n_results=top_k, filter_metadata={\"archived\": \"False\"})\n81:         processed = []\n82:         for r in results:\n83:             dist = r.get(\"distance\", 1.0)\n84:             sim = 1.0 - dist\n85:             if sim < min_score:\n86:                 continue\n87:             processed.append({\n88:                 \"id\": r[\"id\"],\n89:                 \"timestamp\": r[\"metadata\"].get(\"timestamp\", \"\"),\n90:                 \"type\": r[\"metadata\"].get(\"type\", \"\"),\n91:                 \"raw_text\": r[\"metadata\"].get(\"raw_text\", \"\"),\n92:                 \"summary\": r[\"metadata\"].get(\"summary\", \"\"),\n93:                 \"embedding\": r.get(\"embedding\"),\n94:                 \"importance\": float(r[\"metadata\"].get(\"importance\", 1.0)),\n95:                 \"recall_count\": int(r[\"metadata\"].get(\"recall_count\", 0)),\n96:                 \"last_recalled\": r[\"metadata\"].get(\"last_recalled\", None),\n97:                 \"decay_score\": float(r[\"metadata\"].get(\"decay_score\", 1.0)),\n98:                 \"archived\": r[\"metadata\"].get(\"archived\", \"False\") == \"True\",\n99:                 \"similarity\": sim,\n100:             })\n101:         return processed\n102: \n103:     async def bump_recall(self, id: str) -> None:\n104:         mem = self._get_memory_by_id(id)\n105:         if not mem:\n106:             return\n107:         meta = dict(mem[\"metadata\"])\n108:         rc = int(meta.get(\"recall_count\", 0)) + 1\n109:         meta[\"recall_count\"] = str(rc)\n110:         meta[\"last_recalled\"] = datetime.now(timezone.utc).isoformat()\n111:         update_memory(CATEGORY, id, metadata=meta)\n112: \n113:     async def list_recent(self, hours: int = 24) -> list[dict[str, Any]]:\n114:         cutoff = datetime.now(timezone.utc) - timedelta(hours=hours)\n115:         all_mem = get_memories(CATEGORY, n_results=5000)\n116:         results = []\n117:         for r in all_mem:\n118:             ts_str = r[\"metadata\"].get(\"timestamp\", \"\")\n119:             try:\n120:                 ts = datetime.fromisoformat(ts_str)\n121:             except Exception:\n122:                 continue\n123:             if ts < cutoff:\n124:                 continue\n125:             results.append({\n126:                 \"id\": r[\"id\"],\n127:                 \"timestamp\": ts_str,\n128:                 \"type\": r[\"metadata\"].get(\"type\", \"\"),\n129:                 \"raw_text\": r[\"metadata\"].get(\"raw_text\", \"\"),\n130:                 \"summary\": r[\"metadata\"].get(\"summary\", \"\"),\n131:                 \"importance\": float(r[\"metadata\"].get(\"importance\", 1.0)),\n132:                 \"recall_count\": int(r[\"metadata\"].get(\"recall_count\", 0)),\n133:                 \"last_recalled\": r[\"metadata\"].get(\"last_recalled\", None),\n134:                 \"decay_score\": float(r[\"metadata\"].get(\"decay_score\", 1.0)),\n135:                 \"archived\": r[\"metadata\"].get(\"archived\", \"False\") == \"True\",\n136:             })\n137:         results.sort(key=lambda x: x[\"timestamp\"], reverse=True)\n138:         return results\n139: \n140:     async def execute(self, query: str, *args: Any) -> str:\n141:         for arg in args:\n142:             pass\n143:         if \"archived = TRUE\" in query or \"decay_score <\" in query:\n144:             pass\n145:         return \"OK\"\n146: \n147:     async def fetchval(self, query: str, *args: Any) -> Any:\n148:         if \"COUNT\" in query:\n149:             return len(get_memories(CATEGORY, n_results=5000))\n150:         return None\n151: \n152:     def _get_memory_by_id(self, id: str) -> dict | None:\n153:         all_mem = get_memories(CATEGORY, n_results=5000)\n154:         for m in all_mem:\n155:             if m[\"id\"] == id:\n156:                 return m\n157:         return None\n158: \n159:     async def store_decision_episode(\n160:         self,\n161:         decision_id: str,\n162:         intent_class: str,\n163:         action_type: str,\n164:         entity_class: str,\n165:         actor_role: str,\n166:         context_snapshot: dict[str, Any] | None = None,\n167:         scores_json: str | None = None,\n168:         generation_path: str = \"MODEL\",\n169:     ) -> uuid.UUID | str:\n170:         if self._pool:\n171:             async with self._pool.acquire() as conn:\n172:                 row = await conn.fetchrow(\n173:                     \"\"\"INSERT INTO decision_episodes\n174:                        (decision_id, intent_class, action_type, entity_class, actor_role,\n175:                         context_snapshot, scores_json, generation_path)\n176:                        VALUES ($1::uuid, $2, $3, $4, $5, $6::jsonb, $7, $8)\n177:                        RETURNING episode_id\"\"\",\n178:                     str(decision_id), intent_class, action_type, entity_class, actor_role,\n179:                     json.dumps(context_snapshot) if context_snapshot else None,\n180:                     scores_json, generation_path,\n181:                 )\n182:                 return row[\"episode_id"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:20:43.189Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/memory/pg_episodic_store.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/pg_episodic_store.py</path>\n<type>file</type>\n<content>\n1: \"\"\"PostgreSQL + pgvector episodic store — Layer 2 memory.\n2: Backed by agentmemory (ChromaDB) with pgvector-compatible schema semantics.\"\"\"\n3: \n4: from __future__ import annotations\n5: \n6: import json\n7: import uuid\n8: from datetime import datetime, timezone, timedelta\n9: from typing import Any\n10: \n11: from agentmemory import create_memory, search_memory, get_me