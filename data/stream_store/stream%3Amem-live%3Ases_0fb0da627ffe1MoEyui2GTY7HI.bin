\\",\\\"duration_ms\\\":4,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport hashlib\\\\nimport json\\\\nimport time\\\\nfrom datetime import datetime, timezone\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\nfrom uuid import uuid4\\\\n\\\\n\\\\nclass DecisionLedger:\\\\n    def __init__(self, ledger_path: Path) -> None:\\\\n        ledger_path.parent.mkdir(parents=True, exist_ok=True)\\\\n        self._path = ledger_path\\\\n        self._prev_hash: str = self._read_last_hash()\\\\n\\\\n    def _read_last_hash(self) -> str:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Read the hash of the last entry; genesis hash if ledger is empty.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        if not self._path.exists():\\\\n            return \\\\\\\"sha256:\\\\\\\" + \\\\\\\"0\\\\\\\" * 64\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/audit/ledger.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import hashlib\\\\n3: import json\\\\n4: import time\\\\n5: from datetime import datetime, timezone\\\\n6: from pathlib import Path\\\\n7: from typing import Any\\\\n8: from uuid import uuid4\\\\n9: \\\\n10: \\\\n11: class DecisionLedger:\\\\n12:     def __init__(self, ledger_path: Path) -> None:\\\\n13:         ledger_path.parent.mkdir(parents=True, exist_ok=True)\\\\n14:         self._path = ledger_path\\\\n15:         self._prev_hash: str = self._read_last_hash()\\\\n16: \\\\n17:     def _read_last_hash(self) -> str:\\\\n18:         \\\\\\\"\\\\\\\"\\\\\\\"Read the hash of the last entry; genesis hash if ledger is empty.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n19:         if not self._path.exists():\\\\n20:             return \\\\\\\"sha256:\\\\\\\" + \\\\\\\"0\\\\\\\" * 64\\\\n21:         last_hash = \\\\\\\"sha256:\\\\\\\" + \\\\\\\"0\\\\\\\" * 64\\\\n22:         try:\\\\n23:             with self._path.open() as fh:\\\\n24:                 for line in fh:\\\\n25:                     line = line.strip()\\\\n26:                     if line:\\\\n27:                         entry = json.loads(line)\\\\n28:                         last_hash = entry.get(\\\\\\\"hash\\\\\\\", last_hash)\\\\n29:         except Exception:\\\\n30:             pass\\\\n31:         return last_hash\\\\n32: \\\\n33:     def write(\\\\n34:         self,\\\\n35:         decision_id: str,\\\\n36:         trace_id: str,\\\\n37:         intent_hash: str,\\\\n38:         candidates_count: int,\\\\n39:         selected_option_id: str | None,\\\\n40:         scores: dict[str, Any],\\\\n41:         audit_ref: str,\\\\n42:     ) -> str:\\\\n43:         entry: dict[str, Any] = {\\\\n44:             \\\\\\\"decision_id\\\\\\\": decision_id,\\\\n45:             \\\\\\\"timestamp\\\\\\\": datetime.now(timezone.utc).isoformat(),\\\\n46:             \\\\\\\"trace_id\\\\\\\": trace_id,\\\\n47:             \\\\\\\"intent_hash\\\\\\\": intent_hash,\\\\n48:             \\\\\\\"candidates_count\\\\\\\": candidates_count,\\\\n49:             \\\\\\\"selected_option_id\\\\\\\": selected_option_id,\\\\n50:             \\\\\\\"scores\\\\\\\": scores,\\\\n51:             \\\\\\\"audit_ref\\\\\\\": audit_ref,\\\\n52:             \\\\\\\"prev_hash\\\\\\\": self._prev_hash,\\\\n53:         }\\\\n54:         content = json.dumps(\\\\n55:             {k: v for k, v in entry.items()},\\\\n56:             sort_keys=True,\\\\n57:         )\\\\n58:         entry_hash = \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(content.encode()).hexdigest()\\\\n59:         entry[\\\\\\\"hash\\\\\\\"] = entry_hash\\\\n60: \\\\n61:         with self._path.open(\\\\\\\"a\\\\\\\") as fh:\\\\n62:             fh.write(json.dumps(entry) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n63: \\\\n64:         self._prev_hash = entry_hash\\\\n65:         return audit_ref\\\\n66: \\\\n67:     @staticmethod\\\\n68:     def verify_chain(ledger_path: Path) -> bool:\\\\n69:         if not ledger_path.exists():\\\\n70:             return True\\\\n71:         prev_entry = None\\\\n72:         with ledger_path.open() as fh:\\\\n73:             for line in fh:\\\\n74:                 line = line.strip()\\\\n75:                 if not line:\\\\n76:                     continue\\\\n77:                 entry = json.loads(line)\\\\n78:                 if prev_entry:\\\\n79:                     if entry.get(\\\\\\\"prev_hash\\\\\\\") != prev_entry.get(\\\\\\\"hash\\\\\\\"):\\\\n80:                         return False\\\\n81:                     content = json.dumps(\\\\n82:                         {k: v for k, v in entry.items() if k != \\\\\\\"hash\\\\\\\"},\\\\n83:                         sort_keys=True,\\\\n84:                     )\\\\n85:                     expected = \\\\\\\"sha256:\\\\\\\" + hashlib.sha256(content.encode()).hexdigest()\\\\n86:                     if entry.get(\\\\\\\"hash\\\\\\\") != expected:\\\\n87:                         return False\\\\n88:                 prev_entry = entry\\\\n89:         return True\\\\n\\\\n(End of file - total 89 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:21:33.602Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import hashlib\\\\n3: import json\\\\n4: import time\\\\n5: from datetim