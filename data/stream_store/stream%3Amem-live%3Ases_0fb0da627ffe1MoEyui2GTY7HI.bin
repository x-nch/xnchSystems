cio.run_coroutine_threadsafe(\\n32:                         self._watcher._on_file_changed(event.src_path),\\n33:                         loop,\\n34:                     )\\n35: \\n36:                 def on_created(self, event):\\n37:                     if event.is_directory:\\n38:                         return\\n39:                     asyncio.run_coroutine_threadsafe(\\n40:                         self._watcher._on_file_changed(event.src_path),\\n41:                         loop,\\n42:                     )\\n43: \\n44:             self._observer = Observer()\\n45:             self._observer.schedule(\\n46:                 VaultHandler(self),\\n47:                 self._vault_dir,\\n48:                 recursive=True,\\n49:             )\\n50:             self._observer.start()\\n51: \\n52:         await loop.run_in_executor(None, _start)\\n53: \\n54:     async def stop(self) -> None:\\n55:         if self._observer is not None:\\n56:             loop = asyncio.get_running_loop()\\n57:             await loop.run_in_executor(None, self._observer.stop)\\n58:             self._observer = None\\n59: \\n60:     async def _on_file_changed(self, path: str) -> None:\\n61:         now = time.time()\\n62:         last = self._last_event.get(path, 0.0)\\n63:         if now - last < self._debounce_s:\\n64:             return\\n65:         self._last_event[path] = now\\n66:         payload = {\\n67:             \\\"file_path\\\": path,\\n68:             \\\"event\\\": \\\"modified\\\",\\n69:             \\\"timestamp\\\": now,\\n70:         }\\n71:         async with httpx.AsyncClient(timeout=10.0) as client:\\n72:             try:\\n73:                 await client.post(self._k8s_jobs_url, json=payload)\\n74:             except Exception:\\n75:                 pass\\n\\n(End of file - total 75 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:20:51.435Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/