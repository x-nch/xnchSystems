ability_set\\n24: \\n25:     def to_dict(self) -> dict[str, Any]:\\n26:         return {\\\"id\\\": self.id, \\\"role\\\": self.role, \\\"capability_set\\\": self.capability_set}\\n27: \\n28: \\n29: class GovernanceStore:\\n30:     def __init__(self, db_path: Path) -> None:\\n31:         self._db_path = db_path\\n32: \\n33:     async def resolve_actor(self, actor_id: str) -> Actor | None:\\n34:         async with aiosqlite.connect(self._db_path) as db:\\n35:             async with db.execute(\\n36:                 \\\"SELECT actor_id, role, capability_set FROM actors WHERE actor_id = ?\\\",\\n37:                 (actor_id,),\\n38:             ) as cursor:\\n39:                 row = await cursor.fetchone()\\n40:         if not row:\\n41:             return None\\n42:         return Actor(row[0], row[1], json.loads(row[2]))\\n43: \\n44:     async def upsert_actor(self, actor_id: str, role: str, capability_set: list[str]) -> None:\\n45:         async with aiosqlite.connect(self._db_path) as db:\\n46:             await db.execute(\\n47:                 \\\"\\\"\\\"INSERT INTO actors (actor_id, role, capability_set, created_at, updated_at)\\n48:                    VALUES (?, ?, ?, unixepoch(), unixepoch())\\n49:                    ON CONFLICT(actor_id) DO UPDATE SET\\n50:                      role=excluded.role,\\n51:                      capability_set=excluded.capability_set,\\n52:                      updated_at=excluded.updated_at\\\"\\\"\\\",\\n53:                 (actor_id, role, json.dumps(capability_set)),\\n54:             )\\n55:             await db.commit()\\n56: \\n57:     async def bootstrap(self) -> None:\\n58:         \\\"\\\"\\\"Insert default actors if the table is empty.\\\"\\\"\\\"\\n59:         async with aiosqlite.connect(self._db_path) as db:\\n60:             async with db.execute(\\\"SELECT COUNT(*) FROM actors\\\") as cursor:\\n61:                 count = (await cursor.fetchone())[0]\\n62:         if count == 0:\\n63:             for a in _BOOTSTRAP_ACTORS:\\n64:                 await self.upsert_actor(a[\\\"actor_id\\\"], a[\\\"role\\\"], a[\\\"capability_set\\\"])\\n\\n(End of file - total 64 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:21:33.889Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Actor → role + capability_set resolution from the governance store.\\\"\\\"\\\"\\n2: import json\\n3: from pathlib import Path\\n4: from typing import Any\\n5: \\n6: import aiosqlite\\n7: \\n8: from ..config import settings\\n9: \\n10: \\n11: _BOOTSTRAP_ACTORS = [\\n12:     {\\\"actor_id\\\": \\\"admin\\\", \\\"role\\\": \\\"ADMIN\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\", \\\"ADMIN\\\", \\\"SCHEMA_WRITE\\\"]},\\n13:     {\\\"actor_id\\\": \\\"operator\\\", \\\"role\\\": \\\"OPERATOR\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\"]},\\n14:     {\\\"actor_id\\\": \\\"viewer\\\", \\\"role\\\": \\\"VIEWER\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\"]},\\n15:     {\\\"actor_id\\\": \\\"agent\\\", \\\"role\\\": \\\"AGENT\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\", \\\"DEPLOY\\\"]},\\n16: ]\\n17: \\n18: \\n19: class Actor:\\n20:     def __init__(self, actor_id: str, role: str, capability_set: list[str]) -> None:\\n21:         self.id = actor_id\\n22:         self.role = role\\n23:         self.capability_set = capability_set\\n24: \\n25:     def to_dict(self) -> dict[str, Any]:\\n26:         return {\\\"id\\\": self.id, \\\"role\\\": self.role, \\\"capability_set\\\": self.capability_set}\\n27: \\n28: \\n29: class GovernanceStore:\\n30:     def __init__(self, db_path: Path) -> None:\\n31:         self._db_path = db_path\\n32: \\n33:     async def resolve_actor(self, actor_id: 