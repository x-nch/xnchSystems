Model):\n71:     pattern_id: UUID\n72:     context_signature: str\n73:     success_rate: float\n74:     confidence: float\n75:     observation_count: int\n76: \n77: \n78: class PolicyRef(BaseModel):\n79:     policy_id: str\n80:     rule_expression: str\n81:     enforcement_level: str\n82: \n83: \n84: class ContextManifest(BaseModel):\n85:     manifest_id: UUID = Field(default_factory=uuid4)\n86:     session_id: UUID\n87:     system_state_version: str\n88:     pinned_at: datetime = Field(default_factory=lambda: datetime.now(timezone.utc))\n89:     episodes: list[EpisodeRef] = Field(default_factory=list)\n90:     patterns: list[PatternRef] = Field(default_factory=list)\n91:     policies: list[PolicyRef] = Field(default_factory=list)\n\n(End of file - total 91 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:38.246Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/nexi/nexi/models/outcomes.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/nexi/nexi/models/outcomes.py</path>\n<type>file</type>\n<content>\n1: from datetime import datetime, timezone\n2: from enum import StrEnum\n3: from typing import Any\n4: from uuid import UUID, uuid4\n5: \n6: from pydantic import BaseModel, Field\n7: \n8: \n9: class OutcomeStatus(StrEnum):\n10:     SUCCESS = \"SUCCESS\"\n11:     PARTIAL = \"PARTIAL\"\n12:     FAILURE = \"FAILURE\"\n13:     ROLLED_BACK = \"ROLLED_BACK\"\n14: \n15: \n16: class VerdictResponse(BaseModel):\n17:     request_id: UUID\n18:     verdict: str\n19:     verdict_reason: str\n20:     policy_refs: list[str]\n21:     modified_action: dict[str, Any] | None = None\n22:     execution_token: str | None = None\n23:     token_ttl_ms: int\n24:     audit_ref: UUID\n25: \n26: \n27: class ExecutionDispatchPayload(BaseModel):\n28:     execution_ref: UUID = Field(default_factory=uuid4)\n29:     trace_id: UUID\n30:     decision_id: UUID\n31:     action_spec: dict[str, Any]\n32:     execution_token: str\n33:    