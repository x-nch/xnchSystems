)\n</entries>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:05.645Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/deploy/openclaw\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/deploy/openclaw</path>\n<type>directory</type>\n<entries>\nconfig.yaml\nstart_nexi.sh\n\n(2 entries)\n</entries>"},"type":"raw"},"obs_mqv76nc3_cc6bc72b00e1":{"observation":{"hookType":"post_tool_use","id":"obs_mqv76nc3_cc6bc72b00e1","raw":{"attachments":[],"call_id":"call_01_xyCXbHvQpDI72dz5XykD9091","duration_ms":9,"metadata":{"loaded":[],"preview":"FROM python:3.11-slim\n\nWORKDIR /app\n\nCOPY nexi/ /app/nexi/\nCOPY nexi/pyproject.toml /app/nexi/\nCOPY nexi/uv.lock /app/nexi/\n\nRUN pip install --no-cache-dir -e /app/nexi\n\nEXPOSE 8000\n\nCMD [\"uvicorn\", \"nexi.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]","truncated":false},"title":"deploy/docker/nexi.Dockerfile","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/deploy/docker/nexi.Dockerfile\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/deploy/docker/nexi.Dockerfile</path>\n<type>file</type>\n<content>\n1: FROM python:3.11-slim\n2: \n3: WORKDIR /app\n4: \n5: COPY nexi/ /app/nexi/\n6: COPY nexi/pyproject.toml /app/nexi/\n7: COPY nexi/uv.lock /app/nexi/\n8: \n9: RUN pip install --no-cache-dir -e /app/nexi\n10: \n11: EXPOSE 8000\n12: \n13: CMD [\"uvicorn\", \"nexi.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n\n(End of file - total 13 lines)\n</content>"},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:09.792Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/deploy/docker/nexi.Dockerfile\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/deploy/docker/nexi.Dockerfile</path>\n<type>file</type>\n<content>\n1: FROM python:3.11-slim\n2: \n3: WORKDIR /app\n4: \n5: COPY nexi/ /app/nexi/\n6: COPY nexi/pyproject.toml /app/nexi/\n7: COPY nexi/uv.lock /app/nexi/\n8: \n9: RUN pip install --no-cache-dir -e /app/nexi\n10: \n11: EXPOSE 8000\n12: \n13: CMD [\"uvicorn\", \"nexi.main:app\", \"--host\", \"0.0.0.0\", \"--port\", \"8000\"]\n\n(End of file - total 13 lines)\n</content>"},"type":"raw"},"obs_mqv76nc5_e5b63e206412":{"observation":{"hookType":"post_tool_use","id":"obs_mqv76nc5_e5b63e206412","raw":{"attachments":[],"call_id":"call_00_vyfzqVXt7Z2xvgwhUTVY8401","duration_ms":27,"metadata":{"loaded":[],"preview":"import json\nimport logging\nimport os\nfrom typing import Any\nfrom uuid import uuid4\n\nimport httpx\nfrom fastapi import APIRouter, HTTPException, Request\nfrom fastapi.responses import PlainTextResponse, StreamingResponse\nfrom pydantic import BaseModel\n\nfrom nexi.character.prompt_loader import build_system_prompt\nfrom nexi.pipeline.context_assembler import assemble_context\nfrom nexi.proactivity.engine import ProactivityEngine\nfrom xnch.routing.classifier import classify_request\nfrom xnch.security.injection_guard import scan_input\n\nlogger = logging.getLogger(__name__)\nrouter = APIRouter(prefix=\"/nexi\", tags=[\"nexi\"])\n","truncated":false},"title":"xnch/xnch/routes/nexi_gateway.py","tool_input":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\"}","tool_name":"read","tool_output":"<path>/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py</path>\n<type>file</type>\n<content>\n1: import json\n2: import logging\n3: import os\n4: from typing import Any\n5: from uuid import uuid4\n6: \n7: import httpx\n8: from fastapi import APIRouter, HTTPException, Request\n9: from fastapi.responses import PlainTextResponse, StreamingResponse\n10: from pydantic import BaseModel\n11: \n12: from nexi.character.prompt_loader import build_system_prompt\n13: from nexi.pipeline.context_assembler import assemble_context\n14: from nexi.proactivity.engine import ProactivityEngine\n15: from xnch.routing.classifier import classify_request\n16: from xnch.security.injection_guard import scan_input\n17: \n18: logger = logging.getLogger(__name__)\n19: router = APIRouter(prefix=\"/nexi\", tags=[\"nexi\"])\n20: \n21: SYSTEM_PROMPT_CACHE_KEY = \"nexi:system-prompt\"\n22: SYSTEM_PROMPT_CACHE_TTL = 60\n23: \n24: LITELLM_BASE = os.environ.get(\"LITELLM_BASE_URL\", \"http://i7-node:4000\")\n25: LITELLM_API_KEY = os.environ.get(\"LITELLM_API_KEY\", \"\")\n26: \n27: \n28: class ChatRequest(BaseModel):\n29:     session_id: str\n30:     message: str\n31:     actor_role: str = \"openclaw\"\n32: \n33: \n34: class MemoryRecallRequest(BaseModel):\n35:     query: str\n36:     top_k: int = 5\n37: \n38: \n39: def _get_proactivity(app) -> ProactivityEngine:\n40:     if not hasattr(app, \"_nexi_proactivity\"):\n41:         redis = app.kv_cache._redis\n42:         app._nexi_proactivity = ProactivityEngine(redis)\n43:     return app._nexi_proactivity\n44: \n45: \n46: def _invalidate_system_prompt_cache(app) -> None:\n47:     redis = app.kv_cache._redis\n48:     try:\n49:         import asyncio\n50:         asyncio.ensure_future(redis.delete(SYSTEM_PROMPT_CACHE_KEY))\n51:     except Exception:\n52:         pass\n53: \n54: \n55: @router.get(\"/system-prompt\", response_class=PlainTextResponse)\n56: async def get_system_prompt(request: Request) -> str:\n57:     app = request.app.state\n58:     redis = app.kv_cache._redis\n59: \n60:     cached = await redis.get(SYSTEM_PROMPT_CACHE_KEY)\n61:     if cached:\n62:         return cached\n63: \n64:     from agentmemory import get_memories\n65:     entities = get_memories(\"entities\", n_results=20)\n66:     recent_entities = [e.get(\"document\", \"\") for e in entities if e.get(\"document\")]\n67: \n68:     prompt = build_system_prompt(session_memory=[], recent_entities=recent_entities)\n69:     await redis.set(SYSTEM_PROMPT_CACHE_KEY, prompt, ex=SYSTEM_PROMPT_CACHE_TTL)\n70:     return prompt\n71: \n72: \n73: @router.post(\"/chat\")\n74: async def chat(body: ChatRequest, request: Request) -> dict[str, Any]:\n75:     app = request.app.state\n76: \n77:     result = scan_input(body.message, app.event_log)\n78:     if not result.is_clean:\n79:         raise HTTPException(status_code=400, detail=\"Input rejected by injection guard\")\n80: \n81:     ctx = await assemble_context(\n82:         session_id=body.session_id,\n83:         raw_input=body.message,\n84:         working_memory=app.working_memory,\n85:         pg_episodic=app.pg_episodic,\n86:         graph_store=app.graph_store,\n87:         relationship_store=app.relationship_store,\n88:         sensory_buffer=app.sensory_buffer,\n89:         proactivity_engine=_get_proactivity(app),\n90:     )\n91: \n92:     route = classify_request(body.message, body.actor_role, {})\n93:     messages = ctx.to_messages(body.message)\n94:     model_name = route.model_name\n95: \n96:     try:\n97:         async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\n98:             resp = await client.post(\n99:                 \"/chat/completions\",\n100:                 json={\n101:                     \"model\": model_name,\n102:                     \"messages\": messages,\n103:                     \"max_tokens\": 2048,\n104:                     \"temperature\": 0.7,\n105:                 },\n106:                 headers={\"Authorization\": f\"Bearer {LITELLM_API_KEY}\"} if LITELLM_API_KEY else {},\n107:             )\n108:             resp.raise_for_status()\n109:             response_text = resp.json()[\"choices\"][0][\"message\"][\"content\"]\n110:     except Exception as exc:\n111:         logger.error(\"LiteLLM call failed: %s\", exc)\n112:         raise HTTPException(status_code=502, detail=\"LiteLLM unavailable\")\n113: \n114:     await app.working_memory.append_turn(body.session_id, \"user\", body.message)\n115:     await app.working_memory.append_turn(body.session_id, \"assistant\", response_text)\n116: \n117:     await app.pg_episodic.store_episode(\n118:         type_=\"conversation\",\n119:         raw_text=f\"{body.message}\\n{response_text}\",\n120:         summary=f\"OpenClaw chat: {body.message[:100]}\",\n121:     )\n122: \n123:     _invalidate_system_prompt_cache(app)\n124: \n125:     return {\n126:         \"response\": response_text,\n127:         \"model_used\": model_name,\n128:         \"session_id\": body.session_id,\n129:     }\n130: \n131: \n132: @router.post(\"/chat/stream\")\n133: async def chat_stream(body: ChatRequest, request: Request) -> StreamingResponse:\n134:     app = request.app.state\n135: \n136:     result = scan_input(body.message, app.event_log)\n137:     if not result.is_clean:\n138:         raise HTTPException(status_code=400, detail=\"Input rejected by injection guard\")\n139: \n140:     ctx = await assemble_context(\n141:         session_id=body.session_id,\n142:         raw_input=body.message,\n143:         working_memory=app.working_memory,\n144:         pg_episodic=app.pg_episodic,\n145:         graph_store=app.graph_store,\n146:         relationship_store=app.relationship_store,\n147:         sensory_buffer=app.sensory_buffer,\n148:         proactivity_engine=_get_proactivity(app),\n149:     )\n150: \n151:     route = classify_request(body.message, body.actor_role, {})\n152:     messages = ctx.to_messages(body.message)\n153:     model_name = route.model_name\n154: \n155:     await app.working_memory.append_turn(body.session_id, \"user\", body.message)\n156: \n157:     async def event_stream():\n158:         full_text = \"\"\n159:         try:\n160:             async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\n161:                 async with client.stream(\n162:                     \"POST\",\n163:                     \"/chat/completions\",\n164:                     json={\n165:                         \"model\": model_name,\n166:                         \"messages\": messages,\n167:                         \"max_tokens\": 2048,\n168:                         \"temperature\": 0.7,\n169:                         \"stream\": True,\n170:                     },\n171:                     headers={\"Authorization\": f\"Bearer {LITELLM_API_KEY}\"} if LITELLM_API_KEY else {},\n172:                 ) as resp:\n173:                     if resp.status_code != 200:\n174:                         yield f\"data: {json.dumps({'error': f'LiteLLM error {resp.status_code}'})}\\n\\n\"\n175:                         yield \"data: [DONE]\\n\\n\"\n176:                         return\n177:                     async for line in resp.aiter_lines():\n178:                         if not line.startswith(\"data: \"):\n179:                             continue\n180:                         payload = line.removeprefix(\"data: \")\n181:                         if payload == \"[DONE]\":\n182:                             break\n183:                         try:\n184:                             chunk = json.loads(payload)\n185:                             delta = chunk.get(\"choices\", [{}])[0].get(\"delta\", {}).get(\"content\", \"\")\n186:                             if delta:\n187:                                 full_text += delta\n188:                                 yield f\"data: {json.dumps({'content': delta})}\\n\\n\"\n189:                         except json.JSONDecodeError:\n190:                             continue\n191:         except Exception as exc:\n192:             logger.error(\"LiteLLM stream failed: %s\", exc)\n193:             yield f\"data: {json.dumps({'error': 'LiteLLM unavailable'})}\\n\\n\"\n194:             yield \"data: [DONE]\\n\\n\"\n195:             return\n196: \n197:         await app.working_memory.append_turn(body.session_id, \"assistant\""},"sessionId":"ses_0fb0da627ffe1MoEyui2GTY7HI","timestamp":"2026-06-26T17:21:09.794Z","toolInput":"{\"filePath\":\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\"}","toolName":"read","toolOutput":"<path>/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py</path>\n<type>file</type>\n<content>\n1: import json\n2: import logging\n3: import os\n4: from typing import Any\n5: from uuid import