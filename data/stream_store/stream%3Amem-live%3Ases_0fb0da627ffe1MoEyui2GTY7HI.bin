e</type>\\n<content>\\n1: \\\"\\\"\\\"Append-only Event Log — fire-and-forget, never blocks the request path.\\\"\\\"\\\"\\n2: import json\\n3: import time\\n4: from datetime import datetime, timezone\\n5: from pathlib import Path\\n6: from typing import Any\\n7: \\n8: \\n9: class EventLog:\\n10:     def __init__(self, events_path: Path) -> None:\\n11:         events_path.parent.mkdir(parents=True, exist_ok=True)\\n12:         self._path = events_path\\n13: \\n14:     def emit(\\n15:         self,\\n16:         trace_id: str,\\n17:         component: str,\\n18:         event_type: str,\\n19:         level: str = \\\"INFO\\\",\\n20:         message: str = \\\"\\\",\\n21:         data: dict[str, Any] | None = None,\\n22:     ) -> None:\\n23:         event = {\\n24:             \\\"timestamp\\\": datetime.now(timezone.utc).isoformat(),\\n25:             \\\"level\\\": level,\\n26:             \\\"component\\\": component,\\n27:             \\\"event_type\\\": event_type,\\n28:             \\\"message\\\": message,\\n29:             \\\"data\\\": data or {},\\n30:             \\\"trace_id\\\": trace_id,\\n31:         }\\n32:         try:\\n33:             with self._path.open(\\\"a\\\") as fh:\\n34:                 fh.write(json.dumps(event) + \\\"\\\\n\\\")\\n35:         except Exception:\\n36:             pass\\n\\n(End of file - total 36 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:21:33.294Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/audit/event_log.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/audit/event_log.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Append-only Event Log — fire-and-forget, never blocks the request path.\\\"\\\"\\\"\\n2: import json\\n3: import time\\n4: from datetime import datetime, timezone\\n5: from pathlib import Path\\n6: from typing import Any\\n7: \\n8: \\n9: class EventLog:\\n10:     def __init__(self, events_path: Path) -> None:\\n11:         events_path.parent.mkdir(parents=True, exist_ok=True)\\n12:         self._path = events_path\\n13: \\n14:     def emit(\\n15:         self,\\n16:         trace_id: str,\\n17:         component: str,\\n18:         event_type: str,\\n19:         level: str = \\\"INFO\\\",\\n20:         message: str = \\\"\\\",\\n21:         data: dict[str, Any] | None = None,\\n22:     ) -> None:\\n23:         event = {\\n24:             \\\"timestamp\\\": datetime.now(timezone.utc).isoformat(),\\n25:             \\\"level\\\": level,\\n26:             \\\"component\\\": component,\\n27:             \\\"event_type\\\": event_type,\\n28:             \\\"message\\\": message,\\n29:             \\\"data\\\": data or {},\\n30:             \\\"trace_id\\\": trace_id,\\n31:         }\\n32:         try:\\n33:             with self._path.open(\\\"a\\\") as fh:\\n34:                 fh.write(json.dumps(event) + \\\"\\\\n\\\")\\n35:         except Exception:\\n36:             pass\\n\\n(End of file - total 36 lines)\\n</content>\"},\"type\":\"raw\"},\"obs_mqv775pf_8df6c8616fde\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv775pf_8df6c8616fde\",\"raw\":{\"attachments\":[],\"call_id\":\"call_06_XGPvBE5Fjhvr4O3GwxrG3033\",\"duration_ms\":4,\"metadata\":{\"loaded\":[],\"preview\":\"\\\"\\\"\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\"\\\"\\\"\\nimport hashlib\\nimport json\\nimport time\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\nfrom typing import Any\\nfrom uuid import uuid4\\n\\n\\nclass DecisionLedger:\\n    def __init__(self, ledger_path: Path) -> None:\\n        ledger_path.parent.mkdir(parents=True, exist_ok=True)\\n        self._path = ledger_path\\n        self._prev_hash: str = self._read_last_hash()\\n\\n    def _read_last_hash(self) -> str:\\n        \\\"\\\"\\\"Read the hash of the last entry; genesis hash if ledger is empty.\\\"\\\"\\\"\\n        if not self._path.exists():\\n            return \\\"sha256:\\\" + \\\"0\\\" * 64\",\"truncated\":false},\"title\":\"xnch/xnch/audit/ledger.py\",\"tool_input\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py\\\"}\",\"tool_name\":\"read\",\"tool_output\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\"\\\"\\\"\\n2: import hashlib\\n3: import json\\n4: import time\\n5: from datetime import datetime, timezone\\n6: from pathlib import Path\\n7: from typing import Any\\n8: from uuid import uuid4\\n9: \\n10: \\n11: class DecisionLedger:\\n12:     def __init__(self, ledger_path: Path) -> None:\\n13:         ledger_path.parent.mkdir(parents=True, exist_ok=True)\\n14:         self._path = ledger_path\\n15:         self._prev_hash: str = self._read_last_hash()\\n16: \\n17:     def _read_last_hash(self) -> str:\\n18:         \\\"\\\"\\\"Read the hash of the last entry; genesis hash if ledger is empty.\\\"\\\"\\\"\\n19:         if not self._path.exists():\\n20:             return \\\"sha256:\\\" + \\\"0\\\" * 64\\n21:         last_hash = \\\"sha256:\\\" + \\\"0\\\" * 64\\n22:         try:\\n23:             with self._path.open() as fh:\\n24:                 for line in fh:\\n25:                     line = line.strip()\\n26:                     if line:\\n27:                         entry = json.loads(line)\\n28:                         last_hash = entry.get(\\\"hash\\\", last_hash)\\n29:         except Exception:\\n30:             pass\\n31:         return last_hash\\n32: \\n33:     def write(\\n34:         self,\\n35:         decision_id: str,\\n36:         trace_id: str,\\n37:         intent_hash: str,\\n38:         candidates_count: int,\\n39:         selected_option_id: str | None,\\n40:         scores: dict[str, Any],\\n41:         audit_ref: str,\\n42:     ) -> str:\\n43:         entry: dict[str, Any] = {\\n44:             \\\"decision_id\\\": decision_id,\\n45:             \\\"timestamp\\\": datetime.now(timezone.utc).isoformat(),\\n46:             \\\"trace_id\\\": trace_id,\\n47:             \\\"intent_hash\\\": intent_hash,\\n48:             \\\"candidates_count\\\": candidates_count,\\n49:             \\\"selected_option_id\\\": selected_option_id,\\n50:             \\\"scores\\\": scores,\\n51:             \\\"audit_ref\\\": audit_ref,\\n52:             \\\"prev_hash\\\": self._prev_hash,\\n53:         }\\n54:         content = json.dumps(\\n55:             {k: v for k, v in entry.items()},\\n56:             sort_keys=True,\\n57:         )\\n58:         entry_hash = \\\"sha256:\\\" + hashlib.sha256(content.encode()).hexdigest()\\n59:         entry[\\\"hash\\\"] = entry_hash\\n60: \\n61:         with self._path.open(\\\"a\\\") as fh:\\n62:             fh.write(json.dumps(entry) + \\\"\\\\n\\\")\\n63: \\n64:         self._prev_hash = entry_hash\\n65:         return audit_ref\\n66: \\n67:     @staticmethod\\n68:     def verify_chain(ledger_path: Path) -> bool:\\n69:         if not ledger_path.exists():\\n70:             return True\\n71:         prev_entry = None\\n72:         with ledger_path.open() as fh:\\n73:             for line in fh:\\n74:                 line = line.strip()\\n75:                 if not line:\\n76:                     continue\\n77:                 entry = json.loads(line)\\n78:                 if prev_entry:\\n79:                     if entry.get(\\\"prev_hash\\\") != prev_entry.get(\\\"hash\\\"):\\n80:                         return False\\n81:                     content = json.dumps(\\n82:                         {k: v for k, v in entry.items() if k != \\\"hash\\\"},\\n83:                         sort_keys=True,\\n84:                     )\\n85:                     expected = \\\"sha256:\\\" + hashlib.sha256(content.encode()).hexdigest()\\n86:                     if entry.get(\\\"hash\\\") != expected:\\n87:                         return False\\n88:                 prev_entry = entry\\n89:         return True\\n\\n(End of file - total 89 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:21:33.602Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/audit/ledger.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Decision Ledger — SHA-256 chained, append-only, tamper-evident.\\\"\\\"\\\"\\n2: import hashlib\\n3: import json\\n4: import time\\n5: from datetime import datetime, timezone\\n6: from pathlib import Path\\n7: from typing import Any\\n8: from uuid import uuid4\\n9: \\n10: \\n11: class DecisionLedger:\\n12:     def __init__(self, ledger_path: Path) -> None:\\n13:         ledger_path.parent.mkdir(parents=True, exist_ok=True)\\n14:         self._path = ledger_path\\n15:         self._prev_hash: str = self._read_last_hash()\\n16: \\n17:     def _read_last_hash(self) -> str:\\n18:         \\\"\\\"\\\"Read the hash of the last entry; genesis hash if ledger is empty.\\\"\\\"\\\"\\n19:         if not self._path.exists():\\n20:             return \\\"sha256:\\\" + \\\"0\\\" * 64\\n21:         last_hash = \\\"sha256:\\\" + \\\"0\\\" * 64\\n22:         try:\\n23:             with self._path.open() as fh:\\n24:                 for line in fh:\\n25:                     line = line.strip()\\n26:                     if line:\\n27:                         entry = json.loads(line)\\n28:                         last_hash = entry.get(\\\"hash\\\", last_hash)\\n29:         except Exception:\\n30:             pass\\n31:         return last_hash\\n32: \\n33:     def write(\\n34:         self,\\n35:         decision_id: str,\\n36:         trace_id: str,\\n37:         intent_hash: str,\\n38:         candidates_count: int,\\n39:         selected_option_id: str | None,\\n40:         scores: dict[str, Any],\\n41:         audit_ref: str,\\n42:     ) -> str:\\n43:         entry: dict[str, Any] = {\\n44:             \\\"decision_id\\\": decision_id,\\n45:             \\\"timestamp\\\": datetime.now(timezone.utc).isoformat(),\\n46:             \\\"trace_id\\\": trace_id,\\n47:             \\\"intent_hash\\\": intent_hash,\\n48:             \\\"candidates_count\\\": candidates_count,\\n49:             \\\"selected_option_id\\\": selected_option_id,\\n50:             \\\"scores\\\": scores,\\n51:             \\\"audit_ref\\\": audit_ref,\\n52:             \\\"prev_hash\\\": self._prev_hash,\\n53:         }\\n54:         content = json.dumps(\\n55:             {k: v for k, v in entry.items()},\\n56:             sort_keys=True,\\n57:         )\\n58:         entry_hash = \\\"sha256:\\\" + hashlib.sha256(content.encode()).hexdigest()\\n59:         entry[\\\"hash\\\"] = entry_hash\\n60: \\n61:         with self._path.open(\\\"a\\\") as fh:\\n62:             fh.write(json.dumps(entry) + \\\"\\\\n\\\")\\n63: \\n64:         self._prev_hash = entry_hash\\n65:         return audit_ref\\n66: \\n67:     @staticmethod\\n68:     def verify_chain(ledger_path: Path) -> bool:\\n69:         if not ledger_path.exists():\\n70:             return True\\n71:         prev_entry = None\\n72:         with ledger_path.open() as fh:\\n73:             for line in fh:\\n74:                 line = line.strip()\\n75:                 if not line:\\n76:                     continue\\n77:                 entry = json.loads(line)\\n78:                 if prev_entry:\\n79:                     if entry.get(\\\"prev_hash\\\") != prev_entry.get(\\\"hash\\\"):\\n80:                         return False\\n81:                     content = json.dumps(\\n82:                         {k: v for k, v in entry.items() if k != \\\"hash\\\"},\\n83:                         sort_keys=True,\\n84:                     )\\n85:                     expected = \\\"sha256:\\\" + hashlib.sha256(content.encode()).hexdigest()\\n86:                     if entry.get(\\\"hash\\\") != expected:\\n87:                         return False\\n88:                 prev_entry = entry\\n89:         return True\\n\\n(End of file - total 89 lines)\\n</content>\"},\"type\":\"raw\"},\"obs_mqv775xf_7863dfbdc4e7\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv775xf_7863dfbdc4e7\",\"raw\":{\"attachments\":[],\"call_id\":\"call_07_CEi2bLBUlpflorummdUy1823\",\"duration_ms\":13,\"metadata\":{\"loaded\":[],\"preview\":\"\\\"\\\"\\\"Actor → role + capability_set resolution from the governance store.\\\"\\\"\\\"\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport aiosqlite\\n\\nfrom ..config import settings\\n\\n\\n_BOOTSTRAP_ACTORS = [\\n    {\\\"actor_id\\\": \\\"admin\\\", \\\"role\\\": \\\"ADMIN\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\", \\\"ADMIN\\\", \\\"SCHEMA_WRITE\\\"]},\\n    {\\\"actor_id\\\": \\\"operator\\\", \\\"role\\\": \\\"OPERATOR\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\"]},\\n    {\\\"actor_id\\\": \\\"viewer\\\", \\\"role\\\": \\\"VIEWER\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\"]},\\n    {\\\"actor_id\\\": \\\"agent\\\", \\\"role\\\": \\\"AGENT\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\", \\\"DEPLOY\\\"]},\\n]\\n\\n\\nclass Actor:\\n    def __init__(self, actor_id: str, role: str, capability_set: list[str]) -> None:\",\"truncated\":false},\"title\":\"xnch/xnch/auth/governance.py\",\"tool_input\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py\\\"}\",\"tool_name\":\"read\",\"tool_output\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Actor → role + capability_set resolution from the governance store.\\\"\\\"\\\"\\n2: import json\\n3: from pathlib import Path\\n4: from typing import Any\\n5: \\n6: import aiosqlite\\n7: \\n8: from ..config import settings\\n9: \\n10: \\n11: _BOOTSTRAP_ACTORS = [\\n12:     {\\\"actor_id\\\": \\\"admin\\\", \\\"role\\\": \\\"ADMIN\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\", \\\"ADMIN\\\", \\\"SCHEMA_WRITE\\\"]},\\n13:     {\\\"actor_id\\\": \\\"operator\\\", \\\"role\\\": \\\"OPERATOR\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\"]},\\n14:     {\\\"actor_id\\\": \\\"viewer\\\", \\\"role\\\": \\\"VIEWER\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\"]},\\n15:     {\\\"actor_id\\\": \\\"agent\\\", \\\"role\\\": \\\"AGENT\\\", \\\"capability_set\\\": [\\\"READ\\\", \\\"QUERY\\\", \\\"DEPLOY\\\"]},\\n16: ]\\n17: \\n18: \\n19: class Actor:\\n20:     def __init__(self, actor_id: str, role: str, capability_set: list[str]) -> None:\\n21:         self.id = actor_id\\n22:         self.role = role\\n23:         self.capability_set = capability_set\\n24: \\n25:     def to_dict(self) -> dict[str, Any]:\\n26:         return {\\\"id\\\": self.id, \\\"role\\\": self.role, \\\"capability_set\\\": self.capability_set}\\n27: \\n28: \\n29: class GovernanceStore:\\n30:     def __init__(self, db_path: Path) -> None:\\n31:         self._db_path = db_path\\n32: \\n33:     async def resolve_actor(self, actor_id: str) -> Actor | None:\\n34:         async with aiosqlite.connect(self._db_path) as db:\\n35:             async with db.execute(\\n36:                 \\\"SELECT actor_id, role, capability_set FROM actors WHERE actor_id = ?\\\",\\n37:                 (actor_id,),\\n38:             ) as cursor:\\n39:                 row = await cursor.fetchone()\\n40:         if not row:\\n41:             return None\\n42:         return Actor(row[0], row[1], json.loads(row[2]))\\n43: \\n44:     async def upsert_actor(self, actor_id: str, role: str, capability_set: list[str]) -> None:\\n45:         async with aiosqlite.connect(self._db_path) as db:\\n46:             await db.execute(\\n47:                 \\\"\\\"\\\"INSERT INTO actors (actor_id, role, capability_set, created_at, updated_at)\\n48:                    VALUES (?, ?, ?, unixepoch(), unixepoch())\\n49:                    ON CONFLICT(actor_id) DO UPDATE SET\\n50:                      role=excluded.role,\\n51:                      capability_set=excluded.capability_set,\\n52:                      updated_at=excluded.updated_at\\\"\\\"\\\",\\n53:                 (actor_id, role, json.dumps(capability_set)),\\n54:             )\\n55:             await db.commit()\\n56: \\n57:     async def bootstrap(self) -> None:\\n58:         \\\"\\\"\\\"Insert default actors if the table is empty.\\\"\\\"\\\"\\n59:         async with aiosqlite.connect(self._db_path) as db:\\n60:             async with db.execute(\\\"SELECT COUNT(*) FROM actors\\\") as cursor:\\n61:                 count = (await cursor.fetchone())[0]\\n62:         if count == 0:\\n63:             for a in _BOOTSTRAP_ACTORS:\\n64:                 await self.upsert_actor(a[\\\"actor_id\\\"], a[\\\"role\\\"], a[\\\"capability_set\\\"])\\n\\n(End of file - total 64 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:21:33.889Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py\\\"}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/auth/governance.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Actor → role + capability_set resolution from the governance store.\\\"\\\"\\\"\\n2: import json\\n3: from pathlib import Path\\n4: from typing import Any\\n5: \\n6: import aiosqlite\\n7: \\n8: from ..config import settings\\n9: \\n10: \\n11: _BOOTSTRAP_ACTORS = [\\n12:     {\\\"actor_id\\\": \\\"admin\\\", \\\"role\\\": \\\"ADMIN\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\", \\\"ADMIN\\\", \\\"SCHEMA_WRITE\\\"]},\\n13:     {\\\"actor_id\\\": \\\"operator\\\", \\\"role\\\": \\\"OPERATOR\\\", \\\"capability_set\\\": [\\\"DEPLOY\\\", \\\"READ\\\", \\\"QUERY\\\"]},\\n14:     {\\\"actor_id\\\": \\\"viewer\\\", \\\"role\\\": \\\"VI