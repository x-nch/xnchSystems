nc with db.execute(\\\\n124:             \\\\\\\"SELECT value FROM system_state WHERE key = 'state_version'\\\\\\\"\\\\n125:         ) as cursor:\\\\n126:             row = await cursor.fetchone()\\\\n127:         current = int(row[0]) if row else 1\\\\n128:         new_version = current + 1\\\\n129:         await db.execute(\\\\n130:             \\\\\\\"UPDATE system_state SET value = ? WHERE key = 'state_version'\\\\\\\",\\\\n131:             (str(new_version),),\\\\n132:         )\\\\n133:         await db.commit()\\\\n134:     return f\\\\\\\"v{new_version}\\\\\\\"\\\\n\\\\n(End of file - total 134 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76434_3a0d017136e5\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv76434_3a0d017136e5\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_09_sKpKhmFRW6WqeQt6WZ1l8293\\\",\\\"duration_ms\\\":4,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Graph extractor — LLM-based entity/relation extraction using agentmemory.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nfrom __future__ import annotations\\\\n\\\\nimport json\\\\nimport logging\\\\nfrom typing import Any\\\\n\\\\nimport litellm\\\\n\\\\nfrom xnch.memory.graph_store import GraphStore\\\\nfrom xnch.memory.pg_episodic_store import PgEpisodicStore, CATEGORY as EPISODE_CATEGORY\\\\n\\\\nlogger = logging.getLogger(__name__)\\\\n\\\\n_EXTRACTION_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"Extract entity-relation triples from the following decision episode.\\\\nReturn a JSON list of objects, each with:\\\\n  - \\\\\\\"subject\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\\n  - \\\\\\\"relation\\\\\\\": str (e.g. \\\\\\\"deployed_to\\\\\\\", \\\\\\\"triggered_by\\\\\\\", \\\\\\\"approved\\\\\\\")\\\\n  - \\\\\\\"object\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/memory/graph_extractor.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/memory/graph_extractor.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/graph_extractor.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Graph extractor — LLM-based entity/relation extraction using agentmemory.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: \\\\n3: from __future__ import annotations\\\\n4: \\\\n5: import json\\\\n6: import logging\\\\n7: from typing import Any\\\\n8: \\\\n9: import litellm\\\\n10: \\\\n11: from xnch.memory.graph_store import GraphStore\\\\n12: from xnch.memory.pg_episodic_store import PgEpisodicStore, CATEGORY as EPISODE_CATEGORY\\\\n13: \\\\n14: logger = logging.getLogger(__name__)\\\\n15: \\\\n16: _EXTRACTION_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"Extract entity-relation triples from the following decision episode.\\\\n17: Return a JSON list of objects, each with:\\\\n18:   - \\\\\\\"subject\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\\n19:   - \\\\\\\"relation\\\\\\\": str (e.g. \\\\\\\"deployed_to\\\\\\\", \\\\\\\"triggered_by\\\\\\\", \\\\\\\"approved\\\\\\\")\\\\n20:   - \\\\\\\"object\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\\n21: \\\\n22: Episode:\\\\n23: {raw_text}\\\\n24: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n25: \\\\n26: \\\\n27: async def extract_and_store() -> int:\\\\n28:     from agentmemory import get_memories\\\\n29: \\\\n30:     episodes = get_memories(EPISODE_CATEGORY, n_results=100)\\\\n31: \\\\n32:     if not episodes:\\\\n33:         logger.info(\\\\\\\"No recent episodes to extract from\\\\\\\")\\\\n34:         return 0\\\\n35: \\\\n36:     graph = GraphStore()\\\\n37:     graph.connect()\\\\n38:     try:\\\\n39:         triples_written = 0\\\\n40:         for ep in episodes:\\\\n41:             raw = ep[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"raw_text\\\\\\\") or ep[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"summary\\\\\\\") or ep.get(\\\\\\\"document\\\\\\\") or \\\\\\\"\\\\\\\"\\\\n42:             if not raw:\\\\n43:                 continue\\\\n44:             triples = await _extract_triples(raw)\\\\n45:             for t in triples:\\\\n46:                 graph.upsert_entity(\\\\n47:                     id=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n48:                     name=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"name\\\\\\\"],\\\\n49:                     type_=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"type\\\\\\\"],\\\\n50:                 )\\\\n51:                 graph.upsert_entity(\\\\n52:                     id=t[\\\\\\\"object\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n53:                     name=t[\\\\\\\"object\\\\\\\"][\\\\\\\"name\\\\\\\"],\\\\n54:                     type_=t[\\\\\\\"object\\\\\\\"][\\\\\\\"type\\\\\\\"],\\\\n55:                 )\\\\n56:                 graph.upsert_relation(\\\\n57:                     from_id=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n58:                     to_id=t[\\\\\\\"object\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n59:                     rel_type=t[\\\\\\\"relation\\\\\\\"],\\\\n60:                     confidence=0.8,\\\\n61:                 )\\\\n62:                 triples_written += 1\\\\n63:         logger.info(\\\\\\\"Wrote %d triples from %d episodes\\\\\\\", triples_written, len(episodes))\\\\n64:         return triples_written\\\\n65:     finally:\\\\n66:         graph.close()\\\\n67: \\\\n68: \\\\n69: async def _extract_triples(text: str) -> list[dict[str, Any]]:\\\\n70:     try:\\\\n71:         resp = await litellm.acompletion(\\\\n72:             model=\\\\\\\"ollama/phi3:mini\\\\\\\",\\\\n73:             messages=[\\\\n74:                 {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": _EXTRACTION_PROMPT},\\\\n75:                 {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": text},\\\\n76:             ],\\\\n77:             temperature=0.1,\\\\n78:             max_tokens=1024,\\\\n79:         )\\\\n80:         content = resp.choices[0].message.content.strip()\\\\n81:         if content.startswith(\\\\\\\"```\\\\\\\"):\\\\n82:             content = content.split(\\\\\\\"\\\\\\\\n\\\\\\\", 1)[1].rsplit(\\\\\\\"```\\\\\\\", 1)[0].strip()\\\\n83:         return json.loads(content)\\\\n84:     except Exception:\\\\n85:         logger.exception(\\\\\\\"LLM extraction failed for episode text\\\\\\\")\\\\n86:         return []\\\\n\\\\n(End of file - total 86 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:44.846Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/memory/graph_extractor.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/graph_extractor.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Graph extractor — LLM-based entity/relation extraction using agentmemory.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: \\\\n3: from __future__ import annotations\\\\n4: \\\\n5: import json\\\\n6: import logging\\\\n7: from typing import Any\\\\n8: \\\\n9: import litellm\\\\n10: \\\\n11: from xnch.memory.graph_store import GraphStore\\\\n12: from xnch.memory.pg_episodic_store import PgEpisodicStore, CATEGORY as EPISODE_CATEGORY\\\\n13: \\\\n14: logger = logging.getLogger(__name__)\\\\n15: \\\\n16: _EXTRACTION_PROMPT = \\\\\\\"\\\\\\\"\\\\\\\"Extract entity-relation triples from the following decision episode.\\\\n17: Return a JSON list of objects, each with:\\\\n18:   - \\\\\\\"subject\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\\n19:   - \\\\\\\"relation\\\\\\\": str (e.g. \\\\\\\"deployed_to\\\\\\\", \\\\\\\"triggered_by\\\\\\\", \\\\\\\"approved\\\\\\\")\\\\n20:   - \\\\\\\"object\\\\\\\": {\\\\\\\"id\\\\\\\": str, \\\\\\\"name\\\\\\\": str, \\\\\\\"type\\\\\\\": str}\\\\n21: \\\\n22: Episode:\\\\n23: {raw_text}\\\\n24: \\\\\\\"\\\\\\\"\\\\\\\"\\\\n25: \\\\n26: \\\\n27: async def extract_and_store() -> int:\\\\n28:     from agentmemory import get_memories\\\\n29: \\\\n30:     episodes = get_memories(EPISODE_CATEGORY, n_results=100)\\\\n31: \\\\n32:     if not episodes:\\\\n33:         logger.info(\\\\\\\"No recent episodes to extract from\\\\\\\")\\\\n34:         return 0\\\\n35: \\\\n36:     graph = GraphStore()\\\\n37:     graph.connect()\\\\n38:     try:\\\\n39:         triples_written = 0\\\\n40:         for ep in episodes:\\\\n41:             raw = ep[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"raw_text\\\\\\\") or ep[\\\\\\\"metadata\\\\\\\"].get(\\\\\\\"summary\\\\\\\") or ep.get(\\\\\\\"document\\\\\\\") or \\\\\\\"\\\\\\\"\\\\n42:             if not raw:\\\\n43:                 continue\\\\n44:             triples = await _extract_triples(raw)\\\\n45:             for t in triples:\\\\n46:                 graph.upsert_entity(\\\\n47:                     id=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n48:                     name=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"name\\\\\\\"],\\\\n49:                     type_=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"type\\\\\\\"],\\\\n50:                 )\\\\n51:                 graph.upsert_entity(\\\\n52:                     id=t[\\\\\\\"object\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n53:                     name=t[\\\\\\\"object\\\\\\\"][\\\\\\\"name\\\\\\\"],\\\\n54:                     type_=t[\\\\\\\"object\\\\\\\"][\\\\\\\"type\\\\\\\"],\\\\n55:                 )\\\\n56:                 graph.upsert_relation(\\\\n57:                     from_id=t[\\\\\\\"subject\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n58:                     to_id=t[\\\\\\\"object\\\\\\\"][\\\\\\\"id\\\\\\\"],\\\\n59:                     rel_type=t[\\\\\\\"relation\\\\\\\"],\\\\n60:                     confidence=0.8,\\\\n61:                 )\\\\n62:                 triples_written += 1\\\\n63:         logger.info(\\\\\\\"Wrote %d triples from %d episodes\\\\\\\", triples_written, len(episodes))\\\\n64:         return triples_written\\\\n65:     finally:\\\\n66:         graph.close()\\\\n67: \\\\n68: \\\\n69: async def _extract_triples(text: str) -> list[dict[str, Any]]:\\\\n70:     try:\\\\n71:         resp = await litellm.acompletion(\\\\n72:             model=\\\\\\\"ollama/phi3:mini\\\\\\\",\\\\n73:             messages=[\\\\n74:                 {\\\\\\\"role\\\\\\\": \\\\\\\"system\\\\\\\", \\\\\\\"content\\\\\\\": _EXTRACTION_PROMPT},\\\\n75:                 {\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": text},\\\\n76:             ],\\\\n77:             temperature=0.1,\\\\n78:             max_tokens=1024,\\\\n79:         )\\\\n80:         content = resp.choices[0].message.content.strip()\\\\n81:         if content.startswith(\\\\\\\"```\\\\\\\"):\\\\n82:             content = content.split(\\\\\\\"\\\\\\\\n\\\\\\\", 1)[1].rsplit(\\\\\\\"```\\\\\\\", 1)[0].strip()\\\\n83:         return json.loads(content)\\\\n84:     except Exception:\\\\n85:         logger.exception(\\\\\\\"LLM extraction failed for episode text\\\\\\\")\\\\n86:         return []\\\\n\\\\n(End of file - total 86 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv764c7_43160626b414\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv764c7_43160626b414\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_10_k80NmwtRki9ikDOPrLzu8746\\\",\\\"duration_ms\\\":4,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Pattern Store — aggregated patterns derived from episodic history.\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport json\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\nfrom uuid import uuid4\\\\n\\\\nimport aiosqlite\\\\n\\\\n\\\\nclass PatternStore:\\\\n    def __init__(self, db_path: Path) -> None:\\\\n        self._db = db_path\\\\n\\\\n    async def upsert_pattern(\\\\n        self,\\\\n        context_signature: str,\\\\n        intent_class: str,\\\\n        action_type: str,\\\\n        entity_class: str,\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/memory/pattern_store.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/memory/pattern_store.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/pattern_store.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Pattern Store — aggregated patterns derived from episodic history.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import json\\\\n3: import time\\\\n4: from pathlib import Path\\\\n5: from typing import Any\\\\n6: from uuid import uuid4\\\\n7: \\\\n8: import aiosqlite\\\\n9: \\\\n10: \\\\n11: class PatternStore:\\\\n12:     def __init__(self, db_path: Path) -> None:\\\\n13:         self._db = db_path\\\\n14: \\\\n15:     async def upsert_pattern(\\\\n16:         self,\\\\n17:         context_signature: str,\\\\n18:         intent_class: str,\\\\n19:         action_type: str,\\\\n20:         entity_class: str,\\\\n21:         actor_role: str,\\\\n22:         success_rate: float,\\\\n23:         confidence: float,\\\\n24:         observation_count: int,\\\\n25:         avg_prediction_delta: float | None,\\\\n26:         extraction_run_id: str,\\\\n27:     ) -> None:\\\\n28:         now = time.time()\\\\n29:         async with aiosqlite.connect(self._db) as db:\\\\n30:             async with db.execute(\\\\n31:                 \\\\\\\"SELECT pattern_id FROM patterns WHERE context_signature = ?\\\\\\\",\\\\n32:                 (context_signature,),\\\\n33:             ) as cursor:\\\\n34:                 row = await cursor.fetchone()\\\\n35: \\\\n36:             if row:\\\\n37:                 await db.execute(\\\\n38:                     \\\\\\\"\\\\\\\"\\\\\\\"UPDATE patterns SET success_rate=?, confidence=?, observation_count=?,\\\\n39:                        avg_prediction_delta=?, extraction_run_id=?, updated_at=?\\\\n40:                        WHERE context_signature=?\\\\\\\"\\\\\\\"\\\\\\\",\\\\n41:                     (success_rate, confidence, observation_count, avg_prediction_delta,\\\\n42:                      extraction_run_id, now, context_signature),\\\\n43:                 )\\\\n44:             else:\\\\n45:                 await db.execute(\\\\n46:                     \\\\\\\"\\\\\\\"\\\\\\\"INSERT INTO patterns\\\\n47:                        (pattern_id, context_signature, intent_class, action_type, entity_class,\\\\n48:                         actor_role, success_rate, confidence, observation_count,\\\\n49:                         avg_prediction_delta, extraction_run_id, created_at, updated_at)\\\\n50:                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\\\\\\\"\\\\\\\"\\\\\\\",\\\\n51:                     (str(uuid4()), context_signature, intent_class, action_type, entity_class,\\\\n52:                      actor_role, success_rate, confidence, observation_count,\\\\n53:                      avg_prediction_delta, extraction_run_id, now, now),\\\\n54:                 )\\\\n55:             await db.commit()\\\\n56: \\\\n57:     async def fetch_for_manifest(\\\\n58:         self,\\\\n59:         intent_class: str,\\\\n60:         entity_class: str,\\\\n61:         actor_role: str,\\\\n62:         max_patterns: int = 10,\\\\n63:     ) -> list[dict[str, Any]]:\\\\n64:         async with aiosqlite.connect(self._db) as db:\\\\n65:             db.row_factory = aiosqlite.Row\\\\n66:             async with db.execute(\\\\n67:                 \\\\\\\"\\\\\\\"\\\\\\\"SELECT pattern_id, context_signature, success_rate, confidence, observation_count\\\\n68:                    FROM patterns\\\\n69:                    WHERE intent_class = ? AND entity_class = ? AND actor_role = ?\\\\n70:                    ORDER BY confidence DESC LIMIT ?\\\\\\\"\\\\\\\"\\\\\\\",\\\\n71:                 (intent_class, entity_class, actor_role, max_patterns),\\\\n72:             ) as cursor:\\\\n73:                 rows = await cursor.fetchall()\\\\n74:         return [dict(r) for r in rows]\\\\n75: \\\\n76:     async def fetch_low_success(\\\\n77:         self,\\\\n78:         max_success_rate: float = 0.4,\\\\n79:         min_confidence: float = 0.6,\\\\n80:     ) -> list[dict[str, Any]]:\\\\n81:         async with aiosqlite.connect(self._db) as db:\\\\n82:             db.row_factory = aiosqlite.Row\\\\n83:             async with db.execute(\\\\n84:                 \\\\\\\"\\\\\\\"\\\\\\\"SELECT * FROM patterns\\\\n85:                    WHERE success_rate < ? AND confidence > ?\\\\n86:                    ORDER BY confidence DESC\\\\\\\"\\\\\\\"\\\\\\\",\\\\n87:                 (max_success_rate, min_confidence),\\\\n88:             ) as cursor:\\\\n89:                 rows = await cursor.fetchall()\\\\n90:         return [dict(r) for r in rows]\\\\n91: \\\\n92:     async def fetch_all(self) -> list[dict[str, Any]]:\\\\n93:         async with aiosqlite.connect(self._db) as db:\\\\n94:             db.row_factory = aiosqlite.Row\\\\n95:             async with db.execute(\\\\\\\"SELECT * FROM patterns\\\\\\\") as cursor:\\\\n96:                 rows = await cursor.fetchall()\\\\n97:         return [dict(r) for r in rows]\\\\n\\\\n(End of file - total 97 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:20:45.173Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/memory/pattern_store.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/memory/pattern_store.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"Pattern Store — aggregated patterns derived from episodic history.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import json\\\\n3: import time\\\\n4: from pathlib import Path\\\\n5: from typing import Any\\\\n6: from uuid import uuid4\\\\n7: \\\\n8: import aiosqlite\\\\n9: \\\\n10: \\\\n11: class PatternStore:\\\\n12:     def __init__(self, db_path: Path) -> None:\\\\n13:         self._db = db_path\\\\n14: \\\\n15:     async def upsert_pattern(\\\\n16:         self,\\\\n17:         context_signature: str,\\\\n18:         intent_class: str,\\\\n19:         action_type: str,\\\\n20:         entity_class: str,\\\\n21:         actor_role: str,\\\\n22:         success_rate: float,\\\\n23:         confidence: float,\\\\n24:         observation_count: int,\\\\n25:         avg_prediction_delta: float | None,\\\\n26:         extraction_run_id: str,\\\\n27:     ) -> None:\\\\n28:         now = time.time()\\\\n29:         async with aiosqlite.connect(self._db) as db:\\\\n30:             async with db.execute(\\\\n31:                 \\\\\\\"SELECT pattern_id FROM patterns WHERE context_signature = ?\\\\\\\",\\\\n32:                 (context_signature,),\\\\n33:             ) as cursor:\\\\n34:                 row = await cursor.fetchone()\\\\n35: \\\\n36:             if row:\\\\n37:                 await db.execute(\\\\n38:                     \\\\\\\"\\\\\\\"\\\\\\\"UPDATE patterns SET success_rate=?, confidence=?, observation_count=?,\\\\n39:                        avg_prediction_delta=?, extraction_run_id=?, updated_at=?\\\\n40:                        WHERE context_signature=?\\\\\\\"\\\\\\\"\\\\\\\",\\\\n41:                     (success_rate, confidence, observation_count, avg_prediction_delta,\\\\n42:                      extraction_run_id, now, context_signature),\\\\n43:                 )\\\\n44:             else:\\\\n45:                 await db.execute(\\\\n46:                     \\\\\\\"\\\\\\\"\\\\\\\"INSERT INTO patterns\\\\n47:                        (pattern_id, context_signature, intent_class, action_type, entity_class,\\\\n48:                         actor_role, success_rate, confidence, observation_count,\\\\n49:                         avg_prediction_delta, extraction_run_id, created_at, updated_at)\\\\n50:                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\\\\\\\"\\\\\\\"\\\\\\\",\\\\n51:                     (str(uuid4()), context_signature, intent_class, action_type, entity_class,\\\\n52:                      actor_role, success_rate, confidence, observation_count,\\\\n53:                      avg_prediction_delta, extraction_run_id, now, now),\\\\n54:                 )\\\\n55:             await db.commit()\\\\n56: \\\\n57:     async def fetch_for_manifest(\\\\n58:         self,\\\\n59:         intent_class: str,\\\\n60:         entity_class: str,\\\\n61:         actor_role: str,\\\\n62:         max_patterns: int = 10,\\\\n63:     ) -> list[dict[str, Any]]:\\\\n64:         async with aiosqlite.connect(self._db) as db:\\\\n65:             db.row_factory = aiosqlite.Row\\\\n66:             async with db.execute(\\\\n67:                 \\\\\\\"\\\\\\\"\\\\\\\"SELECT pattern_id, context_signature, success_rate, confidence, observation_count\\\\n68:                    FROM patterns\\\\n69:                    WHERE intent_class = ? AND entity_class = ? AND actor_role = ?\\\\n70:                    ORDER BY confidence DESC LIMIT ?\\\\\\\"\\\\\\\"\\\\\\\",\\\\n71:                 (intent_class, entity_class, actor_role, max_patterns),\\\\n72:             ) as cursor:\\\\n73:                 rows = await cursor.fetchall()\\\\n74:         return [dict(r) for r in rows]\\\\n75: \\\\n76:     async def fetch_low_success(\\\\n77:         self,\\\\n78:         max_success_rate: float = 0.4,\\\\n79:         min_confidence: float = 0.6,\\\\n80:     ) -> list[dict[str, Any]]:\\\\n81:         async with aiosqlite.connect(self._db) as db:\\\\n82:             db.row_factory = aiosqlite.Row\\\\n83:             async with db.execute(\\\\n84:                 \\\\\\\"\\\\\\\"\\\\\\\"SELECT * FROM patterns\\\\n85:                    WHERE success_rate < ? AND confidence > ?\\\\n86:                    ORDER BY confidence DESC\\\\\\\"\\\\\\\"\\\\\\\",\\\\n87:                 (max_success_rate, min_confidence),\\\\n88:             ) as cursor:\\\\n89:                 rows = await cursor.fetchall()\\\\n90:         return [dict(r) for r in rows]\\\\n91: \\\\n92:     async def fetch_all(self) -> list[dict[str, Any]]:\\\\n93:         async with aiosqlite.connect(self._db) as db:\\\\n94:             db.row_factory = aiosqlite.Row\\\\n95:             async with db.execute(\\\\\\\"SELECT * FROM patterns\\\\\\\") as cursor:\\\\n96:                 rows = await cursor.fetchall()\\\\n97:         return [dict(r) for r in rows]\\\\n\\\\n(End of file - total 97 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv767k3_83de49489283\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_mqv767k3_83de49489283\\\",\\\"raw\\\":{\\\"attachments\\\":[],\\\"call_id\\\":\\\"call_00_lnyp4EI1KIEEjaULv4H23790\\\",\\\"duration_ms\\\":6,\\\"metadata\\\":{\\\"loaded\\\":[],\\\"preview\\\":\\\"from dataclasses import dataclass\\\\n\\\\nfrom agentmemory import create_memory, search_memory\\\\n\\\\n\\\\ndef _compute_complexity(raw_input: str, metadata: dict) -> float:\\\\n    if 'complexity_score' in metadata:\\\\n        return float(metadata['complexity_score'])\\\\n    length_score = min(len(raw_input) / 500, 1.0)\\\\n    has_multipart = 1.0 if any(c in raw_input for c in ['and then', 'after that', 'first', 'finally', 'steps']) else 0.0\\\\n    has_code = 0.5 if any(c in raw_input for c in ['```', 'def ', 'class ', 'import ', 'kubectl']) else 0.0\\\\n    return min((length_score + has_multipart + has_code) / 3, 1.0)\\\\n\\\\n\\\\n@dataclass\\\\nclass ModelRoute:\\\\n    model_name: str\\\\n    reason: str\\\\n\\\\n\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/routing/classifier.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/routing/classifier.py\\\\\\\"}