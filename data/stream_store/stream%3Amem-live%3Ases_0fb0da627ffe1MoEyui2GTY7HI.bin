\n14: \\n15: \\n16: class VerdictRequest(BaseModel):\\n17:     request_id: str\\n18:     actor: dict[str, Any]\\n19:     action: dict[str, Any]\\n20:     context: dict[str, Any]\\n21: \\n22: \\n23: @router.post(\\\"/verdict\\\")\\n24: async def verdict(body: VerdictRequest, request: Request) -> dict[str, Any]:\\n25:     \\\"\\\"\\\"Step 10: authoritative policy re-evaluation, ledger write, token issuance.\\\"\\\"\\\"\\n26:     app = request.app.state\\n27:     ctx = body.context\\n28: \\n29:     # 1. Verify system_state_version match\\n30:     current_version = await app.get_state_version()\\n31:     submitted_version = ctx.get(\\\"system_state_version\\\", \\\"\\\")\\n32:     if submitted_version != current_version:\\n33:         raise HTTPException(\\n34:             status_code=409,\\n35:             detail=f\\\"STALE_SESSION: submitted version {submitted_version!r} \\\"\\n36:                    f\\\"!= current {current_version!r}\\\",\\n37:         )\\n38: \\n39:     # 2. Re-evaluate against active policy (authoritative — not dry-run)\\n40:     action = body.action\\n41:     actor = body.actor\\n42: \\n43:     resolved = await app.governance.resolve_actor(actor.get(\\\"id\\\", \\\"\\\"))\\n44:     if not resolved:\\n45:         raise HTTPException(status_code=401, detail=\\\"Unknown actor\\\")\\n46: \\n47:     result = app.policy_engine.evaluate(\\n48:         intent_class=action.get(\\\"intent_class\\\", \\\"\\\"),\\n49:         action_type=action.get(\\\"type\\\", \\\"\\\"),\\n50:         entity_class=action.get(\\\"entity_class\\\", \\\"\\\"),\\n51:         actor_role=resolved.role,\\n52:         actor_capabilities=resolved.capability_set,\\n53:         action_spec=action.get(\\\"payload\\\", {}),\\n54:     )\\n55: \\n56:     if result.verdict == \\\"BLOCK\\\":\\n57:         audit_ref = str(uuid4())\\n58:         app.ledger.write(\\n59:             decision_id=body.request_id,\\n60:             trace_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n61:             intent_hash=action.get(\\\"payload_hash\\\", \\\"\\\"),\\n62:             candidates_count=0,\\n63:             selected_option_id=None,\\n64:             scores={},\\n65:             audit_ref=audit_ref,\\n66:         )\\n67:         app.event_log.emit(ctx.get(\\\"session_id\\\", \\\"\\\"), \\\"xnch.verdict\\\", \\\"VERDICT_BLOCK\\\",\\n68:                            data={\\\"policy_refs\\\": result.policy_refs})\\n69:         trace_llm_call(\\n70:             prompt=json.dumps({\\\"action\\\": action, \\\"actor\\\": actor, \\\"context\\\": ctx}),\\n71:             response=json.dumps({\\\"verdict\\\": \\\"BLOCK\\\", \\\"reason\\\": result.policy_refs}),\\n72:             model=\\\"policy-engine\\\",\\n73:             latency_ms=0,\\n74:             tokens_used=0,\\n75:             trace_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n76:         )\\n77:         return {\\n78:             \\\"request_id\\\": body.request_id,\\n79:             \\\"verdict\\\": \\\"BLOCK\\\",\\n80:             \\\"verdict_reason\\\": result.policy_refs[0] if result.policy_refs else \\\"policy blocked\\\",\\n81:             \\\"policy_refs\\\": result.policy_refs,\\n82:             \\\"modified_action\\\": None,\\n83:             \\\"execution_token\\\": None,\\n84:             \\\"token_ttl_ms\\\": 0,\\n85:             \\\"audit_ref\\\": audit_ref,\\n86:         }\\n87: \\n88:     # 3. Issue execution token\\n89:     policy_version = await app.get_policy_version()\\n90:     claims = ExecutionTokenClaims(\\n91:         session_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n92:         decision_id=body.request_id,\\n93:         trace_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n94:         actor_id=resolved.id,\\n95:         actor_role=resolved.role,\\n96:         action_type=action.get(\\\"type\\\", \\\"\\\"),\\n97:         entity_class=action.get(\\\"entity_class\\\", \\\"\\\"),\\n98:         policy_version=policy_version,\\n99:         system_state_version=current_version,\\n100:     )\\n101:     token, ttl_ms = app.token_signer.issue(claims)\\n102: \\n103:     # 4. Write to Decision Ledger (synchronous — before response)\\n104:     audit_ref = str(uuid4())\\n105:     app.ledger.write(\\n106:         decision_id=body.request_id,\\n107:         trace_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n108:         intent_hash=action.get(\\\"payload_hash\\\", \\\"\\\"),\\n109:         candidates_count=1,\\n110:         selected_option_id=body.request_id,\\n111:         scores={},\\n112:         audit_ref=audit_ref,\\n113:     )\\n114: \\n115:     app.event_log.emit(ctx.get(\\\"session_id\\\", \\\"\\\"), \\\"xnch.verdict\\\", \\\"VERDICT_ALLOW\\\",\\n116:                        data={\\\"audit_ref\\\": audit_ref, \\\"policy_refs\\\": result.policy_refs})\\n117: \\n118:     trace_llm_call(\\n119:         prompt=json.dumps({\\\"action\\\": action, \\\"actor\\\": actor, \\\"context\\\": ctx}),\\n120:         response=json.dumps({\\\"verdict\\\": result.verdict, \\\"token\\\": token[:16] + \\\"...\\\" if token else \\\"\\\"}),\\n121:         model=\\\"policy-engine\\\",\\n122:         latency_ms=0,\\n123:         tokens_used=0,\\n124:         trace_id=ctx.get(\\\"session_id\\\", \\\"\\\"),\\n125:     )\\n126: \\n127:     return {\\n128:         \\\"request_id\\\": body.request_id,\\n129:         \\\"verdict\\\": result.verdict,\\n130:         \\\"verdict_reason\\\": result.policy_refs[0] if result.policy_refs else \\\"allowed\\\",\\n\\n(Showing lines 1-130 of 136. Use offset=131 to continue.)\\n</content>\"},\"sessionId\":\"ses_0fae26635ffei03J1upu7SVTC4\",\"timestamp\":\"2026-06-26T18:07:54.929Z\",\"toolInput\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/routes/verdict.py\\\",\\\"offset\\\":1,\\\"limit\\\":130}\",\"toolName\":\"read\",\"toolOutput\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/routes/verdict.py</path>\\n<type>file</type>\\n<content>\\n1: \\\"\\\"\\\"Step 10: /verdict — authoritative policy check, Decision Ledger write, token issuance.\