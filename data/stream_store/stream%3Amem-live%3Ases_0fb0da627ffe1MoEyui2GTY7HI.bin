icy_version, increment_state_version\\\\nfrom .policy import PolicyLoader, PolicyEngine\\\\nfrom .routes import (\\\\n    session_router, memory_router, policy_router,\\\\n    verdict_router, execution_router, governance_router, auth_router,\\\\n    nexi_gateway_router,\\\\n)\\\",\\\"truncated\\\":false},\\\"title\\\":\\\"xnch/xnch/main.py\\\",\\\"tool_input\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/main.py\\\\\\\"}\\\",\\\"tool_name\\\":\\\"read\\\",\\\"tool_output\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/main.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"xnch-server v0 — governance, memory, and authorization service.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import logging\\\\n3: from contextlib import asynccontextmanager\\\\n4: from starlette.requests import Request\\\\n5: from apscheduler.schedulers.asyncio import AsyncIOScheduler\\\\n6: from fastapi import FastAPI\\\\n7: \\\\n8: from .auth import load_or_generate_keypair, GovernanceStore, TokenSigner, TokenVerifier\\\\n9: from .audit import EventLog, DecisionLedger\\\\n10: from .config import settings\\\\n11: from .learning import PatternExtractor, ScoreAdapter, PolicyCandidateGenerator\\\\n12: from .memory import init_db, EpisodicStore, PatternStore, KVCache, PgEpisodicStore\\\\n13: from .memory import SensoryBuffer, WorkingMemory, GraphStore, RelationshipStore\\\\n14: from .memory.db import get_state_version, get_policy_version, increment_state_version\\\\n15: from .policy import PolicyLoader, PolicyEngine\\\\n16: from .routes import (\\\\n17:     session_router, memory_router, policy_router,\\\\n18:     verdict_router, execution_router, governance_router, auth_router,\\\\n19:     nexi_gateway_router,\\\\n20: )\\\\n21: \\\\n22: logger = logging.getLogger(__name__)\\\\n23: \\\\n24: \\\\n25: @asynccontextmanager\\\\n26: async def lifespan(app: FastAPI):\\\\n27:     s = app.state\\\\n28: \\\\n29:     # Ensure directories\\\\n30:     for d in [settings.base_dir, settings.keys_dir, settings.audit_dir,\\\\n31:               settings.governance_dir, settings.policies_dir, settings.weights_dir]:\\\\n32:         d.mkdir(parents=True, exist_ok=True)\\\\n33: \\\\n34:     # DB init\\\\n35:     await init_db(settings.db_path)\\\\n36: \\\\n37:     # Auth\\\\n38:     s.keypair = load_or_generate_keypair(settings.keys_dir)\\\\n39:     s.token_signer = TokenSigner(s.keypair.private_pem)\\\\n40:     s.token_verifier = TokenVerifier(settings.auth_secret)\\\\n41:     s.governance = GovernanceStore(settings.db_path)\\\\n42:     await s.governance.bootstrap()\\\\n43: \\\\n44:     # Memory\\\\n45:     s.episodic = EpisodicStore(settings.db_path)\\\\n46:     s.pattern_store = PatternStore(settings.db_path)\\\\n47:     s.kv_cache = KVCache(settings.redis_url)\\\\n48: \\\\n49:     # Audit\\\\n50:     s.event_log = EventLog(settings.audit_dir / \\\\\\\"events.jsonl\\\\\\\")\\\\n51:     s.ledger = DecisionLedger(settings.audit_dir / \\\\\\\"decisions.jsonl\\\\\\\")\\\\n52: \\\\n53:     # Policy\\\\n54:     _sync_policies(settings)\\\\n55:     loader = PolicyLoader(settings.policies_dir)\\\\n56:     policy_set = loader.load()\\\\n57:     s.policy_engine = PolicyEngine(policy_set)\\\\n58:     s.policy_loader = loader\\\\n59: \\\\n60:     # PG episodic store (production backend)\\\\n61:     s.pg_episodic = PgEpisodicStore(settings.postgres_url)\\\\n62:     await s.pg_episodic.connect()\\\\n63: \\\\n64:     # Layer 0 — Sensory buffer (Redis perception signals)\\\\n65:     s.sensory_buffer = SensoryBuffer(settings.redis_url)\\\\n66: \\\\n67:     # Layer 1 — Working memory (Redis session context)\\\\n68:     s.working_memory = WorkingMemory(settings.redis_url)\\\\n69: \\\\n70:     # Layer 3 — Graph store (agentmemory semantic graph)\\\\n71:     s.relationship_store = RelationshipStore(settings.postgres_url)\\\\n72:     await s.relationship_store.connect()\\\\n73:     s.graph_store = GraphStore(db_path=settings.db_path, relationship_store=s.relationship_store)\\\\n74:     s.graph_store.connect()\\\\n75: \\\\n76:     # Cold-start seed identity memories on first boot\\\\n77:     from nexi.character.cold_start_seeder import seed_identity_memories\\\\n78:     await seed_identity_memories(s.pg_episodic)\\\\n79: \\\\n80:     # Learning\\\\n81:     s.pattern_extractor = PatternExtractor(s.pg_episodic, s.pattern_store)\\\\n82:     s.score_adapter = ScoreAdapter(settings.db_path)\\\\n83:     s.policy_candidates = PolicyCandidateGenerator(s.pattern_store, settings.db_path)\\\\n84: \\\\n85:     # Convenience helpers for routes\\\\n86:     async def _get_state_version() -> str:\\\\n87:         return await get_state_version(settings.db_path)\\\\n88: \\\\n89:     async def _get_policy_version() -> str:\\\\n90:         return await get_policy_version(settings.db_path)\\\\n91: \\\\n92:     async def _increment_state_version() -> str:\\\\n93:         v = await increment_state_version(settings.db_path)\\\\n94:         logger.info(\\\\\\\"system_state_version incremented to %s\\\\\\\", v)\\\\n95:         return v\\\\n96: \\\\n97:     s.get_state_version = _get_state_version\\\\n98:     s.get_policy_version = _get_policy_version\\\\n99:     s.increment_state_version = _increment_state_version\\\\n100: \\\\n101:     # Scheduler\\\\n102:     scheduler = AsyncIOScheduler()\\\\n103:     scheduler.add_job(\\\\n104:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n105:             s.pattern_extractor.run()\\\\n106:         ),\\\\n107:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", id=\\\\\\\"pattern_extractor\\\\\\\",\\\\n108:     )\\\\n109:     scheduler.add_job(\\\\n110:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n111:             s.score_adapter.evaluate()\\\\n112:         ),\\\\n113:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", minute=30, id=\\\\\\\"score_adapter\\\\\\\",\\\\n114:     )\\\\n115:     scheduler.add_job(\\\\n116:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n117:             s.policy_candidates.run()\\\\n118:         ),\\\\n119:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", minute=45, id=\\\\\\\"policy_candidates\\\\\\\",\\\\n120:     )\\\\n121:     scheduler.start()\\\\n122:     s.scheduler = scheduler\\\\n123: \\\\n124:     s.event_log.emit(\\\\\\\"startup\\\\\\\", \\\\\\\"xnch\\\\\\\", \\\\\\\"SERVER_STARTED\\\\\\\", data={\\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\"})\\\\n125:     logger.info(\\\\\\\"xnch-server started\\\\\\\")\\\\n126: \\\\n127:     yield\\\\n128: \\\\n129:     scheduler.shutdown(wait=False)\\\\n130:     await s.kv_cache.aclose()\\\\n131:     await s.sensory_buffer.aclose()\\\\n132:     await s.working_memory.aclose()\\\\n133:     await s.relationship_store.close()\\\\n134:     await s.pg_episodic.close()\\\\n135:     s.event_log.emit(\\\\\\\"shutdown\\\\\\\", \\\\\\\"xnch\\\\\\\", \\\\\\\"SERVER_STOPPED\\\\\\\")\\\\n136: \\\\n137: \\\\n138: app = FastAPI(title=\\\\\\\"xnch\\\\\\\", version=\\\\\\\"0.1.0\\\\\\\", lifespan=lifespan)\\\\n139: \\\\n140: app.include_router(session_router)\\\\n141: app.include_router(memory_router)\\\\n142: app.include_router(policy_router)\\\\n143: app.include_router(verdict_router)\\\\n144: app.include_router(execution_router)\\\\n145: app.include_router(governance_router)\\\\n146: app.include_router(auth_router)\\\\n147: app.include_router(nexi_gateway_router)\\\\n148: \\\\n149: \\\\n150: @app.get(\\\\\\\"/health\\\\\\\")\\\\n151: async def health(request: Request) -> dict:\\\\n152:     redis_ok = await request.app.state.kv_cache.ping()\\\\n153:     state_version = await request.app.state.get_state_version()\\\\n154:     return {\\\\n155:         \\\\\\\"status\\\\\\\": \\\\\\\"ok\\\\\\\" if redis_ok else \\\\\\\"degraded\\\\\\\",\\\\n156:         \\\\\\\"redis\\\\\\\": \\\\\\\"ok\\\\\\\" if redis_ok else \\\\\\\"unavailable\\\\\\\",\\\\n157:         \\\\\\\"state_version\\\\\\\": state_version,\\\\n158:         \\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\",\\\\n159:     }\\\\n160: \\\\n161: \\\\n162: @app.get(\\\\\\\"/system/state\\\\\\\")\\\\n163: async def system_state(request: Request) -> dict:\\\\n164:     state_version = await request.app.state.get_state_version()\\\\n165:     policy_version = await request.app.state.get_policy_version()\\\\n166:     return {\\\\\\\"system_state_version\\\\\\\": state_version, \\\\\\\"policy_version\\\\\\\": policy_version}\\\\n167: \\\\n168: \\\\n169: def _sync_policies(s) -> None:\\\\n170:     \\\\\\\"\\\\\\\"\\\\\\\"Copy bundled default policy to ~/.xnch/policies/ if not already present.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n171:     import pathlib, shutil\\\\n172:     bundled = pathlib.Path(__file__).parent.parent.parent / \\\\\\\"policies\\\\\\\" / \\\\\\\"default.yaml\\\\\\\"\\\\n173:     target = s.policies_dir / \\\\\\\"default.yaml\\\\\\\"\\\\n174:     if bundled.exists() and not target.exists():\\\\n175:         shutil.copy(bundled, target)\\\\n\\\\n(End of file - total 175 lines)\\\\n</content>\\\"},\\\"sessionId\\\":\\\"ses_0fb0da627ffe1MoEyui2GTY7HI\\\",\\\"timestamp\\\":\\\"2026-06-26T17:21:04.024Z\\\",\\\"toolInput\\\":\\\"{\\\\\\\"filePath\\\\\\\":\\\\\\\"/Users/xnch/xnchSystems/xnch/xnch/main.py\\\\\\\"}\\\",\\\"toolName\\\":\\\"read\\\",\\\"toolOutput\\\":\\\"<path>/Users/xnch/xnchSystems/xnch/xnch/main.py</path>\\\\n<type>file</type>\\\\n<content>\\\\n1: \\\\\\\"\\\\\\\"\\\\\\\"xnch-server v0 — governance, memory, and authorization service.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n2: import logging\\\\n3: from contextlib import asynccontextmanager\\\\n4: from starlette.requests import Request\\\\n5: from apscheduler.schedulers.asyncio import AsyncIOScheduler\\\\n6: from fastapi import FastAPI\\\\n7: \\\\n8: from .auth import load_or_generate_keypair, GovernanceStore, TokenSigner, TokenVerifier\\\\n9: from .audit import EventLog, DecisionLedger\\\\n10: from .config import settings\\\\n11: from .learning import PatternExtractor, ScoreAdap