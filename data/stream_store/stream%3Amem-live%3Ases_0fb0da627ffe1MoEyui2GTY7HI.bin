     await redis.set(SYSTEM_PROMPT_CACHE_KEY, prompt, ex=SYSTEM_PROMPT_CACHE_TTL)\\\\n70:     return prompt\\\\n71: \\\\n72: \\\\n73: @router.post(\\\\\\\"/chat\\\\\\\")\\\\n74: async def chat(body: ChatRequest, request: Request) -> dict[str, Any]:\\\\n75:     app = request.app.state\\\\n76: \\\\n77:     result = scan_input(body.message, app.event_log)\\\\n78:     if not result.is_clean:\\\\n79:         raise HTTPException(status_code=400, detail=\\\\\\\"Input rejected by injection guard\\\\\\\")\\\\n80: \\\\n81:     ctx = await assemble_context(\\\\n82:         session_id=body.session_id,\\\\n83:         raw_input=body.message,\\\\n84:         working_memory=app.working_memory,\\\\n85:         pg_episodic=app.pg_episodic,\\\\n86:         graph_store=app.graph_store,\\\\n87:         relationship_store=app.relationship_store,\\\\n88:         sensory_buffer=app.sensory_buffer,\\\\n89:         proactivity_engine=_get_proactivity(app),\\\\n90:     )\\\\n91: \\\\n92:     route = classify_request(body.message, body.actor_role, {})\\\\n93:     messages = ctx.to_messages(body.message)\\\\n94:     model_name = route.model_name\\\\n95: \\\\n96:     try:\\\\n97:         async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\\\\n98:             resp = await client.post(\\\\n99:                 \\\\\\\"/chat/completions\\\\\\\",\\\\n100:                 json={\\\\n101:                     \\\\\\\"model\\\\\\\": model_name,\\\\n102:                     \\\\\\\"messages\\\\\\\": messages,\\\\n103:                     \\\\\\\"max_tokens\\\\\\\": 2048,\\\\n104:                     \\\\\\\"temperature\\\\\\\": 0.7,\\\\n105:                 },\\\\n106:                 headers={\\\\\\\"Authorization\\\\\\\": f\\\\\\\"Bearer {LITELLM_API_KEY}\\\\\\\"} if LITELLM_API_KEY else {},\\\\n107:             )\\\\n108:             resp.raise_for_status()\\\\n109:             response_text = resp.json()[\\\\\\\"choices\\\\\\\"][0][\\\\\\\"message\\\\\\\"][\\\\\\\"content\\\\\\\"]\\\\n110:     except Exception as exc:\\\\n111:         logger.error(\\\\\\\"LiteLLM call failed: %s\\\\\\\", exc)\\\\n112:         raise HTTPException(status_code=502, detail=\\\\\\\"LiteLLM unavailable\\\\\\\")\\\\n113: \\\\n114:     await app.working_memory.append_turn(body.session_id, \\\\\\\"user\\\\\\\", body.message)\\\\n115:     await app.working_memory.append_turn(body.session_id, \\\\\\\"assistant\\\\\\\", response_text)\\\\n116: \\\\n117:     await app.pg_episodic.store_episode(\\\\n118:         type_=\\\\\\\"conversation\\\\\\\",\\\\n119:         raw_text=f\\\\\\\"{body.message}\\\\\\\\n{response_text}\\\\\\\",\\\\n120:         summary=f\\\\\\\"OpenClaw chat: {body.message[:100]}\\\\\\\",\\\\n121:     )\\\\n122: \\\\n123:     _invalidate_system_prompt_cache(app)\\\\n124: \\\\n125:     return {\\\\n126:         \\\\\\\"response\\\\\\\": response_text,\\\\n127:         \\\\\\\"model_used\\\\\\\": model_name,\\\\n128:         \\\\\\\"session_id\\\\\\\": body.session_id,\\\\n129:     }\\\\n130: \\\\n131: \\\\n132: @router.post(\\\\\\\"/chat/stream\\\\\\\")\\\\n133: async def chat_stream(body: ChatRequest, request: Request) -> StreamingResponse:\\\\n134:     app = request.app.state\\\\n135: \\\\n136:     result = scan_input(body.message, app.event_log)\\\\n137:     if not result.is_clean:\\\\n138:         raise HTTPException(status_code=400, detail=\\\\\\\"Input rejected by injection guard\\\\\\\")\\\\n139: \\\\n140:     ctx = await assemble_context(\\\\n141:         session_id=body.session_id,\\\\n142:         raw_input=body.message,\\\\n143:         working_memory=app.working_memory,\\\\n144:         pg_episodic=app.pg_episodic,\\\\n145:         graph_store=app.graph_store,\\\\n146:         relationship_store=app.relationship_store,\\\\n147:         sensory_buffer=app.sensory_buffer,\\\\n148:         proactivity_engine=_get_proactivity(app),\\\\n149:     )\\\\n150: \\\\n151:     route = classify_request(body.message, body.actor_role, {})\\\\n152:     messages = ctx.to_messages(body.message)\\\\n153:     model_name = route.model_name\\\\n154: \\\\n155:     await app.working_memory.append_turn(body.session_id, \\\\\\\"user\\\\\\\", body.message)\\\\n156: \\\\n157:     async def event_stream():\\\\n158:         full_text = \\\\\\\"\\\\\\\"\\\\n159:         try:\\\\n160:             async with httpx.AsyncClient(base_url=LITELLM_BASE, timeout=120.0) as client:\\\\n161:                 async with client.stream(\\\\n162:                     \\\\\\\"POST\\\\\\\",\\\\n163:                     \\\\\\\"/chat/completions\\\\\\\",\\\\n164:                     json={\\\\n165:                         \\\\\\\"model\\\\\\\": model_name,\\\\n166:                         \\\\\\\"messages\\\\\\\": messages,\\\\n167:                         \\\\\\\"max_tokens\\\\\\\": 2048,\\\\n168:                         \\\\\\\"temperature\\\\\\\": 0.7,\\\\n169:                         \\\\\\\"stream\\\\\\\": True,\\\\n170:                     },\\\\n171:                     headers={\\\\\\\"Authorization\\\\\\\": f\\\\\\\"Bearer {LITELLM_API_KEY}\\\\\\\"} if LITELLM_API_KEY else {},\\\\n172:                 ) as resp:\\\\n173:                     if resp.status_code != 200:\\\\n174:                         yield f\\\\\\\"data: {json.dumps({'error': f'LiteLLM error {resp.status_code}'})}\\\\\\\\n\\\\\\\\n\\\\\\\"\\\\n175:                         yield \\\\\\\"data: [DONE]\\\\\\\\n\\\\\\\\n\\\\\\\"\\\\n176:                         return\\\\n177:                     async for line in resp.aiter_lines():\\\\n178:                         if not line.startswith(\\\\\\\"data: \\\\\\\"):\\\\n179:                             continue\\\\n180:                         payload = line.removeprefix(\\\\\\\"data: \\\\\\\")\\\\n181:                         if payload == \\\\\\\"[DONE]\\\\\\\":\\\\n182:                             break\\\\n183:                         try:\\\\n184:                             chunk = json.loads(payload)\\\\n185:               