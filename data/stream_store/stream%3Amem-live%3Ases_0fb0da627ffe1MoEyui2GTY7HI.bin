27.130Z\",\"toolInput\":\"{\\\"pattern\\\":\\\"\\\\\\\\._redis\\\",\\\"path\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py\\\"}\",\"toolName\":\"grep\",\"toolOutput\":\"No files found\"},\"type\":\"raw\"}}\u0000\u0000\u0000�\u0004\u0001\u0000ؾ��\n\\ No newline at end of file\n","status":"added"},{"additions":1,"deletions":0,"file":"data/stream_store/stream%3Amem-live%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin","patch":"Index: data/stream_store/stream%3Amem-live%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin\n===================================================================\n--- data/stream_store/stream%3Amem-live%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin\t\n+++ data/stream_store/stream%3Amem-live%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin\t\n@@ -0,0 +1,1 @@\n+{\"obs_mqv8u4y5_c1668f898dcd\":{\"observation\":{\"concepts\":[\"session management\",\"event hooks\"],\"confidence\":0.9,\"facts\":[\"Timestamp: 2026-06-26T18:07:25.323Z\",\"Event type: session_updated hook\"],\"files\":[],\"id\":\"obs_mqv8u4y5_c1668f898dcd\",\"importance\":1,\"narrative\":\"A system hook was triggered indicating a session update. This event serves as a notification for state changes within the active session.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Internal system hook triggered\",\"timestamp\":\"2026-06-26T18:07:25.323Z\",\"title\":\"System event: session_updated\",\"type\":\"other\"},\"type\":\"compressed\"},\"obs_mqv8u4y8_a73a3fc7c71a\":{\"observation\":{\"concepts\":[\"Python 3.13 asyncio compatibility</cancept>\\n    <concept>APScheduler configuration\",\"SQLite schema alignment\",\"AsyncIO event loop management\"],\"confidence\":1,\"facts\":[\"Bug 1: `lambda: __import__('asyncio').get_event_loop().create_task(...)` causes `RuntimeError` in Python 3.13 when run in non-main threads.\",\"Bug 1 Fix: Replace lambda wrappers with direct coroutine references in `scheduler.add_job`.\",\"Bug 2: `score_adapter.py` references `context_json` which does not exist in the SQLite schema.\",\"Bug 2 Fix: Rename `context_json` to `context_snapshot` in SQL query and dictionary access.\"],\"files\":[\"/Users/xnch/xnchSystems/xnch/xnch/main.py\",\"/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py\"],\"id\":\"obs_mqv8u4y8_a73a3fc7c71a\",\"importance\":6,\"narrative\":\"The user has identified two specific bugs in the xnch package requiring code modifications in `main.py` and `score_adapter.py`. The goal is to update the scheduler implementation for Python 3.13 compatibility and correct a database column name mismatch.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Fix APScheduler RuntimeError in Python 3.13 and incorrect SQL column name\",\"timestamp\":\"2026-06-26T18:07:25.326Z\",\"title\":\"Bug fix task: xnch package\",\"type\":\"task\"},\"type\":\"compressed\"},\"obs_mqv8u4yq_5432f11708f2\":{\"observation\":{\"concepts\":[\"session management\",\"system hooks\"],\"confidence\":0.9,\"facts\":[\"Timestamp: 2026-06-26T18:07:25.345Z\",\"Hook: session_status\"],\"files\":[],\"id\":\"obs_mqv8u4yq_5432f11708f2\",\"importance\":1,\"narrative\":\"A system hook for session status was recorded at the specified timestamp. This represents a routine status update.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"System event timestamp\",\"timestamp\":\"2026-06-26T18:07:25.345Z\",\"title\":\"Session Status Hook Triggered\",\"type\":\"other\"},\"type\":\"compressed\"},\"obs_mqv8u4yt_d8fa0f305064\":{\"observation\":{\"concepts\":[\"memory compression\",\"structured data extraction\"],\"confidence\":0.9,\"facts\":[\"Timestamp: 2026-06-26T18:07:25.347Z\",\"Role: Memory compression engine for AI coding agent\"],\"files\":[],\"id\":\"obs_mqv8u4yt_d8fa0f305064\",\"importance\":1,\"narrative\":\"The system has been initialized and is ready to process tool usage observations. The engine will transform raw observations into structured XML for long-term memory retention.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Memory compression engine operational\",\"timestamp\":\"2026-06-26T18:07:25.347Z\",\"title\":\"System Initialization\",\"type\":\"conversation\"},\"type\":\"compressed\"},\"obs_mqv8u52a_fd8805143f5c\":{\"observation\":{\"concepts\":[\"session management\",\"state synchronization\"],\"confidence\":0.9,\"facts\":[\"Timestamp: 2026-06-26T18:07:25.473Z\",\"Hook name: session_diff\"],\"files\":[],\"id\":\"obs_mqv8u52a_fd8805143f5c\",\"importance\":1,\"narrative\":\"A session diff hook was triggered at the specified timestamp. This indicates a check or synchronization event occurred within the session state.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Timestamped event for session_diff hook\",\"timestamp\":\"2026-06-26T18:07:25.473Z\",\"title\":\"Session Diff Hook Triggered\",\"type\":\"other\"},\"type\":\"compressed\"},\"obs_mqv8u52h_3716a9a50b44\":{\"observation\":{\"hookType\":\"llm_params\",\"id\":\"obs_mqv8u52h_3716a9a50b44\",\"raw\":{\"agent\":\"languages/python-pro\",\"context_limit\":200000,\"cost_1k_input\":0,\"cost_1k_output\":0,\"max_output_tokens\":32000,\"model\":\"opencode/big-pickle\",\"provider_url\":\"https://opencode.ai/zen/v1\"},\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"timestamp\":\"2026-06-26T18:07:25.481Z\"},\"type\":\"raw\"},\"obs_mqv8u6wg_042fe446e198\":{\"observation\":{\"concepts\":[\"memory compression\",\"structured data extraction\",\"observation logging\"],\"confidence\":0.9,\"facts\":[\"The engine is designed to extract essential information from tool usage observations.\",\"Output must adhere to a strict XML schema for structured data storage.\"],\"files\":[],\"id\":\"obs_mqv8u6wg_042fe446e198\",\"importance\":5,\"narrative\":\"The system has initialized its memory compression protocol. This allows for efficient processing of tool usage observations by converting raw logs into structured, searchable XML observations.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Initialization of the compression process for tool usage observations\",\"timestamp\":\"2026-06-26T18:07:27.854Z\",\"title\":\"Memory Compression Engine Activation\",\"type\":\"decision\"},\"type\":\"compressed\"},\"obs_mqv8u7dm_32bdb2c10018\":{\"observation\":{\"concepts\":[\"FastAPI lifespan\",\"Multi-layered memory architecture\",\"Hierarchical storage (Redis/Postgres/Local)\",\"Agentic governance\"],\"confidence\":1,\"facts\":[\"The service is a FastAPI-based governance, memory, and authorization service.\",\"Uses a multi-layered memory architecture including EpisodicStore, PatternStore, KVCache, SensoryBuffer, WorkingMemory, and GraphStore.\",\"Utilizes Redis for transient layers (Sensory/Working) and Postgres/local DB for persistent layers.\",\"Implements complex lifecycle management via an asynclifespan including auth keypair generation and DB bootstrapping.\"],\"files\":[\"/Users/xnch/xnchSystems/xnch/xnch/main.py\"],\"id\":\"obs_mqv8u7dm_32bdb2c10018\",\"importance\":6,\"narrative\":\"Read the main entry point to understand the system's initialization sequence and architectural layers. The system manages complex state across multiple storage engines (Redis, Postgres, local files) and implements a tiered memory model.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Exploring the core architecture of xnch-server\",\"timestamp\":\"2026-06-26T18:07:28.472Z\",\"title\":\"Read main.py entry point\",\"type\":\"file_read\"},\"type\":\"compressed\"},\"obs_mqv8u7ew_b87a5c59f104\":{\"observation\":{\"concepts\":[\"drift detection\",\"performance monitoring\",\"weight optimization\",\"accuracy correlation\"],\"confidence\":1,\"facts\":[\"ScoreAdapter monitors prediction accuracy across four dimensions: policy_score, outcome_score, risk_score, and context_fit_score.\",\"Identifies drift when 7-day accuracy deviates from 30-day baseline by > 0.05.\",\"Triggers weight adjustment proposals via POST /governance/weights/propose when drift is detected.\",\"Uses correlation between predicted scores and actual outcomes (SUCCESS/FAILURE) to measure accuracy.\"],\"files\":[\"/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py\"],\"id\":\"obs_mqv8u7ew_b87a5c59f104\",\"importance\":4,\"narrative\":\"Read the implementation of ScoreAdapter to understand how the system detects performance drift in scoring dimensions and how it proposes new weights to the governance API.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"Analyzing the ScoreAdapter implementation for drift detection\",\"timestamp\":\"2026-06-26T18:07:28.519Z\",\"title\":\"Read score_adapter.py\",\"type\":\"file_read\"},\"type\":\"compressed\"},\"obs_mqv8u7hz_11eeaca19f4e\":{\"observation\":{\"concepts\":[\"lifecycle hooks\",\"lifecycle hooks\"],\"confidence\":0.9,\"facts\":[\"Timestamp: 2026-06-26T18:07:28.630Z\",\"Triggered hook: step_finish\"],\"files\":[],\"id\":\"obs_mqv8u7hz_11eeaca19f4e\",\"importance\":1,\"narrative\":\"The execution step has reached a completion state. This marks the end of a processing cycle.\",\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"subtitle\":\"System event: step_finish hook triggered\",\"timestamp\":\"2026-06-26T18:07:28.630Z\",\"title\":\"Step Finish Notification\",\"type\":\"other\"},\"type\":\"compressed\"},\"obs_mqv8ugeh_3ce08d6a0ea9\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv8ugeh_3ce08d6a0ea9\",\"raw\":{\"attachments\":[],\"call_id\":\"call_00_KvrQDdtefDo6HHYPFBdx7462\",\"duration_ms\":9,\"metadata\":{\"description\":\"Check git history for both files\",\"exit\":0,\"output\":\"29079db (HEAD -> v0, v4-localOC, v3) nexi-xnch-v0\\n\",\"truncated\":false},\"title\":\"Check git history for both files\",\"tool_input\":\"{\\\"command\\\":\\\"git log --oneline -10 -- xnch/xnch/main.py xnch/xnch/learning/score_adapter.py\\\",\\\"description\\\":\\\"Check git history for both files\\\"}\",\"tool_name\":\"bash\",\"tool_output\":\"29079db (HEAD -> v0, v4-localOC, v3) nexi-xnch-v0\\n\"},\"sessionId\":\"ses_0fae28776ffeZ9tGekj9Vspli7\",\"timestamp\":\"2026-06-26T18:07:40.167Z\",\"toolInput\":\"{\\\"command\\\":\\\"git log --oneline -10 -- xnch/xnch/main.py xnch/xnch/learning/score_adapter.py\\\",\\\"description\\\":\\\"Check git history for both files\\\"}\",\"toolName\":\"bash\",\"toolOutput\":\"29079db (HEAD -> v0, v4-localOC, v3) nexi-xnch-v0\\n\"},\"type\":\"raw\"},\"obs_mqv8ugmr_de0f7d6b3bdf\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv8ugmr_de0f7d6b3bdf\",\"raw\":{\"attachments\":[],\"call_id\":\"call_01_Ncm7hQOzOPFS7yp96HpB2127\",\"duration_ms\":1,\"metadata\":{\"description\":\"Check uncommitted changes in both files\",\"exit\":0,\"output\":\"diff --git c/xnch/xnch/learning/score_adapter.py w/xnch/xnch/learning/score_adapter.py\\nindex 45ca618..19fc71e 100644\\n--- c/xnch/xnch/learning/score_adapter.py\\n+++ w/xnch/xnch/learning/score_adapter.py\\n@@ -1,10 +1,15 @@\\n-\\\"\\\"\\\"Score Adapter — monitors dimension prediction accuracy; proposes weight adjustments.\\\"\\\"\\\"\\n+\\\"\\\"\\\"Score Adapter — monitors per-dimension prediction accuracy; proposes weight adjustments.\\n+\\n+Rolling 7-day accuracy vs 30-day baseline.\\n+If drift > 0.05: POST /governance/weights/propose.\\n+\\\"\\\"\\\"\\n import json\\n import logging\\n import time\\n from pathlib import Path\\n from uuid import uuid4\\n \\n+import httpx\\n import aiosqlite\\n \\n from ..config import settings\\n@@ -13,48 +18,139 @@ logger = logging.getLogger(__name__)\\n \\n _DIMENSIONS = [\\\"policy_score\\\", \\\"outcome_score\\\", \\\"risk_score\\\", \\\"context_fit_score\\\"]\\n \\n+_DEFAULT_WEIGHTS = {\\n+    'policy_score': 0.4,\\n+    'outcome_score': 0.3,\\n+    'risk_score': 0.2,\\n+    'context_fit_score': 0.1,\\n+}\\n+\\n \\n class ScoreAdapter:\\n     def __init__(self, db_path: Path) -> None:\\n         self._db = db_path\\n \\n     async def evaluate(self) -> list[dict]:\\n-        \\\"\\\"\\\"Check dimension accuracy. Returns list of proposed weight adjustments.\\\"\\\"\\\"\\n         episodes = await self._fetch_episodes_with_scores()\\n         if not episodes:\\n             return []\\n \\n+        now = time.time()\\n+        seven_days = now - 86400 * 7\\n+        thirty_days = now - 86400 * 30\\n+\\n+        short_win = [e for e in episodes if e[\\\"created_at\\\"] >= seven_days]\\n+        long_win = [e for e in episodes if e[\\\"created_at\\\"] >= thirty_days]\\n+\\n         proposals = []\\n         for dim in _DIMENSIONS:\\n-            predicted = [ep[dim] for ep in episodes if ep.get(dim) is not None]\\n-            actuals = [1.0 if ep[\\\"outcome\\\"] == \\\"SUCCESS\\\" else 0.0\\n-                       for ep in episodes if ep.get(dim) is not None]\\n-            if len(predicted) < 10:\\n-                continue\\n+            short_acc = self._dimension_accuracy(short_win, dim)\\n+            long_acc = self._dimension_accuracy(long_win, dim)\\n+            drift = abs(short_acc - long_acc)\\n \\n-            accuracy = self._correlation(predicted, actuals)\\n-            if accuracy < settings.score_adapter_accuracy_threshold:\\n-                logger.warning(\\\"Dimension %s accuracy %.2f < %.2f — proposing adjustment\\\",\\n-                               dim, accuracy, settings.score_adapter_accuracy_threshold)\\n-                proposals.append({\\n-                    \\\"dimension\\\": dim,\\n-                    \\\"current_accuracy\\\": round(accuracy, 4),\\n-                    \\\"threshold\\\": settings.score_adapter_accuracy_threshold,\\n-                    \\\"episode_count\\\": len(predicted),\\n-                })\\n+            logger.info(\\n+                \\\"Dimension %s: 7d=%.3f  30d=%.3f  drift=%.4f\\\",\\n+                dim, short_acc, long_acc, drift,\\n+            )\\n \\n+            if drift > 0.05 and len(short_win) >= 10:\\n+                logger.warning(\\n+                    \\\"Drift %.4f > 0.05 for %s — proposing weight adjustment\\\",\\n+                    drift, dim,\\n+                )\\n+                intent_classes = set(e[\\\"intent_class\\\"] for e in short_win)\\n+                for ic in intent_classes:\\n+                    current = await self._fetch_current_weights(ic)\\n+                    version = await self._propose_via_api(\\n+                        intent_class=ic,\\n+                        current_weights=current.get(\\\"weights\\\", current),\\n+                        dimension=dim,\\n+                        accuracy=short_acc,\\n+                    )\\n+                    if version:\\n+                        proposals.append({\\n+                            \\\"intent_class\\\": ic,\\n+                            \\\"dimension\\\": dim,\\n+                            \\\"drift\\\": round(drift, 4),\\n+                            \\\"short_accuracy\\\": round(short_acc, 4),\\n+                            \\\"long_accuracy\\\": round(long_acc, 4),\\n+                            \\\"version\\\": version,\\n+                        })\\n         return proposals\\n \\n-    async def propose_weight_adjustment(\\n+    def _dimension_accuracy(self, episodes: list[dict], dimension: str) -> float:\\n+        predicted = [ep[\\\"scores\\\"].get(dimension) for ep in episodes\\n+                     if ep.get(\\\"scores\\\") and ep[\\\"scores\\\"].get(dimension) is not None]\\n+        if len(predicted) < 5:\\n+            return 1.0\\n+        actuals = [1.0 if ep[\\\"outcome\\\"] == \\\"SUCCESS\\\" else 0.0 for ep in episodes\\n+                   if ep.get(\\\"scores\\\") and ep[\\\"scores\\\"].get(dimension) is not None]\\n+        return self._correlation(predicted, actuals)\\n+\\n+    def _correlation(self, predicted: list[float], actual: list[float]) -> float:\\n+        n = len(predicted)\\n+        if n < 2:\\n+            return 1.0\\n+        mean_p = sum(predicted) / n\\n+        mean_a = sum(actual) / n\\n+        num = sum((p - mean_p) * (a - mean_a) for p, a in zip(predicted, actual))\\n+        den_p = (sum((p - mean_p) ** 2 for p in predicted)) ** 0.5\\n+        den_a = (sum((a - mean_a) ** 2 for a in actual)) ** 0.5\\n+        if den_p * den_a == 0:\\n+            return 1.0\\n+        return num / (den_p * den_a)\\n+\\n+    async def _fetch_episodes_with_scores(self) -> list[dict]:\\n+        async with aiosqlite.connect(self._db) as db:\\n+            db.row_factory = aiosqlite.Row\\n+            async with db.execute(\\n+                 \\\"\\\"\\\"SELECT episode_id, intent_class, outcome, context_snapshot, created_at\\n+                    FROM decision_episodes\\n+                   WHERE outcome IS NOT NULL\\n+                     AND json_extract(context_snapshot, '$.scores') IS NOT NULL\\n+                   ORDER BY created_at DESC\\n+                   LIMIT 5000\\\"\\\"\\\"\\n+            ) as cursor:\\n+                rows = await cursor.fetchall()\\n+\\n+        results = []\\n+        for r in rows:\\n+            try:\\n+                snapshot = json.loads(r[\\\"context_snapshot\\\"])\\n+            except (json.JSONDecodeError, TypeError):\\n+                continue\\n+            scores = snapshot.get(\\\"scores\\\") if isinstance(snapshot, dict) else None\\n+            if not scores:\\n+                continue\\n+            results.append({\\n+                \\\"episode_id\\\": r[\\\"episode_id\\\"],\\n+                \\\"intent_class\\\": r[\\\"intent_class\\\"],\\n+                \\\"outcome\\\": r[\\\"outcome\\\"],\\n+                \\\"scores\\\": scores,\\n+                \\\"created_at\\\": r[\\\"created_at\\\"],\\n+            })\\n+        return results\\n+\\n+    async def _fetch_current_weights(self, intent_class: str) -> dict:\\n+        async with aiosqlite.connect(self._db) as db:\\n+            db.row_factory = aiosqlite.Row\\n+            async with db.execute(\\n+                \\\"SELECT weights FROM weight_configs WHERE intent_class = ? AND is_active = 1\\\",\\n+                (intent_class,),\\n+            ) as cursor:\\n+                row = await cursor.fetchone()\\n+        if row:\\n+            return json.loads(row[\\\"weights\\\"])\\n+        return dict(_DEFAULT_WEIGHTS)\\n+\\n+    async def _propose_via_api(\\n         self,\\n         intent_class: str,\\n         current_weights: dict,\\n         dimension: str,\\n         accuracy: float,\\n-        episode_batch: str,\\n     ) -> str:\\n-        \\\"\\\"\\\"Write a pending weight config for operator review.\\\"\\\"\\\"\\n-        rate = settings.score_adapter_accuracy_threshold - accuracy\\n+        rate = 0.6 - accuracy\\n         adjustment = min(rate * 0.1, 0.05)\\n \\n         new_weights = dict(current_weights)\\n@@ -71,31 +167,19 @@ class ScoreAdapter:\\n             logger.warning(\\\"Weight adjustment would violate minimum 0.05 constraint — skipping\\\")\\n             return \\\"\\\"\\n \\n-        version = f\\\"wc-proposed-{uuid4().hex[:8]}\\\"\\n-        async with aiosqlite.connect(self._db) as db:\\n-            await db.execute(\\n-                \\\"\\\"\\\"INSERT INTO pending_weight_configs\\n-                   (version, intent_class, weights, episode_batch, proposed_at, proposed_by)\\n-                   VALUES (?, ?, ?, ?, ?, ?)\\\"\\\"\\\",\\n-                (version, intent_class, json.dumps(new_weights), episode_batch,\\n-                 time.time(), \\\"score_adapter\\\"),\\n-            )\\n-            await db.commit()\\n-        return version\\n-\\n-    def _correlation(self, predicted: list[float], actual: list[float]) -> float:\\n-        n = len(predicted)\\n-        if n < 2:\\n-            return 1.0\\n-        mean_p = sum(predicted) / n\\n-        mean_a = sum(actual) / n\\n-        num = sum((p - mean_p) * (a - mean_a) for p, a in zip(predicted, actual))\\n-        den_p = (sum((p - mean_p) ** 2 for p in predicted)) ** 0.5\\n-        den_a = (sum((a - mean_a) ** 2 for a in actual)) ** 0.5\\n-        if den_p * den_a == 0:\\n-            return 1.0\\n-        return num / (den_p * den_a)\\n-\\n-    async def _fetch_episodes_with_scores(self) -> list[dict]:\\n-        # v0 stub: returns empty — full implementation queries episodes joined with decision scores\\n-        return []\\n+        payload = {\\n+            \\\"intent_class\\\": intent_class,\\n+            \\\"weights\\\": new_weights,\\n+            \\\"episode_batch\\\": f\\\"batch-{int(time.time())}\\\",\\n+            \\\"proposed_by\\\": \\\"score_adapter\\\",\\n+        }\\n+        try:\\n+            async with httpx.AsyncClient(base_url=\\\"http://localhost:8001\\\", timeout=10.0) as client:\\n+                resp = await client.post(\\\"/governance/weights/propose\\\", json=payload)\\n+                resp.raise_for_status()\\n+                result = resp.json()\\n+                logger.info(\\\"Weight proposal submitted: %s\\\", result.get(\\\"version\\\"))\\n+                return result.get(\\\"version\\\", \\\"\\\")\\n+        except Exception as exc:\\n+            logger.error(\\\"Failed to propose weight adjustment: %s\\\", exc)\\n+            return \\\"\\\"\\n\\\\ No newline at end of file\\ndiff --git c/xnch/xnch/main.py w/xnch/xnch/main.py\\nindex 3ec31e0..32b2171 100644\\n--- c/xnch/xnch/main.py\\n+++ w/xnch/xnch/main.py\\n@@ -9,12 +9,14 @@ from .auth import load_or_generate_keypair, GovernanceStore, TokenSigner, TokenV\\n from .audit import EventLog, DecisionLedger\\n from .config import settings\\n from .learning import PatternExtractor, ScoreAdapter, PolicyCandidateGenerator\\n-from .memory import init_db, EpisodicStore, PatternStore, KVCache\\n+from .memory import init_db, EpisodicStore, PatternStore, KVCache, PgEpisodicStore\\n+from .memory import SensoryBuffer, WorkingMemory, GraphStore, RelationshipStore\\n from .memory.db import get_state_version, get_policy_version, increment_state_version\\n from .policy import PolicyLoader, PolicyEngine\\n from .routes import (\\n     session_router, memory_router, policy_rout