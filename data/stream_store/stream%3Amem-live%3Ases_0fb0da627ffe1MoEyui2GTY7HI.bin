\\n99:     s.increment_state_version = _increment_state_version\\\\n100: \\\\n101:     # Scheduler\\\\n102:     scheduler = AsyncIOScheduler()\\\\n103:     scheduler.add_job(\\\\n104:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n105:             s.pattern_extractor.run()\\\\n106:         ),\\\\n107:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", id=\\\\\\\"pattern_extractor\\\\\\\",\\\\n108:     )\\\\n109:     scheduler.add_job(\\\\n110:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n111:             s.score_adapter.evaluate()\\\\n112:         ),\\\\n113:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", minute=30, id=\\\\\\\"score_adapter\\\\\\\",\\\\n114:     )\\\\n115:     scheduler.add_job(\\\\n116:         lambda: __import__('asyncio').get_event_loop().create_task(\\\\n117:             s.policy_candidates.run()\\\\n118:         ),\\\\n119:         \\\\\\\"cron\\\\\\\", hour=\\\\\\\"*/6\\\\\\\", minute=45, id=\\\\\\\"policy_candidates\\\\\\\",\\\\n120:     )\\\\n121:     scheduler.start()\\\\n122:     s.scheduler = scheduler\\\\n123: \\\\n124:     s.event_log.emit(\\\\\\\"startup\\\\\\\", \\\\\\\"xnch\\\\\\\", \\\\\\\"SERVER_STARTED\\\\\\\", data={\\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\"})\\\\n125:     logger.info(\\\\\\\"xnch-server started\\\\\\\")\\\\n126: \\\\n127:     yield\\\\n128: \\\\n129:     scheduler.shutdown(wait=False)\\\\n130:     await s.kv_cache.aclose()\\\\n131:     await s.sensory_buffer.aclose()\\\\n132:     await s.working_memory.aclose()\\\\n133:     await s.relationship_store.close()\\\\n134:     await s.pg_episodic.close()\\\\n135:     s.event_log.emit(\\\\\\\"shutdown\\\\\\\", \\\\\\\"xnch\\\\\\\", \\\\\\\"SERVER_STOPPED\\\\\\\")\\\\n136: \\\\n137: \\\\n138: app = FastAPI(title=\\\\\\\"xnch\\\\\\\", version=\\\\\\\"0.1.0\\\\\\\", lifespan=lifespan)\\\\n139: \\\\n140: app.include_router(session_router)\\\\n141: app.include_router(memory_router)\\\\n142: app.include_router(policy_router)\\\\n143: app.include_router(verdict_router)\\\\n144: app.include_router(execution_router)\\\\n145: app.include_router(governance_router)\\\\n146: app.include_router(auth_router)\\\\n147: app.include_router(nexi_gateway_router)\\\\n148: \\\\n149: \\\\n150: @app.get(\\\\\\\"/health\\\\\\\")\\\\n151: async def health(request: Request) -> dict:\\\\n152:     redis_ok = await request.app.state.kv_cache.ping()\\\\n153:     state_version = await request.app.state.get_state_version()\\\\n154:     return {\\\\n155:         \\\\\\\"status\\\\\\\": \\\\\\\"ok\\\\\\\" if redis_ok else \\\\\\\"degraded\\\\\\\",\\\\n156:         \\\\\\\"redis\\\\\\\": \\\\\\\"ok\\\\\\\" if redis_ok else \\\\\\\"unavailable\\\\\\\",\\\\n157:         \\\\\\\"state_version\\\\\\\": state_version,\\\\n158:         \\\\\\\"version\\\\\\\": \\\\\\\"0.1.0\\\\\\\",\\\\n159:     }\\\\n160: \\\\n161: \\\\n162: @app.get(\\\\\\\"/system/state\\\\\\\")\\\\n163: async def system_state(request: Request) -> dict:\\\\n164:     state_version = await request.app.state.get_state_version()\\\\n165:     policy_version = await request.app.state.get_policy_version()\\\\n166:     return {\\\\\\\"system_state_version\\\\\\\": state_version, \\\\\\\"policy_version\\\\\\\": policy_version}\\\\n167: \\\\n168: \\\\n169: def _sync_policies(s) -> None:\\\\n170:     \\\\\\\"\\\\\\\"\\\\\\\"Copy bundled default policy to ~/.xnch/policies/ if not already present.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n171:     import pathlib, shutil\\\\n172:     bundled = pathlib.Path(__file__).parent.parent.parent / \\\\\\\"policies\\\\\\\" / \\\\\\\"default.yaml\\\\\\\"\\\\n173:     target = s.policies_dir / \\\\\\\"default.yaml\\\\\\\"\\\\n174:     if bundled.exists() and not target.exists():\\\\n175:         shutil.copy(bundled, target)\\\\n\\\\n(End of file - total 175 lines)\\\\n</content>\\\"},\\\"type\\\":\\\"raw\\\"},\\\"obs_mqv76j2g_d2aedb38fd38\\\":{\\\"observation\\\":{\\\"hookType\\\":\\\"post_tool_use\\\",\\\"id\\\":\\\"obs_m