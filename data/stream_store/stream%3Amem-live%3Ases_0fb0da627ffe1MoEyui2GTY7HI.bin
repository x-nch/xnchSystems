d\\\")\\n49: \\n50:             actor_role = request.headers.get(\\\"X-Actor-Role\\\", \\\"\\\")\\n51:             level = get_trust_level(actor_role)\\n52:             if level.value < minimum.value:\\n53:                 raise HTTPException(\\n54:                     status_code=403,\\n55:                     detail=f\\\"Actor '{actor_role}' (trust level {level.name}) \\\"\\n56:                            f\\\"does not meet minimum trust level {minimum.name}\\\",\\n57:                 )\\n58:             return await func(*args, **kwargs)\\n59:         return wrapper\\n60:     return decorator\\n\\n(End of file - total 60 lines)\\n</content>\"},\"type\":\"raw\"},\"obs_mqv7682k_b709c44efd08\":{\"observation\":{\"hookType\":\"post_tool_use\",\"id\":\"obs_mqv7682k_b709c44efd08\",\"raw\":{\"attachments\":[],\"call_id\":\"call_02_hDuaWk1bX1p0kV9nS7sy6775\",\"duration_ms\":10,\"metadata\":{\"loaded\":[],\"preview\":\"from __future__ import annotations\\n\\nimport re\\nfrom dataclasses import dataclass, field\\n\\nfrom xnch.audit.event_log import EventLog\\n\\nINJECTION_PATTERNS: list[re.Pattern] = [\\n    re.compile(r'ignore previous instructions', re.I),\\n    re.compile(r'forget your (system prompt|character|identity)', re.I),\\n    re.compile(r'you are now', re.I),\\n    re.compile(r'your new (instructions|role|persona)', re.I),\\n    re.compile(r'disregard.*above', re.I),\\n    re.compile(r'act as (?!Nexi)', re.I),\\n    re.compile(r'jailbreak', re.I),\\n    re.compile(r'DAN mode', re.I),\\n    re.compile(r'pretend (you|that)', re.I),\\n]\\n\\n\",\"truncated\":false},\"title\":\"xnch/xnch/security/injection_guard.py\",\"tool_input\":\"{\\\"filePath\\\":\\\"/Users/xnch/xnchSystems/xnch/xnch/security/injection_guard.py\\\"}\",\"tool_name\":\"read\",\"tool_output\":\"<path>/Users/xnch/xnchSystems/xnch/xnch/security/injection_guard.py</path>\\n<type>file</type>\\n<content>\\n1: from __future__ import annotations\\n2: \\n3: import re\\n4: from dataclasses import dataclass, field\\n5: \\n6: from xnch.audit.event_log import EventLog\\n7: \\n8: INJECTION_PATTERNS: list[re.Pattern] = [\\n9:     re.compile(r'ignore previous instructions', re.I),\\n10:     re.compile(r'forget your (system prompt|character|identity)', re.I),\\n11:     re.compile(r'you are now', re.I),\\n12:     re.compile(r'your new (instructions|role|persona)', re.I),\\n13:     re.compile(r'disregard.*above', re.I),\\n14:     re.compile(r'act as (?!Nexi)', re.I),\\n15:     re.compile(r'jailbreak', re.I),\\n16:     re.compile(r'DAN mode', re.I),\\n17:     re.compile(r'pretend (you|that)', re.I),\\n18: ]\\n19: \\n20: \\n21: @dataclass\\n22: class InjectionResult:\\n23:     is_clean: bool\\n24:     matched_patterns: list[str] = field(default_factory=list)\\n25:     risk_score: float = 0.0\\n26: \\n27: \\n28: def scan_input(text: str, event_log: EventLog | None = None) -> InjectionResult:\\n29:     matched: list[str] = []\\n30:     for pattern in INJECTION_PATTERNS:\\n31:         m = pattern.search(text)\\n32:         if m:\\n33:             matched.append(m.group(0))\\n34: \\n35:     if not matched:\\n36:         return InjectionResult(is_clean=True, risk_score=0.0)\\n37: \\n38:     risk_score = len(matched) / len(INJECTION_PATTERNS)\\n39: \\n40:     if risk_score > 0.1 and event_log is not None:\\n41:         event_log.emit(\\n42:             \\\"injection_guard\\\", \\\"security\\\",\\n43:             \\\"injection_attempt\\\",\\n44:             level=\\\"WARNING\\\",\\n45:             data={\\n46:                 \\\"matched_patterns\\\": matched,\\n47:                 \\\"risk_score\\\": risk_score,\\n48:                 \\\"text_preview\\\": text[:200],\\n49:             },\\n50:         )\\n51: \\n52:     is_clean = risk_score == 0.0\\n53:     return InjectionResult(is_clean=is_clean, matched_patterns=matched, risk_score=risk_score)\\n\\n(End of file - total 53 lines)\\n</content>\"},\"sessionId\":\"ses_0fb0da627ffe1MoEyui2GTY7HI\",\"timestamp\":\"2026-06-26T17:20:50.