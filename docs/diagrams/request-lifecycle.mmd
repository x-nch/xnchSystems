%% Request Lifecycle — Full Chat Request Processing
%% Sequence of interactions from user typing to response display

sequenceDiagram
    participant User
    participant OC as OpenClaw
    participant GW as nexi_gateway
    participant IG as injection_guard
    participant CA as context_assembler
    participant CL as classifier
    participant LL as LiteLLM
    participant GM as Gemma4
    participant WM as working_memory
    participant EP as pg_episodic_store

    User->>OC: types message
    OC->>GW: POST /nexi/chat
    GW->>IG: scan_input()
    IG->>GW: clean / reject
    GW->>CA: assemble_context(session_id, message)
    CA->>WM: get_turns(last 20)
    CA->>EP: retrieve_similar(top_k=5)
    EP-->>CA: similar episodes
    WM-->>CA: recent turns
    CA->>GW: AssembledContext
    GW->>CL: classify_request()
    CL->>GW: ModelRoute(gemma4-local)
    GW->>LL: POST /v1/chat (messages, context)
    LL->>GM: forward inference
    GM-->>LL: response tokens
    LL-->>GW: response
    GW->>WM: append_turn(user + assistant)
    GW->>EP: store_episode()
    GW-->>OC: {response, model_used}
    OC-->>User: display
