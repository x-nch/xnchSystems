%% Trust Model — Actor-Based Access Control
%% Request flow through trust level enforcement

flowchart LR

  REQ[Incoming Request] --> JWT[extract actor_role<br/>from JWT]
  JWT --> TRUST[get_trust_level()]
  TRUST --> DECO["@requires_trust(level)<br/>route decorator check"]

  DECO --> SYSTEM{"TrustLevel<br/>SYSTEM / OWNER?"}
  SYSTEM -->|yes| FULL[Full Access<br/>- all CRUD<br/>- policy management<br/>- governance overrides]

  DECO --> TRUSTED{"TrustLevel<br/>TRUSTED_AGENT?"}
  TRUSTED -->|yes| AGENT[Agent Access<br/>- write memory<br/>- trigger jobs<br/>- NO policy modify]

  DECO --> EXTERNAL{"TrustLevel<br/>EXTERNAL_AGENT?"}
  EXTERNAL -->|yes| READ[Read-Only Access<br/>- query episodes<br/>- browse graph<br/>- NO mutations]

  DECO --> UNTRUSTED{"TrustLevel<br/>UNTRUSTED?"}
  UNTRUSTED -->|yes| BLOCK[Blocked — 403 Forbidden]

  %% injection_guard runs regardless
  REQ --> IG[injection_guard<br/>scan_input() — always runs]
  IG --> JWT

  %% Actor-to-trust mapping
  subgraph Mappings["Actor → Trust Level Mappings"]
    M1["nexi engine —> SYSTEM"]
    M2["openclaw —> OWNER"]
    M3["claude_code —> TRUSTED_AGENT"]
    M4["perception_daemon —> TRUSTED_AGENT"]
    M5["consolidation_job —> TRUSTED_AGENT"]
    M6["external —> UNTRUSTED"]
  end
