%% System Overview — XNCH / Nexi Private AI Platform
%% Two physical nodes in k3s cluster

graph LR

  subgraph i7_node["i7-node (role=memory)"]
    direction TB
    PG[(PostgreSQL 15<br/>+ pgvector)]
    REDIS[(Redis 7)]
    LANGFUSE[Langfuse<br/>Observability]
    LITELLM[LiteLLM Proxy<br/>Model Router]
    XNCH["xnch Server<br/>(FastAPI :8001)"]
    DAEMONS["Perception Daemons<br/>Silero VAD · faster-whisper<br/>Moondream2 · watchdog"]
    KUZU[Kuzu Graph DB<br/>(planned)]
  end

  subgraph i9_node["i9-node (role=inference)"]
    direction TB
    VLLM["vLLM + Gemma 4 26B<br/>(OpenAI-compat :8000)"]
    NEXI["Nexi Engine<br/>(FastAPI :8000)"]
    MEM0[mem0]
    ZEP[Zep]
    OPENCLAW[OpenClaw Client]
  end

  %% Communication arrows
  OPENCLAW -->|"model request"| LITELLM
  LITELLM -->|"route"| VLLM
  NEXI -->|"http://xnch:8001"| XNCH
  XNCH <-->|"SQL / vector"| PG
  XNCH <-->|"session / buffer"| REDIS
