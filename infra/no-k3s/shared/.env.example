# Node IPs (static, 192.168.50.0/24 LAN)
NODE_A_IP=192.168.50.1
NODE_B_IP=192.168.50.2

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# Langfuse Postgres (separate instance)
LANGFUSE_POSTGRES_PASSWORD=change-me-in-production
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production

# LiteLLM
LITELLM_MASTER_KEY=change-me-in-production

# XNCH
XNCH_AUTH_SECRET=change-me-in-production

# Nexi cross-node addresses
NEXI_LITELLM_PROXY_URL=http://NODE_A_IP:4000/v1
NEXI_XNCH_BASE_URL=http://NODE_A_IP:8001
NEXI_REDIS_URL=redis://NODE_A_IP:6379/0
NEXI_POSTGRES_URL=postgresql://xnch:POSTGRES_PASSWORD@NODE_A_IP:5432/xnch