[Unit]
Description=vLLM — Ornith-1.0-35B (GPTQ-Pro, Qwen3-MoE, agentic coding)
After=network-online.target nvidia-ready.service
Wants=network-online.target nvidia-ready.service
Conflicts=xtrain-cycle.service xtrain-promote.service vision-media.service
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
User=x-nch
WorkingDirectory=/home/x-nch
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
Environment=VLLM_ATTENTION_BACKEND=FLASH_ATTN
Environment=VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
ExecStart=/home/x-nch/venvs/vllm-ornith/bin/vllm serve \
  /home/x-nch/models/ornith-gptq-pro \
  --served-model-name ornith-1.0-35b \
  --host 0.0.0.0 \
  --port 8082 \
  --trust-remote-code \
  --dtype float16 \
  --max-model-len 32768 \
  --quantization gptq_marlin \
  --gpu-memory-utilization 0.95 \
  --enable-prefix-caching \
  --max-num-seqs 2 \
  --enable-auto-tool-choice \
  --tool-call-parser qwen3_xml
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
