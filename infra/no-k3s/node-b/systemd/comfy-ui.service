[Unit]
Description=ComfyUI — Flux image + Wan 2.2 video generation/editing
After=network-online.target nvidia-ready.service
Wants=network-online.target nvidia-ready.service
Conflicts=vllm-ornith.service
ConditionPathExists=/usr/bin/nvidia-smi

[Service]
Type=simple
User=x-nch
WorkingDirectory=/home/x-nch/ComfyUI
Environment=COMFYUI_MODELS_DIR=/home/x-nch/models/comfy
ExecStart=/home/x-nch/venvs/comfy/bin/python main.py \
  --listen 0.0.0.0 \
  --port 8188 \
  --preview-method auto \
  --reserve-vram 14
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
