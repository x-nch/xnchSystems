# Cloudflare Tunnel — expose gate7 xnch (:8001) to api.x-nch.com
#
# Setup:
#   1. cloudflared tunnel login
#   2. cloudflared tunnel create xnch-gate7
#   3. cp this file to ~/.cloudflared/config.yml
#   4. Replace <TUNNEL-UUID> with the UUID from step 2
#   5. cloudflared tunnel route dns xnch-gate7 api.x-nch.com
#   6. sudo cp infra/no-k3s/node-a/systemd/cloudflared-xnch.service /etc/systemd/system/
#   7. sudo systemctl enable --now cloudflared-xnch.service
#
# Vercel env: XNCH_GATEWAY_URL=https://api.x-nch.com

tunnel: xnch-gate7
credentials-file: /home/x-nch/.cloudflared/<TUNNEL-UUID>.json

ingress:
  - hostname: api.x-nch.com
    service: http://127.0.0.1:8001
    originRequest:
      connectTimeout: 30s
      noTLSVerify: false
  - service: http_status:404
