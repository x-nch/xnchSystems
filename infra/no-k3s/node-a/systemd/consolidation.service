[Unit]
Description=XNCH Consolidation Job — Summarization, Graph Extraction, Decay
After=network.target xnch.service
Wants=xnch.service

[Service]
Type=oneshot
User=x-nch
EnvironmentFile=/home/x-nch/.xnch/xnch.env
ExecStart=/bin/sh -c 'curl -sf -X POST -H "X-Internal-Token: $XNCH_MEMORY_TOKEN" http://127.0.0.1:8003/v1/consolidation/run'
StandardOutput=journal
StandardError=journal
