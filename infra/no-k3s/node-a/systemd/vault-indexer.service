[Unit]
Description=XNCH Vault Indexer — Index Vault Documents
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=x-nch
WorkingDirectory=/home/x-nch/xnchSystems
EnvironmentFile=/home/x-nch/.xnch/vault-indexer.env
ExecStart=/usr/bin/python3 -c "import asyncio; from xnch.perception.vision_encoder import index_vault; asyncio.run(index_vault())"
StandardOutput=journal
StandardError=journal