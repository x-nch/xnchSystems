m-live%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin\\\",\\n+    \\\"data/state_store.db/mem%3Aobs%3Ases_0fae28776ffeZ9tGekj9Vspli7.bin\\\",\\n+    \\\"data/stream_store/stream%3Amem-live%3A8a12ce37-9817-49dc-8990-dd863ab7acf0.bin\\\",\\n+    \\\"data/state_store.db/mem%3Aobs%3A8a12ce37-9817-49dc-8990-dd863ab7acf0.bin\\\",\\n+    \\\"data/stream_store/stream%3Amem-live%3Ases_0fae5dfd6ffes8nhx5eGrq5TbX.bin\\\",\\n+    \\\"docs/architecture/system-loop.md\\\",\\n+    \\\"image.png\\\",\\n     \\\"docs/architecture/tech-stack.md\\\",\\n-    \\\"xnch/dump.rdb\\\",\\n-    \\\"nexi/nexi/__pycache__/main.cpython-313.pyc\\\",\\n     \\\"GEMINI.md\\\",\\n     \\\"AGENTS.md\\\",\\n     \\\"CLAUDE.md\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/verdict.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/session.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/policy.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/memory.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/governance.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/execution.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/auth.cpython-313.pyc\\\",\\n-    \\\"xnch/xnch/routes/__pycache__/__init__.cpython-313.pyc\\\",\\n     \\\"ArchitecturalAuidtReport.md\\\",\\n-    \\\"docs/architecture/system-loop.md\\\",\\n     \\\"docs/architecture/_memory-map.md\\\",\\n     \\\"docs/architecture/_decision-map.md\\\",\\n     \\\"diagrams/system-architecture.md\\\",\\ndiff --git a/AGENTS.md b/AGENTS.md\\nindex a5fee4e..312da71 100644\\n--- a/AGENTS.md\\n+++ b/AGENTS.md\\n@@ -1,9 +1,11 @@\\n ## Monorepo Structure\\n \\n-- `nexi/` — Execution engine (Python 3.11+, FastAPI, decision/policy system)\\n-- `xnch/` — Control plane API (Python 3.13+, REST routes, auth, memory)\\n+- `nexi/` — Execution engine (FastAPI, decision/policy system)\\n+- `xnch/` — Control plane API (REST routes, auth, memory)\\n - Root pyproject.toml requires Python 3.13+\\n \\n+**Note:** Individual packages specify `>=3.11` but root requires `>=3.13`. Align to 3.13.\\n+\\n **Entrypoints:**\\n - `nexi/nexi/main.py` — Engine CLI\\n - `xnch/xnch/main.py` — API server\\n@@ -14,6 +16,7 @@\\n pytest                  # Run all tests (auto-asyncio mode)\\n pytest nexi/tests       # Run only nexi tests\\n pytest xnch/tests     # Run only xnch tests\\n+pytest nexi/tests/test_evaluator.py  # Run single test file\\n ```\\n \\n No dedicated lint/typecheck commands in this repo.\\ndiff --git \\\"a/Gemma 4 \\\\342\\\\200\\\\224 Google DeepMind.html\\\" \\\"b/Gemma 4 \\\\342\\\\200\\\\224 Google DeepMind.html\\\"\\nnew file mode 100644\\nindex 0000000..928e1f0\\n--- /dev/null\\n+++ \\\"b/Gemma 4 \\\\342\\\\200\\\\224 Google DeepMind.html\\\"\\t\\n@@ -0,0 +1,152 @@\\n+<!doctype html><html class=deepai data-gtm-id=GTM-NRDHXJGK lang=en><head><meta charset=utf-8><meta content=\\\"ie=edge\\\" http-equiv=x-ua-compatible><meta content=\\\"width=device-width,initial-scale=1.0\\\" name=viewport><title>Gemma 4 — Google DeepMind</title><link href=https://deepmind.google/models/gemma/gemma-4/ rel=canonical><meta content=\\\"Gemma 4 is a family of open models, purpose-built for advanced reasoning and agentic workflows.\\\" name=description><meta content=\\\"Gemma 4\\\" property=og:title><meta content=\\\"Our most intelligent open models, built from Gemini 3 research.\\\" property=og:description><meta content=\\\"https://lh3.googleusercontent.com/XtdGQ6B0XzfV1gByFCtGbxLthooBSyg6QZWJn4VuM4SpDduwdYqOPFWpxyMIv875LTG1zUt0Xm34B29PfjACwd6m8fLiQpFLkZnjR5bVmJnCDANx6g=w1200-h630-n-nu-rw\\\" property=og:image><meta content=\\\"Google DeepMind\\\" property=og:site_name><meta content=https://deepmind.google/models/gemma/gemma-4/ property=og:url><meta content=website property=og:type><meta content=summary_large_image name=twitter:card><meta content=\\\"Gemma 4\\\" name=twitter:title><meta content=\\\"https://lh3.googleusercontent.com/XtdGQ6B0XzfV1gByFCtGbxLthooBSyg6QZWJn4VuM4SpDduwdYqOPFWpxyMIv875LTG1zUt0Xm34B29PfjACwd6m8fLiQpFLkZnjR5bVmJnCDANx6g=w1200-h630-n-nu-rw\\\" name=twitter:image><meta content=\\\"Our most intelligent open models, built from Gemini 3 research.\\\" name=twitter:description><meta content=@GoogleDeepMind name=twitter:site><link href=https://storage.googleapis.com/gdm-deepmind-com-prod-public/icons/google_deepmind_2x_96dp.png rel=apple-touch-icon><link href=https://storage.googleapis.com/gdm-deepmind-com-prod-public/icons/google_deepmind_32dp.ico rel=icon sizes=32x32 type=image/x-icon><link href=https://storage.googleapis.com/gdm-deepmind-com-prod-public/icons/google_deepmind_16dp.ico rel=icon sizes=16x16 type=image/x-icon><link href=https://storage.googleapis.com/gdm-deepmind-com-prod-public/icons/google_deepmind_alldp.ico rel=icon sizes=any type=image/x-icon><link href=https://storage.googleapis.com/gdm-deepmind-com-prod-public/icons/google_deepmind_48dp.svg rel=icon type=image/svg+xml><link href=https://deepmind.google/mo...[truncated]"},"type":"raw"},"obs_mqv9332w_0d5f26466231":{"observation":{"concepts":["proactive monitoring","automated system health checks","event-driven maintenance"],"confidence":1,"facts":["ProactivityEngine monitors system health via patterns, database state, and service availability.","Triggers include 'stale_pattern' (low success rate), 'consolidation_stale' (db check), and 'inference_down' (vllm health check).","Uses Redis for state and httpx for health checks."],"files":["/Users/xnch/xnchSystems/nexi/nexi/proactivity/engine.py"],"id":"obs_mqv9332w_0d5f26466231","importance":3,"narrative":"The engine defines ProactivityEvent structures and a ProactivityEngine class that scans for system issues. It automates the creation of proactive alerts when certain thresholds (e.g., success rates, time intervals) are met.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Exploring the logic for automated system maintenance events","timestamp":"2026-06-26T18:14:22.755Z","title":"Read Proactivity Engine Implementation","type":"file_read"},"type":"compressed"},"obs_mqv9338s_bfbbd6d2ccc3":{"observation":{"concepts":["FastAPI lifecycle","Decision Engine Pipeline","Intent Interpretation","Context Manifest Loading"],"confidence":1,"facts":["Nexi is a FastAPI-based decision engine application.","Uses XnchClient, ModelAdapter, PolicyFilter, and IntentInterpreter for its pipeline.","Implements a lifespan context manager to initialize core services.","Defines SessionStartRequest and SessionStartResponse schemas for session handling.","The /session/start endpoint handles intent interpretation and context loading."],"files":["/Users/xnch/xnchSystems/nexi/nexi/main.py"],"id":"obs_mqv9338s_bfbbd6d2ccc3","importance":3,"narrative":"Read the main entry point of the Nexi application to understand the request lifecycle, service initialization, and the pipeline steps (intent interpretation and context loading) used to process session requests.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Exploring /nexi/main.py for core application logic","timestamp":"2026-06-26T18:14:22.977Z","title":"Read Nexi main application entry point","type":"file_read"},"type":"compressed"},"obs_mqv933k0_e98a42858931":{"observation":{"concepts":["FastAPI lifespan","Multi-layered memory architecture","Policy-driven governance","Hierarchical memory (Sensory, Working, Episodic, Graph)","Graph-based semantic memory"],"confidence":1,"facts":["The service (xnch-server) handles governance, memory, and authorization.","Uses FastAPI with a lifespan context manager for complex state initialization.","Implements a multi-layered memory architecture: Sensory Buffer (Redis), Working Memory (Redis), Episodic Store (SQL/PG), and Graph Store (Postgres/Graph).","Integrates PolicyEngine, PolicyLoader, and PatternExtractor for learning and governance.","Key components include: Auth (TokenSigner/Verifier), Audit (EventLog/DecisionLedger), and Memory (Episodic/Pattern/Graph/KV)."],"files":["/Users/xnch/xnch/xnch/main.py"],"id":"obs_mqv933k0_e98a42858931","importance":7,"narrative":"Read the main entry point of the xnch-server to understand the system's initialization sequence. The architecture reveals a sophisticated hierarchy of memory layers (Sensory -> Working -> Episodic -> Graph) and a policy-driven governance system.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting the core server initialization and service architecture","timestamp":"2026-06-26T18:14:23.381Z","title":"Read main.py entry point","type":"file_read"},"type":"compressed"},"obs_mqv933wv_16bd66223b8b":{"observation":{"concepts":["episodic memory","vector database","pgvector","ChromaDB","memory retrieval patterns"],"confidence":1,"facts":["Implements `PgEpisodicStore` for Layer 2 episodic memory.","Uses `agentmemory` (ChromaDB-based) for underlying storage logic.","Stores episodes with metadata: type, raw_text, summary, importance, recall_count, etc.","Includes `store_episode` and `retrieve_similar` methods."],"files":["/Users/xnch/xnchSystems/xnch/xnch/memory/pg_episodic_store.py"],"id":"obs_mqv933wv_16bd66223b8b","importance":3,"narrative":"Examined the implementation of the episodic memory store which interfaces with agentmemory to handle long-term episodic data. This file defines how memory is structured and retrieved using vector similarity.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Implementation of PostgreSQL/pgvector episodic memory store","timestamp":"2026-06-26T18:14:23.845Z","title":"Read pg_episodic_store.py","type":"file_read"},"type":"compressed"},"obs_mqv9344m_20960ee683a6":{"observation":{"concepts":["Semantic Graph Store","Entity-Relationship modeling","Memory Upsert Logic","Agent Memory Layer 3"],"confidence":1,"facts":["GraphStore manages semantic graph memory using agentmemory categories: 'entities' and 'relations'.","upsert_entity uses search_memory to check for existing entities before creating or updating.","upsert_relation stores relationships as text strings (e.g., \"id1 rel_type id2\") in the relations category.","The class supports an optional relationship_store for secondary storage/graph updates."],"files":["/Users/xnch/xnch/xnch/memory/graph_store.py"],"id":"obs_mqv9344m_20960ee683a6","importance":3,"narrative":"The tool read the implementation of GraphStore, which provides the core logic for managing a semantic graph of entities and their relationships. This is a key component of the Layer 3 memory system.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"/Users/xnch/xnch/xnch/memory/graph_store.py","timestamp":"2026-06-26T18:14:24.124Z","title":"Read GraphStore implementation","type":"file_read"},"type":"compressed"},"obs_mqv934b1_a4a7eb820d9a":{"observation":{"concepts":["knowledge graph extraction","LLM-based entity extraction","episodic memory","graph database upsert"],"confidence":1,"facts":["Uses litellm to perform extraction via a configurable model (defaulting to ollama/phi3:mini)","Processes episodes from PgEpisodicStore to identify subject-relation-object triples","Stores extracted triples into a GraphStore","Extraction prompt defines a specific JSON schema for entity/relation triples"],"files":["/Users/xnch/xnchSystems/xnch/xnch/memory/graph_extractor.py"],"id":"obs_mqv934b1_a4a7eb820d9a","importance":5,"narrative":"The file contains the logic for the graph extraction pipeline, which parses recent episodic memories and populates a graph database with semantic relationships. This is a core component of the system's long-term memory construction.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Implementation of LLM-based entity/relation extraction from episodic memory","timestamp":"2026-06-26T18:14:24.354Z","title":"Read graph_extractor.py","type":"file_read"},"type":"compressed"},"obs_mqv93dzt_c884c00e0931":{"observation":{"concepts":["asynchronous database access","JSON extraction from SQLite","episode-based learning data","aiosqlite"],"confidence":1,"facts":["The file implements an async method `_fetch_episodes_with_scores` using aiosqlite.","The SQL query retrieves episode data from `decision_episodes` where outcome and scores are present.","Data includes episode_id, intent_class, outcome, context_snapshot, and created_at.","The parser extracts scores from a JSON field within the `context_snapshot` column."],"files":["/Users/xnch/xnchSystems/xnch/xnch/learning/score_adapter.py"],"id":"obs_mqv93dzt_c884c00e0931","importance":3,"narrative":"The user inspected a portion of the score_adapter.py file to understand how historical episode data and their associated scores are retrieved from the SQLite database. This is crucial for understanding the data pipeline for the learning module.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting episode fetching logic in learning module","timestamp":"2026-06-26T18:14:36.907Z","title":"Read score_adapter.py","type":"file_read"},"type":"compressed"},"obs_mqv93ejc_8aa338c43157":{"observation":{"concepts":["memory consolidation","graph extraction","exponential decay","episodic memory archival"],"confidence":1,"facts":["The consolidation job performs summarization, graph extraction, decay calculation, and archival.","Uses 'agentmemory' for storage operations and 'extract_and_store' for graph extraction.","Decay formula: importance * e^(-0.1 * days) * (1 + 0.1 * recall_count).","Archives episodes if decay_score falls below 0.1."],"files":["/Users/xnch/xnchSystems/xnch/xnch/jobs/consolidation.py"],"id":"obs_mqv93ejc_8aa338c43157","importance":4,"narrative":"Read the consolidation.py script to understand the periodic background job responsible for managing memory lifecycle. The script handles Zep summarization, relationship extraction to a graph, and metadata-based decay/archival.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Examination of periodic memory cleanup and graph extraction logic","timestamp":"2026-06-26T18:14:37.615Z","title":"Read consolidation job script","type":"file_read"},"type":"compressed"},"obs_mqv93eu5_08bbb231fe87":{"observation":{"concepts":["FastAPI routing","LiteLLM integration","Prompt caching","Input security scanning","Context assembly pattern"],"confidence":1,"facts":["Defines `/nexi` API router with endpoints for `/system-prompt` and `/chat`","Uses `LiteLLM` for backend LLM interactions","Implements security layers: `scan_input` (injection guard) and `validate_memory_write`","Features a system prompt cache in Redis with TTL","Integrates with `ProactivityEngine`, `assemble_context`, and `classify_request`"],"files":["/Users/xnch/xnchSystems/xnch/xnch/routes/nexi_gateway.py"],"id":"obs_mqv93eu5_08bbb231fe87","importance":5,"narrative":"Read the Nexi gateway route file to understand the request handling, security scanning, and context assembly logic for the Nexi agent interface. This file serves as the primary entry point for chat and system prompt management.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting the Nexi gateway routing implementation","timestamp":"2026-06-26T18:14:38.003Z","title":"Read nexi_gateway.py","type":"file_read"},"type":"compressed"},"obs_mqv93f6h_e1856e0f9d27":{"observation":{"concepts":["LLM Observability","Langfuse","Async HTTP client","Tracing"],"confidence":1,"facts":["Implements LangfuseClient using httpx for async API calls","Uses Basic Auth with public and secret keys from settings","Supports tracing LLM calls with prompt, response, model, and latency data","Sends data to /api/public/ingestion endpoint"],"files":["/Users/xnch/xnchSystems/xnch/xnch/observability/langfuse_client.py"],"id":"obs_mqv93f6h_e1856e0f9d27","importance":3,"narrative":"The file contains the implementation of a Langfuse client used for monitoring LLM performance. It handles trace creation and generation logging for-llm calls.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Exploring observability integration for LLM tracing","timestamp":"2026-06-26T18:14:38.445Z","title":"Read Langfuse client implementation","type":"file_read"},"type":"compressed"},"obs_mqv93syj_b09742103367":{"observation":{"concepts":["vision encoding","moondream VL model","asynchronous image processing","Redis caching"],"confidence":1,"facts":["Uses `moondream2` model for image captioning via the `moondream` library.","Implements `VisionEncoder` class with asynchronous model loading and execution.","Stores generated descriptions in Redis with a 60-second TTL.","Uses `aioredis` for asynchronous Redis communication.","Encodes images (bytes) into text descriptions (captions)."],"files":["/Users/xnch/xnchSystems/xnch/xnch/perception/vision_encoder.py"],"id":"obs_mqv93syj_b09742103367","importance":4,"narrative":"Read the source code for vision_encoder.py to understand how screenshots are processed. The module uses a Moondream VL model to generate captions and persists the results in Redis for short-term access.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspected the vision encoding implementation","timestamp":"2026-06-26T18:14:56.301Z","title":"Read vision_encoder.py","type":"file_read"},"type":"compressed"},"obs_mqv93tk2_fa78d1c7f069":{"observation":{"concepts":["audio transcription","Whisper model","asyncio executor","numpy audio normalization"],"confidence":1,"facts":["The _transcribe method uses an internal _whisper_model for speech-to-text.","Audio buffer is converted from raw bytes to float32 numpy array normalized to [-1.0, 1.0].","Transcription is executed in a separate thread using loop.run_in_executor to avoid blocking the event loop.","Transcription uses beam_size=1 and language=\"en\"."],"files":["/Users/xnch/xnchSystems/xnch/xnch/perception/voice_daemon.py"],"id":"obs_mqv93tk2_fa78d1c7f069","importance":3,"narrative":"Read a snippet of the voice_daemon.py file to understand how audio data is processed and transcribed using Whisper. This reveals the concurrency strategy (executor) and data normalization process used in the perception module.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Examining the _transcribe method in voice_daemon.py","timestamp":"2026-06-26T18:14:57.078Z","title":"Read voice_daemon.py transcription logic","type":"file_read"},"type":"compressed"},"obs_mqv93tty_7351e2ac823b":{"observation":{"concepts":["Context Assembly Pipeline","Entity Extraction","Relational Graph Store","Episodic Memory Retrieval","Prompt Engineering"],"confidence":1,"facts":["Defines AssembledContext dataclass containing system prompts, recent turns, episodes, entities, and perceptions.","Uses working_memory, pg_episodic, and graph_store to aggregate multi-modal context.","Extracts entity mentions via regex and retrieves related graph connections and relationships.","Integrates sensory buffer (voice) and proactivity engine observations into the final prompt."],"files":["/Users/xnch/xnchSystems/nexi/nexi/pipeline/context_assembler.py"],"id":"obs_mqv93tty_7351e2ac823b","importance":5,"narrative":"The file contains the implementation of the context assembly pipeline, which orchestrates the retrieval of episodic, relational, and sensory data to build a coherent system prompt for the agent.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting the core context assembly logic for the Nexi pipeline","timestamp":"2026-06-26T18:14:57.436Z","title":"Read context_assembler.py","type":"file_read"},"type":"compressed"},"obs_mqv93u52_be5920914927":{"observation":{"concepts":["LLM classification","Async HTTP requests","Event emission","LiteLLM proxy integration"],"confidence":1,"facts":["Uses httpx.AsyncClient for LLM calls","Sends requests to settings.litellm_proxy_url","Uses a system prompt (_CLASSIFICATION_SYSTEM_PROMPT) and JSON response format","Emits 'LLM_CLASSIFY_START' event via emit_event"],"files":["/Users/xnch/xnchSystems/nexi/nexi/pipeline/intent_interpreter.py"],"id":"obs_mqv93u52_be5920914927","importance":3,"narrative":"Read a portion of the intent interpreter implementation. The code reveals how user input is processed via an LLM proxy to classify intent using a specific system prompt.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting LLM classification logic in pipeline","timestamp":"2026-06-26T18:14:57.836Z","title":"Read intent_interpreter.py snippet","type":"file_read"},"type":"compressed"},"obs_mqv93ufl_e15f8c39f7b4":{"observation":{"concepts":["Pydantic Settings","Microservices configuration","Environment variables"],"confidence":1,"facts":["Uses Pydantic Settings with NEXI_ prefix and .env file support.","Configures URLs for xnch (8001), vLLM (8000/v1), LiteLLM proxy (4000/v1), and execution runner (8002).","Defines model_id as 'mistralai/Mistral-7B-Instruct-v0.3'.","Uses Redis via unix socket: unix:///tmp/xnch-redis.sock.","Includes timeouts for vLLM (30s/45s) and LiteLLM (60s)."],"files":["/Users/xnch/xnchSystems/nexi/nexi/config.py"],"id":"obs_mqv93ufl_e15f8c39f7b4","importance":3,"narrative":"Read the project's central configuration file to identify service endpoints, model identifiers, and infrastructure dependencies like Redis and LiteLLM.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting nexi/config.py for environment and service settings","timestamp":"2026-06-26T18:14:58.216Z","title":"Read configuration settings","type":"file_read"},"type":"compressed"},"obs_mqv93uz3_3db6cbd7119e":{"observation":{"concepts":["Redis cache","aioredis","key-value storage","session deduplication"],"confidence":1,"facts":["KVCache uses aioredis for connection management","Class includes a redis_client property and an aclose method","File contains logic for session deduplication (Step 2a)"],"files":["/Users/xnch/xnchSystems/xnch/xnch/memory/kv_cache.py"],"id":"obs_mqv93uz3_3db6cbd7119e","importance":2,"narrative":"The agent read a portion of kv_cache.py to understand how the Redis client is initialized and managed. This is part of exploring the persistent memory storage layer.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting Redis-based key-value cache structure","timestamp":"2026-06-26T18:14:58.915Z","title":"Read KVCache implementation","type":"file_read"},"type":"compressed"},"obs_mqv941ul_de2836b14459":{"observation":{"concepts":["Docker deployment","Python runtime","Uvicorn server","Containerization"],"confidence":1,"facts":["Uses python:3.13-slim base image","Installs nexi package in editable mode from /app/nexi/","Exposes port 8000","Runs uvicorn with nexi.main:app entrypoint"],"files":["/Users/xnch/xnchSystems/deploy/docker/nexi.Dockerfile"],"id":"obs_mqv941ul_de2836b14459","importance":3,"narrative":"The Dockerfile for the nexi service was read to understand the container build process. This file defines the environment, dependencies, and startup command for the application deployment.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting deployment configuration in /deploy/docker/nexi.Dockerfile","timestamp":"2026-06-26T18:15:07.817Z","title":"Read Dockerfile for nexi service","type":"file_read"},"type":"compressed"},"obs_mqv942dz_61b7d1a7d7d0":{"observation":{"concepts":["Kubernetes CronJob","Python asyncio","K8s Secret injection","PostgreSQL connection strings"],"confidence":1,"facts":["CronJob name: 'consolidation' in namespace 'xnch-system'","Schedule: '0 2 * * *' (runs daily at 2:00 AM)","Uses image 'xnch/xnch-server:latest'","Executes python command: asyncio.run(run_consolidation())","Depends on 'xnch-secret' for POSTGRES_PASSWORD","Connects to postgres-pgvector:5432"],"files":["/Users/xnch/xnchSystems/deploy/k8s/jobs/consolidation-cronjob.yaml"],"id":"obs_mqv942dz_61b7d1a7d7d0","importance":3,"narrative":"The file was read to understand the configuration of the daily consolidation task. This task is a Kubernetes CronJob that runs a specific Python function within the xnch-server container.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting consolidation-cronjob.yaml for job scheduling and execution details","timestamp":"2026-06-26T18:15:08.525Z","title":"Read Kubernetes CronJob configuration","type":"file_read"},"type":"compressed"},"obs_mqv942om_5f0d8464691e":{"observation":{"concepts":["Kubernetes Deployment","Kubernetes Service","K8s NodeSelector","Kubernetes Volumes","Container Resource Limits"],"confidence":1,"facts":["Deployment name: xnch in namespace xnch-system","Uses Recreate deployment strategy","Node selector requires role: memory","Container image: xnch/xnch-server:latest","Service exposes port 8001","Environment variables include XNCH_REDIS_URL and XNCH_POSTGRES_URL","Uses persistent volumes for /app/config and /data"],"files":["/Users/xnch/xnchSystems/deploy/k8s/i7-node/xnch-deployment.yaml"],"id":"obs_mqv942om_5f0d8464691e","importance":5,"narrative":"Read the Kubernetes deployment and service manifest to understand the infrastructure setup for the xnch service, including resource limits, environment variables, and volume mounts.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting xnch-deployment.yaml for service configuration","timestamp":"2026-06-26T18:15:08.909Z","title":"Read Kubernetes Deployment Configuration","type":"file_read"},"type":"compressed"},"obs_mqv943ac_9a7d322c5086":{"observation":{"concepts":["event-driven processing","idle timeout monitoring","asynchronous consolidation","threshold-based filtering"],"confidence":1,"facts":["Class AttentionFilter evaluates voice, screen changes, and file saves to trigger system actions.","Thresholds for silence, screen pixel diff, and idle timeout are pulled from settings.","Triggers 'run_consolidation' job when user idle duration exceeds threshold."],"files":["/Users/xnch/xnchSystems/xnch/xnch/perception/attention_filter.py"],"id":"obs_mqv943ac_9a7d322c5086","importance":4,"narrative":"The user read the implementation of the AttentionFilter module. This module is responsible for determining which perceptual events (voice, screen, file changes) warrant downstream processing or system consolidation.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting perception layer logic for event processing","timestamp":"2026-06-26T18:15:09.690Z","title":"Read attention_filter.py","type":"file_read"},"type":"compressed"},"obs_mqv94baq_4d4f8d2f1bc6":{"observation":{"concepts":["async/await mismatch","mocking async dependencies","pytest failure analysis","JWT security warnings"],"confidence":1,"facts":["8 tests failed out of 244 total tests","TypeError: object MagicMock can't be used in 'await' expression in nexi_gateway.py:66","Redis mock usage in tests is incorrectly configured for async await","InsecureKeyLengthWarning detected in jwt-related tests","Failures observed in security/test_trust_model.py and test_nexi_gateway.py"],"files":["xnch/routes/nexi_gateway.py","tests/security/test_trust_model.py","tests/test_nexi_gateway.py"],"id":"obs_mqv94baq_4d4f8d2f1bc6","importance":7,"narrative":"The full test suite execution failed due to a TypeError where a MagicMock was being awaited in the nexi_gateway route. This indicates a regression or bug in how Redis/dependency mocks are implemented for asynchronous calls.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"pytest execution results for xnch and nexi modules","timestamp":"2026-06-26T18:15:20.043Z","title":"Full Test Suite Execution Failure","type":"command_run"},"type":"compressed"},"obs_mqv95w4t_da0962ccf6c6":{"observation":{"concepts":["temporal synchronization"],"confidence":0.9,"facts":["Timestamp: 2026-06-26T18:16:33.724Z"],"files":[],"id":"obs_mqv95w4t_da0962ccf6c6","importance":1,"narrative":"The system received a timestamped notification. This serves as a temporal marker for the start of the current processing context.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Incoming timestamp event","timestamp":"2026-06-26T18:16:33.724Z","title":"System Timestamp Notification","type":"notification"},"type":"compressed"},"obs_mqv981op_56eba35be57b":{"observation":{"concepts":["Async/Await Mocking","Redis Mocking","FastAPI Dependency Injection","Unit Testing Error"],"confidence":1,"facts":["pytest failure in `tests/security/test_trust_model.py` and `tests/test_nexi_gateway.py`","TypeError: object MagicMock can't be used in 'await' expression","Error occurs in `xnch/xnch/routes/nexi_gateway.py:66` during `await redis.get(SYSTEM_PROMPT_CACHE_KEY)`","The `redis.get` call is returning a `MagicMock` which is not awaitable"],"files":["tests/security/test_trust_model.py","tests/test_nexi_gateway.py","xnch/xnch/routes/nexi_gateway.py"],"id":"obs_mqv981op_56eba35be57b","importance":6,"narrative":"Running pytest revealed critical failures in security and gateway tests. The Redis client mock is not properly configured as an asynchronous mock, causing an awaitable error in the Nexi gateway route.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Async await error when using MagicMock for Redis","timestamp":"2026-06-26T18:18:14.220Z","title":"pytest failure: TypeError in Nexi Gateway","type":"error"},"type":"compressed"},"obs_mqv981ui_d942da26b1b5":{"observation":{"concepts":["Role-based access control","Trust model","FastAPI middleware/decorators","Security testing"],"confidence":1,"facts":["TrustLevel enum contains: UNTRUSTED (1), EXTERNAL_AGENT (2), TRUSTED_AGENT (3), OWNER (4), SYSTEM (5)","get_trust_level maps specific actors (nexi, openclaw, opencode, perception_daemon) to specific TrustLevels","@requires_trust decorator enforces minimum trust level via X-Actor-Role header","ACTOR_TRUST_MAP contains keys: nexi, openclaw, claude_code, opencode, perception_daemon, consolidation_job, external"],"files":["/Users/xnch/xnchSystems/tests/security/test_trust_model.py"],"id":"obs_mqv981ui_d942da26b1b5","importance":2,"narrative":"Read the unit tests for the security trust model to understand how actor-based authorization and trust level enforcement are implemented in the system.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting test_trust_model.py for trust level logic","timestamp":"2026-06-26T18:18:14.448Z","title":"Read security trust model tests","type":"file_read"},"type":"compressed"},"obs_mqv985wl_2519cd23a0ef":{"observation":{"concepts":["pytest fixtures","mocking dependencies","unit testing","AsyncMock"],"confidence":1,"facts":["File contains unit tests for xnch/routes/nexi_gateway.py using mock dependencies.","Uses a custom _FakeRedis class to mock Redis operations (get, set, delete, etc.).","Defines a pytest fixture `mock_state` that mocks a complex global state including Redis, pg_episodic, working_memory, relationship_store, graph_store, and sensory_buffer."],"files":["/Users/xnch/xnchSystems/tests/test_nexi_gateway.py"],"id":"obs_mqv985wl_2519cd23a0ef","importance":2,"narrative":"Read the beginning of the Nexi gateway test file to understand the testing setup. The file uses extensive mocking of the application state to isolate the route logic.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting unit tests for Nexi gateway route","timestamp":"2026-06-26T18:18:19.704Z","title":"Read test_nexi_gateway.py","type":"file_read"},"type":"compressed"},"obs_mqv98b7t_532cd7acea3d":{"observation":{"concepts":["e2e testing","pytest","chat injection guard","chat memory persistence"],"confidence":1,"facts":["Ran pytest on tests/test_nexi_chat_e2e.py","All 4 tests passed successfully","Test suite duration: 1.73s","Tests covered: chat roundtrip, stream persistence, injection guard, and memory recall"],"files":["tests/test_nexi_chat_e2e.py"],"id":"obs_mqv98b7t_532cd7acea3d","importance":4,"narrative":"Executed the end-to-end test suite for the Nexi chat functionality to verify core features including streaming, memory, and security guards. All tests passed, confirming stable system behavior.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Executing pytest for nexi_chat e2e suite","timestamp":"2026-06-26T18:18:26.588Z","title":"Run end-to-end chat tests","type":"command_run"},"type":"compressed"},"obs_mqv99afy_f796d7b4049a":{"observation":{"concepts":["subagent lifecycle","process termination"],"confidence":0.9,"facts":["The subagent execution cycle has reached a stop state."],"files":[],"id":"obs_mqv99afy_f796d7b4049a","importance":1,"narrative":"The subagent triggered a stop event, indicating the completion or interruption of a specific sub-task or delegated process. This marks the end of that specific subagent's operational context within the current session.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Subagent lifecycle event","timestamp":"2026-06-26T18:19:12.239Z","title":"Subagent process terminated","type":"subagent"},"type":"compressed"},"obs_mqv9aci0_e464f72af2c9":{"observation":{"concepts":["FastAPI HTTPException","Python decorators","Request object injection","Security middleware"],"confidence":1,"facts":["test_requires_trust_passes failed in tests/security/test_trust_model.py","HTTPException 500 raised: \"Request object not found\"","Failure occurs in xnch/xnch/security/trust_model.py:48","The wrapper function fails to locate a Request object in args or kwargs"],"files":["tests/security/test_trust_model.py","xnch/xnch/security/trust_model.py"],"id":"obs_mqv9aci0_e464f72af2c9","importance":6,"narrative":"Running pytest on the trust model security tests revealed a regression or bug where the decorator/wrapper fails to find the Request object, leading to a 500 error. This indicates a failure in dependency injection or argument parsing within the security middleware/decorator.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Execution of security test suite failed","timestamp":"2026-06-26T18:20:01.537Z","title":"pytest failure: trust model test","type":"command_run"},"type":"compressed"},"obs_mqv9acn0_dc39761708dc":{"observation":{"concepts":["pytest-asyncio","asyncio configuration","pyproject.toml"],"confidence":0.9,"facts":["pyproject.toml contains asyncio_mode = \"auto\"","pytest-asyncio version >= 1.4.0 is specified as a dependency"],"files":["pyproject.toml"],"id":"obs_mqv9acn0_dc39761708dc","importance":3,"narrative":"Ran a grep command on pyproject.toml to identify asyncio-related configurations. This confirms the project uses auto-mode for asyncio and includes pytest-asyncio in its development dependencies.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting dependency and mode settings for asyncio","timestamp":"2026-06-26T18:20:01.745Z","title":"Check asyncio configuration in pyproject.toml","type":"command_run"},"type":"compressed"},"obs_mqv9e451_819a3eb22f43":{"observation":{"concepts":["memory compression engine","agent memory management"],"confidence":0.9,"facts":["User invoked the /agentmemory command","The instruction was to update the memory compression engine's processing logic"],"files":[],"id":"obs_mqv9e451_819a3eb22f43","importance":5,"narrative":"The user submitted a prompt specifically targeting the agent memory mechanism. This indicates a meta-instruction to refine how information is compressed and stored.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"User requested a manual update to the agent memory system","timestamp":"2026-06-26T18:22:57.330Z","title":"Memory Update Request","type":"other"},"type":"compressed"},"obs_mqv9ex9m_66c8c9aae101":{"observation":{"concepts":["event notification"],"confidence":0.9,"facts":["Event occurred at 2026-06-26T18:23:35.080Z"],"files":[],"id":"obs_mqv9ex9m_66c8c9aae101","importance":1,"narrative":"A notification hook was triggered. No specific payload or content was provided in the notification event.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Timestamped event notification","timestamp":"2026-06-26T18:23:35.080Z","title":"System Notification Triggered","type":"notification"},"type":"compressed"},"obs_mqv9gckd_069bf53e4e16":{"observation":{"hookType":"post_tool_use","id":"obs_mqv9gckd_069bf53e4e16","raw":{"tool_input":{"concepts":"agentmemory-integration, pg-episodic-store-chromadb, episodic-memory-categories, agentmemory-api-patterns, chromadb-test-isolation","content":"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph store. PgEpisodicStore wraps agentmemory under a Postgres-like interface — despite the name, the Layer 2 memory (episodes) is stored in ChromaDB via agentmemory, not PostgreSQL. The PostgreSQL pool (asyncpg) is only used for decision_episodes and relationship_memory tables. Key agentmemory API calls used: create_memory, search_memory, get_memories, get_memory, update_memory. Category names in use: \"episodes\" (pg_episodic_store), \"entities\" (graph_store), \"intent-classifications\" (intent_interpreter), \"graph-entities\" and \"graph-relations\" (graph_store). The connect() method in PgEpisodicStore is a no-op stub — pool is never initialized from DSN, so store_decision_episode() and complete_decision_episode() raise RuntimeError at runtime until a real PostgreSQL connection is wired. ChromaDB test isolation is a known issue: e2e tests using agentmemory share collection state and fail mid-suite when run together.","files":"xnch/xnch/memory/pg_episodic_store.py, xnch/xnch/memory/graph_store.py, nexi/nexi/pipeline/intent_interpreter.py, tests/test_nexi_chat_e2e.py","project":"xnchSystems","type":"architecture"},"tool_name":"mcp__plugin_agentmemory_agentmemory__memory_save","tool_output":[{"text":"{\"memory\":{\"concepts\":[\"agentmemory-integration\",\"pg-episodic-store-chromadb\",\"episodic-memory-categories\",\"agentmemory-api-patterns\",\"chromadb-test-isolation\"],\"content\":\"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph store. PgEpisodicStore wraps agentmemory under a Postgres-like interface — despite the name, the Layer 2 memory (episodes) is stored in ChromaDB via agentmemory, not PostgreSQL. The PostgreSQL pool (asyncpg) is only used for decision_episodes and relationship_memory tables. Key agentmemory API calls used: create_memory, search_memory, get_memories, get_memory, update_memory. Category names in use: \\\"episodes\\\" (pg_episodic_store), \\\"entities\\\" (graph_store), \\\"intent-classifications\\\" (intent_interpreter), \\\"graph-entities\\\" and \\\"graph-relations\\\" (graph_store). The connect() method in PgEpisodicStore is a no-op stub — pool is never initialized from DSN, so store_decision_episode() and complete_decision_episode() raise RuntimeError at runtime until a real PostgreSQL connection is wired. ChromaDB test isolation is a known issue: e2e tests using agentmemory share collection state and fail mid-suite when run together.\",\"createdAt\":\"2026-06-26T18:24:41.270Z\",\"files\":[\"xnch/xnch/memory/pg_episodic_store.py\",\"xnch/xnch/memory/graph_store.py\",\"nexi/nexi/pipeline/intent_interpreter.py\",\"tests/test_nexi_chat_e2e.py\"],\"id\":\"mem_mqv9gcai_718a974eb30c\",\"isLatest\":true,\"sessionIds\":[],\"sourceObservationIds\":[],\"strength\":7,\"supersedes\":[],\"title\":\"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph s\",\"type\":\"architecture\",\"updatedAt\":\"2026-06-26T18:24:41.270Z\",\"version\":1},\"success\":true}","type":"text"}]},"sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","timestamp":"2026-06-26T18:24:41.571Z","toolInput":{"concepts":"agentmemory-integration, pg-episodic-store-chromadb, episodic-memory-categories, agentmemory-api-patterns, chromadb-test-isolation","content":"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph store. PgEpisodicStore wraps agentmemory under a Postgres-like interface — despite the name, the Layer 2 memory (episodes) is stored in ChromaDB via agentmemory, not PostgreSQL. The PostgreSQL pool (asyncpg) is only used for decision_episodes and relationship_memory tables. Key agentmemory API calls used: create_memory, search_memory, get_memories, get_memory, update_memory. Category names in use: \"episodes\" (pg_episodic_store), \"entities\" (graph_store), \"intent-classifications\" (intent_interpreter), \"graph-entities\" and \"graph-relations\" (graph_store). The connect() method in PgEpisodicStore is a no-op stub — pool is never initialized from DSN, so store_decision_episode() and complete_decision_episode() raise RuntimeError at runtime until a real PostgreSQL connection is wired. ChromaDB test isolation is a known issue: e2e tests using agentmemory share collection state and fail mid-suite when run together.","files":"xnch/xnch/memory/pg_episodic_store.py, xnch/xnch/memory/graph_store.py, nexi/nexi/pipeline/intent_interpreter.py, tests/test_nexi_chat_e2e.py","project":"xnchSystems","type":"architecture"},"toolName":"mcp__plugin_agentmemory_agentmemory__memory_save","toolOutput":[{"text":"{\"memory\":{\"concepts\":[\"agentmemory-integration\",\"pg-episodic-store-chromadb\",\"episodic-memory-categories\",\"agentmemory-api-patterns\",\"chromadb-test-isolation\"],\"content\":\"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph store. PgEpisodicStore wraps agentmemory under a Postgres-like interface — despite the name, the Layer 2 memory (episodes) is stored in ChromaDB via agentmemory, not PostgreSQL. The PostgreSQL pool (asyncpg) is only used for decision_episodes and relationship_memory tables. Key agentmemory API calls used: create_memory, search_memory, get_memories, get_memory, update_memory. Category names in use: \\\"episodes\\\" (pg_episodic_store), \\\"entities\\\" (graph_store), \\\"intent-classifications\\\" (intent_interpreter), \\\"graph-entities\\\" and \\\"graph-relations\\\" (graph_store). The connect() method in PgEpisodicStore is a no-op stub — pool is never initialized from DSN, so store_decision_episode() and complete_decision_episode() raise RuntimeError at runtime until a real PostgreSQL connection is wired. ChromaDB test isolation is a known issue: e2e tests using agentmemory share collection state and fail mid-suite when run together.\",\"createdAt\":\"2026-06-26T18:24:41.270Z\",\"files\":[\"xnch/xnch/memory/pg_episodic_store.py\",\"xnch/xnch/memory/graph_store.py\",\"nexi/nexi/pipeline/intent_interpreter.py\",\"tests/test_nexi_chat_e2e.py\"],\"id\":\"mem_mqv9gcai_718a974eb30c\",\"isLatest\":true,\"sessionIds\":[],\"sourceObservationIds\":[],\"strength\":7,\"supersedes\":[],\"title\":\"XNCH/Nexi uses agentmemory (ChromaDB-backed) as the primary episodic and graph s\",\"type\":\"architecture\",\"updatedAt\":\"2026-06-26T18:24:41.270Z\",\"version\":1},\"success\":true}","type":"text"}]},"type":"raw"},"obs_mqv9gr5c_6e75e122def3":{"observation":{"concepts":["pytest integration tests","API security injection guards","Async integration testing","Redis caching mocks"],"confidence":1,"facts":["Tests cover /nexi/system-prompt and /nexi/chat endpoints","Uses ASGITransport and AsyncClient for integration testing","Includes tests for system prompt caching and injection detection (scan_input)","Mocking involves agentmemory.get_memories and xnch.routes.nexi_gateway components"],"files":["/Users/xnch/xnchSystems/tests/test_nexi_gateway.py"],"id":"obs_mqv9gr5c_6e75e122def3","importance":3,"narrative":"Read a portion of the Nexi gateway test suite to understand the routing logic and security guards. The tests validate system prompt generation, caching, and input sanitization/injection rejection.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"Inspecting pytest implementation for Nexi gateway routes","timestamp":"2026-06-26T18:25:00.482Z","title":"Read test_nexi_gateway.py snippet","type":"file_read"},"type":"compressed"},"obs_mqv9gr79_9a39d80ef9df":{"observation":{"concepts":["e2e testing","integration tests","mocking httpx","Redis working memory","asgi transport testing"],"confidence":1,"facts":["The test verifies the Nexi chat roundtrip through the OpenClaw gateway.","Uses fakeredis and aiosqlite to avoid real LLM/Redis dependencies.","Mocks scanning, classification, and httpx client for a complete chat loop simulation.","Verifies that chat turns are correctly persisted in the Redis-backed working memory."],"files":["/Users/xnch/xnchSystems/tests/test_nexi_chat_e2e.py"],"id":"obs_mqv9gr79_9a39d80ef9df","importance":3,"narrative":"The user inspected the end-to-end integration tests for the Nexi chat system. This file defines how the chat flow (input, classification, gateway response) is validated using mocked external services and verifies state persistence in working memory.","sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","subtitle":"/Users/xnch/xnchSystems/tests/test_nexi_chat_e2e.py","timestamp":"2026-06-26T18:25:00.552Z","title":"Read end-to-end test for Nexi chat","type":"file_read"},"type":"compressed"},"obs_mqv9hwd5_37980691d746":{"observation":{"hookType":"post_tool_use","id":"obs_mqv9hwd5_37980691d746","raw":{"tool_input":{"command":".venv/bin/pytest -x --tb=no -q 2>&1 | tail -15","description":"Quick full suite run to count current failures","timeout":90000},"tool_name":"Bash","tool_output":{"interrupted":false,"isImage":false,"noOutputExpected":false,"stderr":"","stdout":"xnch/tests/test_auth.py::TestTokenVerifier::test_valid_bearer_token_returns_subject\nxnch/tests/test_auth.py::TestTokenVerifier::test_wrong_signature_returns_none\nxnch/tests/test_auth.py::TestTokenVerifier::test_expired_token_returns_none\nxnch/tests/test_auth.py::TestTokenVerifier::test_missing_subject_returns_none\nxnch/tests/test_auth.py::TestTokenVerifier::test_bearer_prefix_stripped\nxnch/tests/test_auth.py::TestTokenVerifier::test_whitespace_in_bearer_header\n  /Users/xnch/xnchSystems/.venv/lib/python3.13/site-packages/jwt/api_jwt.py:368: InsecureKeyLengthWarning: The HMAC key is 31 bytes long, which is below the minimum recommended length of 32 bytes for SHA256. See RFC 7518 Section 3.2.\n    decoded = self.decode_complete(\n\nxnch/tests/test_auth.p