ent":"\"\"\"Tests for PgEpisodicStore with mocked agentmemory.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom unittest.mock import patch\n\nimport pytest\n\nfrom xnch.memory.pg_episodic_store import PgEpisodicStore\n\n\n@pytest.fixture\nasync def store():\n    s = PgEpisodicStore()\n    await s.connect()\n    yield s\n    await s.close()\n\n\nMOCK_CREATE = {\n    \"side_effect\": lambda cat, text, id=None, embedding=None, metadata=None: id or \"new-id\"\n}\n\n\n@pytest.mark.asyncio\nasync def test_store_episode(store):\n    with patch(\"xnch.memory.pg_episodic_store.create_memory\") as mock_cm:\n        mock_cm.return_value = \"ep-001\"\n        eid = await store.store_episode(\n            type_=\"decision\",\n            raw_text=\"deploy service foo\",\n            summary=\"deployment episode\",\n            importance=1.0,\n        )\n    assert eid is not None\n    mock_cm.assert_called_once()\n    _, kwargs = mock_cm.call_args\n    assert kwargs[\"metadata\"][\"type\"] == \"decision\"\n","filePath":"/Users/xnch/xnchSystems/xnch/tests/test_pg_episodic_store.py","numLines":40,"startLine":1,"totalLines":124},"type":"text"}},"sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","timestamp":"2026-06-26T18:29:24.591Z","toolInput":{"file_path":"/Users/xnch/xnchSystems/xnch/tests/test_pg_episodic_store.py","limit":40},"toolName":"Read","toolOutput":{"file":{"content":"\"\"\"Tests for PgEpisodicStore with mocked agentmemory.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom unittest.mock import patch\n\nimport pytest\n\nfrom xnch.memory.pg_episodic_store import PgEpisodicStore\n\n\n@pytest.fixture\nasync def store():\n    s = PgEpisodicStore()\n    await s.connect()\n    yield s\n    await s.close()\n\n\nMOCK_CREATE = {\n    \"side_effect\": lambda cat, text, id=None, embedding=None, metadata=None: id or \"new-id\"\n}\n\n\n@pytest.mark.asyncio\nasync def test_store_episode(store):\n    with patch(\"xnch.memory.pg_episodic_store.create_memory\") as mock_cm:\n        mock_cm.return_value = \"ep-001\"\n        eid = await store.store_episode(\n            type_=\"decision\",\n            raw_text=\"deploy service foo\",\n            summary=\"deployment episode\",\n            importance=1.0,\n        )\n    assert eid is not None\n    mock_cm.assert_called_once()\n    _, kwargs = mock_cm.call_args\n    assert kwargs[\"metadata\"][\"type\"] == \"decision\"\n","filePath":"/Users/xnch/xnchSystems/xnch/tests/test_pg_episodic_store.py","numLines":40,"startLine":1,"totalLines":124},"type":"text"}},"type":"raw"},"obs_mqv9mjdw_ec46e2eb7346":{"observation":{"hookType":"post_tool_failure","id":"obs_mqv9mjdw_ec46e2eb7346","raw":{"error":"Exit code 1","tool_input":"{\"command\":\"grep -rl \\\"agentmemory\\\\|PgEpisodicStore\\\\|create_memory\\\\|search_memory\\\\|get_memories\\\" nexi/tests/ | xargs grep -l \\\"^from agentmemory\\\\|^import agentmemory\\\" 2>/dev/null\",\"description\":\"Find tests importing agentmemory directly (not mocked)\"}","tool_name":"Bash"},"sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","timestamp":"2026-06-26T18:29:30.362Z","toolInput":"{\"command\":\"grep -rl \\\"agentmemory\\\\|PgEpisodicStore\\\\|create_memory\\\\|search_memory\\\\|get_memories\\\" nexi/tests/ | xargs grep -l \\\"^from agentmemory\\\\|^import agentmemory\\\" 2>/dev/null\",\"description\":\"Find tests importing agentmemory directly (not mocked)\"}","toolName":"Bash","toolOutput":"Exit code 1"},"type":"raw"},"obs_mqv9mpj0_4df93ba31cfe":{"observation":{"hookType":"post_tool_use","id":"obs_mqv9mpj0_4df93ba31cfe","raw":{"tool_input":{"command":"python3 -c \"import agentmemory; print(agentmemory.__file__)\" 2>/dev/null || .venv/bin/python -c \"import agentmemory; import chromadb; c = chromadb.Client(); print(c._settings.chroma_db_impl, getattr(c._settings, 'persist_directory', 'in-memory'))\" 2>&1 | head -5","description":"Check agentmemory backend config"},"tool_n