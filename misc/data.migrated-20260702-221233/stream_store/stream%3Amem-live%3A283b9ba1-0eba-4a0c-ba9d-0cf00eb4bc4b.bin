  matchLabels:\n      app: xnch\n  template:\n    metadata:\n      labels:\n        app: xnch\n    spec:\n      nodeSelector:\n        role: memory\n      containers:\n        - name: xnch\n          image: xnch/xnch-server:latest\n          ports:\n            - containerPort: 8001\n          env:\n            - name: XNCH_REDIS_URL\n              value: redis://redis:6379/0\n            - name: XNCH_POSTGRES_URL\n              value: postgresql://xnch:$(POSTGRES_PASSWORD)@postgres-pgvector:5432/xnch\n            - name: XNCH_AUTH_SECRET\n              valueFrom:\n                secretKeyRef:\n                  name: xnch-secret\n                  key: auth_secret\n          resources:\n            limits:\n              memory: \"1.5Gi\"\n              cpu: \"1\"\n            requests:\n              memory: \"768Mi\"\n              cpu: \"500m\"\n          volumeMounts:\n            - name: config\n              mountPath: /app/config\n            - name: data\n              mountPath: /data\n      volumes:\n        - name: config\n          configMap:\n            name: xnch-config\n        - name: data\n          persistentVolumeClaim:\n            claimName: xnch-data\n---\napiVersion: v1\nkind: Service\nmetadata:\n  name: xnch\n  namespace: xnch-system\nspec:\n  selector:\n    app: xnch\n  ports:\n    - port: 8001\n      targetPort: 8001\n","filePath":"/Users/xnch/xnchSystems/deploy/k8s/i7-node/xnch-deployment.yaml","numLines":66,"startLine":1,"totalLines":66},"type":"text"}},"sessionId":"283b9ba1-0eba-4a0c-ba9d-0cf00eb4bc4b","timestamp":"2026-06-26T17:29:01.217Z","toolInput":{"file_path":"/Users/xnch/xnchSystems/deploy/k8s/i7-node/xnch-deployment.yaml"},"toolName":"Read","toolOutput":{"file":{"content":"apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: xnch\n  namespace: xnch-system\nspec:\n  replicas: 1\n  strategy:\n    type: Recreate\n  selector:\n    matchLabels:\n      app: xnch\n  template:\n    metadata:\n      labels:\n        app: xnch\n   