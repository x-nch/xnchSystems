{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "qwen-vl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen-VL (local)",
      "options": {
        "baseURL": "http://192.168.1.9:8083/v1",
        "apiKey": "no-key"
      },
      "models": {
        "qwen2.5-vl-7b": {
          "name": "Qwen2.5-VL-7B (local)",
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 16384, "output": 4096 },
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "serve", "--repo", "/Users/xnch/xnchSystems"]
    },
    "xnch": {
      "type": "local",
      "command": ["/Users/xnch/xnchSystems/.venv/bin/python", "-m", "xnch_mcp"],
      "env": { "XNCH_BASE_URL": "http://127.0.0.1:8001", "XNCH_ACTOR": "opencode" }
    },
    "superpowers": {
      "type": "local",
      "command": ["node", "./mcp/superpowers-mcp/build/index.js"],
      "env": {
        "SUPERPOWERS_SKILLS_DIR": "./skills/superpowers/skills",
        "SUPERPOWERS_USE_LOCAL_SKILLS": "true"
      }
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111",
        "AGENTMEMORY_SECRET": "xnch-agentmemory-secret"
      }
    },
    "langchain-docs": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "enabled": true
    }
  }
}
