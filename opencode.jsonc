{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "/home/x-nch/xnchSystems"
      ]
    },
    "xnch": {
      "type": "local",
      "command": [
        "/home/x-nch/xnchSystems/.venv/bin/python",
        "-m",
        "xnch_mcp"
      ],
      "env": {
        "XNCH_BASE_URL": "http://127.0.0.1:8001",
        "XNCH_ACTOR": "opencode"
      }
    }
  }
}
