{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "qwen-vl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen-VL (local)",
      "options": {
        "baseURL": "http://192.168.1.9:8083/v1",
        "apiKey": "no-key"
      },
      "models": {
        "qwen2.5-vl-7b": {
          "name": "Qwen2.5-VL-7B (local)",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "/home/x-nch/xnchSystems"
      ]
    },
    "xnch": {
      "type": "local",
      "command": [
        "/home/x-nch/xnchSystems/.venv/bin/python",
        "-m",
        "xnch_mcp"
      ],
      "env": {
        "XNCH_BASE_URL": "http://127.0.0.1:8001",
        "XNCH_ACTOR": "opencode"
      }
    },
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@figma-developer-mcp/figma-developer-mcp",
        "--figma-api-key",
        "{env:FIGMA_API_KEY}"
      ]
    }
  }
}
